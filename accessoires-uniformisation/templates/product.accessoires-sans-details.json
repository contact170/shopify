    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Est-ce que cet accessoire est compatible avec mon système d’alarme Daewoo ?",
            "text": "<p>Tous nos accessoires sont compatibles avec une ou plusieurs gammes d’alarmes Daewoo Security (TOUCH, VIGILIA, ELITE).</p><p>La compatibilité exacte est indiquée dans la fiche produit. Si vous avez un doute, n’hésitez pas à nous contacter avec la référence de votre centrale.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Est-ce que l’accessoire fonctionne avec l’application Daewoo Home Connect ?",
            "text": "<p>Tous les accessoires sont disponibles et directement paramétrables dans l’application Daewoo Home Connect.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "Comment l’installer ?",
