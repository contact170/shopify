{% comment %}
  ── /collections/all — page catalogue (05/09/2026) ──

  Rendu depuis layout/theme.liquid, seul endroit qui distingue cette URL.

  Pourquoi pas un gabarit : Shopify ne route pas templates/collection.all.json
  (verifie en preview le 05/09). Pourquoi pas templates/collection.json : il
  sert aussi a la collection « Accessoires configurateurs », qui doit afficher
  ces 77 produits. Pourquoi un snippet et pas une section : la documentation ne
  garantit pas le rendu statique d'une section a l'interieur d'une condition,
  alors qu'elle garantit celui d'un snippet.

  Les cartes de destination sont typographiques, sans photo : les six
  collections ont des visuels de ratios trop differents (2,43:1, 2,8:1,
  1,78:1, 1,62:1) et « Tous les accessoires » n'en a aucun.

  Les reglages sont les assigns ci-dessous. cat_destinations est une liste
  « handle-de-collection|libelle », separee par des virgules.
{% endcomment %}

{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cat_surtitre = 'Catalogue'
  assign cat_titre = 'Tout le catalogue Daewoo Security'
  assign cat_chapo = "Alarmes sans abonnement, caméras et objets connectés. Si vous cherchez quelque chose de précis, passez par une des six entrées ci-dessous : elles vous mèneront plus vite que la liste complète."
  assign cat_titre_grille = 'Tous nos produits'
  assign cat_tag_exclu = 'Configurateur'
  assign cat_par_page = 48
  assign cat_colonnes = 4
  assign cat_colonnes_mobile = '2'

  assign cat_destinations = "systeme-dalarme-vigilia|Alarmes Vigilia,systeme-dalarme-am301-am302|Alarmes Touch et Touch XL,systeme-dalarme-pa501z|Alarmes Élite,cameras-de-surveillance|Caméras de surveillance,tous-les-accessoires|Tous les accessoires,domotique|Maison connectée"

  assign par_page = cat_par_page
  assign tag_exclu = cat_tag_exclu
-%}

<div class="cat">
<style>
  .cat{
    --cat-navy:#0c1e4a;
    --cat-bleu:#1a4fab;
    --cat-doux:#5a6484;
    --cat-filet:#e3e8f5;
    --cat-fond:#eef2fd;
  }
  .cat .cat-entete{background:var(--cat-fond);padding:clamp(38px,5.4vw,68px) 0 clamp(30px,4.2vw,52px)}
  .cat-wrap{max-width:1200px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}
  .cat-surtitre{font-size:13px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;
    color:var(--cat-bleu);margin:0 0 12px}
  .cat-titre{font-size:clamp(28px,4.4vw,46px);font-weight:600;letter-spacing:-.03em;line-height:1.08;
    margin:0;color:var(--cat-navy);text-wrap:balance}
  .cat-chapo{margin:14px 0 0;max-width:60ch;font-size:clamp(16px,1.7vw,19px);line-height:1.6;color:var(--cat-doux)}

  .cat-dest{display:grid;grid-template-columns:repeat(auto-fit,minmax(248px,1fr));gap:14px;
    margin:clamp(26px,3.4vw,40px) 0 0}
  .cat-carte{display:flex;align-items:center;justify-content:space-between;gap:18px;
    background:#fff;border:1.5px solid var(--cat-filet);border-radius:14px;
    padding:20px 22px;text-decoration:none;min-width:0;
    transition:border-color .2s ease,box-shadow .2s ease}
  .cat-carte:hover{border-color:var(--cat-bleu);box-shadow:0 8px 24px rgba(12,30,74,.08);text-decoration:none}
  .cat-carte:focus-visible{outline:2px solid var(--cat-bleu);outline-offset:3px}
  .cat-corps{display:flex;flex-direction:column;gap:3px;min-width:0}
  .cat-nom{font-size:17px;font-weight:600;color:var(--cat-navy);line-height:1.3;margin:0}
  .cat-compte{font-size:13px;color:var(--cat-doux);margin:0;font-variant-numeric:tabular-nums}
  .cat-fleche{flex:0 0 auto;font-size:19px;line-height:1;color:var(--cat-bleu);
    transition:transform .2s cubic-bezier(.22,1,.36,1)}
  .cat-carte:hover .cat-fleche{transform:translateX(4px)}
  @media (prefers-reduced-motion:reduce){.cat-fleche{transition:none}}

  .cat-grille-tete{max-width:1200px;margin:clamp(38px,5vw,60px) auto clamp(14px,2vw,20px);
    padding:0 clamp(20px,4vw,40px);display:flex;align-items:baseline;justify-content:space-between;
    gap:16px;flex-wrap:wrap}
  .cat-grille-titre{font-size:clamp(21px,2.6vw,28px);font-weight:600;letter-spacing:-.02em;
    color:var(--cat-navy);margin:0}
  .cat-grille-compte{font-size:14px;color:var(--cat-doux)}
  .cat-grille-wrap{max-width:1200px;margin:0 auto;padding:0 clamp(20px,4vw,40px) clamp(48px,6vw,88px)}
  .cat-vide{text-align:center;padding:60px 20px;color:var(--cat-doux)}
</style>

<div class="cat-entete">
  <div class="cat-wrap">
    {%- if cat_surtitre != blank -%}
      <p class="cat-surtitre">{{ cat_surtitre }}</p>
    {%- endif -%}
    <h1 class="cat-titre">{{ cat_titre }}</h1>
    {%- if cat_chapo != blank -%}
      <p class="cat-chapo">{{ cat_chapo }}</p>
    {%- endif -%}

    {%- if cat_destinations != blank -%}
      <div class="cat-dest">
        {%- assign paires = cat_destinations | split: ',' -%}
        {%- for paire in paires -%}
          {%- liquid
            assign duo = paire | strip | split: '|'
            assign dest = collections[duo[0]]
            assign libelle = duo[1]
            if libelle == blank
              assign libelle = dest.title
            endif
          -%}
          {%- if dest != blank and dest.handle != blank -%}
            <a href="{{ dest.url }}" class="cat-carte">
              <span class="cat-corps">
                <span class="cat-nom">{{ libelle }}</span>
                <span class="cat-compte">
                  {%- if dest.all_products_count == 1 -%}1 produit
                  {%- else -%}{{ dest.all_products_count }} produits{%- endif -%}
                </span>
              </span>
              <span class="cat-fleche" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- paginate collection.products by par_page -%}

  {%- liquid
    assign visibles = 0
    for produit in collection.products
      unless tag_exclu != blank and produit.tags contains tag_exclu
        assign visibles = visibles | plus: 1
      endunless
    endfor
  -%}

  <div class="cat-grille-tete">
    <h2 class="cat-grille-titre">{{ cat_titre_grille }}</h2>
    {%- if paginate.pages > 1 -%}
      <p class="cat-grille-compte">Page {{ paginate.current_page }} sur {{ paginate.pages }}</p>
    {%- endif -%}
  </div>

  <div class="cat-grille-wrap">
    {%- if visibles > 0 -%}
      {%- capture card_sizes -%}(max-width: 639px) calc(100vw / {{ cat_colonnes_mobile }}), calc(min({{ settings.page_width }}px, 100vw) / {{ cat_colonnes }}){%- endcapture -%}
      <div class="card-grid card-grid--{{ cat_colonnes }} mobile:card-grid--{{ cat_colonnes_mobile }} grid relative">
        {%- for product in collection.products -%}
          {%- liquid
            if tag_exclu != blank and product.tags contains tag_exclu
              continue
            endif

            assign lazy_load = true
            if forloop.index <= 4
              assign lazy_load = false
            endif
          -%}
          {%- render 'product-card',
            product: product,
            product_id: product.id,
            section_id: 'catalogue',
            lazy_load: lazy_load,
            sizes: card_sizes,
            image_ratio: settings.product_image_ratio,
            image_fill: settings.product_image_fill,
            show_secondary_image: settings.product_secondary_image,
            show_multiple_images: settings.product_multiple_images,
            show_vendor: settings.product_vendor,
            title_truncation: settings.product_title_truncation,
            title_line_limit: settings.product_title_line_limit,
            show_rating: settings.product_rating,
            show_color_swatches: settings.product_color_swatches,
            show_countdown: settings.product_countdown,
            show_quick_add: settings.product_quick_add,
            show_quick_view: settings.product_quick_view,
            vertical_badges: settings.product_vertical_badges,
            show_sold_out: settings.product_sold_out,
            show_save_amount: settings.product_save_amount,
            save_type: settings.product_save_type,
            show_icon_list: settings.product_icon_list
          -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="cat-vide">Aucun produit sur cette page.</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate, mode: 'paginated' -%}
    {%- endif -%}
  </div>

{%- endpaginate -%}

</div>
