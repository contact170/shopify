{{ 'acc-premium.css' | asset_url | stylesheet_tag }}
<style>
  .accp-texte{margin-top:22px}
  .accp-texte > *:first-child{margin-top:0}
  .accp-texte h2{font-size:clamp(22px,2.8vw,31px);font-weight:600;letter-spacing:-.025em;line-height:1.2;margin:36px 0 12px}
  .accp-texte h3{font-size:clamp(19px,2.2vw,23px);font-weight:600;letter-spacing:-.02em;line-height:1.25;margin:28px 0 8px}
  .accp-texte h4{font-size:19px;font-weight:600;margin:24px 0 8px}
  .accp-texte p{margin:0 0 16px;font-size:18px;line-height:1.7;color:var(--accp-doux)}
  .accp-texte strong{color:var(--accp-encre);font-weight:600}
  .accp-texte ul,.accp-texte ol{margin:0 0 16px;padding-left:22px;color:var(--accp-doux);font-size:18px;line-height:1.7}
  .accp-texte li{margin-bottom:7px}
  .accp-texte li > p{margin:0}
  .accp-texte a{color:var(--accp-bleu)}
  .accp-texte img{border-radius:14px;margin:18px 0}
  /* le .rte du theme impose sa propre police : on la neutralise */
  .accp-texte,.accp-texte p,.accp-texte li,.accp-texte h2,.accp-texte h3,.accp-texte h4,
  .accp-texte span,.accp-texte strong,.accp-texte em,.accp-texte a,.accp-texte td,.accp-texte th{font-family:var(--accp-sans)!important}
</style>
{%- if product.description != blank -%}
<div class="accp">
  <section class="accp-bande accp-bande--serree">
    <div class="accp-wrap accp-etroit">
      {%- if section.settings.surtitre != blank -%}<p class="accp-ref">{{ section.settings.surtitre }}</p>{%- endif -%}
      <div class="accp-texte rte">{{ product.description }}</div>
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Accessoire — description",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "En detail" }
  ],
  "presets": [ { "name": "Accessoire — description" } ]
}
{% endschema %}
