{%- comment -%}
  Donnees structurees VideoObject (schema.org) pour la video affichee sur
  la page : video hebergee sur Shopify (prioritaire) ou lien YouTube /
  Vimeo. Section invisible : elle aide Google (resultats video) et les
  moteurs de reponse IA a comprendre la video.
  Rien n'est emis si la video ou la date de mise en ligne manque.
{%- endcomment -%}
{%- liquid
  assign video = section.settings.video
  assign lien = section.settings.video_url
  assign date_video = section.settings.date | strip
  assign a_video = false
  if video != blank or lien != blank
    assign a_video = true
  endif
-%}
{%- if a_video and date_video != blank -%}
  {%- liquid
    assign url_embed = ''
    assign duree = section.settings.duree | strip
    if video != blank
      comment
        Video Shopify : MP4 de meilleure definition, vignette generee par
        Shopify, duree calculee (millisecondes -> format ISO 8601).
      endcomment
      assign mp4 = video.sources | where: 'format', 'mp4' | sort: 'height' | last
      assign url_video = mp4.url | default: video.sources.first.url
      assign debut = url_video | slice: 0, 2
      if debut == '//'
        assign url_video = url_video | prepend: 'https:'
      endif
      assign vignette = video.preview_image | image_url: width: 1280 | prepend: 'https:'
      if duree == blank and video.duration > 0
        assign secondes = video.duration | divided_by: 1000
        assign minutes = secondes | divided_by: 60
        assign reste = secondes | modulo: 60
        assign duree = 'PT' | append: minutes | append: 'M' | append: reste | append: 'S'
      endif
    elsif lien.type == 'youtube'
      assign url_video = 'https://www.youtube.com/watch?v=' | append: lien.id
      assign url_embed = 'https://www.youtube.com/embed/' | append: lien.id
      assign vignette = 'https://i.ytimg.com/vi/' | append: lien.id | append: '/hqdefault.jpg'
    else
      assign url_video = 'https://vimeo.com/' | append: lien.id
      assign url_embed = 'https://player.vimeo.com/video/' | append: lien.id
      assign vignette = product.featured_image | image_url: width: 1280 | prepend: 'https:'
    endif
    assign nom = section.settings.nom | default: product.title
    assign desc = section.settings.description | strip
    if desc == blank
      assign desc = product.description | strip_html | strip_newlines | strip | truncate: 500
    endif
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": {{ nom | json }},
  "description": {{ desc | json }},
  "thumbnailUrl": [{{ vignette | json }}],
  "uploadDate": {{ date_video | json }},
  {%- if duree != blank %}
  "duration": {{ duree | json }},
  {%- endif %}
  "contentUrl": {{ url_video | json }},
  {%- if url_embed != blank %}
  "embedUrl": {{ url_embed | json }},
  {%- endif %}
  "inLanguage": "fr",
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
  "about": { "@id": {{ '/products/' | append: product.handle | append: '#product' | json }} }
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Video — SEO",
  "settings": [
    { "type": "paragraph", "content": "Section invisible : decrit la video de demonstration pour Google et les moteurs IA." },
    { "type": "video", "id": "video", "label": "Video hebergee sur Shopify (la meme que la video affichee)", "info": "Prioritaire sur le lien YouTube / Vimeo." },
    { "type": "video_url", "id": "video_url", "label": "Ou lien YouTube / Vimeo (le meme que la video affichee)", "accept": ["youtube", "vimeo"] },
    { "type": "text", "id": "nom", "label": "Titre de la video" },
    { "type": "textarea", "id": "description", "label": "Description de la video", "info": "Vide = description du produit." },
    { "type": "text", "id": "date", "label": "Date de mise en ligne", "info": "Format AAAA-MM-JJ, ex. 2026-10-22. Obligatoire." },
    { "type": "text", "id": "duree", "label": "Duree (facultatif)", "info": "Calculee automatiquement pour une video Shopify. Sinon format ISO 8601, ex. PT1M30S pour 1 min 30 s." }
  ],
  "presets": [ { "name": "Video — SEO" } ]
}
{% endschema %}
