{{ 'acc-premium.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Canon a fumee : fiche technique detaillee.
  Blocs « caracteristique » (libelle / valeur), affiches sur deux colonnes
  sur ordinateur, lues de haut en bas. Blocs « bon a savoir » en cartes
  sous le tableau.
{%- endcomment -%}
{%- liquid
  assign nb_specs = 0
  assign nb_notes = 0
  for block in section.blocks
    if block.type == 'spec'
      assign nb_specs = nb_specs | plus: 1
    elsif block.type == 'note'
      assign nb_notes = nb_notes | plus: 1
    endif
  endfor
  assign lignes = nb_specs | plus: 1 | divided_by: 2
-%}
{%- if nb_specs > 0 or nb_notes > 0 -%}
<style>
  .fum-specs-tete{margin:0 auto;text-align:center}
  .fum-specs-tete h2{margin-top:14px;text-wrap:balance}
  .fum-specs-tete .accp-chapo{text-wrap:pretty}
  .fum-specs-carte{margin:clamp(26px,3.6vw,42px) 0 0;background:#fff;border-radius:var(--accp-rayon);
    box-shadow:var(--accp-ombre);padding:0 26px;overflow:hidden}
  .fum-specs{margin:-1px 0 0;display:grid;grid-template-columns:1fr;column-gap:48px}
  .fum-spec{display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:16px 0;
    border-top:1px solid var(--accp-filet)}
  .fum-spec dt{margin:0;color:var(--accp-doux);font-size:16px;line-height:1.45}
  .fum-spec dd{margin:0;text-align:right;font-size:16px;line-height:1.45;font-weight:500;color:var(--accp-encre)}
  @media(min-width:820px){
    .fum-specs{grid-template-columns:1fr 1fr;grid-auto-flow:column;grid-template-rows:repeat(var(--fum-lignes),auto)}
  }
  .accp .fum-notes-titre{margin:clamp(34px,4.4vw,48px) 0 0;font-size:clamp(19px,2.3vw,24px)}
  .fum-notes{list-style:none;margin:16px 0 0;padding:0;display:grid;gap:14px;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
  .fum-note{background:#fff;border-radius:var(--accp-rayon);box-shadow:var(--accp-ombre);padding:22px 22px 24px}
  .accp .fum-note h3{font-size:17px;letter-spacing:-.01em;line-height:1.3}
  .fum-note p{margin:8px 0 0;font-size:15px;line-height:1.6;color:var(--accp-doux)}
</style>
<div class="accp">
  <section class="accp-bande{% if section.settings.fond == 'clair' %} accp-bande--gris{% endif %}">
    <div class="accp-wrap">
      <div class="accp-etroit fum-specs-tete">
        {%- if section.settings.surtitre != blank -%}<p class="accp-ref">{{ section.settings.surtitre }}</p>{%- endif -%}
        {%- if section.settings.titre != blank -%}<h2>{{ section.settings.titre }}</h2>{%- endif -%}
      </div>

      {%- if nb_specs > 0 -%}
        <div class="fum-specs-carte">
          <dl class="fum-specs" style="--fum-lignes:{{ lignes }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'spec' -%}
                <div class="fum-spec" {{ block.shopify_attributes }}>
                  <dt>{{ block.settings.libelle }}</dt>
                  <dd>{{ block.settings.valeur }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        </div>
      {%- endif -%}

      {%- if nb_notes > 0 -%}
        {%- if section.settings.titre_notes != blank -%}<h3 class="fum-notes-titre">{{ section.settings.titre_notes }}</h3>{%- endif -%}
        <ul class="fum-notes">
          {%- for block in section.blocks -%}
            {%- if block.type == 'note' -%}
              <li class="fum-note" {{ block.shopify_attributes }}>
                {%- if block.settings.titre != blank -%}<h3>{{ block.settings.titre }}</h3>{%- endif -%}
                {%- if block.settings.texte != blank -%}<p>{{ block.settings.texte }}</p>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Fumee — fiche technique",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Fiche technique" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Les chiffres." },
    { "type": "text", "id": "titre_notes", "label": "Titre des cartes « bon a savoir »", "default": "Bon a savoir" },
    {
      "type": "select", "id": "fond", "label": "Fond", "default": "clair",
      "options": [ { "value": "blanc", "label": "Blanc" }, { "value": "clair", "label": "Bleu tres clair" } ]
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Caracteristique",
      "settings": [
        { "type": "text", "id": "libelle", "label": "Libelle", "default": "Volume protege" },
        { "type": "text", "id": "valeur", "label": "Valeur", "default": "100 a 150 m3" }
      ]
    },
    {
      "type": "note",
      "name": "Bon a savoir",
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre" },
        { "type": "textarea", "id": "texte", "label": "Texte" }
      ]
    }
  ],
  "presets": [ { "name": "Fumee — fiche technique" } ]
}
{% endschema %}
