{% stylesheet %}
.ds-config__layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
.ds-config__visual {
  position: relative;
}
.ds-config__mockup {
  background: var(--ds-black);
  border-radius: 20px;
  padding: 2.5rem;
  box-shadow: 0 30px 80px rgba(0,0,0,.18);
  border: 1px solid var(--ds-border-light);
  position: relative;
  overflow: hidden;
}
.ds-config__mockup-bar {
  display: flex; gap: 6px; margin-bottom: 1.5rem;
}
.ds-config__mockup-dot {
  width: 10px; height: 10px; border-radius: 50%;
}
.ds-config__mockup-dot:nth-child(1) { background: #FF5F57; }
.ds-config__mockup-dot:nth-child(2) { background: #FFBD2E; }
.ds-config__mockup-dot:nth-child(3) { background: #28C840; }
.ds-config__mockup-step {
  background: rgba(255,255,255,.04);
  border: 1px solid var(--ds-border);
  border-radius: 10px;
  padding: 1rem 1.25rem;
  margin-bottom: .75rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.ds-config__mockup-step.active { border-color: var(--ds-accent); background: rgba(230,57,70,.08); }
.ds-config__mockup-label {
  font-family: var(--ds-font); font-size: .8rem; font-weight: 600; color: #fff;
}
.ds-config__mockup-sublabel {
  font-family: var(--ds-font); font-size: .7rem; color: var(--ds-muted);
}
.ds-config__mockup-indicator {
  width: 8px; height: 8px; border-radius: 50%; background: var(--ds-accent);
  margin-left: auto; flex-shrink: 0;
}
.ds-config__badge-float {
  position: absolute;
  background: var(--ds-white);
  border-radius: 12px;
  padding: .75rem 1rem;
  box-shadow: 0 8px 24px rgba(0,0,0,.12);
  font-family: var(--ds-font);
  font-size: .8rem;
  font-weight: 600;
  color: var(--ds-black);
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: .5rem;
}
.ds-config__badge-float--tl { top: -1rem; left: -1.5rem; animation: ds-float 3.5s ease-in-out infinite; }
.ds-config__badge-float--br { bottom: -1rem; right: -1rem; animation: ds-float-slow 4.5s ease-in-out infinite; }
.ds-config__content { display: flex; flex-direction: column; gap: 1.5rem; }
.ds-config__note { font-family: var(--ds-font); font-size: .8rem; color: var(--ds-muted); display: flex; align-items: center; gap: .4rem; }
@media (max-width: 900px) {
  .ds-config__layout { grid-template-columns: 1fr; gap: 3rem; }
  .ds-config__badge-float--tl, .ds-config__badge-float--br { display: none; }
}
{% endstylesheet %}

<section class="ds-section ds-bg-white" id="ds-config-{{ section.id }}">
  <div class="ds-container ds-section-inner">
    <div class="ds-config__layout">

      <!-- Visual côté gauche -->
      <div class="ds-config__visual" data-ds-reveal>
        {%- if section.settings.visual_image != blank -%}
          <img
            src="{{ section.settings.visual_image | image_url: width: 600 }}"
            alt="Configurador de alarma Daewoo Security"
            style="width:100%;border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.12);"
            loading="lazy"
          >
        {%- else -%}
          <div class="ds-config__mockup">
            <div class="ds-config__mockup-bar">
              <div class="ds-config__mockup-dot"></div>
              <div class="ds-config__mockup-dot"></div>
              <div class="ds-config__mockup-dot"></div>
            </div>
            <div class="ds-config__mockup-step active">
              <svg width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 1.5L3 4.5v5c0 3.5 2.6 6.75 6 7.5 3.4-.75 6-4 6-7.5v-5L9 1.5Z" stroke="#E63946" stroke-width="1.5"/></svg>
              <div><div class="ds-config__mockup-label">Central de alarma WiFi/4G</div><div class="ds-config__mockup-sublabel">1 unidad seleccionada</div></div>
              <div class="ds-config__mockup-indicator"></div>
            </div>
            <div class="ds-config__mockup-step">
              <svg width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="7" r="3" stroke="#8E8E93" stroke-width="1.5"/><path d="M3 17c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="#8E8E93" stroke-width="1.5" stroke-linecap="round"/></svg>
              <div><div class="ds-config__mockup-label" style="color:var(--ds-muted)">Detectores de movimiento</div><div class="ds-config__mockup-sublabel">Elige cantidad</div></div>
            </div>
            <div class="ds-config__mockup-step">
              <svg width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="3" width="12" height="12" rx="2" stroke="#8E8E93" stroke-width="1.5"/><path d="M7 9l2 2 3-3" stroke="#8E8E93" stroke-width="1.5" stroke-linecap="round"/></svg>
              <div><div class="ds-config__mockup-label" style="color:var(--ds-muted)">Sensores puertas/ventanas</div><div class="ds-config__mockup-sublabel">Elige cantidad</div></div>
            </div>
            <div class="ds-config__mockup-step">
              <svg width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true"><rect x="4" y="2" width="10" height="14" rx="2" stroke="#8E8E93" stroke-width="1.5"/><circle cx="9" cy="13" r="1" fill="#8E8E93"/></svg>
              <div><div class="ds-config__mockup-label" style="color:var(--ds-muted)">Cámara exterior HD</div><div class="ds-config__mockup-sublabel">Opcional</div></div>
            </div>
          </div>
          <div class="ds-config__badge-float ds-config__badge-float--tl">
            <svg width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1l1.8 3.6L13 5.1l-3 2.9.7 4.1L7 10.5l-3.7 1.6.7-4.1L1 5.1l4.2-.5L7 1Z" fill="#F59E0B"/></svg>
            {{ section.settings.float_badge_1 | default: '5 min de configuración' }}
          </div>
          <div class="ds-config__badge-float ds-config__badge-float--br">
            <svg width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7l3.5 3.5L12 4" stroke="#34C759" stroke-width="2" stroke-linecap="round"/></svg>
            {{ section.settings.float_badge_2 | default: 'Sin instalador' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Contenu côté droit -->
      <div class="ds-config__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ds-eyebrow" data-ds-reveal>{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="ds-title ds-title-md ds-text-black" data-ds-reveal data-ds-delay="100">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="ds-subtitle" data-ds-reveal data-ds-delay="200">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- assign checklist_items = section.settings.checklist | newline_to_br | split: '<br />' -%}
        {%- if checklist_items.size > 0 and section.settings.checklist != blank -%}
          <ul class="ds-checklist" data-ds-reveal data-ds-delay="300">
            {%- for item in checklist_items -%}
              {%- if item != blank -%}
                <li>{{ item | strip }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div data-ds-reveal data-ds-delay="400">
          {%- if section.settings.cta_text != blank -%}
            <a href="{{ section.settings.cta_url }}" class="ds-btn ds-btn-primary ds-btn-lg">
              {{ section.settings.cta_text }}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.cta_note != blank -%}
            <p class="ds-config__note" style="margin-top:.75rem;">
              <svg width="12" height="12" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1L7.5 4.3L11 4.8l-2.5 2.4.6 3.4L6 8.9l-3.1 1.7.6-3.4L1 4.8l3.5-.5L6 1Z" fill="#34C759"/></svg>
              {{ section.settings.cta_note }}
            </p>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "DS Configurador",
  "tag": "section",
  "class": "ds-section",
  "settings": [
    { "type": "text",        "id": "eyebrow",       "label": "Eyebrow",          "default": "Configurador inteligente" },
    { "type": "text",        "id": "title",         "label": "Título",           "default": "Diseña tu alarma perfecta en minutos" },
    { "type": "textarea",    "id": "subtitle",      "label": "Subtítulo",        "default": "Nuestro configurador online te hace las preguntas correctas y te recomienda exactamente los componentes que necesitas. Sin sorpresas." },
    { "type": "textarea",    "id": "checklist",     "label": "Checklist (una por línea)", "default": "Adaptado al tamaño y tipo de tu vivienda\nSin conocimientos técnicos necesarios\nPrecios transparentes desde el primer paso\nCompatible con app gratuita iOS/Android\nGarantía de satisfacción 30 días" },
    { "type": "text",        "id": "cta_text",      "label": "CTA texto",        "default": "Iniciar configurador" },
    { "type": "url",         "id": "cta_url",       "label": "CTA enlace" },
    { "type": "text",        "id": "cta_note",      "label": "Nota bajo el CTA", "default": "Gratis y sin compromiso. Presupuesto en 5 minutos." },
    { "type": "image_picker","id": "visual_image",  "label": "Imagen (reemplaza mockup)" },
    { "type": "text",        "id": "float_badge_1", "label": "Badge flotante 1", "default": "5 min de configuración" },
    { "type": "text",        "id": "float_badge_2", "label": "Badge flotante 2", "default": "Sin instalador" }
  ],
  "presets": [
    {
      "name": "DS Configurador",
      "settings": {
        "eyebrow":    "Configurador inteligente",
        "title":      "Diseña tu alarma perfecta en minutos",
        "subtitle":   "Nuestro configurador online te hace las preguntas correctas y te recomienda exactamente los componentes que necesitas. Sin sorpresas, sin letras pequeñas.",
        "checklist":  "Adaptado al tamaño y tipo de tu vivienda\nSin conocimientos técnicos necesarios\nPrecios transparentes desde el primer paso\nCompatible con app gratuita iOS/Android\nGarantía de satisfacción 30 días",
        "cta_text":   "Iniciar configurador gratuito",
        "cta_note":   "Gratis y sin compromiso. Presupuesto en 5 minutos.",
        "float_badge_1": "5 min de configuración",
        "float_badge_2": "Sin instalador"
      }
    }
  ]
}
{% endschema %}
