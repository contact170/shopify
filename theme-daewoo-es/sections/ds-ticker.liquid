{% stylesheet %}
.ds-ticker {
  background: {{ section.settings.bg_color | default: '#E63946' }};
  overflow: hidden;
  padding: .9rem 0;
  position: relative;
  z-index: 10;
}
.ds-ticker__track {
  display: flex;
  gap: 0;
  width: max-content;
  animation: ds-ticker-scroll {{ section.settings.speed | default: 30 }}s linear infinite;
}
.ds-ticker__track:hover { animation-play-state: paused; }
@keyframes ds-ticker-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.ds-ticker__item {
  display: inline-flex;
  align-items: center;
  gap: .65rem;
  padding: 0 2.5rem;
  white-space: nowrap;
  font-family: var(--ds-font);
  font-size: .82rem;
  font-weight: 700;
  color: {{ section.settings.text_color | default: '#FFFFFF' }};
  letter-spacing: .02em;
}
.ds-ticker__sep {
  color: {{ section.settings.sep_color | default: 'rgba(255,255,255,.4)' }};
  font-size: 1rem;
}
{% endstylesheet %}

<div class="ds-ticker" aria-hidden="true">
  <div class="ds-ticker__track">
    {%- comment -%}Duplicate 2× for infinite seamless loop{%- endcomment -%}
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <span class="ds-ticker__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon == 'star' -%}
              <svg width="13" height="13" fill="currentColor" viewBox="0 0 13 13"><path d="M6.5 1l1.65 3.35L12 4.9 9.25 7.6l.65 3.9-3.4-1.8-3.4 1.8.65-3.9L1 4.9l3.85-.55L6.5 1Z"/></svg>
            {%- elsif block.settings.icon == 'check' -%}
              <svg width="13" height="13" fill="none" viewBox="0 0 13 13"><circle cx="6.5" cy="6.5" r="5.5" stroke="currentColor" stroke-width="1.4"/><path d="M4 6.5l2 2 3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            {%- elsif block.settings.icon == 'shield' -%}
              <svg width="13" height="13" fill="none" viewBox="0 0 13 13"><path d="M6.5 1L2 3.25v4C2 10 4 12.25 6.5 13 9 12.25 11 10 11 7.25v-4L6.5 1Z" stroke="currentColor" stroke-width="1.4"/></svg>
            {%- elsif block.settings.icon == 'truck' -%}
              <svg width="13" height="13" fill="none" viewBox="0 0 13 13"><path d="M1 2h8v7H1zM9 5h2.5l1.5 2v3H9V5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="3.5" cy="10.5" r="1.2" stroke="currentColor" stroke-width="1.2"/><circle cx="10" cy="10.5" r="1.2" stroke="currentColor" stroke-width="1.2"/></svg>
            {%- endif -%}
            {{ block.settings.text }}
          </span>
          <span class="ds-ticker__sep">·</span>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "DS Ticker",
  "tag": "section",
  "class": "ds-ticker-section",
  "settings": [
    { "type": "color",  "id": "bg_color",   "label": "Color fondo",   "default": "#E63946" },
    { "type": "color",  "id": "text_color", "label": "Color texto",   "default": "#FFFFFF" },
    { "type": "color",  "id": "sep_color",  "label": "Color separador","default": "#FFFFFF" },
    { "type": "number", "id": "speed",      "label": "Velocidad (seg, menor = más rápido)", "default": 30 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento ticker",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icono",
          "options": [
            { "value": "star",   "label": "Estrella" },
            { "value": "check",  "label": "Check" },
            { "value": "shield", "label": "Escudo" },
            { "value": "truck",  "label": "Camión" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Sin cuotas mensuales" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS Ticker",
      "settings": { "bg_color": "#E63946", "text_color": "#FFFFFF", "speed": 30 },
      "blocks": [
        { "type": "item", "settings": { "icon": "check",  "text": "Sin cuotas mensuales" } },
        { "type": "item", "settings": { "icon": "truck",  "text": "Envío gratis en 24h" } },
        { "type": "item", "settings": { "icon": "shield", "text": "Garantía 3 años" } },
        { "type": "item", "settings": { "icon": "star",   "text": "4.8/5 valoración" } },
        { "type": "item", "settings": { "icon": "check",  "text": "Instalación en 1 hora" } },
        { "type": "item", "settings": { "icon": "check",  "text": "App iOS y Android gratis" } },
        { "type": "item", "settings": { "icon": "shield", "text": "Devolución 30 días" } },
        { "type": "item", "settings": { "icon": "check",  "text": "15.000+ hogares protegidos" } }
      ]
    }
  ]
}
{% endschema %}
