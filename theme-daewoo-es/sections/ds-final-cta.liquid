{% stylesheet %}
.ds-final-cta {
  background: var(--ds-black);
  position: relative;
  overflow: hidden;
  text-align: center;
}
.ds-final-cta::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 50% -10%, rgba(230,57,70,.22) 0%, transparent 65%),
    radial-gradient(ellipse 40% 30% at 50% 110%, rgba(230,57,70,.1) 0%, transparent 60%);
  pointer-events: none;
}
.ds-final-cta__inner {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}
.ds-final-cta__ctas { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
.ds-final-cta__note { font-family: var(--ds-font); font-size: .8rem; color: var(--ds-muted); display: flex; align-items: center; gap: .4rem; }
.ds-final-cta__trust { margin-top: 1rem; justify-content: center; }
{% endstylesheet %}

<section class="ds-section ds-final-cta" id="ds-final-cta-{{ section.id }}">
  <div class="ds-container ds-section-inner">
    <div class="ds-final-cta__inner">

      {%- if section.settings.badge != blank -%}
        <span class="ds-badge ds-badge-accent" data-ds-reveal>{{ section.settings.badge }}</span>
      {%- endif -%}

      <h2 class="ds-title ds-title-lg ds-text-white" data-ds-reveal data-ds-delay="100">
        {{ section.settings.title }}
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="ds-subtitle" data-ds-reveal data-ds-delay="200" style="max-width:560px;">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}

      <div class="ds-final-cta__ctas" data-ds-reveal data-ds-delay="300">
        {%- if section.settings.cta_primary_text != blank -%}
          <a href="{{ section.settings.cta_primary_url }}" class="ds-btn ds-btn-primary ds-btn-lg">
            {{ section.settings.cta_primary_text }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_text != blank -%}
          <a href="{{ section.settings.cta_secondary_url }}" class="ds-btn ds-btn-ghost">
            {{ section.settings.cta_secondary_text }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="ds-final-cta__note" data-ds-reveal data-ds-delay="400">
          <svg width="12" height="12" fill="none" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1l1.4 2.8L10.5 4.3l-2.25 2.2.53 3.15L6 7.9l-2.78 1.65.53-3.15L1.5 4.3l3.1-.5L6 1Z" fill="#F59E0B"/></svg>
          {{ section.settings.note }}
        </p>
      {%- endif -%}

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank -%}
        <div class="ds-trust-row ds-final-cta__trust" data-ds-reveal>
          {%- if section.settings.trust_1 != blank -%}
            <div class="ds-trust-item">
              <svg width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1L8.5 4.3L12.5 4.8 10 7.2l.6 3.9L7 9.5l-3.6 1.6.6-3.9-2.5-2.4 4-.5L7 1Z" fill="#E63946"/></svg>
              {{ section.settings.trust_1 }}
            </div>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <div class="ds-trust-item">
              <svg width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="#E63946" stroke-width="1.4"/><path d="M4.5 7l2 2 3.5-3.5" stroke="#E63946" stroke-width="1.4" stroke-linecap="round"/></svg>
              {{ section.settings.trust_2 }}
            </div>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <div class="ds-trust-item">
              <svg width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="3" width="10" height="8" rx="1.2" stroke="#E63946" stroke-width="1.4"/><path d="M5 3V2.5a2 2 0 014 0V3" stroke="#E63946" stroke-width="1.4"/></svg>
              {{ section.settings.trust_3 }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "DS CTA Final",
  "tag": "section",
  "class": "ds-section",
  "settings": [
    { "type": "text",     "id": "badge",              "label": "Badge",              "default": "Oferta limitada" },
    { "type": "text",     "id": "title",              "label": "Título",             "default": "Protege tu hogar hoy. Sin cuotas, para siempre." },
    { "type": "textarea", "id": "subtitle",           "label": "Subtítulo",          "default": "Únete a más de 15.000 familias que ya confían en Daewoo Security. Configurador online en 5 minutos." },
    { "type": "text",     "id": "cta_primary_text",   "label": "CTA principal",      "default": "Configurar mi alarma" },
    { "type": "url",      "id": "cta_primary_url",    "label": "CTA principal enlace" },
    { "type": "text",     "id": "cta_secondary_text", "label": "CTA secundario",     "default": "Ver todos los packs" },
    { "type": "url",      "id": "cta_secondary_url",  "label": "CTA secundario enlace" },
    { "type": "text",     "id": "note",               "label": "Nota",               "default": "Envío gratis · Garantía 3 años · Devolución 30 días" },
    { "type": "text",     "id": "trust_1",            "label": "Trust 1",            "default": "Sin cuotas mensuales" },
    { "type": "text",     "id": "trust_2",            "label": "Trust 2",            "default": "Garantía 3 años" },
    { "type": "text",     "id": "trust_3",            "label": "Trust 3",            "default": "Envío en 24h" }
  ],
  "presets": [
    {
      "name": "DS CTA Final",
      "settings": {
        "badge":              "Empieza hoy",
        "title":              "Tu hogar protegido. Sin cuotas, para siempre.",
        "subtitle":           "Más de 15.000 familias en España ya confían en Daewoo Security. Configura tu alarma en 5 minutos y recíbela en 24h.",
        "cta_primary_text":   "Configurar mi alarma ahora",
        "cta_secondary_text": "Ver todos los packs",
        "note":               "Envío gratis · Garantía 3 años · Devolución en 30 días",
        "trust_1":            "Sin cuotas mensuales",
        "trust_2":            "Garantía 3 años",
        "trust_3":            "Envío gratis 24h"
      }
    }
  ]
}
{% endschema %}
