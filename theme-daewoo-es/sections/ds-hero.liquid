{% stylesheet %}
.ds-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  background: var(--ds-black);
  overflow: hidden;
}
.ds-hero__bg-gradient {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 60% at 20% 50%, rgba(230,57,70,.14) 0%, transparent 65%),
              radial-gradient(ellipse 50% 40% at 80% 80%, rgba(230,57,70,.07) 0%, transparent 60%);
  pointer-events: none;
}
.ds-hero__bg-img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: .25;
}
.ds-hero__inner {
  position: relative;
  z-index: 2;
  padding-block: clamp(5rem,10vw,8rem);
}
.ds-hero__layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.ds-hero__content { display: flex; flex-direction: column; gap: 1.5rem; }
.ds-hero__badge { margin-bottom: .25rem; }
.ds-hero__title { color: #fff; }
.ds-hero__title span { color: var(--ds-accent); }
.ds-hero__subtitle { max-width: 520px; }
.ds-hero__ctas { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
.ds-hero__trust { margin-top: .5rem; }
.ds-hero__image-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.ds-hero__image {
  max-width: 100%;
  border-radius: 16px;
  box-shadow: 0 30px 80px rgba(0,0,0,.5);
  animation: ds-float 5s ease-in-out infinite;
}
.ds-hero__scroll {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .5rem;
  z-index: 3;
}
.ds-hero__scroll-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ds-accent);
  animation: ds-scroll-indicator 1.8s ease-in-out infinite;
}
.ds-hero__scroll-text {
  font-family: var(--ds-font);
  font-size: .65rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--ds-muted);
}
@media (max-width:900px) {
  .ds-hero__layout { grid-template-columns: 1fr; gap: 3rem; }
  .ds-hero__image-wrap { display: none; }
}
{% endstylesheet %}

<section class="ds-hero ds-section" id="ds-hero-{{ section.id }}">
  {%- if section.settings.bg_image != blank -%}
    <div class="ds-hero__bg-img" style="background-image: url('{{ section.settings.bg_image | image_url: width: 1600 }}');"></div>
  {%- else -%}
    <div class="ds-hero__bg-gradient"></div>
  {%- endif -%}

  <div class="ds-container ds-hero__inner">
    <div class="ds-hero__layout">
      <div class="ds-hero__content">

        {%- if section.settings.badge != blank -%}
          <div class="ds-hero__badge" data-ds-reveal>
            <span class="ds-badge ds-badge-accent">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1L7.545 4.13L11 4.635L8.5 7.07L9.09 10.5L6 8.875L2.91 10.5L3.5 7.07L1 4.635L4.455 4.13L6 1Z" fill="currentColor"/></svg>
              {{ section.settings.badge }}
            </span>
          </div>
        {%- endif -%}

        <h1 class="ds-title ds-title-xl ds-text-white ds-hero__title" data-ds-reveal data-ds-delay="100">
          {{ section.settings.heading }}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="ds-subtitle ds-hero__subtitle" data-ds-reveal data-ds-delay="200">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}

        <div class="ds-hero__ctas" data-ds-reveal data-ds-delay="300">
          {%- if section.settings.cta_primary_text != blank -%}
            <a href="{{ section.settings.cta_primary_url }}" class="ds-btn ds-btn-primary ds-btn-lg">
              {{ section.settings.cta_primary_text }}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_text != blank -%}
            <a href="{{ section.settings.cta_secondary_url }}" class="ds-btn ds-btn-ghost">
              {{ section.settings.cta_secondary_text }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank -%}
          <div class="ds-trust-row ds-hero__trust" data-ds-reveal data-ds-delay="400">
            {%- if section.settings.trust_1 != blank -%}
              <div class="ds-trust-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5L10 6h4.5L11 8.75l1.5 4.75L8 10.5l-4.5 3 1.5-4.75L1.5 6H6L8 1.5Z" fill="currentColor"/></svg>
                {{ section.settings.trust_1 }}
              </div>
            {%- endif -%}
            {%- if section.settings.trust_2 != blank -%}
              <div class="ds-trust-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2a4 4 0 014 4c0 3-4 8-4 8S4 9 4 6a4 4 0 014-4Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="6" r="1.5" fill="currentColor"/></svg>
                {{ section.settings.trust_2 }}
              </div>
            {%- endif -%}
            {%- if section.settings.trust_3 != blank -%}
              <div class="ds-trust-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="4" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 4V3a3 3 0 116 0v1" stroke="currentColor" stroke-width="1.5"/></svg>
                {{ section.settings.trust_3 }}
              </div>
            {%- endif -%}
            {%- if section.settings.trust_4 != blank -%}
              <div class="ds-trust-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12M8 2v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                {{ section.settings.trust_4 }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

      {%- if section.settings.product_image != blank -%}
        <div class="ds-hero__image-wrap ds-hide-mobile">
          <img
            src="{{ section.settings.product_image | image_url: width: 600 }}"
            alt="{{ section.settings.product_image.alt | default: 'Sistema de alarma Daewoo Security' }}"
            class="ds-hero__image"
            width="600"
            loading="eager"
          >
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <div class="ds-hero__scroll" aria-hidden="true">
      <div class="ds-hero__scroll-dot"></div>
      <span class="ds-hero__scroll-text">Descubrir</span>
    </div>
  {%- endif -%}
</section>

