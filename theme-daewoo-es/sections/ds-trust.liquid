{% stylesheet %}
.ds-trust__stats {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 2rem;
  padding: 3rem;
  background: var(--ds-black);
  border-radius: 20px;
  margin-bottom: 4rem;
}
.ds-trust__stat { text-align: center; }
.ds-trust__stat-value { color: var(--ds-white); }
.ds-trust__stat-suffix { color: var(--ds-accent); font-family: var(--ds-font); font-weight: 900; font-size: clamp(2rem,4vw,3rem); }
.ds-trust__stat-label { font-family: var(--ds-font); font-size: .8rem; color: var(--ds-muted); margin-top: .25rem; }
.ds-trust__reviews-title { font-family: var(--ds-font); font-size: 1.35rem; font-weight: 700; color: var(--ds-black); margin-bottom: 1.5rem; }
.ds-trust__review-card { background: var(--ds-white); border: 1px solid var(--ds-border-light); border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; gap: .75rem; box-shadow: var(--ds-shadow-sm); }
.ds-trust__review-text { font-family: var(--ds-font); font-size: .9rem; line-height: 1.65; color: #3A3A3C; flex: 1; }
.ds-trust__review-author { font-family: var(--ds-font); font-size: .8rem; font-weight: 600; color: var(--ds-black); }
.ds-trust__review-city { font-family: var(--ds-font); font-size: .75rem; color: var(--ds-muted); }
.ds-trust__guarantees { margin-top: 4rem; }
.ds-trust__guarantees-title { font-family: var(--ds-font); font-size: 1.35rem; font-weight: 700; color: var(--ds-black); margin-bottom: 1.5rem; text-align: center; }
.ds-trust__guarantee-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .75rem; }
.ds-trust__guarantee-title { font-family: var(--ds-font); font-size: .95rem; font-weight: 700; color: var(--ds-black); }
.ds-trust__guarantee-desc { font-family: var(--ds-font); font-size: .8rem; line-height: 1.6; color: var(--ds-muted); }
@media (max-width:900px) { .ds-trust__stats { grid-template-columns: repeat(2,1fr); } }
@media (max-width:500px) { .ds-trust__stats { grid-template-columns: repeat(2,1fr); gap:1.5rem; padding:1.75rem; } }
{% endstylesheet %}

<section class="ds-section" id="ds-trust-{{ section.id }}" style="background:{{ section.settings.section_bg | default: '#F5F5F7' }};">
  <div class="ds-container ds-section-inner">

    <div class="ds-section-header ds-section-header--center" data-ds-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="ds-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="ds-title ds-title-md ds-text-black">{{ section.settings.title }}</h2>
    </div>

    <!-- Stats bar -->
    <div class="ds-trust__stats" data-ds-reveal style="background:{{ section.settings.stats_bg | default: '#0D0D0D' }};">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="ds-trust__stat" {{ block.shopify_attributes }}>
            <div style="display:flex;align-items:baseline;justify-content:center;gap:.05rem;">
              <span class="ds-counter-value ds-trust__stat-value" data-ds-counter="{{ block.settings.value }}" data-ds-counter-suffix="{{ block.settings.suffix }}" style="color:{{ section.settings.stats_text | default: '#FFFFFF' }};font-family:var(--ds-font);font-size:clamp(2rem,4vw,3rem);font-weight:900;">0</span>
              <span class="ds-counter-suffix" style="color:{{ section.settings.stats_suffix_color | default: '#E63946' }};font-family:var(--ds-font);font-size:clamp(2rem,4vw,3rem);font-weight:900;">{{ block.settings.suffix }}</span>
            </div>
            <div class="ds-trust__stat-label" style="color:{{ section.settings.stats_label_color | default: '#8E8E93' }};">{{ block.settings.label }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Avis clients -->
    {%- assign reviews = section.blocks | where: 'type', 'review' -%}
    {%- if reviews.size > 0 -%}
      <div class="ds-trust__reviews-section">
        <h3 class="ds-trust__reviews-title">{{ section.settings.reviews_title | default: 'Lo que dicen nuestros clientes' }}</h3>
        <div class="ds-grid-3">
          {%- for block in reviews -%}
            <div class="ds-trust__review-card" data-ds-reveal data-ds-delay="{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
              <div class="ds-stars">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1l1.8 3.7L14 5.4l-3 2.9.7 4.2L8 10.5l-3.7 2 .7-4.2-3-2.9 4.2-.7L8 1Z"/></svg>
                {%- endfor -%}
              </div>
              <p class="ds-trust__review-text">"{{ block.settings.text }}"</p>
              <div>
                <div class="ds-trust__review-author">{{ block.settings.author }}</div>
                <div class="ds-trust__review-city">{{ block.settings.city }}</div>
                {%- if block.settings.product != blank -%}
                  <span class="ds-tag" style="margin-top:.5rem;display:inline-block;">{{ block.settings.product }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Garantías -->
    {%- assign guarantees = section.blocks | where: 'type', 'guarantee' -%}
    {%- if guarantees.size > 0 -%}
      <div class="ds-trust__guarantees">
        <h3 class="ds-trust__guarantees-title">{{ section.settings.guarantees_title | default: 'Nuestras garantías' }}</h3>
        <div class="ds-grid-4" style="--ds-grid-cols:5;">
          {%- for block in guarantees -%}
            <div class="ds-trust__guarantee-item" data-ds-reveal data-ds-delay="{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
              <div class="ds-icon-wrap">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L4 5.5v7C4 16.75 7.75 21.1 12 22c4.25-.9 8-5.25 8-9.5v-7L12 2Z" stroke="currentColor" stroke-width="1.8"/><path d="M8 12l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {%- when 'truck' -%}
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" aria-hidden="true"><path d="M1 3h14v13H1zM15 8h4l3 3v5h-7V8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="5.5" cy="18.5" r="2" stroke="currentColor" stroke-width="1.8"/><circle cx="18.5" cy="18.5" r="2" stroke="currentColor" stroke-width="1.8"/></svg>
                  {%- when 'refresh' -%}
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" aria-hidden="true"><path d="M1 4v6h6M23 20v-6h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 9A9 9 0 105.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 0118.36 18.36" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  {%- when 'phone' -%}
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92Z" stroke="currentColor" stroke-width="1.8"/></svg>
                  {%- else -%}
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M8 12l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                {%- endcase -%}
              </div>
              <div class="ds-trust__guarantee-title">{{ block.settings.title }}</div>
              <p class="ds-trust__guarantee-desc">{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "DS Confianza",
  "tag": "section",
  "class": "ds-section",
  "settings": [
    { "type": "text",  "id": "eyebrow",           "label": "Eyebrow",              "default": "Confianza" },
    { "type": "text",  "id": "title",             "label": "Título",               "default": "Miles de hogares ya protegidos" },
    { "type": "text",  "id": "reviews_title",     "label": "Título reseñas",       "default": "Lo que dicen nuestros clientes" },
    { "type": "text",  "id": "guarantees_title",  "label": "Título garantías",     "default": "Nuestras garantías" },
    { "type": "header","id": "h_colors",          "content": "Colores" },
    { "type": "color", "id": "stats_bg",          "label": "Fondo estadísticas",   "default": "#0D0D0D" },
    { "type": "color", "id": "stats_text",        "label": "Color número",         "default": "#FFFFFF" },
    { "type": "color", "id": "stats_suffix_color","label": "Color sufijo/acento",  "default": "#E63946" },
    { "type": "color", "id": "stats_label_color", "label": "Color etiqueta stat",  "default": "#8E8E93" },
    { "type": "color", "id": "section_bg",        "label": "Fondo sección",        "default": "#F5F5F7" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "settings": [
        { "type": "number", "id": "value",  "label": "Valor",  "default": 15000 },
        { "type": "text",   "id": "suffix", "label": "Sufijo", "default": "+" },
        { "type": "text",   "id": "label",  "label": "Etiqueta", "default": "Hogares protegidos" }
      ]
    },
    {
      "type": "review",
      "name": "Reseña cliente",
      "settings": [
        { "type": "textarea", "id": "text",    "label": "Texto reseña", "default": "La instalación fue muy sencilla. En menos de una hora tenía todo funcionando y la app es muy intuitiva. Totalmente recomendable." },
        { "type": "text",     "id": "author",  "label": "Nombre",       "default": "María G." },
        { "type": "text",     "id": "city",    "label": "Ciudad",       "default": "Madrid" },
        { "type": "text",     "id": "product", "label": "Producto",     "default": "Pack Casa Basic" }
      ]
    },
    {
      "type": "guarantee",
      "name": "Garantía",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "options": [
            { "value": "shield",  "label": "Escudo" },
            { "value": "truck",   "label": "Camión" },
            { "value": "refresh", "label": "Devolución" },
            { "value": "phone",   "label": "Soporte" },
            { "value": "check",   "label": "Check" }
          ],
          "default": "shield"
        },
        { "type": "text",     "id": "title",       "label": "Título",      "default": "Garantía 3 años" },
        { "type": "textarea", "id": "description", "label": "Descripción", "default": "Cobertura completa durante 3 años ante cualquier defecto de fabricación." }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS Confianza",
      "settings": {
        "eyebrow":          "Por qué confían en nosotros",
        "title":            "Miles de hogares ya protegidos en España",
        "reviews_title":    "Lo que dicen nuestros clientes",
        "guarantees_title": "Nuestras garantías incluidas"
      },
      "blocks": [
        { "type": "stat", "settings": { "value": 15000, "suffix": "+",   "label": "Hogares protegidos" } },
        { "type": "stat", "settings": { "value": 4,     "suffix": ".8★", "label": "Valoración media" } },
        { "type": "stat", "settings": { "value": 98,    "suffix": "%",   "label": "Clientes satisfechos" } },
        { "type": "stat", "settings": { "value": 60,    "suffix": "min", "label": "Tiempo de instalación" } },
        {
          "type": "review",
          "settings": {
            "text":    "La instalación fue muy sencilla. En menos de una hora tenía todo funcionando. La app es intuitiva y las alertas son inmediatas. Totalmente recomendable.",
            "author":  "María G.",
            "city":    "Madrid",
            "product": "Pack Casa Basic"
          }
        },
        {
          "type": "review",
          "settings": {
            "text":    "Llevaba años pagando 45 € al mes por otra alarma. Con Daewoo pagué una vez y ya no pago más. La calidad es igual o mejor. Muy contento.",
            "author":  "Carlos M.",
            "city":    "Barcelona",
            "product": "Pack Casa Plus"
          }
        },
        {
          "type": "review",
          "settings": {
            "text":    "Tengo segunda residencia y esta alarma es perfecta. Funciona con 4G sin WiFi, y me avisa instantáneamente si alguien entra. El soporte es excelente.",
            "author":  "Ana R.",
            "city":    "Valencia",
            "product": "Pack Segunda Residencia"
          }
        },
        { "type": "guarantee", "settings": { "icon": "shield",  "title": "Garantía 3 años",        "description": "Cobertura completa ante cualquier defecto de fabricación durante 3 años." } },
        { "type": "guarantee", "settings": { "icon": "truck",   "title": "Envío gratis 24h",        "description": "Envío gratuito a toda España peninsular en 24 horas laborables." } },
        { "type": "guarantee", "settings": { "icon": "refresh", "title": "Devolución 30 días",      "description": "Si no estás satisfecho, te devolvemos el dinero sin preguntas." } },
        { "type": "guarantee", "settings": { "icon": "phone",   "title": "Soporte de por vida",    "description": "Soporte técnico en español gratuito, para siempre, por teléfono y chat." } },
        { "type": "guarantee", "settings": { "icon": "check",   "title": "Instalación guiada",     "description": "Videollamada gratuita con un técnico para guiarte durante la instalación." } }
      ]
    }
  ]
}
{% endschema %}
