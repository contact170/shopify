        { "type": "benefit",  "settings": { "text": "Funciona sin conexión a internet" } },
        { "type": "benefit",  "settings": { "text": "2 años de garantía incluida" } },
        { "type": "kit_item", "settings": { "quantity": "1", "name": "Central WiFi+4G",          "description": "Batería de respaldo 24h incluida" } },
        { "type": "kit_item", "settings": { "quantity": "3", "name": "Detectores PIR",            "description": "Cobertura 90° · 12m de alcance" } },
        { "type": "kit_item", "settings": { "quantity": "2", "name": "Sensores puerta/ventana",   "description": "Adhesivo, sin taladros" } },
        { "type": "kit_item", "settings": { "quantity": "1", "name": "Sirena interior 120dB",     "description": "Batería de respaldo incluida" } },
        { "type": "kit_item", "settings": { "quantity": "1", "name": "Mando a distancia",         "description": "Activación rápida" } },
        { "type": "kit_item", "settings": { "quantity": "1", "name": "App gratuita iOS/Android",  "description": "Control remoto total" } },
