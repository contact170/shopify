or_overlay":"#171717","overlay_opacity":100}}},"block_order":["image_TUXiLT","image_D6GnBU","image_C7K9p9","image_fVeqaP"],"name":"t:sections.collage.name","settings":{"heading":"<strong>Une solution qui s’adapte à vous<\/strong>","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"<p><strong>Maison, appartement, résidence secondaire ? <\/strong>Nos alarmes fonctionnent en Wi-Fi ou en GSM (carte SIM) pour une surveillance continue, même sans connexion Internet.<\/p>","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false,"enable_parallax":true}},"portfolio_Ra4tcP":{"type":"portfolio","blocks":{"profile_rUXWQW":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Visuel_lifestyle_accessoires_9_f71b66b7-4d10-495a-acbf-18612d531db9.png","heading":"Gamme Key","text":"<h3><strong>L’alarme simple et rassurante, avec clavier intégré<\/strong><\/h3><p>Vous cherchez un système de sécurité fiable, facile à utiliser, et accessible à toute la famille ?<br\/><br\/>La gamme <strong>KEY<\/strong> est faite pour vous.<\/p><p>Avec son <strong>clavier intégré<\/strong>, il suffit de composer un code pour activer ou désactiver l’alarme. Pas besoin de smartphone, pas besoin d’application — un geste simple, à la portée de tous, idéal pour les enfants, les proches âgés ou les invités.<\/p><p>Installez-la dans l’entrée ou près de votre porte principale : elle devient le point de contrôle central de votre sécurité. Le tout, sans abonnement, et toujours connecté via Wi-Fi ou carte SIM.<\/p><p><strong>KEY, c’est le choix de la simplicité, sans compromis sur la sécurité.<\/strong><\/p>","color_text":"#ffffff","color_background":"#4c5538"}},"profile_Tfhxeb":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Visuel_lifestyle_accessoires_8.png","heading":"Gamme Touch","text":"<h3><strong>L’alarme intelligente, élégante et intuitive<\/strong><\/h3><p>Vous aimez les objets connectés, les interfaces modernes, et le confort d’un contrôle total depuis un seul point ?<br\/><br\/>La gamme <strong>TOUCH<\/strong> combine <strong>design et technologie<\/strong> pour une sécurité aussi fluide qu’efficace.<\/p><p>Grâce à son <strong>écran tactile couleur<\/strong>, la navigation est ultra intuitive. En un coup d’œil, vous pilotez votre système, activez un mode « nuit », ajoutez un accessoire, ou vérifiez l’état de votre alarme.<\/p><p>Vous partez de chez vous ? Activez votre système depuis l’écran ou votre téléphone. En vacances ? Contrôlez tout à distance, où que vous soyez.<\/p><p><strong>TOUCH est notre gamme la plus complète, la plus évolutive, et la plus confortable à utiliser au quotidien.<\/strong><\/p>","color_text":"#ffffff","color_background":"#886a51"}},"profile_iF8LHc":{"type":"profile","settings":{"image":"shopify:\/\/shop_images\/Visuel_lifestyle_accessoires_10.png","heading":"Gamme Élite","text":"<h3><strong>L’alarme discrète, pensée pour se faire oublier<\/strong><\/h3><p>Vous ne voulez pas voir votre alarme, mais vous voulez qu’elle veille sur votre maison 24h\/24 ?<br\/><br\/>La gamme <strong>ELITE<\/strong> a été pensée pour cela.<\/p><p>Sans clavier, sans écran, <strong>entièrement pilotable depuis l’application mobile<\/strong>, elle se dissimule facilement dans un placard ou un meuble. Parfaite pour les intérieurs épurés ou si vous cherchez une solution <strong>discrète mais ultra-efficace<\/strong>.<\/p><p>Dotée de la <strong>technologie ZigBee<\/strong>, elle assure une communication rapide et stable avec tous vos accessoires. Et bien sûr, comme toutes nos alarmes, elle fonctionne <strong>sans abonnement<\/strong> et peut être connectée via <strong>Wi-Fi ou GSM<\/strong>.<\/p><p><strong>ELITE, c’est la sécurité invisible, pour ceux qui veulent la tranquillité sans l’encombrement.<\/strong><\/p>","color_text":"#ffffff","color_background":"#2e2d45"}}},"block_order":["profile_rUXWQW","profile_Tfhxeb","profile_iF8LHc"],"settings":{"columns":4,"carousel_on_desktop":false,"layout":"grid","image_ratio":"portrait","image_ratio_mobile":"portrait","columns_mobile":"1","swipe_on_mobile":true,"heading":"Trouvez <em>l’alarme<\/em> qui s’adapte à votre quotidien","heading_size":"title-md","heading_alignment":"text-left justify-start","heading_tag":"h2","subheading":"","description":"<p>Toutes nos alarmes sont sans abonnement, simples à installer et entièrement personnalisables. <\/p>","button_label":"Découvrir tous les packs","button_link":"shopify:\/\/collections\/tous-les-packs-alarme-sa-pa-am","button_external":false,"button_icon":true,"highlighted_text":"full_text","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"#ccd8b5","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":72,"divider":false,"full_width":false,"rounded":false}},"collection_list_HcWcTN":{"type":"collection-list","blocks":{"collection_haj3rn":{"type":"collection","settings":{"collection":"tous-les-packs-alarme-sa-pa-am","image":"shopify:\/\/shop_images\/am302-starter-pack-alarme-daewoo-wifi-gsm-4g-7-206581_1_d54109f7-e185-4d3d-9d26-8d0ee3d44e0a.webp","title":"Tous les packs alarme","description":"Découvrez tous nos packs prêt à l'emploi","overlay_content":false,"color_text":"#ffffff","color_overlay":"#000000","overlay_opacity":30}},"collection_zP4yaV":{"type":"collection","settings":{"collection":"systeme-dalarme-am301-am302","title":"","description":"Avec écran tactile. Facile à utiliser, design moderne.","overlay_content":false,"color_text":"#fffff