{%- comment -%}
  Panneau latéral de Franck (styles, structure et script), rendu par
  dw-franck-questions. Aucun Liquid ici : le fichier peut être testé tel quel.
{%- endcomment -%}
<div class="dwf-voile" data-dwf-fermer hidden></div>
<aside class="dwf-panneau" role="dialog" aria-modal="true" aria-labelledby="dwf-panneau-titre" hidden>
  <header class="dwf-panneau__tete">
    <span class="dwf__avatar dwf__avatar--clair" aria-hidden="true">F<span class="dwf__pastille"></span></span>
    <p class="dwf-panneau__nom">
      <strong id="dwf-panneau-titre">Franck</strong>
      <span>Assistant IA Daewoo Security</span>
    </p>
    <button type="button" class="dwf-panneau__fermer" data-dwf-fermer aria-label="Fermer la discussion">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
    </button>
  </header>
  <div class="dwf-panneau__fil" aria-live="polite">
    <p class="dwf-bulle dwf-bulle--client" data-dwf-rappel hidden></p>
    <p class="dwf-bulle dwf-bulle--franck" data-dwf-attente>
      <span class="sr-only">Franck prépare sa réponse</span>
      <span class="dwf-points" aria-hidden="true"><i></i><i></i><i></i></span>
    </p>
    <div class="dwf-retard" data-dwf-retard hidden>
      <p>Franck met plus de temps que prévu à arriver.</p>
      <button type="button" class="dwf-retard__bouton" data-dwf-reessayer>Réessayer</button>
      <a class="dwf-retard__lien" href="/pages/nous-contacter">Nous écrire</a>
    </div>
  </div>
</aside>

<style>
  .dwf{
    --dwf-marine:#0c1e4a;--dwf-encre:#1d1d1f;--dwf-gris:#6e6e73;--dwf-fond:#f5f5f7;--dwf-trait:#d2d2d7;--dwf-vert:#037e05;
    --dwf-sortie:cubic-bezier(.23,1,.32,1);
    box-sizing:border-box;width:100%;margin:14px 0 6px;padding:14px;border-radius:18px;background:var(--dwf-fond);
    text-align:left;color:var(--dwf-encre);
    opacity:1;transform:none;transition:opacity .3s var(--dwf-sortie),transform .3s var(--dwf-sortie);
  }
  .dwf[hidden]{display:none;}
  .dwf.dwf--entree{opacity:0;transform:translateY(6px);}
  .dwf *{box-sizing:border-box;}
  .dwf__tete{display:flex;align-items:center;gap:10px;margin:0 0 12px;}
  .dwf__avatar{
    position:relative;flex:none;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;
    background:#0c1e4a;color:#fff;font-size:14px;font-weight:600;line-height:1;
  }
  .dwf__pastille{position:absolute;right:-1px;bottom:-1px;width:10px;height:10px;border-radius:50%;background:#1faa3c;border:2px solid #f5f5f7;}
  .dwf__titre{margin:0;display:flex;flex-direction:column;gap:1px;line-height:1.3;}
  .dwf__titre strong{font-size:14.5px;font-weight:600;color:var(--dwf-encre);}
  .dwf__titre span{font-size:12.5px;color:var(--dwf-gris);}
  .dwf__questions{display:flex;flex-direction:column;gap:8px;}
  .dwf__question{
    display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:46px;margin:0;padding:11px 14px;
    border:1px solid var(--dwf-trait);border-radius:12px;background:#fff;color:var(--dwf-encre);
    font:inherit;font-size:14px;font-weight:500;line-height:1.3;text-align:left;cursor:pointer;
    -webkit-tap-highlight-color:transparent;
    transition:border-color .16s ease,box-shadow .16s ease,transform .16s var(--dwf-sortie);
  }
  .dwf__question svg{flex:none;color:var(--dwf-marine);transition:transform .2s var(--dwf-sortie);}
  .dwf__question:active{transform:scale(.98);}
  .dwf__question:focus-visible,.dwf__libre:focus-visible{outline:2px solid var(--dwf-marine);outline-offset:2px;}
  @media (hover:hover) and (pointer:fine){
    .dwf__question:hover{border-color:var(--dwf-marine);box-shadow:0 1px 2px rgba(12,30,74,.08),0 6px 16px -8px rgba(12,30,74,.25);}
    .dwf__question:hover svg{transform:translateX(3px);}
    .dwf__libre:hover{color:var(--dwf-marine);}
  }
  .dwf__libre{
    display:inline-block;margin:10px 0 0 2px;padding:2px 0;border:0;background:none;color:var(--dwf-gris);
    font:inherit;font-size:12.5px;text-decoration:underline;text-underline-offset:3px;cursor:pointer;transition:color .16s ease;
  }

  /* ---- panneau latéral ---- */
  .dwf-voile.dwf-voile{
    display:block;position:fixed;inset:0;z-index:2147483000;background:rgba(8,20,48,.32);
    opacity:0;transition:opacity .2s ease;
  }
  .dwf-panneau{
    position:fixed;top:0;right:0;bottom:0;z-index:2147483001;display:flex;flex-direction:column;
    width:min(440px,100vw);background:#fff;color:#1d1d1f;
    box-shadow:-24px 0 60px -20px rgba(8,20,48,.35);
    transform:translateX(100%);transition:transform .32s cubic-bezier(.32,.72,0,1);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  .dwf-voile.dwf-voile[hidden],.dwf-panneau[hidden]{display:none;}
  html.dwf-ouvert .dwf-voile{opacity:1;}
  html.dwf-ouvert .dwf-panneau{transform:none;}
  .dwf-panneau *{box-sizing:border-box;}
  .dwf-panneau__tete{display:flex;align-items:center;gap:12px;padding:16px 16px 16px 20px;background:#0c1e4a;color:#fff;}
  .dwf__avatar--clair{background:#fff;color:#0c1e4a;}
  .dwf__avatar--clair .dwf__pastille{border-color:#0c1e4a;}
  .dwf-panneau__nom{flex:1;margin:0;display:flex;flex-direction:column;gap:1px;line-height:1.3;}
  .dwf-panneau__nom strong{font-size:15px;font-weight:600;}
  .dwf-panneau__nom span{font-size:12.5px;color:rgba(255,255,255,.72);}
  .dwf-panneau__fermer{
    flex:none;display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:50%;
    background:rgba(255,255,255,.12);color:#fff;cursor:pointer;transition:background-color .16s ease,transform .16s ease;
  }
  .dwf-panneau__fermer:active{transform:scale(.94);}
  .dwf-panneau__fermer:focus-visible{outline:2px solid #fff;outline-offset:2px;}
  @media (hover:hover) and (pointer:fine){.dwf-panneau__fermer:hover{background:rgba(255,255,255,.22);}}
  .dwf-panneau__fil{flex:1;display:flex;flex-direction:column;gap:10px;padding:20px;overflow-y:auto;background:#fff;}
  .dwf-bulle{max-width:84%;margin:0;padding:11px 14px;border-radius:18px;font-size:14.5px;line-height:1.45;}
  .dwf-bulle[hidden],.dwf-retard[hidden]{display:none;}
  .dwf-bulle--client{align-self:flex-end;background:#0c1e4a;color:#fff;border-bottom-right-radius:6px;}
  .dwf-bulle--franck{align-self:flex-start;background:#f5f5f7;border-bottom-left-radius:6px;}
  .dwf-points{display:flex;gap:5px;padding:5px 2px;}
  .dwf-points i{width:7px;height:7px;border-radius:50%;background:#8e8e93;animation:dwf-point 1.1s ease-in-out infinite;}
  .dwf-points i:nth-child(2){animation-delay:.15s;}
  .dwf-points i:nth-child(3){animation-delay:.3s;}
  @keyframes dwf-point{0%,60%,100%{opacity:.35;transform:translateY(0);}30%{opacity:1;transform:translateY(-3px);}}
  .dwf-retard{align-self:flex-start;max-width:84%;padding:14px;border-radius:18px;background:#f5f5f7;font-size:14px;line-height:1.45;}
  .dwf-retard p{margin:0 0 10px;}
  .dwf-retard__bouton{
    margin:0 12px 0 0;padding:8px 16px;border:0;border-radius:999px;background:#0c1e4a;color:#fff;
    font:inherit;font-size:13.5px;font-weight:600;cursor:pointer;
  }
  .dwf-retard__lien{font-size:13.5px;color:#0c1e4a;text-decoration:underline;text-underline-offset:3px;}

  /* La fenêtre Chatbase prend la place du panneau. */
  html.dwf-ouvert #chatbase-bubble-button,
  html.dwf-ouvert #chatbase-message-bubbles{opacity:0 !important;pointer-events:none !important;}
  @media (min-width:768px){
    html.dwf-ouvert .dwf-fenetre{
      position:fixed !important;top:0 !important;right:0 !important;bottom:0 !important;left:auto !important;
      width:min(440px,100vw) !important;height:100% !important;max-width:none !important;max-height:none !important;
      margin:0 !important;border:0 !important;border-radius:0 !important;box-shadow:none !important;
      z-index:2147483002 !important;
    }
    html.dwf-ouvert .dwf-fenetre iframe{width:100% !important;height:100% !important;max-height:none !important;border-radius:0 !important;}
  }
  @media (max-width:767px){
    .dwf{margin:0;}
    .dwf-panneau{left:0;width:auto;transform:translateY(100%);}
    .dwf__titre strong{font-size:14px;}
  }
  @media (prefers-reduced-motion:reduce){
    .dwf,.dwf-panneau{transition:opacity .2s ease;}
    .dwf.dwf--entree{transform:none;}
    .dwf-panneau{transform:none;opacity:0;}
    html.dwf-ouvert .dwf-panneau{opacity:1;}
    .dwf-points i{animation:none;opacity:.7;}
    .dwf__question,.dwf__question svg{transition:none;}
  }
</style>

<script>
  (function () {
    'use strict';

    var bloc = document.getElementById('dw-franck');
    var panneau = document.querySelector('.dwf-panneau');
    var voile = document.querySelector('.dwf-voile');
    if (!bloc || !panneau || !voile) return;

    /* Sans le chargeur Chatbase (snippet chat-differe), le bloc reste masqué. */
    if (typeof window.chatbase !== 'function') return;

    var racine = document.documentElement;
    var rappel = panneau.querySelector('[data-dwf-rappel]');
    var attente = panneau.querySelector('[data-dwf-attente]');
    var retard = panneau.querySelector('[data-dwf-retard]');
    var DELAI_RETARD = 15000;

    var ancre = null;
    var fenetre = null;
    var fenetreVue = false;
    var declencheur = null;
    var dernierMessage = '';
    var veille = null;
    var minuterie = null;
    var fermeture = null;

    /* ---- 1. Placement sous le bouton d'achat ---- */

    function suivreOrdre() {
      if (ancre) bloc.style.order = getComputedStyle(ancre).order;
    }

    function placer() {
      ancre = document.querySelector('.pv-hero__bouton');
      if (!ancre || !ancre.parentNode) return;
      bloc.classList.add('dwf--entree');
      ancre.parentNode.insertBefore(bloc, ancre.nextSibling);
      suivreOrdre();
      bloc.hidden = false;
      window.addEventListener('resize', suivreOrdre, { passive: true });
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { bloc.classList.remove('dwf--entree'); });
      });
    }

    /* ---- 2. Fenêtre Chatbase ---- */

    function trouverFenetre() {
      var el = document.getElementById('chatbase-bubble-window');
      if (!el) {
        var cadres = document.querySelectorAll('iframe[src*="chatbase.co"]');
        for (var i = 0; i < cadres.length; i++) {
          if (cadres[i].id !== 'chatbase-message-bubbles' && !panneau.contains(cadres[i])) { el = cadres[i]; break; }
        }
      }
      while (el && el.parentElement && el.parentElement !== document.body) el = el.parentElement;
      return el || null;
    }

    function estVisible(el) {
      if (!el || !el.isConnected) return false;
      var style = getComputedStyle(el);
      if (style.display === 'none' || style.visibility === 'hidden') return false;
      var r = el.getBoundingClientRect();
      return r.width > 120 && r.height > 120;
    }

    function surveiller() {
      if (!fenetre) fenetre = trouverFenetre();
      if (fenetre) fenetre.classList.add('dwf-fenetre');

      if (estVisible(fenetre)) {
        if (!fenetreVue) {
          fenetreVue = true;
          clearTimeout(minuterie);
          /* Si la fenêtre Chatbase ne recouvre pas le panneau (mobile, ou
             mise en forme refusée), notre panneau lui laisse la place. */
          var r = fenetre.getBoundingClientRect();
          var couvre = r.height >= window.innerHeight * 0.9 && r.width >= panneau.offsetWidth * 0.9;
          panneau.style.visibility = 'hidden';
          if (!couvre) voile.style.display = 'none';
        }
      } else if (fenetreVue) {
        fermer(false);
      }
    }

    /* ---- 3. Ouverture et fermeture ---- */

    function envoyer(message) {
      try {
        if (message) window.chatbase.open({ message: message });
        else window.chatbase.open();
      } catch (e) {}
    }

    function ouvrir(question, message, source) {
      clearTimeout(fermeture);
      declencheur = source || null;
      dernierMessage = message;
      fenetreVue = false;

      rappel.textContent = question;
      rappel.hidden = !question;
      attente.hidden = false;
      retard.hidden = true;
      panneau.style.visibility = '';
      voile.style.display = '';
      panneau.hidden = false;
      voile.hidden = false;
      void panneau.offsetWidth;
      racine.classList.add('dwf-ouvert');
      panneau.querySelector('.dwf-panneau__fermer').focus({ preventScroll: true });

      envoyer(message);

      clearInterval(veille);
      veille = setInterval(surveiller, 250);
      clearTimeout(minuterie);
      minuterie = setTimeout(function () {
        if (fenetreVue) return;
        attente.hidden = true;
        retard.hidden = false;
      }, DELAI_RETARD);
    }

    function fermer(avertirChatbase) {
      if (!racine.classList.contains('dwf-ouvert')) return;
      clearInterval(veille);
      clearTimeout(minuterie);
      racine.classList.remove('dwf-ouvert');
      if (avertirChatbase !== false) {
        try { window.chatbase.close(); } catch (e) {}
      }
      fermeture = setTimeout(function () {
        panneau.hidden = true;
        voile.hidden = true;
      }, 340);
      if (declencheur && declencheur.focus) declencheur.focus({ preventScroll: true });
    }

    bloc.addEventListener('click', function (event) {
      var bouton = event.target.closest('[data-dwf-message]');
      if (!bouton) return;
      ouvrir(bouton.getAttribute('data-dwf-question'), bouton.getAttribute('data-dwf-message'), bouton);
    });

    document.addEventListener('click', function (event) {
      if (event.target.closest('[data-dwf-fermer]')) fermer();
      else if (event.target.closest('[data-dwf-reessayer]')) ouvrir(rappel.textContent, dernierMessage, declencheur);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') fermer();
    });

    placer();
  })();
</script>
