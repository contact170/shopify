{%- comment -%}
  Message de disponibilité sur la fiche produit (25/11/2026, rupture W512MW).
  Affiché si le métachamp produit « Disponibilité – titre » (custom.dispo_titre)
  est renseigné, avec « Disponibilité – message » (custom.dispo_texte) dessous.
  Placé par script juste au-dessus du premier bouton d'achat de la page.
  Pour retirer le message d'un produit : vider ses deux métachamps dans l'admin.
  Rendu en fin de page par layout/theme.liquid (fiches produits seulement).
{%- endcomment -%}
{%- if product -%}
  {%- assign dwd_titre = product.metafields.custom.dispo_titre.value | strip -%}
  {%- if dwd_titre != blank -%}
    {%- assign dwd_texte = product.metafields.custom.dispo_texte.value | strip -%}
    <div id="dw-dispo" class="dw-dispo" role="note" hidden>
      <span class="dw-dispo__ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
      <div>
        <p class="dw-dispo__titre">{{ dwd_titre | escape }}</p>
        {%- if dwd_texte != blank -%}<p class="dw-dispo__texte">{{ dwd_texte | escape | newline_to_br }}</p>{%- endif -%}
      </div>
    </div>
    <style>
      .dw-dispo{display:flex;gap:12px;align-items:flex-start;width:100%;box-sizing:border-box;margin:0 0 14px;padding:12px 14px;border-radius:14px;background:#fff6db;border:1px solid #f0d27c;color:#3d2e00;text-align:left;font-family:inherit;}
      .dw-dispo[hidden]{display:none;}
      .dw-dispo__ico{flex:0 0 30px;width:30px;height:30px;border-radius:50%;background:#ffd84d;display:flex;align-items:center;justify-content:center;color:#3d2e00;}
      .dw-dispo__ico svg{width:17px;height:17px;}
      .dw-dispo__titre{margin:0;font-size:15px;font-weight:700;line-height:1.3;color:#3d2e00;}
      .dw-dispo__texte{margin:4px 0 0;font-size:13.5px;line-height:1.45;color:#5c4a12;}
      .dw-dispo--haut{margin:12px 16px;width:auto;}
    </style>
    <script>
      (function () {
        var bloc = document.getElementById('dw-dispo');
        if (!bloc) return;
        function fixe(el) {
          for (var e = el; e && e !== document.body; e = e.parentElement) {
            var pos = getComputedStyle(e).position;
            if (pos === 'fixed') return true;
            if (pos === 'sticky') return true;
          }
          return false;
        }
        function visible(el) {
          var r = el.getBoundingClientRect();
          return r.width > 0 && r.height > 0 && getComputedStyle(el).visibility !== 'hidden';
        }
        function exclu(el) {
          return !!el.closest('#dw-dispo, cart-drawer, #CartDrawer, .cart-drawer, header, footer, .dwf-panneau, .dwh-collant');
        }
        function enLigne(parent) {
          if (parent.children.length < 2) return false;
          var cs = getComputedStyle(parent);
          if (cs.display.indexOf('flex') > -1 && cs.flexDirection.indexOf('row') === 0) return true;
          if (cs.display.indexOf('grid') > -1 && cs.gridTemplateColumns.trim().split(/\s+/).length > 1) return true;
          return false;
        }
        function placer() {
          if (bloc.getAttribute('data-place')) return true;
          var liste = document.querySelectorAll('[data-dwd-ancre], [id^="PVHeroCta-"], button[type="submit"][form], form[action*="/cart/add"] [type="submit"], form[action*="/cart/add"] button[name="add"]');
          var meilleur = null;
          var haut = Infinity;
          for (var i = 0; i < liste.length; i++) {
            var c = liste[i];
            if (exclu(c)) continue;
            if (!visible(c)) continue;
            if (fixe(c)) continue;
            var y = c.getBoundingClientRect().top + window.scrollY;
            if (y < haut) { haut = y; meilleur = c; }
          }
          if (!meilleur) return false;
          var el = meilleur.closest('[id^="PVHeroCta-"]');
          if (!el) el = meilleur;
          while (el.parentElement && el.parentElement !== document.body && enLigne(el.parentElement)) el = el.parentElement;
          bloc.style.order = getComputedStyle(el).order;
          el.parentNode.insertBefore(bloc, el);
          bloc.hidden = false;
          bloc.setAttribute('data-place', '1');
          return true;
        }
        function lancer() {
          if (placer()) return;
          window.addEventListener('load', function () {
            if (placer()) return;
            var main = document.querySelector('main');
            if (!main) return;
            main.insertBefore(bloc, main.firstChild);
            bloc.classList.add('dw-dispo--haut');
            bloc.hidden = false;
          });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', lancer);
        else lancer();
      })();
    </script>
  {%- endif -%}
{%- endif -%}
