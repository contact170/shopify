{%- comment -%}
  Ligne de disponibilité sous un article du panier et du tiroir panier (25/11/2026).
  Affichée si le produit a le métachamp « Disponibilité – titre » (custom.dispo_titre).
  Appel : render 'dw-dispo-panier', item: item (sections main-cart et cart-drawer).
{%- endcomment -%}
{%- assign dwd_titre = item.product.metafields.custom.dispo_titre.value | strip -%}
{%- if dwd_titre != blank -%}
  <p class="dw-dispo-ligne" style="display:flex;gap:6px;align-items:flex-start;margin:6px 0 0;padding:6px 9px;border-radius:8px;background:#fff6db;border:1px solid #f0d27c;color:#5c4300;font-size:12.5px;font-weight:600;line-height:1.35;"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{{ dwd_titre | escape }}</span></p>
{%- endif -%}
