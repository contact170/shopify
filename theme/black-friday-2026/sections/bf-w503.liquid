{%- comment -%}
  Black Friday : encart de l'offre du configurateur, au-dessus de la section configurateur de l'accueil.
  Fichier repris de l'encart « caméra W503 offerte » (terminé le 16/11 9h30) pour l'offre −7 %
  (le nom du fichier est gardé pour ne pas modifier templates/index.json).
  - Visible entre la date de début et la date de fin, puis disparaît seul.
  - Avant la date de début, il est rendu masqué ; ?bf_test=1 dans l'adresse l'affiche pour le tester.
  - Paliers : une ligne par palier « seuil|remise du configurateur » ; la remise totale affichée
    est calculée à partir de cette remise et de la remise supplémentaire.
  - Sur mobile, version compacte : le paragraphe d'explication est masqué.
{%- endcomment -%}
{%- liquid
  assign maintenant = 'now' | date: '%s' | plus: 0
  assign actif = true
  assign masque = false
  if section.settings.title == blank
    assign actif = false
  endif
  if section.settings.end_date != blank
    assign fin = section.settings.end_date | date: '%s' | plus: 0
    if maintenant > fin
      assign actif = false
    endif
  endif
  if section.settings.start_date != blank
    assign debut = section.settings.start_date | date: '%s' | plus: 0
    if maintenant < debut
      assign masque = true
    endif
  endif
  if request.design_mode
    assign actif = true
    assign masque = false
  endif
  assign bonus = section.settings.bonus | default: 7 | round
  assign reste_bonus = 100 | minus: bonus
-%}
{%- if actif -%}
{% render 'dw-home-head' %}
<div class="dwh bfc" id="BfConfig-{{ section.id }}"{% if masque %} hidden{% endif %}
  data-debut="{{ section.settings.start_date | escape }}" data-fin="{{ section.settings.end_date | escape }}">
  <div class="dwh-large">
    <div class="bfc__carte">
      <div class="bfc__sceau" aria-hidden="true">
        <span class="bfc__sceau-val">−{{ bonus }}&nbsp;%</span>
        <span class="bfc__sceau-txt">{{ section.settings.seal_text }}</span>
      </div>
      <div class="bfc__tete">
        {%- if section.settings.label != blank -%}<p class="bfc__pastille">{{ section.settings.label }}</p>{%- endif -%}
        <h2 class="bfc__titre">{{ section.settings.title }}</h2>
      </div>
      <div class="bfc__corps">
        {%- if section.settings.text != blank -%}<p class="bfc__texte">{{ section.settings.text }}</p>{%- endif -%}
        {%- assign lignes = section.settings.tiers | newline_to_br | split: '<br />' -%}
        {%- if section.settings.tiers != blank -%}
          <ul class="bfc__paliers" role="list"{% if section.settings.tiers_label != blank %} aria-label="{{ section.settings.tiers_label | escape }}"{% endif %}>
            {%- for ligne in lignes -%}
              {%- assign morceaux = ligne | strip | split: '|' -%}
              {%- if morceaux.size == 2 -%}
                {%- liquid
                  assign remise = morceaux[1] | strip | plus: 0 | round
                  assign reste = 100 | minus: remise | times: reste_bonus
                  assign dixiemes = 10000 | minus: reste | plus: 5 | divided_by: 10
                  assign entier = dixiemes | divided_by: 10
                  assign decimale = dixiemes | modulo: 10
                -%}
                <li class="bfc__palier">
                  <span class="bfc__seuil">{{ morceaux[0] | strip }}</span>
                  <span class="bfc__total">−{{ entier }}{% if decimale > 0 %},{{ decimale }}{% endif %}&nbsp;%</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if section.settings.tiers_caption != blank -%}<p class="bfc__legende">{{ section.settings.tiers_caption }}</p>{%- endif -%}
        {%- endif -%}
      </div>
      <div class="bfc__action">
        <p class="bfc__infos">
          {%- if section.settings.end_text != blank -%}<span class="bfc__fin">{{ section.settings.end_text }}</span>{%- endif -%}
          <span class="bfc__reste" data-bfc-reste></span>
        </p>
        {%- if section.settings.cta_label != blank -%}
          <a class="dwh-btn bfc__btn" href="{{ section.settings.cta_link }}">
            <span>{{ section.settings.cta_label }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.conditions != blank -%}<p class="bfc__mention">{{ section.settings.conditions }}</p>{%- endif -%}
    </div>
  </div>
</div>

<style>
  .bfc{--bf-noir:#07080c;--bf-jaune:#ffd500;--bf-rouge:#e11d48;padding:32px 16px;background:var(--porcelaine,#f5f6fa);}
  .bfc[hidden]{display:none;}
  .bfc .bfc__carte{display:grid;grid-template-columns:76px minmax(0,1fr);grid-template-areas:"s t" "c c" "a a" "m m";gap:14px;align-items:center;max-width:1140px;margin:0 auto;padding:18px 16px;border-radius:22px;color:#fff;
    background:radial-gradient(80% 140% at 100% 0%,rgba(255,213,0,.18),transparent 60%),var(--bf-noir);box-shadow:inset 0 0 0 1.5px rgba(255,213,0,.6),0 24px 48px -28px rgba(7,8,12,.55);}
  .bfc .bfc__sceau{grid-area:s;display:flex;flex-direction:column;align-items:center;justify-content:center;width:76px;height:76px;border-radius:50%;background:linear-gradient(135deg,#ffe24d,var(--bf-jaune) 55%,#e6b800);color:var(--bf-noir);box-shadow:0 0 0 4px rgba(255,213,0,.22);}
  .bfc .bfc__sceau-val{font-size:22px;font-weight:900;line-height:1;letter-spacing:-.02em;white-space:nowrap;}
  .bfc .bfc__sceau-txt{margin-top:3px;font-size:9.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;}
  .bfc .bfc__tete{grid-area:t;}
  .bfc .bfc__pastille{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--bf-jaune);}
  .bfc .bfc__titre{margin-top:6px;font-size:20px;line-height:1.2;font-weight:700;letter-spacing:-.01em;color:#fff;text-wrap:balance;}
  .bfc .bfc__corps{grid-area:c;min-width:0;}
  .bfc .bfc__texte{display:none;font-size:15px;line-height:1.5;color:#c9cfdd;text-wrap:pretty;}
  .bfc .bfc__paliers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin:0;padding:0;list-style:none;}
  .bfc .bfc__palier{display:flex;flex-direction:column;align-items:center;gap:4px;padding:9px 2px;border-radius:12px;background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1px rgba(255,213,0,.25);text-align:center;}
  .bfc .bfc__seuil{font-size:11px;font-weight:600;color:#c9cfdd;white-space:nowrap;}
  .bfc .bfc__total{font-size:clamp(14px,4.3vw,20px);font-weight:800;line-height:1;color:var(--bf-jaune);font-variant-numeric:tabular-nums;white-space:nowrap;}
  .bfc .bfc__legende{margin-top:8px;font-size:12px;line-height:1.4;color:#9aa2b5;}
  .bfc .bfc__action{grid-area:a;display:flex;flex-direction:column;gap:12px;}
  .bfc .bfc__infos{display:flex;flex-wrap:wrap;gap:8px;}
  .bfc .bfc__infos span{padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.07);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12);font-size:13px;font-weight:600;color:#fff;}
  .bfc .bfc__infos .bfc__fin{color:var(--bf-jaune);}
  .bfc .bfc__infos .bfc__reste:empty{display:none;}
  .bfc .bfc__btn{background:var(--bf-jaune);color:var(--bf-noir);font-weight:700;}
  @media (hover:hover) and (pointer:fine){.bfc .bfc__btn:hover{background:#ffe24d;}}
  .bfc .bfc__mention{grid-area:m;font-size:11.5px;line-height:1.45;color:#9aa2b5;}
  .bfc :focus-visible{outline-color:var(--bf-jaune);}
  @media (min-width:480px){
    .bfc .bfc__paliers{gap:8px;}
    .bfc .bfc__palier{padding:10px 8px;border-radius:14px;}
    .bfc .bfc__seuil{font-size:12.5px;}
  }
  @media (min-width:750px){
    .bfc{padding:48px 24px;}
    .bfc .bfc__carte{grid-template-columns:128px minmax(0,1fr) auto;grid-template-areas:"s t a" "s c a" "m m m";gap:12px 28px;padding:24px 28px;}
    .bfc .bfc__sceau{width:128px;height:128px;align-self:start;}
    .bfc .bfc__sceau-val{font-size:36px;}
    .bfc .bfc__sceau-txt{font-size:11px;}
    .bfc .bfc__titre{font-size:26px;}
    .bfc .bfc__texte{display:block;margin-bottom:14px;}
    .bfc .bfc__action{align-self:center;align-items:stretch;min-width:240px;}
    .bfc .bfc__infos{justify-content:center;}
    .bfc .bfc__btn{width:auto;white-space:nowrap;}
    .bfc .bfc__mention{font-size:12px;}
  }
</style>

<script>
  (function () {
    var el = document.getElementById('BfConfig-{{ section.id }}');
    if (!el) return;
    var d = Date.parse(el.getAttribute('data-debut') || ''), f = Date.parse(el.getAttribute('data-fin') || '');
    if (!{{ request.design_mode | json }}) {
      /* Le cache des pages peut servir l'encart hors période : on vérifie côté navigateur (?bf_test=1 pour le tester avant) */
      var n = Date.now();
      if (f && n > f) { el.remove(); return; }
      el.hidden = !(/[?&]bf_test=1(&|$)/.test(window.location.search) || !d || n >= d);
    }
    /* Temps restant, mis à jour chaque minute */
    var r = el.querySelector('[data-bfc-reste]');
    if (!r || !f) return;
    function maj() {
      var s = Math.floor((f - Date.now()) / 1000);
      if (s <= 0) { r.textContent = ''; return; }
      var j = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
      r.textContent = 'Fin dans ' + (j > 0 ? j + ' j ' + h + ' h' : (h > 0 ? h + ' h ' + m + ' min' : m + ' min'));
    }
    maj();
    setInterval(maj, 60000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Black Friday · Config",
  "tag": "div",
  "class": "bfc-section",
  "settings": [
    { "type": "header", "content": "Période" },
    { "type": "text", "id": "start_date", "label": "Début", "default": "2026-11-16T17:00:00+01:00", "info": "Avant cette date, l'encart est masqué (ajoutez ?bf_test=1 à l'adresse pour le voir)." },
    { "type": "text", "id": "end_date", "label": "Fin", "default": "2026-11-20T14:00:00+01:00", "info": "L'encart disparaît automatiquement après cette date." },
    { "type": "header", "content": "Contenu" },
    { "type": "number", "id": "bonus", "label": "Remise supplémentaire (%)", "default": 7 },
    { "type": "text", "id": "seal_text", "label": "Sous le pourcentage", "default": "en plus" },
    { "type": "text", "id": "label", "label": "Pastille", "default": "Black Friday · Configurateur" },
    { "type": "text", "id": "title", "label": "Titre", "default": "−7 % en plus de la remise du configurateur" },
    { "type": "textarea", "id": "text", "label": "Texte (masqué sur mobile)", "default": "Composez votre alarme sur mesure : les 7 % s'ajoutent à la remise du configurateur et sont appliqués automatiquement au paiement, sans code à saisir." },
    { "type": "textarea", "id": "tiers", "label": "Paliers", "default": "dès 300 €|10\ndès 450 €|15\ndès 700 €|20\ndès 900 €|25", "info": "Une ligne par palier : seuil|remise du configurateur en %. La remise totale affichée est calculée avec la remise supplémentaire." },
    { "type": "text", "id": "tiers_label", "label": "Paliers : titre pour les lecteurs d'écran", "default": "Remise totale selon le montant d'achat" },
    { "type": "text", "id": "tiers_caption", "label": "Paliers : légende", "default": "Remise totale : remise du configurateur + 7 %" },
    { "type": "text", "id": "end_text", "label": "Échéance affichée", "default": "Jusqu'à vendredi 14h" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Composer mon alarme" },
    { "type": "text", "id": "cta_link", "label": "Lien du bouton", "default": "/pages/configurateur_2" },
    { "type": "textarea", "id": "conditions", "label": "Conditions", "default": "Offre réservée aux commandes passées via le configurateur, du lundi 16 novembre 17h au vendredi 20 novembre 2026 14h, une fois par client. Les 7 % s'appliquent automatiquement au paiement, sur le prix après remise du configurateur (10 % dès 300 €, 15 % dès 450 €, 20 % dès 700 €, 25 % dès 900 € d'achat)." }
  ],
  "presets": [ { "name": "Black Friday · Config" } ]
}
{% endschema %}
