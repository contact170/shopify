{"sections":{"custom_liquid_JJzJtA":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.name","settings":{"liquid":"<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Poppins:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .bandeau-promo *,\n  .bandeau-promo *::before,\n  .bandeau-promo *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  :root {\n    --bp-gold: #C9963A;\n    --bp-gold-light: #E8B85A;\n    --bp-dark: #0F1117;\n    --bp-white: #FAFAF8;\n  }\n\n  .bandeau-promo {\n    width: 100%;\n    background: var(--bp-dark);\n    position: relative;\n    overflow: hidden;\n    font-family: 'Poppins', sans-serif;\n    box-shadow: 0 4px 24px rgba(0,0,0,.3);\n  }\n\n  .bandeau-promo::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 3px;\n    background: linear-gradient(90deg, transparent, var(--bp-gold), var(--bp-gold-light), var(--bp-gold), transparent);\n  }\n\n  .bandeau-promo::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(115deg, rgba(201,150,58,.06) 0%, transparent 55%);\n    pointer-events: none;\n  }\n\n  .bandeau-promo__inner {\n    display: grid;\n    grid-template-columns: auto 1fr auto;\n    align-items: center;\n    gap: 28px;\n    padding: 22px 36px;\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n  .bandeau-promo__icon {\n    width: 52px;\n    height: 52px;\n    border: 2px solid var(--bp-gold);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 22px;\n    flex-shrink: 0;\n    animation: bp-pulse 2.4s ease-in-out infinite;\n    position: relative;\n    z-index: 1;\n  }\n\n  .bandeau-promo__icon::after {\n    content: '';\n    position: absolute;\n    inset: -6px;\n    border-radius: 50%;\n    border: 1px solid var(--bp-gold);\n    opacity: 0;\n    animation: bp-ripple 2.4s ease-in-out infinite;\n  }\n\n  @keyframes bp-pulse {\n    0%, 100% { box-shadow: 0 0 0 0 rgba(201,150,58,.4); }\n    50%       { box-shadow: 0 0 0 8px rgba(201,150,58,0); }\n  }\n\n  @keyframes bp-ripple {\n    0%   { transform: scale(1); opacity: .5; }\n    100% { transform: scale(1.4); opacity: 0; }\n  }\n\n  .bandeau-promo__text { min-width: 0; position: relative; z-index: 1; }\n\n  .bandeau-promo__eyebrow {\n    font-size: 10px;\n    font-weight: 500;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: var(--bp-gold);\n    margin-bottom: 5px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .bandeau-promo__eyebrow::before {\n    content: '';\n    display: inline-block;\n    width: 24px;\n    height: 1px;\n    background: var(--bp-gold);\n  }\n\n  .bandeau-promo__headline {\n    font-size: clamp(16px, 2.2vw, 22px);\n    font-weight: 800;\n    color: var(--bp-white);\n    line-height: 1.2;\n    margin-bottom: 5px;\n  }\n\n  .bandeau-promo__headline span {\n    color: var(--bp-gold-light);\n  }\n\n  .bandeau-promo__sub {\n    font-size: 13px;\n    font-weight: 300;\n    color: rgba(250,250,248,.55);\n    line-height: 1.5;\n  }\n\n  .bandeau-promo__sub strong {\n    color: rgba(250,250,248,.85);\n    font-weight: 500;\n  }\n\n  .bandeau-promo__badge {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    background: #FF6B35;\n    color: #fff;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    padding: 3px 8px;\n    border-radius: 1px;\n    animation: bp-blink 3s ease-in-out infinite;\n  }\n\n  @keyframes bp-blink {\n    0%, 85%, 100% { opacity: 1; }\n    90%           { opacity: .3; }\n  }\n\n  .bandeau-promo__cta { flex-shrink: 0; position: relative; z-index: 1; }\n\n  .bandeau-promo__btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--bp-gold);\n    color: var(--bp-dark);\n    font-family: 'Poppins', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    padding: 13px 22px;\n    border-radius: 2px;\n    text-decoration: none;\n    white-space: nowrap;\n    cursor: pointer;\n    border: none;\n    transition: background .2s, transform .15s;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .bandeau-promo__btn::before {\n    content: '';\n    position: absolute;\n    top: -50%; left: -60%;\n    width: 50%; height: 200%;\n    background: rgba(255,255,255,.22);\n    transform: skewX(-20deg);\n    transition: left .35s;\n  }\n\n  .bandeau-promo__btn:hover { background: #E8B85A; transform: translateY(-1px); }\n  .bandeau-promo__btn:hover::before { left: 130%; }\n\n  @media (max-width: 680px) {\n    .bandeau-promo__inner {\n      grid-template-columns: auto 1fr;\n      padding: 18px 20px;\n      gap: 16px;\n    }\n    .bandeau-promo__cta { display: none; }\n    .bandeau-promo__badge { display: none; }\n  }\n<\/style>\n\n<div class=\"bandeau-promo\">\n  <span class=\"bandeau-promo__badge\">Offre limitée<\/span>\n\n  <div class=\"bandeau-promo__inner\">\n\n    <div class=\"bandeau-promo__icon\">🎁<\/div>\n\n    <div class=\"bandeau-promo__text\">\n      <div class=\"bandeau-promo__eyebrow\">Offre exclusive configurateur<\/div>\n      <div class=\"bandeau-promo__headline\">\n        Un <span>cadeau offert<\/span> sur votre commande.\n      <\/div>\n      <div class=\"bandeau-promo__sub\">\n        Montre connectée, visiophone ou accessoire — <strong>une surprise rien que pour vous.<\/strong>\n      <\/div>\n    <\/div>\n\n    <div class=\"bandeau-promo__cta\">\n      <a href=\"https:\/\/daewoo-security.fr\/pages\/configurateur_2\" class=\"bandeau-promo__btn\">\n        Configurer mon système →\n      <\/a>\n    <\/div>\n\n  <\/div>\n<\/div>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow