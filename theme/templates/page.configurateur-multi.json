{"sections":{"custom_liquid_rbCxn8":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.name","settings":{"liquid":"<div style=\"width:100%;background:#1a2e6c;font-family:Arial,sans-serif;\">\n  <div style=\"display:flex;align-items:center;justify-content:space-between;padding:12px 32px;gap:20px;flex-wrap:wrap;\">\n\n    <div style=\"display:flex;align-items:center;gap:14px;flex-wrap:wrap;flex:1;\">\n      <span style=\"background:#f5c518;color:#1a2e6c;font-size:11px;font-weight:700;padding:4px 10px;border-radius:4px;text-transform:uppercase;letter-spacing:1px;white-space:nowrap;\">\n        Offre limitée\n      <\/span>\n      <span style=\"font-size:13px;color:#ffffff;line-height:1.4;\">\n        Pour tout achat d'une alarme — recevez <strong style=\"color:#f5c518;\">5% en bon de réduction<\/strong> de la valeur de votre achat. Offre valable jusqu'à lundi 10h.\n      <\/span>\n    <\/div>\n\n    <div style=\"display:flex;align-items:center;gap:6px;flex-shrink:0;\">\n      <span style=\"font-size:11px;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:1px;margin-right:4px;white-space:nowrap;\">\n        Se termine dans\n      <\/span>\n      <div style=\"display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,0.1);border-radius:4px;padding:5px 8px;min-width:38px;\">\n        <span id=\"dws-cd-d\" style=\"font-size:16px;font-weight:700;color:#ffffff;line-height:1;\">00<\/span>\n        <span style=\"font-size:8px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-top:2px;\">jours<\/span>\n      <\/div>\n      <span style=\"font-size:14px;font-weight:700;color:rgba(255,255,255,0.4);margin-bottom:8px;\">:<\/span>\n      <div style=\"display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,0.1);border-radius:4px;padding:5px 8px;min-width:38px;\">\n        <span id=\"dws-cd-h\" style=\"font-size:16px;font-weight:700;color:#ffffff;line-height:1;\">00<\/span>\n        <span style=\"font-size:8px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-top:2px;\">heures<\/span>\n      <\/div>\n      <span style=\"font-size:14px;font-weight:700;color:rgba(255,255,255,0.4);margin-bottom:8px;\">:<\/span>\n      <div style=\"display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,0.1);border-radius:4px;padding:5px 8px;min-width:38px;\">\n        <span id=\"dws-cd-m\" style=\"font-size:16px;font-weight:700;color:#ffffff;line-height:1;\">00<\/span>\n        <span style=\"font-size:8px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-top:2px;\">min<\/span>\n      <\/div>\n      <span style=\"font-size:14px;font-weight:700;color:rgba(255,255,255,0.4);margin-bottom:8px;\">:<\/span>\n      <div style=\"display:flex;flex-direction:column;align-items:center;background:rgba(255,255,255,0.1);border-radius:4px;padding:5px 8px;min-width:38px;\">\n        <span id=\"dws-cd-s\" style=\"font-size:16px;font-weight:700;color:#ffffff;line-height:1;\">00<\/span>\n        <span style=\"font-size:8px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin-top:2px;\">sec<\/span>\n      <\/div>\n    <\/div>\n\n    <a href=\"https:\/\/daewoo-security.fr\/pages\/trouver-mon-alarme-quiz\"\n       style=\"background:#f5c518;color:#1a2e6c;font-size:12px;font-weight:700;padding:10px 20px;border-radius:6px;text-decoration:none;white-space:nowrap;border:2px solid #d4a800;flex-shrink:0;\">\n      J'en profite →\n    <\/a>\n\n  <\/div>\n<\/div>\n\n<script>\n  (function() {\n    var deadline = new Date();\n    var day = deadline.getDay();\n    var daysUntilMonday = (8 - day) % 7 || 7;\n    deadline.setDate(deadline.getDate() + daysUntilMonday);\n    deadline.setHours(10, 0, 0, 0);\n\n    function pad(n) { return String(n).padStart(2, '0'); }\n\n    function tick() {\n      var diff = deadline.getTime() - new Date().getTime();\n      if (diff <= 0) {\n        ['dws-cd-d','dws-cd-h','dws-cd-m','dws-cd-s'].forEach(function(id) {\n          document.getElementById(id).textContent = '00';\n        });\n        return;\n      }\n      document.getElementById('dws-cd-d').textContent = pad(Math.floor(diff \/ 86400000));\n      document.getElementById('dws-cd-h').textContent = pad(Math.floor((diff % 86400000) \/ 3600000));\n      document.getElementById('dws-cd-m').textContent = pad(Math.floor((diff % 3600000) \/ 60000));\n      document.getElementById('dws-cd-s').textContent = pad(Math.floor((diff % 60000) \/ 1000));\n    }\n\n    tick();\n    setInterval(tick, 1000);\n  })();\n<\/script>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":64,"divider":false,"narrow":false,"rounded":false}},"custom_liquid_gdEWPK":{"type":"custom-liquid","name":"t:sections.custom-liquid.name","settings":{"liquid":"<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Poppins:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .bpc2 { width:100%; font-family:'Poppins',sans-serif; box-sizing:border-box; }\n  .bpc2 * { box-sizing:border-box; margin:0; padding:0; font-family:inherit; }\n  .bpc2-wrap { padding:2rem 2.5rem; border-top:1px solid #d5dff5; border-bottom:1px solid #d5dff5; background:#edf2fc; }\n  .bpc2-top { display:flex; align-items:flex-start; justify-content:space-between; gap:2rem; flex-wrap:wrap; }\n  .bpc2-intro { flex:1; min-width:220px; }\n  .bpc2-label { font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.15em; color:rgba(11,30,74,0.35); margin-bottom:0.4rem; }\n  .bpc2-title { font-size:1.1rem; font-weight:700; color:#0b1e4a; line-height:1.35; margin-bottom:0.5rem; }\n  .bpc2-title em { font-style:normal; color:#1a6fd4; }\n  .bpc2-sub { font-size:0.88rem; color:rgba(11,30,74,0.55); line-height:1.7; max-width:420px; }\n  .bpc2-sub strong { color:#0b1e4a; fon