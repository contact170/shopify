{{ 'https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

<style>
#dq { font-family: 'Poppins', sans-serif; max-width: 640px; margin: 2rem auto; }
#dq * { box-sizing: border-box; margin: 0; padding: 0; font-family: inherit; }
#dq .dq-card { background: #fff; border-radius: 20px; box-shadow: 0 8px 40px rgba(11,30,74,0.10); overflow: hidden; }
#dq .dq-top { background: #0b1e4a; padding: 1.25rem 1.75rem; display: flex; align-items: center; gap: 16px; }
#dq .dq-top-label { font-size: 12px; font-weight: 600; color: #7a99bf; white-space: nowrap; min-width: 80px; }
#dq .dq-bar-wrap { flex: 1; background: rgba(255,255,255,0.15); border-radius: 99px; height: 5px; overflow: hidden; }
#dq .dq-bar-fill { background: #0771e3; height: 100%; border-radius: 99px; transition: width 0.4s ease; }
#dq .dq-step-dots { display: flex; gap: 5px; }
#dq .dq-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.2); transition: background 0.3s; }
#dq .dq-dot.active { background: #0771e3; }
#dq .dq-dot.done { background: rgba(255,255,255,0.5); }
#dq .dq-body { padding: 2rem 1.75rem 1.5rem; }
#dq .dq-step { display: none; }
#dq .dq-step.active { display: block; animation: dqFadeIn 0.25s ease; }
@keyframes dqFadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
#dq .dq-q-number { font-size: 11px; font-weight: 700; color: #0771e3; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
#dq .dq-q-title { font-size: 20px; font-weight: 700; color: #0b1e4a; line-height: 1.3; margin-bottom: 0.4rem; }
#dq .dq-q-sub { font-size: 13px; color: #7a8faa; margin-bottom: 1.75rem; line-height: 1.5; }
#dq .dq-opts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 1.5rem; }
#dq .dq-opts-grid.cols-1 { grid-template-columns: 1fr; }
#dq .dq-opts-grid.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
#dq .dq-opt { border: 2px solid #e8edf5; border-radius: 14px; padding: 1.1rem 1rem; cursor: pointer; background: #fff; transition: all 0.18s ease; text-align: center; position: relative; display: flex; flex-direction: column; align-items: center; }
#dq .dq-opt[style*="flex-direction:row"] { flex-direction: row !important; align-items: center !important; text-align: left !important; }
#dq .dq-opt:hover { border-color: #0771e3; background: #f5f8ff; transform: translateY(-1px); }
#dq .dq-opt.selected { border-color: #0771e3; background: #f0f5ff; box-shadow: 0 0 0 4px rgba(7,113,227,0.08); }
#dq .dq-opt.selected::after { content: '✓'; position: absolute; top: 8px; right: 10px; font-size: 11px; font-weight: 700; color: #0771e3; background: #dbeafe; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; line-height: 18px; }
#dq .dq-opt-icon { font-size: 28px; margin-bottom: 0.5rem; display: block; }
#dq .dq-opt-title { font-size: 13px; font-weight: 700; color: #0b1e4a; display: block; line-height: 1.3; }
#dq .dq-opt-sub { font-size: 11px; color: #7a8faa; margin-top: 3px; display: block; line-height: 1.4; }
#dq .dq-toggles { display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.5rem; }
#dq .dq-toggle { display: flex; align-items: center; gap: 14px; border: 2px solid #e8edf5; border-radius: 12px; padding: 0.875rem 1rem; cursor: pointer; background: #fff; transition: all 0.18s; position: relative; }
#dq .dq-toggle:hover { border-color: #0771e3; background: #f5f8ff; }
#dq .dq-toggle.selected { border-color: #0771e3; background: #f0f5ff; }
#dq .dq-toggle-check { width: 20px; height: 20px; border-radius: 6px; border: 2px solid #cbd5e1; background: white; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all 0.15s; font-size: 11px; color: white; font-weight: 700; }
#dq .dq-toggle.selected .dq-toggle-check { background: #0771e3; border-color: #0771e3; }
#dq .dq-toggle.selected .dq-toggle-check::after { content: '✓'; }
#dq .dq-toggle-body { flex: 1; }
#dq .dq-toggle-title { font-size: 13px; font-weight: 600; color: #0b1e4a; }
#dq .dq-toggle-sub { font-size: 11px; color: #7a8faa; margin-top: 2px; line-height: 1.4; }
#dq .dq-toggle-price { font-weight: 700; color: #0771e3; }
#dq .dq-sub-opt { display: block !important; }
#dq .dq-sub-opt > div:first-child { display: flex !important; flex-direction: row !important; align-items: center !important; gap: 10px !important; }
#dq .dq-counter-row { display: none; align-items: center; justify-content: space-between; background: #f8fafc; border-radius: 8px; padding: 8px 12px; margin-top: 6px; }
#dq .dq-counter-row.visible { display: flex; }
#dq .dq-counter-row-label { font-size: 12px; color: #5a6a8a; }
#dq .dq-counter-btns { display: flex; align-items: center; gap: 10px; }
#dq .dq-counter-btns button { width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid #0771e3; background: white; color: #0771e3; font-size: 15px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1; transition: all 0.15s; }
#dq .dq-counter-btns button:hover { background: #0771e3; color: white; }
#dq .dq-counter-btns .dq-count { font-size: 16px; font-weight: 700; color: #0b1e4a; min-width: 20px; text-align: center; }
#dq .dq-none-btn { width: 100%; border: 2px solid #0771e3; border-radius: 10px; padding: 0.75rem; background: white; color: #0771e3; font-size: 13px; font-weight: 600; cursor: pointer; text-align: center; transition: all 0.18s; margin-bottom: 1.5rem; font-family: 'Poppins', sans-serif; }
#dq .dq-none-btn:hover { background: #f0f5ff; }
#dq .dq-none-btn.active { background: #0771e3; color: white; }
#dq .dq-pack-notice { background: #fef9ec; border: 1px solid #f5d87e; border-radius: 10px; padding: 10px 14px; font-size: 12px; color: #7a5c00; margin-bottom: 1rem; display: flex; gap: 8px; align-items: flex-start; line-height: 1.5; }
#dq .dq-nav { display: flex; justify-content: space-between; align-items: center; padding-top: 1.25rem; border-top: 1px solid #f1f5f9; margin-top: 0.5rem; }
#dq .dq-btn { padding: 0.75rem 1.5rem; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s; font-family: 'Poppins', sans-serif; }
#dq .dq-btn-back { background: transparent; border: 1.5px solid #e2e8f0; color: #7a8faa; }
#dq .dq-btn-back:hover { border-color: #0b1e4a; color: #0b1e4a; }
#dq .dq-btn-next { background: #0771e3; color: white; padding: 0.75rem 2rem; margin-left: auto; display: flex; align-items: center; gap: 6px; }
#dq .dq-btn-next:hover { background: #0558b5; }
#dq .dq-btn-next:disabled { background: #c8daf5; cursor: not-allowed; }
#dq .dq-result { display: none; }
#dq .dq-result.active { display: block; animation: dqFadeIn 0.3s ease; }
#dq .dq-result-hero { background: linear-gradient(135deg, #0b1e4a 0%, #1a3a7a 100%); padding: 2rem 1.75rem 1.5rem; color: white; text-align: center; }
#dq .dq-result-hero h3 { font-size: 13px; font-weight: 600; color: #7a99bf; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
#dq .dq-result-alarm-name { font-size: 22px; font-weight: 800; color: white; margin-bottom: 0.25rem; }
#dq .dq-result-alarm-desc { font-size: 13px; color: #a8bcd8; line-height: 1.5; }
#dq .dq-result-body { padding: 1.5rem 1.75rem; }
#dq .dq-result-pack { background: #f8fafc; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; }
#dq .dq-result-pack-title { font-size: 11px; font-weight: 700; color: #0b1e4a; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 6px; }
#dq .dq-result-pack ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
#dq .dq-result-pack li { font-size: 12px; color: #5a6a8a; display: flex; align-items: flex-start; gap: 6px; }
#dq .dq-result-pack li::before { content: '✓'; color: #0771e3; font-weight: 700; flex-shrink: 0; margin-top: 1px; }
#dq .dq-version-selector { background: #f0f5ff; border: 1.5px solid #c5d8f8; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; }
#dq .dq-version-title { font-size: 12px; font-weight: 700; color: #0b1e4a; margin-bottom: 0.75rem; }
#dq .dq-version-opts { display: flex; flex-direction: column; gap: 6px; }
#dq .dq-version-opt { display: flex; justify-content: space-between; align-items: center; background: white; border: 2px solid #e8edf5; border-radius: 8px; padding: 10px 14px; cursor: pointer; transition: all 0.15s; }
#dq .dq-version-opt:hover { border-color: #0771e3; }
#dq .dq-version-opt.selected { border-color: #0771e3; background: #f5f8ff; }
#dq .dq-version-opt-left .dq-version-opt-name { font-size: 13px; font-weight: 600; color: #0b1e4a; }
#dq .dq-version-opt-left .dq-version-opt-sub { font-size: 11px; color: #7a8faa; margin-top: 1px; }
#dq .dq-version-opt-price { font-size: 14px; font-weight: 700; color: #0771e3; white-space: nowrap; margin-left: 10px; }
#dq .dq-result-acc-title { font-size: 13px; font-weight: 700; color: #0b1e4a; margin-bottom: 0.75rem; }
#dq .dq-result-acc-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 1.25rem; }
#dq .dq-result-acc-item { display: flex; justify-content: space-between; align-items: center; background: white; border: 1px solid #e8edf5; border-radius: 10px; padding: 0.7rem 1rem; }
#dq .dq-result-acc-name { font-size: 13px; font-weight: 600; color: #0b1e4a; }
#dq .dq-result-acc-ref { font-size: 11px; color: #7a8faa; }
#dq .dq-result-acc-price { font-size: 13px; font-weight: 700; color: #0771e3; white-space: nowrap; margin-left: 8px; }
#dq .dq-qty-badge { display: inline-block; background: #0771e3; color: white; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 99px; margin-right: 5px; }
#dq .dq-discount-box { background: linear-gradient(135deg, #0b1e4a 0%, #1a3a7a 100%); border-radius: 14px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; display: none; position: relative; overflow: hidden; }
#dq .dq-discount-box::before { content: ''; position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(7,113,227,0.15); border-radius: 50%; }
#dq .dq-discount-label { font-size: 20px; font-weight: 800; color: #ffffff; margin-bottom: 4px; }
#dq .dq-discount-sub { font-size: 12px; color: #a8bcd8; margin-bottom: 8px; }
#dq .dq-discount-urgency { font-size: 12px; color: #fbbf24; font-weight: 700; display: flex; align-items: center; gap: 6px; }
#dq .dq-total-box { background: #0b1e4a; border-radius: 12px; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
#dq .dq-total-left .dq-total-label { font-size: 13px; color: #a8bcd8; margin-bottom: 2px; }
#dq .dq-total-left .dq-total-sub { font-size: 11px; color: #5a7aa8; }
#dq .dq-total-right { text-align: right; }
#dq .dq-total-original { font-size: 14px; color: #a0b4cc; text-decoration: line-through; margin-bottom: 2px; }
#dq .dq-total-amount { font-size: 28px; font-weight: 800; color: white; }
#dq .dq-total-saving { font-size: 12px; color: #4ade80; margin-top: 2px; }
#dq .dq-btn-cart { display: block; width: 100%; text-align: center; background: #16a34a; color: white; padding: 1rem; border-radius: 12px; font-size: 15px; font-weight: 700; border: none; cursor: pointer; font-family: 'Poppins', sans-serif; transition: background 0.2s; margin-bottom: 1rem; }
#dq .dq-btn-cart:hover { background: #15803d; }
#dq .dq-btn-cart:disabled { background: #86efac; cursor: not-allowed; }
#dq .dq-restart { text-align: center; margin-top: 1rem; }
#dq .dq-restart button { background: none; border: none; color: #7a8faa; font-size: 12px; cursor: pointer; text-decoration: underline; font-family: 'Poppins', sans-serif; }
@media (max-width: 520px) {
  #dq .dq-body { padding: 1.5rem 1.25rem 1.25rem; }
  #dq .dq-opts-grid { grid-template-columns: 1fr; }
  #dq .dq-opts-grid.cols-3 { grid-template-columns: 1fr; }
  #dq .dq-q-title { font-size: 17px; }
  #dq .dq-result-body { padding: 1.25rem; }
  #dq .dq-total-box { flex-direction: column; align-items: flex-start; gap: 6px; }
}
</style>

<div id="dq">
  <div class="dq-card">

    <div class="dq-top" id="dq-top">
      <span class="dq-top-label" id="dq-top-label">Étape 1 / 7</span>
      <div class="dq-bar-wrap"><div class="dq-bar-fill" id="dq-bar" style="width:0%"></div></div>
      <div class="dq-step-dots" id="dq-dots"></div>
    </div>

    <div class="dq-body">

      <!-- ÉTAPE 1 -->
      <div class="dq-step active" id="step-1">
        <div class="dq-q-number">Question 1</div>
        <div class="dq-q-title">Quel type de logement souhaitez-vous protéger ?</div>
        <div class="dq-q-sub">Cela nous aide à calibrer votre installation.</div>
        <div class="dq-opts-grid">
          <div class="dq-opt" data-group="logement" data-val="appartement" onclick="selectOpt(this)">
            <span class="dq-opt-icon">🏢</span>
            <span class="dq-opt-title">Appartement</span>
            <span class="dq-opt-sub">Studio, T2, T3…</span>
          </div>
          <div class="dq-opt" data-group="logement" data-val="maison" onclick="selectOpt(this)">
            <span class="dq-opt-icon">🏠</span>
            <span class="dq-opt-title">Maison</span>
            <span class="dq-opt-sub">Individuelle, mitoyenne…</span>
          </div>
        </div>
        <div class="dq-nav">
          <span></span>
          <button class="dq-btn dq-btn-next" id="next-1" disabled onclick="goTo(2)">Suivant →</button>
        </div>
      </div>

      <!-- ÉTAPE 2 -->
      <div class="dq-step" id="step-2">
        <div class="dq-q-number">Question 2</div>
        <div class="dq-q-title">Comment souhaitez-vous contrôler votre alarme ?</div>
        <div class="dq-q-sub">Choisissez ce qui vous correspond le mieux.</div>
        <div class="dq-opts-grid cols-1">
          <div class="dq-opt" data-group="tech" data-val="clavier" onclick="selectOpt(this)" style="flex-direction:row;align-items:center;gap:14px;text-align:left;">
            <img id="alarm-img-vigilia" src="https://daewoo-security.fr/cdn/shop/files/958b5e1e-36cd-47db-93da-efc4b7f2d77c.jpg?v=1770108516&width=1600" alt="Vigilia" style="width:72px;height:72px;object-fit:contain;border-radius:8px;flex-shrink:0;background:#f5f8ff;">
            <div>
              <span class="dq-opt-title">Clavier physique + télécommande + appli</span>
              <span class="dq-opt-sub">La solution la plus populaire — Alarme Vigilia</span>
            </div>
          </div>
          <div class="dq-opt" data-group="tech" data-val="tactile" onclick="selectOpt(this)" style="flex-direction:row;align-items:center;gap:14px;text-align:left;">
            <img id="alarm-img-touch" src="" alt="Touch" style="width:72px;height:72px;object-fit:contain;border-radius:8px;flex-shrink:0;background:#f5f8ff;">
            <div>
              <span class="dq-opt-title">Écran tactile sur la centrale + appli</span>
              <span class="dq-opt-sub">Grand écran 4,3'' ou 7'' — Alarme Touch</span>
            </div>
          </div>
          <div class="dq-opt" data-group="tech" data-val="appli" onclick="selectOpt(this)" style="flex-direction:row;align-items:center;gap:14px;text-align:left;">
            <img id="alarm-img-elite" src="" alt="Élite" style="width:72px;height:72px;object-fit:contain;border-radius:8px;flex-shrink:0;background:#f5f8ff;">
            <div>
              <span class="dq-opt-title">100% depuis mon smartphone</span>
              <span class="dq-opt-sub">Technologie Zigbee, ultra-fiable — Alarme Élite</span>
            </div>
          </div>
        </div>
        <div class="dq-nav">
          <button class="dq-btn dq-btn-back" onclick="goTo(1)">← Retour</button>
          <button class="dq-btn dq-btn-next" id="next-2" disabled onclick="goTo(3)">Suivant →</button>
        </div>
      </div>

      <!-- ÉTAPE 3 -->
      <div class="dq-step" id="step-3">
        <div class="dq-q-number">Question 3</div>
        <div class="dq-q-title">Quels accès voulez-vous sécuriser ?</div>
        <div class="dq-q-sub">Le pack de base inclut déjà 2 contacteurs de porte/fenêtre.</div>
        <div class="dq-pack-notice"><span>📦</span><span>Votre pack inclut déjà <strong>2 contacteurs de porte/fenêtre</strong>. Indiquez uniquement si vous en avez besoin de plus.</span></div>
        <div class="dq-toggles">
          <div>
            <div class="dq-toggle" id="tog-portes" onclick="toggleItem('portes')">
              <div class="dq-toggle-check" id="chk-portes"></div>
              <img id="timg-WDV301" src="" alt="" style="width:44px;height:44px;object-fit:contain;border-radius:6px;flex-shrink:0;background:#f5f8ff;">
              <div class="dq-toggle-body">
                <div class="dq-toggle-title">Portes et fenêtres supplémentaires</div>
                <div class="dq-toggle-sub"><span id="tlabel-contacteur">Contacteur ouverture + vibration WDV301</span> — <span class="dq-toggle-price" id="tprice-WDV301">39,90 €</span> / unité</div>
              </div>
            </div>
            <div class="dq-counter-row" id="ctr-portes">
              <span class="dq-counter-row-label">Combien de portes / fenêtres supplémentaires ?</span>
              <div class="dq-counter-btns">
                <button type="button" onclick="changeCount('portesQty',-1)">−</button>
                <span class="dq-count" id="cnt-portesQty">1</span>
                <button type="button" onclick="changeCount('portesQty',1)">+</button>
              </div>
            </div>
          </div>
          <div>
            <div class="dq-toggle" id="tog-baies" onclick="toggleItem('baies')">
              <div class="dq-toggle-check" id="chk-baies"></div>
              <img id="timg-WVD301" src="" alt="" style="width:44px;height:44px;object-fit:contain;border-radius:6px;flex-shrink:0;background:#f5f8ff;">
              <div class="dq-toggle-body">
                <div class="dq-toggle-title">Baies vitrées ou grandes fenêtres</div>
                <div class="dq-toggle-sub"><span id="tlabel-vibration">Détecteur de vibration WVD301</span> — <span class="dq-toggle-price" id="tprice-WVD301">34,90 €</span> / unité</div>
              </div>
            </div>
            <div class="dq-counter-row" id="ctr-baies">
              <span class="dq-counter-row-label">Combien de baies vitrées ?</span>
              <div class="dq-counter-btns">
                <button type="button" onclick="changeCount('baiesQty',-1)">−</button>
                <span class="dq-count" id="cnt-baiesQty">1</span>
                <button type="button" onclick="changeCount('baiesQty',1)">+</button>
              </div>
            </div>
          </div>
          <div>
            <div class="dq-toggle" id="tog-garage" onclick="toggleItem('garage')">
              <div class="dq-toggle-check" id="chk-garage"></div>
              <img id="timg-WDG301" src="" alt="" style="width:44px;height:44px;object-fit:contain;border-radius:6px;flex-shrink:0;background:#f5f8ff;">
              <div class="dq-toggle-body">
                <div class="dq-toggle-title">Porte de garage</div>
                <div class="dq-toggle-sub"><span id="tlabel-garage">Contacteur spécial garage WDG301</span> — <span class="dq-toggle-price" id="tprice-WDG301">49,90 €</span> / unité</div>
              </div>
            </div>
            <div class="dq-counter-row" id="ctr-garage">
              <span class="dq-counter-row-label">Combien de garage ?</span>
              <div class="dq-counter-btns">
                <button type="button" onclick="changeCount('garageQty',-1)">−</button>
                <span class="dq-count" id="cnt-garageQty">1</span>
                <button type="button" onclick="changeCount('garageQty',1)">+</button>
              </div>
            </div>
          </div>
        </div>
        <button class="dq-none-btn" id="none-3" onclick="toggleNone(3)">✓ Le pack de base suffit, pas besoin de plus</button>
        <div class="dq-nav">
          <button class="dq-btn dq-btn-back" onclick="goTo(2)">← Retour</button>
          <button class="dq-btn dq-btn-next" id="next-3" disabled onclick="goTo(4)">Suivant →</button>
        </div>
      </div>

      <!-- ÉTAPE 4 -->
      <div class="dq-step" id="step-4">
        <div class="dq-q-number">Question 4</div>
        <div class="dq-q-title">Avez-vous des besoins particuliers pour la détection de mouvement ?</div>
        <div class="dq-q-sub">Tous nos détecteurs sont compatibles animaux de compagnie.</div>
        <div class="dq-pack-notice"><span>📦</span><span>Votre pack inclut déjà <strong>1 détecteur de mouvement compatible animaux</strong>. Cochez uniquement si vous avez des besoins supplémentaires.</span></div>
        <div class="dq-toggles">
          <div>
            <div class="dq-toggle" id="tog-mouvement" onclick="toggleItem('mouvement')">
              <div class="dq-toggle-check" id="chk-mouvement"></div>
              <img id="timg-WPS305-int" src="" alt="" style="width:44px;height:44px;object-fit:contain;border-radius:6px;flex-shrink:0;background:#f5f8ff;">
              <div class="dq-toggle-body">
                <div class="dq-toggle-title">Pièces intérieures supplémentaires à couvrir</div>
                <div class="dq-toggle-sub"><span id="tlabel-mouvement">Détecteur mouvement WPS305</span> — <span class="dq-toggle-price" id="tprice-WPS305-int">34,90 €</span> / unité</div>
              </div>
            </div>
