      document.getElementById('res-discount-urgency').innerHTML = '⏰ Ce code est valable 48h — ne passez pas à côté !';
      document.getElementById('res-total-original').textContent = fmtPrice(total);
      document.getElementById('res-total-original').style.display = 'block';
      document.getElementById('res-total').textContent = fmtPrice(discTotal);
      document.getElementById('res-total-saving').textContent = '🎁 Vous économisez ' + fmtPrice(saving) + ' avec ce code';
      document.getElementById('res-total-saving').style.display = 'block';
    } else {
      discBox.style.display = 'none';
      document.getElementById('res-total-original').style.display = 'none';
      document.getElementById('res-total-saving').style.display = 'none';
      document.getElementById('res-total').textContent = fmtPrice(total);
    }
  }

  window.showResult = function() {
    var key = pickAlarm(); var alarm = alarms[key]; var raw = buildAccessories(key);
    document.querySelectorAll('#dq .dq-step').forEach(function(s) { s.classList.remove('active'); });
    document.getElementById('dq-top').style.display = 'none';
    document.getElementById('dq-result').classList.add('active');
    document.getElementById('dq').scrollIntoView({ behavior: 'smooth', block: 'start' });
    var resBody = document.querySelector('#dq-result .dq-result-body');
    resBody.style.opacity = '0.4'; resBody.style.pointerEvents = 'none';
    document.getElementById('res-alarm-name').textContent = alarm.name;
    document.getElementById('res-alarm-desc').textContent = '⏳ Chargement des prix…';
    var uniqueRefs = []; raw.forEach(function(a) { if (a && uniqueRefs.indexOf(a.ref) === -1) uniqueRefs.push(a.ref); });
    var alarmHandle = alarmHandles[key]; var totalToFetch = 1 + uniqueRefs.length; var fetched = 0; var finalAlarmPrice = alarm.price;
    function onAllFetched() {
      fetched++;
      if (fetched < totalToFetch) return;
      resBody.style.opacity = '1'; resBody.style.pointerEvents = '';
      updateTogglePrices(key);
      document.getElementById('res-alarm-name').textContent = alarm.name;
      document.getElementById('res-alarm-desc').textContent = alarm.desc;
      var pcEl = document.getElementById('res-pack-contents'); pcEl.innerHTML = '';
      alarm.packContents.forEach(function(c) { var li = document.createElement('li'); li.textContent = c; pcEl.appendChild(li); });
      selectedVid = alarmVids[key]; addSimCard = false;
      var vsEl = document.getElementById('res-version-selector'); var voEl = document.getElementById('res-version-opts'); voEl.innerHTML = '';
      var versions = [];
      if (key === 'vigilia') {
        var pWifi = finalAlarmPrice; var pGsmLive = priceCache[alarmHandles.vigilia_gsm] || (finalAlarmPrice + 50);
        versions = [{ name: 'Wi-Fi', sub: 'Connexion via votre box — idéal pour la majorité', price: pWifi, vid: alarmVids.vigilia, selected: true, simNote: false }, { name: 'Wi-Fi + GSM 4G', sub: 'Fonctionne même si internet est coupé — nécessite une carte SIM', price: pGsmLive, vid: alarmVidsAlt.vigilia_gsm, selected: false, simNote: true }];
        fetchVariantPrice(alarmVidsAlt.vigilia_gsm, 'starter-pack-vigilia', function(p) { if (p) { versions[1].price = p; var opt = document.getElementById('vopt-1'); if (opt) { var priceEl = opt.querySelector('.dq-version-opt-price'); if (priceEl) priceEl.textContent = fmtPrice(p); } } });
      } else if (key === 'touch') {
        var pTouch = finalAlarmPrice; var pXlLive = priceCache[alarmHandles.touch_xl] || (finalAlarmPrice + 100);
        versions = [{ name: 'Touch AM301 — écran 4,3\'\'', sub: 'Format compact et discret', price: pTouch, vid: alarmVids.touch, selected: true, simNote: false }, { name: 'Touch XL AM302 — écran 7\'\'', sub: 'Grand écran — autonomie batterie 20h', price: pXlLive, vid: alarmVidsAlt.touch_xl, selected: false, simNote: false }];
        fetchVariantPrice(alarmVidsAlt.touch_xl, 'alarme-daewoo-wifi-gsm-4g-starter-pack-am301', function(p) { if (p) { versions[1].price = p; var opt = document.getElementById('vopt-1'); if (opt) { var priceEl = opt.querySelector('.dq-version-opt-price'); if (priceEl) priceEl.textContent = fmtPrice(p); } } });
      }
      if (versions.length) {
        vsEl.style.display = 'block';
        document.getElementById('res-version-title').textContent = key === 'vigilia' ? 'Quelle connexion préférez-vous ?' : 'Quelle taille d\'écran ?';
        versions.forEach(function(v, idx) {
          var d = document.createElement('div'); d.className = 'dq-version-opt' + (v.selected ? ' selected' : ''); d.id = 'vopt-' + idx;
          var simHtml = v.simNote ? '<div style="font-size:11px;color:#b45309;background:#fef3c7;border-radius:5px;padding:4px 8px;margin-top:6px;display:inline-block;">📶 La version GSM nécessite une carte SIM — disponible sur notre site</div>' : '';
          d.innerHTML = '<div class="dq-version-opt-left"><div class="dq-version-opt-name">' + v.name + '</div><div class="dq-version-opt-sub">' + v.sub + '</div>' + simHtml + '</div><div class="dq-version-opt-price">' + fmtPrice(v.price) + '</div>';
          d.onclick = (function(vid, i, hasSimNote, vRef, vName) { return function() {
            selectedVid = vid; voEl.querySelectorAll('.dq-version-opt').forEach(function(el, j) { el.classList.toggle('selected', j === i); }); addSimCard = hasSimNote;
            if (vName && vName.indexOf('AM302') !== -1) { var pcEl2 = document.getElementById('res-pack-contents'); if (pcEl2) { pcEl2.innerHTML = ''; ['1 centrale Touch XL AM302 (sirène & batterie intégrées)', '2 contacteurs de porte WDS301', '1 détecteur de mouvement WPS301', '2 télécommandes WRC301'].forEach(function(c) { var li = document.createElement('li'); li.textContent = c; pcEl2.appendChild(li); }); } }
            else if (vName && vName.indexOf('AM301') !== -1) { var pcEl3 = document.getElementById('res-pack-contents'); if (pcEl3) { pcEl3.innerHTML = ''; alarms.touch.packContents.forEach(function(c) { var li = document.createElement('li'); li.textContent = c; pcEl3.appendChild(li); }); } }
            var totalAcc = currentGrouped.reduce(function(s, a) { return s + a.total; }, 0);
            renderDiscount(versions[vRef].price + totalAcc);
          }; })(v.vid, idx, v.simNote, idx, v.name);
          voEl.appendChild(d);
        });
      } else { vsEl.style.display = 'none'; }
      currentGrouped = groupAcc(raw);
      var accSection = document.getElementById('res-acc-section'); var accList = document.getElementById('res-acc-list'); accList.innerHTML = '';
      if (currentGrouped.length) {
        accSection.style.display = 'block';
        currentGrouped.forEach(function(a) { var div = document.createElement('div'); div.className = 'dq-result-acc-item'; var qtyBadge = a.qty > 1 ? '<span class="dq-qty-badge">×' + a.qty + '</span>' : ''; div.innerHTML = '<div><div class="dq-result-acc-name">' + qtyBadge + a.name + '</div><div class="dq-result-acc-ref">' + a.ref + (a.qty > 1 ? ' · ' + a.qty + ' × ' + fmtPrice(a.price) : '') + '</div></div><div class="dq-result-acc-price">' + fmtPrice(a.total) + '</div>'; accList.appendChild(div); });
      } else { accSection.style.display = 'none'; }
      var totalAcc = currentGrouped.reduce(function(s, a) { return s + a.total; }, 0);
      renderDiscount(finalAlarmPrice + totalAcc);
    }
    fetchPrice(alarmHandle, function(p) { if (p !== null) finalAlarmPrice = p; onAllFetched(); });
    if (uniqueRefs.length === 0) { totalToFetch = 1; }
    else { uniqueRefs.forEach(function(ref) { var handle = accHandles[ref]; if (handle) { fetchPrice(handle, function() { onAllFetched(); }); } else { onAllFetched(); } }); }
  };

  /* ✅ TRACKING QUIZ → SEGMENT SHOPIFY */
  function tagCartWithQuizSource(callback) {
    fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ attributes: { 'Source': 'quiz-alarme' } }) })
    .then(function() { callback(); }).catch(function() { callback(); });
  }

  window.addAllToCart = function() {
    var btn = document.getElementById('res-btn-cart');
    var vid = selectedVid || alarmVids[pickAlarm()];
    var items = [];
    if (vid) items.push({ id: vid, qty: 1 });
    if (addSimCard && simCardVid) items.push({ id: simCardVid, qty: 1 });
    currentGrouped.forEach(function(a) { if (a.vid) items.push({ id: a.vid, qty: a.qty }); });
    if (items.length === 0) { alert('Aucun produit à ajouter.'); return; }
    btn.disabled = true; btn.textContent = '⏳ Ajout en cours…';
    tagCartWithQuizSource(function() {
      function addNext(index) {
        if (index >= items.length) { window.location.href = '/cart'; return; }
        var item = items[index];
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + item.id + '&quantity=' + item.qty })
        .then(function(r) { if (r.ok) { addNext(index + 1); } else { return r.json().then(function(err) { console.error('Erreur item ' + item.id + ' :', err); addNext(index + 1); }); } })
        .catch(function() { addNext(index + 1); });
      }
      addNext(0);
    });
  };

  window.restart = function() {
    A = { logement: null, tech: null, portes: false, portesQty: 1, baies: false, baiesQty: 1, garage: false, garageQty: 1, jardin: false, jardinType: null, jardinQty: 1, alleeQty: 1, jardinExtQty: 1, jardin_allee: false, jardin_jardin: false, mouvement: false, mouvementQty: 1, camInt: false, camIntQty: 1, camExtFixe: false, camExtFixeQty: 1, camExt360: false, camExt360Qty: 1, camExtFilaire: false, camExtFilaireQty: 1, sirene: false, sireneType: 'solaire', sireneQty: 1, fumee: false, fumeeQty: 1, eau: false, eauQty: 1, domestique: false, canon: false, canonQty: 1, telecommande: false, telecommandeQty: 1, clavier: false, clavierQty: 1, badge: false, badgeQty: 1 };
    noneState = { 3: false, 4: false, 5: false, 6: false, 7: false };
    selectedVid = null; currentGrouped = []; addSimCard = false;
    document.querySelectorAll('#dq .dq-opt').forEach(function(o) { o.classList.remove('selected'); });
    document.querySelectorAll('#dq .dq-toggle').forEach(function(t) { t.classList.remove('selected'); });
    document.querySelectorAll('#dq .dq-counter-row').forEach(function(c) { c.classList.remove('visible'); });
    document.querySelectorAll('#dq .dq-none-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('#dq .dq-count').forEach(function(c) { c.textContent = '1'; });
    ['sub-jardin','sub-sirene','sub-domestique'].forEach(function(id) { var el = document.getElementById(id); if (el) el.style.display = 'none'; });
    ['allee', 'jardin-sub'].forEach(function(t) { var chk = document.getElementById('chk-' + t); var opt = document.getElementById('sub-' + (t === 'allee' ? 'allee' : 'jardin') + '-opt'); var ctr = document.getElementById(t === 'allee' ? 'ctr-allee' : 'ctr-jardin-ext'); if (chk) { chk.style.background = 'white'; chk.style.borderColor = '#cbd5e1'; chk.textContent = ''; } if (opt) { opt.style.borderColor = '#e8edf5'; opt.style.background = 'white'; } if (ctr) ctr.classList.remove('visible'); });
    resetDomestiqueUI(); selectSireneType('solaire');
    [1,2,3,4,5,6,7].forEach(function(n) { var b = document.getElementById('next-' + n); if (b) b.disabled = true; });
    document.getElementById('dq-result').classList.remove('active');
    document.getElementById('dq-top').style.display = 'flex';
    document.getElementById('res-btn-cart').disabled = false;
    document.getElementById('res-btn-cart').textContent = 'Ajouter ma sélection au panier →';
    goTo(1);
  };

})();
</script>

