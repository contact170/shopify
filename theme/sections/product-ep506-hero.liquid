{%- doc -%}
  Hero half of the bespoke EP506 product page (wired outdoor/indoor PTZ
  camera). Split from product-ep506-body.liquid so the Moast video reels can
  sit as their own "apps" section between hero and body — same pattern as
  the IP506P page, see that section's doc comment for why.

  Shares fixed element ids (EP506Form, EP506HeroCta, EP506Sticky) with
  product-ep506-body.liquid — both are only ever used once, together, on
  this one product template, so hardcoded ids are safe.
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'EP506Form'

  assign gallery = product.images
  assign hero_image = gallery[0] | default: product.featured_image

  assign has_compare = false
  if variant.compare_at_price > variant.price
    assign has_compare = true
  endif
-%}

<div class="ep506">
  <style>
    .ep506{
      --ep506-navy:#0c1e4a;
      --ep506-navy-dark:#081430;
      --ep506-ink:#1d1d1f;
      --ep506-gray:#6e6e73;
      --ep506-bg-alt:#f5f5f7;
      --ep506-line:#d2d2d7;
      --ep506-success:#037e05;
      --ep506-gold:#fde68a;
      font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      color:var(--ep506-ink);
      background:#fff;
      overflow-x:hidden;
    }
    .ep506 *{box-sizing:border-box;}
    .ep506 :where(h1,h2,h3,p){margin:0;}
    .ep506 .ep506-wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
    .ep506 img{max-width:100%;display:block;}
    .ep506 h1,.ep506 h2,.ep506 h3{font-weight:600;letter-spacing:-.02em;line-height:1.08;}

    /* ---- sticky bar ---- */
    .ep506-sticky{
      position:fixed;left:0;right:0;bottom:0;z-index:60;
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:12px 20px;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
      border-top:1px solid var(--ep506-line);
      transform:translateY(110%);transition:transform .35s ease;
    }
    .ep506-sticky.is-shown{transform:translateY(0);}
    .ep506-sticky__info{display:flex;align-items:center;gap:12px;min-width:0;}
    .ep506-sticky__thumb{width:40px;height:40px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--ep506-bg-alt);}
    .ep506-sticky__thumb img{width:100%;height:100%;object-fit:cover;}
    .ep506-sticky__name{font-size:13px;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:50vw;}

    /* ---- section rhythm ---- */
    .ep506-section{padding:72px 0;}
    .ep506-section--alt{background:var(--ep506-bg-alt);}
    .ep506-eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
      color:var(--ep506-navy);margin-bottom:18px;
    }
    .ep506-eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ep506-success);}

    /* ---- hero ---- */
    .ep506-hero{padding:96px 0 56px;text-align:center;}
    .ep506-hero h1{font-size:clamp(32px,5.6vw,58px);max-width:880px;margin:0 auto;}
    .ep506-hero__sub{
      font-size:clamp(17px,2.2vw,21px);color:var(--ep506-gray);
      max-width:660px;margin:22px auto 0;line-height:1.5;font-weight:400;text-align:center;
    }
    .ep506-hero__cta{margin-top:36px;display:flex;flex-direction:column;align-items:center;gap:12px;}
    .ep506-hero__price{font-size:15px;color:var(--ep506-gray);}
    .ep506-hero__price strong{color:var(--ep506-ink);font-size:17px;}
    .ep506-hero__compare{text-decoration:line-through;color:var(--ep506-gray);margin-right:6px;}
    .ep506-hero__rating{margin-top:2px;}
    .ep506-hero__rating .product__rating{justify-content:center;}
    .ep506-hero__trust{
      margin-top:30px;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;
      font-size:13px;color:var(--ep506-gray);
    }
    .ep506-hero__trust span{display:inline-flex;align-items:center;gap:6px;}
    .ep506-hero__media{margin-top:56px;}
    .ep506-hero__media img{width:100%;max-width:820px;margin:0 auto;border-radius:28px;background:var(--ep506-bg-alt);}

    /* ---- buttons ---- */
    .ep506-btn{
      position:relative;overflow:hidden;isolation:isolate;
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      border:none;border-radius:999px;cursor:pointer;
      font-family:inherit;font-size:16px;font-weight:600;
      padding:15px 30px;min-width:230px;
      transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease;
    }
    .ep506-btn:active{transform:scale(.98);}
    .ep506-btn[disabled]{opacity:.5;cursor:not-allowed;}
    .ep506-btn--primary{background:var(--ep506-navy);color:#fff;box-shadow:0 8px 20px -8px rgba(12,30,74,.55);}
    .ep506-btn--primary .btn-fill{background:var(--ep506-navy-dark);}
    .ep506-btn .btn-fill{position:absolute;inset:0;z-index:-1;transform:translateY(100%);}
    .ep506-btn__text{position:relative;display:inline-flex;align-items:center;gap:10px;}

    /* ---- trust strip ---- */
    .ep506-strip{
      display:flex;flex-wrap:wrap;justify-content:center;gap:14px;
      padding:28px 0;border-top:1px solid var(--ep506-line);border-bottom:1px solid var(--ep506-line);
    }
    .ep506-strip__item{
      display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;
      padding:10px 18px;border-radius:999px;background:var(--ep506-bg-alt);
    }
    .ep506-strip__item svg{color:var(--ep506-navy);flex-shrink:0;}
    .ep506-strip__item--highlight{background:var(--ep506-navy);color:#fff;}
    .ep506-strip__item--highlight svg{color:#fff;}

    /* ---- features ---- */
    .ep506-feature{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;padding:64px 0;}
    .ep506-feature__media img{border-radius:24px;background:var(--ep506-bg-alt);}
    .ep506-feature__num{font-size:13px;font-weight:700;color:var(--ep506-navy);letter-spacing:.08em;margin-bottom:14px;display:block;}
    .ep506-feature h2{font-size:clamp(26px,3.4vw,38px);}
    .ep506-feature__text{margin-top:18px;color:var(--ep506-gray);font-size:17px;line-height:1.6;max-width:480px;}
    .ep506-feature ul{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:12px;max-width:480px;}
    .ep506-feature ul li{display:flex;gap:10px;font-size:15px;line-height:1.5;color:var(--ep506-ink);}
    .ep506-feature ul li svg{flex-shrink:0;margin-top:3px;color:var(--ep506-success);}
    @media (min-width:900px){
      .ep506-feature{grid-template-columns:1fr 1fr;gap:72px;}
      .ep506-feature--reverse .ep506-feature__media{order:2;}
      .ep506-feature--reverse .ep506-feature__body{order:1;}
    }

    /* ---- highlight band (wired power / alarm compat) ---- */
    .ep506-band-hl{
      background:var(--ep506-navy);border-radius:28px;padding:56px 40px;color:#fff;
      display:grid;gap:44px;grid-template-columns:1fr;align-items:center;
    }
    @media (min-width:860px){.ep506-band-hl{grid-template-columns:1fr 1.1fr;padding:64px 56px;}}
    .ep506-band-hl__eyebrow{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ep506-gold);margin-bottom:14px;}
    .ep506-band-hl h2{color:#fff;font-size:clamp(26px,3.4vw,40px);}
    .ep506-band-hl p{color:rgba(255,255,255,.78);margin-top:14px;font-size:16px;line-height:1.6;max-width:480px;}
    .ep506-band-hl ul{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:14px;}
    .ep506-band-hl ul li{display:flex;gap:12px;font-size:15px;line-height:1.4;color:#fff;background:rgba(255,255,255,.08);padding:14px 16px;border-radius:14px;}
    .ep506-band-hl ul li svg{flex-shrink:0;margin-top:2px;color:var(--ep506-gold);}

    /* ---- wired power animation ---- */
    .ep506-plug-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;}
    .ep506-plug{
      position:relative;width:180px;height:180px;border-radius:50%;
      background:radial-gradient(circle at 32% 30%,#24356f,#0a1836 78%);
      box-shadow:0 0 0 8px rgba(255,255,255,.06),0 20px 50px -20px rgba(0,0,0,.6);
      display:flex;align-items:center;justify-content:center;flex-shrink:0;
    }
    .ep506-plug svg{position:relative;z-index:1;}
    .ep506-plug__pulse{
      position:absolute;inset:20px;border-radius:50%;
      border:2px solid var(--ep506-gold);opacity:0;
      animation:ep506-pulse 2.2s ease-out infinite;
    }
    .ep506-plug__pulse--delay{animation-delay:1.1s;}
    @keyframes ep506-pulse{
      0%{transform:scale(.7);opacity:.7;}
      100%{transform:scale(1.35);opacity:0;}
    }
    .ep506-plug__status{font-size:13px;font-weight:600;letter-spacing:.02em;color:rgba(255,255,255,.85);display:flex;align-items:center;gap:8px;}
    .ep506-plug__status::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--ep506-success);}
    @media (prefers-reduced-motion:reduce){
      .ep506-plug__pulse{animation:none;opacity:0;}
    }

    /* ---- PoE explainer ---- */
    .ep506-poe__head{text-align:center;max-width:680px;margin:0 auto 48px;}
    .ep506-poe__head h2{font-size:clamp(26px,3.4vw,38px);}
    .ep506-poe__head p{margin-top:14px;color:var(--ep506-gray);font-size:17px;line-height:1.6;}
    .ep506-poe__steps{display:grid;grid-template-columns:1fr;gap:18px;max-width:920px;margin:0 auto;}
    @media (min-width:760px){.ep506-poe__steps{grid-template-columns:1fr 1fr 1fr;}}
    .ep506-poe__step{border:1px solid var(--ep506-line);border-radius:20px;padding:28px 24px;text-align:center;background:#fff;}
    .ep506-poe__step svg{color:var(--ep506-navy);margin:0 auto 16px;display:block;}
    .ep506-poe__step h3{font-size:16px;font-weight:600;margin-bottom:8px;}
    .ep506-poe__step p{font-size:14px;color:var(--ep506-gray);line-height:1.5;}
    .ep506-poe__note{
      max-width:760px;margin:36px auto 0;padding:18px 22px;border-radius:16px;
      background:var(--ep506-bg-alt);font-size:14px;color:var(--ep506-ink);line-height:1.6;text-align:center;
    }
    .ep506-poe__note strong{color:var(--ep506-navy);}

    /* ---- mid CTA band ---- */
    .ep506-band{background:var(--ep506-navy);color:#fff;border-radius:28px;padding:56px 32px;text-align:center;margin:24px 0;}
    .ep506-band h2{color:#fff;font-size:clamp(24px,3vw,34px);max-width:620px;margin:0 auto;}
    .ep506-band p{color:rgba(255,255,255,.72);margin-top:14px;font-size:16px;max-width:520px;margin-left:auto;margin-right:auto;}
    .ep506-band .ep506-btn{margin-top:26px;background:#fff;color:var(--ep506-navy);}
    .ep506-band .ep506-btn .btn-fill{background:#e9e9ee;}

    /* ---- specs ---- */
    .ep506-specs__head{text-align:center;max-width:640px;margin:0 auto 48px;}
    .ep506-specs__head h2{font-size:clamp(26px,3.4vw,38px);}
    .ep506-specs__head p{margin-top:14px;color:var(--ep506-gray);font-size:17px;}
    .ep506-specs__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--ep506-line);border:1px solid var(--ep506-line);border-radius:20px;overflow:hidden;}
    .ep506-specs__item{background:#fff;padding:24px 28px;}
    .ep506-specs__item dt{font-size:13px;font-weight:700;color:var(--ep506-navy);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;}
    .ep506-specs__item dd{margin:0;font-size:15px;color:var(--ep506-ink);line-height:1.5;}
    @media (min-width:700px){.ep506-specs__grid{grid-template-columns:1fr 1fr;}}
    @media (min-width:1000px){.ep506-specs__grid{grid-template-columns:1fr 1fr 1fr;}}

    /* ---- guarantee band ---- */
    .ep506-guarantee{display:grid;grid-template-columns:1fr;gap:28px;text-align:center;}
    @media (min-width:700px){.ep506-guarantee{grid-template-columns:repeat(4,1fr);}}
    .ep506-guarantee__item{padding:0 12px;}
    .ep506-guarantee__item svg{color:var(--ep506-navy);margin:0 auto 14px;display:block;}
    .ep506-guarantee__item h3{font-size:16px;font-weight:600;}
    .ep506-guarantee__item p{margin-top:8px;font-size:14px;color:var(--ep506-gray);line-height:1.5;}

    /* ---- faq ---- */
    .ep506-faq{max-width:760px;margin:0 auto;}
    .ep506-faq h2{text-align:center;font-size:clamp(26px,3.4vw,38px);margin-bottom:40px;}
    .ep506-faq details{border-bottom:1px solid var(--ep506-line);padding:20px 0;}
    .ep506-faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:17px;font-weight:500;}
    .ep506-faq summary::-webkit-details-marker{display:none;}
    .ep506-faq summary .ep506-faq__icon{flex-shrink:0;transition:transform .25s ease;color:var(--ep506-navy);}
    .ep506-faq details[open] summary .ep506-faq__icon{transform:rotate(45deg);}
    .ep506-faq__a{margin-top:14px;color:var(--ep506-gray);font-size:15px;line-height:1.6;max-width:660px;}

    /* ---- final cta ---- */
    .ep506-final{text-align:center;}
    .ep506-final h2{font-size:clamp(28px,4vw,44px);max-width:700px;margin:0 auto;}
    .ep506-final p{margin-top:16px;color:var(--ep506-gray);font-size:17px;}
    .ep506-final__ctas{margin-top:32px;display:flex;flex-wrap:wrap;gap:14px;justify-content:center;}
    .ep506-final__legal{margin-top:22px;font-size:13px;color:var(--ep506-gray);}

    /* ---- reveal-on-scroll ---- */
    .ep506-reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
    .ep506-reveal.is-visible{opacity:1;transform:none;}
    @media (prefers-reduced-motion:reduce){
      .ep506-reveal{opacity:1;transform:none;transition:none;}
      .ep506-sticky{transition:none;}
    }
  </style>

  {%- comment -%} Hidden product form shared by every "Add to cart" button on this page (hero + body) {%- endcomment -%}
  {%- form 'product', product, id: form_id, data-type: 'add-to-cart-form', is: 'product-form', class: 'ep506-visually-hidden' -%}
    <input type="hidden" name="id" value="{{ variant.id }}" disabled>
    <input type="hidden" name="quantity" value="1">
    <button type="submit" name="add" tabindex="-1" aria-hidden="true"></button>
    <div class="product-form__error-message alert alert--error" role="alert" hidden style="position:fixed;left:16px;right:16px;bottom:84px;z-index:70;background:#fff;border:1px solid #e11d48;color:#e11d48;padding:12px 16px;border-radius:12px;font-size:14px;"></div>
  {%- endform -%}
  <style>.ep506-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}</style>

  {%- comment -%} Sticky add-to-cart bar {%- endcomment -%}
  <div class="ep506-sticky" id="EP506Sticky">
    <div class="ep506-sticky__info">
      <div class="ep506-sticky__thumb">
        {%- if hero_image -%}
          {{ hero_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '80,160' }}
        {%- endif -%}
      </div>
      <div class="ep506-sticky__name">{{ product.title }}</div>
    </div>
    {%- render 'ep506-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
  </div>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="ep506-hero">
    <div class="ep506-wrap">
      <span class="ep506-eyebrow">Daewoo Security · EP506</span>
      <h1>Toujours alimentée.<br>Toujours connectée.</h1>
      <p class="ep506-hero__sub">
        Caméra rotative <strong>100&nbsp;% filaire</strong> 4MP&nbsp;: pas de batterie à recharger,
        pas de coupure de signal. Alimentation secteur ou <strong>PoE</strong> au choix, pour une
        surveillance qui ne faiblit jamais.
      </p>
      <div class="ep506-hero__cta">
        <div id="EP506HeroCta">
          {%- render 'ep506-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
        </div>
        <div class="ep506-hero__price">
          {%- if has_compare -%}
            <span class="ep506-hero__compare">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
          <strong>{{ variant.price | money }}</strong> · paiement sécurisé
        </div>
        <div class="ep506-hero__rating">
          {%- render 'product-rating', product: product -%}
        </div>
      </div>
      <div class="ep506-hero__trust">
        <span>🔌 100% filaire</span>
        <span>🌐 Compatible PoE</span>
        <span>🎥 4MP</span>
        <span>🔄 Rotation 355°/90°</span>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <script>
    (function () {
      /* Sticky add-to-cart bar: show once the hero CTA has scrolled out of view */
      var heroCta = document.getElementById('EP506HeroCta');
      var stickyBar = document.getElementById('EP506Sticky');
      if (heroCta && stickyBar && 'IntersectionObserver' in window) {
        var stickyIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            stickyBar.classList.toggle('is-shown', !entry.isIntersecting);
          });
        }, { threshold: 0, rootMargin: '-64px 0px 0px 0px' });
        stickyIo.observe(heroCta);
      }
    })();
  </script>
</div>

{% schema %}
{
  "name": "EP506 – Hero",
  "settings": []
}
{% endschema %}
