{%- doc -%}
  Hero half of the bespoke IP506P product page. Split from the rest of the
  page (product-ip506p-body) so the Moast video reels can be inserted as
  their own "apps" section between the two — app blocks aren't accepted
  inside a hand-written custom section here, so this is the reliable way
  to put the video reels above the product photo.

  Shares fixed element ids (IP506Form, IP506HeroCta, IP506Sticky) with
  product-ip506p-body.liquid — both are only ever used once, together, on
  this one product template, so hardcoded ids are safe and let the two
  sections coordinate (shared form, sticky-bar visibility).
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'IP506Form'

  assign gallery = product.images
  assign hero_image = gallery[0] | default: product.featured_image

  assign has_compare = false
  if variant.compare_at_price > variant.price
    assign has_compare = true
  endif
-%}

<div class="ip506">
  <style>
    .ip506{
      --ip506-navy:#0c1e4a;
      --ip506-navy-dark:#081430;
      --ip506-ink:#1d1d1f;
      --ip506-gray:#6e6e73;
      --ip506-bg-alt:#f5f5f7;
      --ip506-line:#d2d2d7;
      --ip506-success:#037e05;
      --ip506-gold:#fde68a;
      font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      color:var(--ip506-ink);
      background:#fff;
      overflow-x:hidden;
    }
    .ip506 *{box-sizing:border-box;}
    .ip506 :where(h1,h2,h3,p){margin:0;}
    .ip506 .ip506-wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
    .ip506 img{max-width:100%;display:block;}
    .ip506 h1,.ip506 h2,.ip506 h3{font-weight:600;letter-spacing:-.02em;line-height:1.08;}

    /* ---- sticky bar ---- */
    .ip506-sticky{
      position:fixed;left:0;right:0;bottom:0;z-index:60;
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:12px 20px;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
      border-top:1px solid var(--ip506-line);
      transform:translateY(110%);transition:transform .35s ease;
    }
    .ip506-sticky.is-shown{transform:translateY(0);}
    .ip506-sticky__info{display:flex;align-items:center;gap:12px;min-width:0;}
    .ip506-sticky__thumb{width:40px;height:40px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--ip506-bg-alt);}
    .ip506-sticky__thumb img{width:100%;height:100%;object-fit:cover;}
    .ip506-sticky__name{font-size:13px;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:50vw;}

    /* ---- section rhythm ---- */
    .ip506-section{padding:72px 0;}
    .ip506-section--alt{background:var(--ip506-bg-alt);}
    .ip506-eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
      color:var(--ip506-navy);margin-bottom:18px;
    }
    .ip506-eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ip506-success);}

    /* ---- hero ---- */
    .ip506-hero{padding:96px 0 56px;text-align:center;}
    .ip506-hero h1{font-size:clamp(32px,5.6vw,58px);max-width:880px;margin:0 auto;}
    .ip506-hero__sub{
      font-size:clamp(17px,2.2vw,21px);color:var(--ip506-gray);
      max-width:660px;margin:22px auto 0;line-height:1.5;font-weight:400;text-align:center;
    }
    .ip506-hero__cta{margin-top:36px;display:flex;flex-direction:column;align-items:center;gap:12px;}
    .ip506-hero__price{font-size:15px;color:var(--ip506-gray);}
    .ip506-hero__price strong{color:var(--ip506-ink);font-size:17px;}
    .ip506-hero__compare{text-decoration:line-through;color:var(--ip506-gray);margin-right:6px;}
    .ip506-hero__rating{margin-top:2px;}
    .ip506-hero__rating .product__rating{justify-content:center;}
    .ip506-hero__trust{
      margin-top:30px;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;
      font-size:13px;color:var(--ip506-gray);
    }
    .ip506-hero__trust span{display:inline-flex;align-items:center;gap:6px;}
    .ip506-hero__media{margin-top:56px;}
    .ip506-hero__media img{width:100%;max-width:820px;margin:0 auto;border-radius:28px;background:var(--ip506-bg-alt);}

    /* ---- buttons ---- */
    .ip506-btn{
      position:relative;overflow:hidden;isolation:isolate;
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      border:none;border-radius:999px;cursor:pointer;
      font-family:inherit;font-size:16px;font-weight:600;
      padding:15px 30px;min-width:230px;
      transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease;
    }
    .ip506-btn:active{transform:scale(.98);}
    .ip506-btn[disabled]{opacity:.5;cursor:not-allowed;}
    .ip506-btn--primary{background:var(--ip506-navy);color:#fff;box-shadow:0 8px 20px -8px rgba(12,30,74,.55);}
    .ip506-btn--primary .btn-fill{background:var(--ip506-navy-dark);}
    .ip506-btn .btn-fill{position:absolute;inset:0;z-index:-1;transform:translateY(100%);}
    .ip506-btn__text{position:relative;display:inline-flex;align-items:center;gap:10px;}

    /* ---- trust strip ---- */
    .ip506-strip{
      display:flex;flex-wrap:wrap;justify-content:center;gap:14px;
      padding:28px 0;border-top:1px solid var(--ip506-line);border-bottom:1px solid var(--ip506-line);
    }
    .ip506-strip__item{
      display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;
      padding:10px 18px;border-radius:999px;background:var(--ip506-bg-alt);
    }
    .ip506-strip__item svg{color:var(--ip506-navy);flex-shrink:0;}
    .ip506-strip__item--highlight{background:var(--ip506-navy);color:#fff;}
    .ip506-strip__item--highlight svg{color:#fff;}

    /* ---- features ---- */
    .ip506-feature{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;padding:64px 0;}
    .ip506-feature__media img{border-radius:24px;background:var(--ip506-bg-alt);}
    .ip506-feature__num{font-size:13px;font-weight:700;color:var(--ip506-navy);letter-spacing:.08em;margin-bottom:14px;display:block;}
    .ip506-feature h2{font-size:clamp(26px,3.4vw,38px);}
    .ip506-feature__text{margin-top:18px;color:var(--ip506-gray);font-size:17px;line-height:1.6;max-width:480px;}
    .ip506-feature ul{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:12px;max-width:480px;}
    .ip506-feature ul li{display:flex;gap:10px;font-size:15px;line-height:1.5;color:var(--ip506-ink);}
    .ip506-feature ul li svg{flex-shrink:0;margin-top:3px;color:var(--ip506-success);}
    @media (min-width:900px){
      .ip506-feature{grid-template-columns:1fr 1fr;gap:72px;}
      .ip506-feature--reverse .ip506-feature__media{order:2;}
      .ip506-feature--reverse .ip506-feature__body{order:1;}
    }

    /* ---- privacy band (the star feature) ---- */
    .ip506-privacy{
      background:var(--ip506-navy);border-radius:28px;padding:56px 40px;color:#fff;
      display:grid;gap:44px;grid-template-columns:1fr;align-items:center;
    }
    @media (min-width:860px){.ip506-privacy{grid-template-columns:1fr 1.1fr;padding:64px 56px;}}
    .ip506-privacy__eyebrow{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ip506-gold);margin-bottom:14px;}
    .ip506-privacy h2{color:#fff;font-size:clamp(26px,3.4vw,40px);}
    .ip506-privacy p{color:rgba(255,255,255,.78);margin-top:14px;font-size:16px;line-height:1.6;max-width:480px;}
    .ip506-privacy ul{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:14px;}
    .ip506-privacy ul li{display:flex;gap:12px;font-size:15px;line-height:1.4;color:#fff;background:rgba(255,255,255,.08);padding:14px 16px;border-radius:14px;}
    .ip506-privacy ul li svg{flex-shrink:0;margin-top:2px;color:var(--ip506-gold);}

    /* ---- privacy shutter animation ---- */
    .ip506-shutter-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;}
    .ip506-shutter{
      position:relative;width:180px;height:180px;border-radius:50%;
      background:radial-gradient(circle at 32% 30%,#24356f,#0a1836 78%);
      box-shadow:0 0 0 8px rgba(255,255,255,.06),0 20px 50px -20px rgba(0,0,0,.6);
      overflow:hidden;flex-shrink:0;
    }
    .ip506-shutter__lens{
      position:absolute;inset:20px;border-radius:50%;
      background:radial-gradient(circle at 38% 35%,#bfe4ff 0%,#4f8fe0 45%,#123073 85%);
      animation:ip506-lens-glow 4.5s ease-in-out infinite;
    }
    .ip506-shutter__lid{
      position:absolute;left:-4px;right:-4px;height:54%;background:var(--ip506-navy-dark);
      box-shadow:0 0 0 4px var(--ip506-navy-dark);
    }
    .ip506-shutter__lid--top{top:-4px;border-radius:0 0 6px 6px;transform-origin:top;animation:ip506-lid-top 4.5s ease-in-out infinite;}
    .ip506-shutter__lid--bottom{bottom:-4px;border-radius:6px 6px 0 0;transform-origin:bottom;animation:ip506-lid-bottom 4.5s ease-in-out infinite;}
    .ip506-shutter__status{font-size:13px;font-weight:600;letter-spacing:.02em;color:rgba(255,255,255,.85);display:flex;align-items:center;gap:8px;}
    .ip506-shutter__status::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--ip506-success);animation:ip506-status-dot 4.5s ease-in-out infinite;}

    @keyframes ip506-lid-top{
      0%,38%{transform:scaleY(0);}
      50%,88%{transform:scaleY(1);}
      100%{transform:scaleY(0);}
    }
    @keyframes ip506-lid-bottom{
      0%,38%{transform:scaleY(0);}
      50%,88%{transform:scaleY(1);}
      100%{transform:scaleY(0);}
    }
    @keyframes ip506-lens-glow{
      0%,38%{opacity:1;}
      50%,88%{opacity:0;}
      100%{opacity:1;}
    }
    @keyframes ip506-status-dot{
      0%,38%{background:var(--ip506-success);}
      50%,88%{background:#e11d48;}
      100%{background:var(--ip506-success);}
    }
    @media (prefers-reduced-motion:reduce){
      .ip506-shutter__lid,.ip506-shutter__lens,.ip506-shutter__status::before{animation:none;}
      .ip506-shutter__lid{transform:scaleY(0);}
    }

    /* ---- mid CTA band ---- */
    .ip506-band{background:var(--ip506-navy);color:#fff;border-radius:28px;padding:56px 32px;text-align:center;margin:24px 0;}
    .ip506-band h2{color:#fff;font-size:clamp(24px,3vw,34px);max-width:620px;margin:0 auto;}
    .ip506-band p{color:rgba(255,255,255,.72);margin-top:14px;font-size:16px;max-width:520px;margin-left:auto;margin-right:auto;}
    .ip506-band .ip506-btn{margin-top:26px;background:#fff;color:var(--ip506-navy);}
    .ip506-band .ip506-btn .btn-fill{background:#e9e9ee;}

    /* ---- specs ---- */
    .ip506-specs__head{text-align:center;max-width:640px;margin:0 auto 48px;}
    .ip506-specs__head h2{font-size:clamp(26px,3.4vw,38px);}
    .ip506-specs__head p{margin-top:14px;color:var(--ip506-gray);font-size:17px;}
    .ip506-specs__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--ip506-line);border:1px solid var(--ip506-line);border-radius:20px;overflow:hidden;}
    .ip506-specs__item{background:#fff;padding:24px 28px;}
    .ip506-specs__item dt{font-size:13px;font-weight:700;color:var(--ip506-navy);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;}
    .ip506-specs__item dd{margin:0;font-size:15px;color:var(--ip506-ink);line-height:1.5;}
    @media (min-width:700px){.ip506-specs__grid{grid-template-columns:1fr 1fr;}}
    @media (min-width:1000px){.ip506-specs__grid{grid-template-columns:1fr 1fr 1fr;}}

    /* ---- guarantee band ---- */
    .ip506-guarantee{display:grid;grid-template-columns:1fr;gap:28px;text-align:center;}
    @media (min-width:700px){.ip506-guarantee{grid-template-columns:repeat(4,1fr);}}
    .ip506-guarantee__item{padding:0 12px;}
    .ip506-guarantee__item svg{color:var(--ip506-navy);margin:0 auto 14px;display:block;}
    .ip506-guarantee__item h3{font-size:16px;font-weight:600;}
    .ip506-guarantee__item p{margin-top:8px;font-size:14px;color:var(--ip506-gray);line-height:1.5;}

    /* ---- faq ---- */
    .ip506-faq{max-width:760px;margin:0 auto;}
    .ip506-faq h2{text-align:center;font-size:clamp(26px,3.4vw,38px);margin-bottom:40px;}
    .ip506-faq details{border-bottom:1px solid var(--ip506-line);padding:20px 0;}
    .ip506-faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:17px;font-weight:500;}
    .ip506-faq summary::-webkit-details-marker{display:none;}
    .ip506-faq summary .ip506-faq__icon{flex-shrink:0;transition:transform .25s ease;color:var(--ip506-navy);}
    .ip506-faq details[open] summary .ip506-faq__icon{transform:rotate(45deg);}
    .ip506-faq__a{margin-top:14px;color:var(--ip506-gray);font-size:15px;line-height:1.6;max-width:660px;}

    /* ---- final cta ---- */
    .ip506-final{text-align:center;}
    .ip506-final h2{font-size:clamp(28px,4vw,44px);max-width:700px;margin:0 auto;}
    .ip506-final p{margin-top:16px;color:var(--ip506-gray);font-size:17px;}
    .ip506-final__ctas{margin-top:32px;display:flex;flex-wrap:wrap;gap:14px;justify-content:center;}
    .ip506-final__legal{margin-top:22px;font-size:13px;color:var(--ip506-gray);}

    /* ---- reveal-on-scroll ---- */
    .ip506-reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
    .ip506-reveal.is-visible{opacity:1;transform:none;}
    @media (prefers-reduced-motion:reduce){
      .ip506-reveal{opacity:1;transform:none;transition:none;}
      .ip506-sticky{transition:none;}
    }
  </style>

  {%- comment -%} Hidden product form shared by every "Add to cart" button on this page (hero + body) {%- endcomment -%}
  {%- form 'product', product, id: form_id, data-type: 'add-to-cart-form', is: 'product-form', class: 'ip506-visually-hidden' -%}
    <input type="hidden" name="id" value="{{ variant.id }}" disabled>
    <input type="hidden" name="quantity" value="1">
    <button type="submit" name="add" tabindex="-1" aria-hidden="true"></button>
    <div class="product-form__error-message alert alert--error" role="alert" hidden style="position:fixed;left:16px;right:16px;bottom:84px;z-index:70;background:#fff;border:1px solid #e11d48;color:#e11d48;padding:12px 16px;border-radius:12px;font-size:14px;"></div>
  {%- endform -%}
  <style>.ip506-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}</style>

  {%- comment -%} Sticky add-to-cart bar {%- endcomment -%}
  <div class="ip506-sticky" id="IP506Sticky">
    <div class="ip506-sticky__info">
      <div class="ip506-sticky__thumb">
        {%- if hero_image -%}
          {{ hero_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '80,160' }}
        {%- endif -%}
      </div>
      <div class="ip506-sticky__name">{{ product.title }}</div>
    </div>
    {%- render 'ip506p-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
  </div>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="ip506-hero">
    <div class="ip506-wrap">
      <span class="ip506-eyebrow">Daewoo Security · IP506P</span>
      <h1>Elle surveille.<br>Sauf quand vous êtes là.</h1>
      <p class="ip506-hero__sub">
        Caméra intérieure Wi-Fi Full HD avec Mode Vie Privée&nbsp;: elle se replie
        mécaniquement pour couper la vidéo dès que vous êtes chez vous. Installation
        en 2 minutes, sans abonnement.
      </p>
      <div class="ip506-hero__cta">
        <div id="IP506HeroCta">
          {%- render 'ip506p-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
        </div>
        <div class="ip506-hero__price">
          {%- if has_compare -%}
            <span class="ip506-hero__compare">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
          <strong>{{ variant.price | money }}</strong> · paiement sécurisé
        </div>
        <div class="ip506-hero__rating">
          {%- render 'product-rating', product: product -%}
        </div>
      </div>
      <div class="ip506-hero__trust">
        <span>🔒 Mode Vie Privée mécanique</span>
        <span>🎥 Full HD 1080p</span>
        <span>🔄 Rotation 355°/160°</span>
        <span>🚫 Sans abonnement</span>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <script>
    (function () {
      /* Sticky add-to-cart bar: show once the hero CTA has scrolled out of view */
      var heroCta = document.getElementById('IP506HeroCta');
      var stickyBar = document.getElementById('IP506Sticky');
      if (heroCta && stickyBar && 'IntersectionObserver' in window) {
        var stickyIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            stickyBar.classList.toggle('is-shown', !entry.isIntersecting);
          });
        }, { threshold: 0, rootMargin: '-64px 0px 0px 0px' });
        stickyIo.observe(heroCta);
      }
    })();
  </script>
</div>

{% schema %}
{
  "name": "IP506P – Hero",
  "settings": []
}
{% endschema %}
