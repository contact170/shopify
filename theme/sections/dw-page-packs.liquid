  {%- endif -%}

  {%- comment -%} ===================== PACKS ÉLITE ===================== {%- endcomment -%}
  {%- if nb_elite > 0 or request.design_mode -%}
  <section class="dpk-elite" id="packs-elite" aria-labelledby="dpk-elite-h-{{ sid }}">
    <div class="dpk-wrap">
      <div class="dpk-head">
        <span class="dpk-eyebrow">{{ section.settings.elite_eyebrow }}</span>
        <h2 class="dpk-h2" id="dpk-elite-h-{{ sid }}">{{ section.settings.elite_title }}</h2>
        {%- if section.settings.elite_text != blank -%}<p class="dpk-lead">{{ section.settings.elite_text }}</p>{%- endif -%}
      </div>
      <ul class="dpk-elite__points">
        {%- for i in (1..4) -%}
          {%- assign k_t = 'elite_point_' | append: i | append: '_title' -%}
          {%- assign k_x = 'elite_point_' | append: i | append: '_text' -%}
          {%- if section.settings[k_t] != blank -%}<li><b>{{ section.settings[k_t] }}</b>{{ section.settings[k_x] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="dpk-elist">
        {%- for b in elite_blocks -%}
          {%- assign p = b.settings.product -%}
          {%- if p == blank -%}
            {%- if request.design_mode -%}<div class="dpk-erow" {{ b.shopify_attributes }}>Bloc « Pack Élite » sans produit visible.</div>{%- endif -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign v = p.selected_or_first_available_variant
            assign name = b.settings.name
            if name == blank
              assign name = p.title | split: '|' | first | strip
            endif
            assign ideal = b.settings.ideal | default: p.metafields.custom.ideal_pour.value

            if p.metafields.custom.contenu_pack.value != blank
              assign elines = p.metafields.custom.contenu_pack.value
              assign from_mf = true
            else
              assign elines = b.settings.contenu | newline_to_br | split: '<br />'
              assign from_mf = false
            endif

            assign e_cont = 0
            assign e_cams = 0
            assign e_kbd = false
            for line in elines
              assign l = line | strip | downcase
              if from_mf
                assign q = l | split: ' ' | first | plus: 0
              else
                assign q = l | split: '|' | first | plus: 0
              endif
              if q == 0
                assign q = 1
              endif
              if l contains 'caméra' or l contains 'camera'
                assign e_cams = e_cams | plus: q
              elsif l contains 'contacteur' or l contains 'wds502' or l contains "d'ouverture"
                assign e_cont = e_cont | plus: q
              elsif l contains 'clavier'
                assign e_kbd = true
              endif
            endfor
            assign e_ext = p.metafields.custom.cameras_exterieures.value | plus: 0
            assign e_acc = p.metafields.custom.nb_accessoires.value | plus: 0
            assign alma_base = v.price | divided_by: 4
            assign alma_1 = alma_base | times: 3 | minus: v.price | abs
            assign eimg = v.featured_media.preview_image | default: p.featured_media.preview_image
            if eimg == blank
              assign eimg = p.featured_media.preview_image
            endif
          -%}
          <article class="dpk-erow" id="pack-{{ p.handle }}" data-dpk-elite data-key="{{ b.id }}" data-name="{{ name | escape }}" data-ideal="{{ ideal | escape }}"
            data-contacts="{{ e_cont }}" data-ext="{{ e_ext }}" data-url="{{ p.url }}" data-id="{{ v.id }}" data-price="{{ v.price }}"
            data-ref="{% if v.compare_at_price > v.price %}{{ v.compare_at_price }}{% else %}0{% endif %}"
            data-img="{% if eimg != blank %}{{ eimg | image_url: width: 720 }}{% endif %}" data-alt="{{ eimg.alt | default: p.title | escape }}" {{ b.shopify_attributes }}>
            <a class="dpk-erow__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {%- if eimg != blank -%}
                <img src="{{ eimg | image_url: width: 480 }}" srcset="{{ eimg | image_url: width: 240 }} 240w, {{ eimg | image_url: width: 480 }} 480w, {{ eimg | image_url: width: 720 }} 720w"
                  sizes="(min-width: 1100px) 220px, (min-width: 700px) 180px, 240px" width="480" height="480" loading="lazy" alt="{{ eimg.alt | default: p.title | escape }}">
              {%- endif -%}
            </a>
            <div>
              {%- if b.settings.badge != blank -%}<span class="dpk-erow__badge">{{ b.settings.badge }}</span>{%- endif -%}
              {%- if v.sku != blank -%}<p class="dpk-erow__ref">Réf. {{ v.sku }}</p>{%- endif -%}
              <h3><a href="{{ p.url }}">{{ name }}</a></h3>
              {%- if ideal != blank -%}<p class="dpk-erow__ideal">{{ ideal }}</p>{%- endif -%}
              <ul class="dpk-chips" aria-label="En bref">
                {%- if e_acc > 0 -%}<li><b>{{ e_acc }}</b> accessoires</li>{%- endif -%}
                {%- if e_cams > 0 -%}<li class="is-cam"><b>{{ e_cams }}</b> caméras{% if e_ext > 0 %} dont {{ e_ext }} extérieure{% if e_ext > 1 %}s{% endif %}{% endif %}</li>{%- endif -%}
                {%- if e_kbd -%}<li>Clavier mural</li>{%- endif -%}
              </ul>
            </div>
            <ul class="dpk-erow__list" aria-label="Contenu du pack">
              {%- for line in elines -%}
                {%- assign t = line | strip -%}
                {%- if t == blank -%}{%- continue -%}{%- endif -%}
                {%- if from_mf -%}
                  {%- assign q = t | split: ' ' | first -%}
                  {%- assign rest = t | remove_first: q | strip -%}
                {%- else -%}
                  {%- assign q = t | split: '|' | first | strip -%}
                  {%- assign rest = t | split: '|' | last | strip -%}
                {%- endif -%}
                <li><b>{{ q }}×</b><span>{{ rest }}</span></li>
              {%- endfor -%}
            </ul>
            <div class="dpk-erow__buy">
              <p class="dpk-price">
                <span class="dpk-price__now">{{ v.price | money }}</span>
                {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
              </p>
              <p class="dpk-alma">ou 4× sans frais&nbsp;: {{ alma_1 | money }} puis 3 × {{ alma_base | money }}</p>
              <button type="button" class="dpk-btn dpk-btn--primary" data-dpk-add="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>{% if v.available %}Ajouter au panier{% else %}Indisponible{% endif %}</button>
              <a class="dpk-btn dpk-btn--ghost" href="{{ p.url }}">Voir le pack</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.elite_foot != blank -%}<p class="dpk-elite__foot">{{ section.settings.elite_foot }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

