<script>
(function () {
  var root = document.getElementById('dpk-{{ sid }}');
  if (!root) return;
  var CART_URL = {{ routes.cart_url | json }};
  var ROOT_URL = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';

  /* Même rendu que le filtre money de Liquid (format de prix de la boutique) */
  var MONEY_FORMAT = {{ shop.money_format | json }};
  function euros(c) {
    var parts = (Math.round(c) / 100).toFixed(2).split('.');
    var dot = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.'), comma = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    if (!MONEY_FORMAT) return dot + ',' + parts[1] + ' €';
    return MONEY_FORMAT.replace(/\{\{\s*(\w+)\s*\}\}/, function (m, k) {
      if (k === 'amount_with_comma_separator') return dot + ',' + parts[1];
      if (k === 'amount_no_decimals_with_comma_separator') return dot;
      if (k === 'amount_no_decimals') return comma;
      if (k === 'amount_with_space_separator') return parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ',' + parts[1];
      return comma + '.' + parts[1];
    });
  }
  function alma(c) { var base = Math.floor(c / 4); return 'ou 4× sans frais : ' + euros(c - base * 3) + ' puis 3 × ' + euros(base); }
  function pct(price, ref) { return ref > price ? Math.floor((ref - price) * 100 / ref) : 0; }
  function $$(sel, el) { return Array.prototype.slice.call((el || root).querySelectorAll(sel)); }

  /* ---------- Toast ---------- */
  var toast = root.querySelector('[data-dpk-toast]'), toastT;
  function say(msg) {
    if (!toast) return;
    toast.textContent = msg; toast.classList.add('is-on');
    clearTimeout(toastT); toastT = setTimeout(function () { toast.classList.remove('is-on'); }, 2600);
  }

  /* ---------- Données des cartes ---------- */
  var cards = $$('[data-dpk-card]').map(function (el) {
    var data = {};
    try { data = JSON.parse(el.querySelector('[data-dpk-variants]').textContent); } catch (e) {}
    return { el: el, key: el.getAttribute('data-key'), name: el.getAttribute('data-name'), ideal: el.getAttribute('data-ideal'),
      contacts: +el.getAttribute('data-contacts') || 0, ext: +el.getAttribute('data-ext') || 0,
      pir: +el.getAttribute('data-pir') || 0, smoke: +el.getAttribute('data-smoke') || 0,
      url: el.getAttribute('data-url'), v: data, elite: false };
  });
  var elites = $$('[data-dpk-elite]').map(function (el) {
    var d = { id: +el.getAttribute('data-id'), price: +el.getAttribute('data-price'), ref: +el.getAttribute('data-ref') || 0,
      available: true, img: el.getAttribute('data-img'), alt: el.getAttribute('data-alt') };
    return { el: el, key: el.getAttribute('data-key'), name: el.getAttribute('data-name'), ideal: el.getAttribute('data-ideal'),
      contacts: +el.getAttribute('data-contacts') || 0, ext: +el.getAttribute('data-ext') || 0,
      url: el.getAttribute('data-url'), v: { elite: d }, elite: true };
  });

  /* ---------- Sélecteur de centrale ---------- */
  var radios = $$('[data-dpk-switch] input[type="radio"]');
  var current = root.getAttribute('data-c0');

  function linkFor(card, slug) { return card.url + (card.url.indexOf('?') > -1 ? '&' : '?') + 'centrale=' + encodeURIComponent(slug); }

  function applyCentrale(slug, opts) {
    var radio = radios.filter(function (r) { return r.value === slug; })[0];
    if (!radio) return;
    current = slug;
    radio.checked = true;
    $$('[data-dpk-switch] label').forEach(function (l) { l.classList.toggle('is-on', l.getAttribute('data-slug') === slug); });
    var label = radio.getAttribute('data-label');
    var hasRfid = radio.getAttribute('data-rfid') === 'true';
    $$('[data-dpk-cname]').forEach(function (n) { n.textContent = label; });
    $$('[data-dpk-rfid]').forEach(function (n) { n.hidden = !hasRfid; });
    var desc = root.querySelector('[data-dpk-desc]');
    if (desc) { desc.innerHTML = ''; var b = document.createElement('b'); b.textContent = label; desc.appendChild(b); desc.appendChild(document.createTextNode(' · ' + radio.getAttribute('data-desc'))); }

    cards.forEach(function (c) {
      var d = c.v[slug]; var el = c.el;
      var btn = el.querySelector('[data-dpk-add]');
      if (!d) { if (btn) { btn.disabled = true; btn.textContent = 'Indisponible'; } return; }
      el.querySelector('[data-dpk-price]').textContent = euros(d.price);
      var p = pct(d.price, d.ref), s = el.querySelector('[data-dpk-ref]'), t = el.querySelector('[data-dpk-pct]');
      if (s) { s.hidden = !p; s.textContent = p ? euros(d.ref) : ''; }
      if (t) { t.hidden = !p; t.textContent = '-' + p + ' %'; }
      var a = el.querySelector('[data-dpk-alma]'); if (a) a.textContent = alma(d.price);
      var img = el.querySelector('[data-dpk-img]');
      if (img && d.img && img.getAttribute('src') !== d.img) { img.src = d.img; if (d.srcset) img.srcset = d.srcset; img.alt = d.alt || img.alt; }
      if (btn) { btn.setAttribute('data-dpk-add', d.id); btn.disabled = !d.available; btn.textContent = d.available ? 'Ajouter au panier' : 'Indisponible'; }
      var href = linkFor(c, slug);
      $$('[data-dpk-link]', el).forEach(function (l) { l.href = href; });
      var cell = root.querySelector('[data-dpk-tprice="' + c.key + '"]'); if (cell) cell.textContent = euros(d.price);
      var th = $$('#comparatif-packs [data-dpk-link]')[cards.indexOf(c)]; if (th) th.href = href;
      var cta = $$('.dpk-table__cta [data-dpk-link]')[cards.indexOf(c)]; if (cta) cta.href = href;
    });

    if (!opts || !opts.silent) {
      try { var u = new URL(location.href); u.searchParams.set('centrale', slug); history.replaceState(history.state, '', u); } catch (e) {}
    }
  }
  radios.forEach(function (r) { r.addEventListener('change', function () { if (r.checked) applyCentrale(r.value); }); });
  try {
    var wanted = new URLSearchParams(location.search).get('centrale');
    if (wanted && wanted !== current) applyCentrale(wanted, { silent: true });
  } catch (e) {}

  /* ---------- Ajout au panier ---------- */
  function addToCart(btn) {
    var id = Number(btn.getAttribute('data-dpk-add'));
    if (!id || btn.getAttribute('aria-busy') === 'true') return;
    btn.setAttribute('aria-busy', 'true');
    var label = btn.textContent; btn.textContent = 'Ajout…';
    fetch(ROOT_URL + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
    })
      .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })
      .then(function () {
        btn.textContent = 'Ajouté ✓';
        setTimeout(function () { btn.textContent = label; }, 2200);
        if (window.theme && theme.pubsub && theme.pubsub.PUB_SUB_EVENTS) {
          fetch(ROOT_URL + 'cart.js').then(function (r) { return r.json(); }).then(function (cart) {
            theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, { source: 'dw-page-packs', cart: cart });
          }).catch(function () {});
        }
        if (document.querySelector('cart-drawer')) {
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: true } }));
        } else {
          window.location.href = CART_URL;
        }
      })
      .catch(function (e) {
        btn.textContent = label;
        say((e && (e.description || e.message)) || "Le pack n'a pas pu être ajouté au panier. Merci de réessayer.");
      })
      .finally(function () { btn.removeAttribute('aria-busy'); });
  }
  root.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-dpk-add]');
    if (btn && !btn.disabled) { e.preventDefault(); addToCart(btn); }
  });

  /* ---------- Conseiller ---------- */
  var adv = root.querySelector('[data-dpk-adv]');
  if (adv) {
    var steps = $$('[data-dpk-q]', adv), result = adv.querySelector('[data-dpk-result]');
    var stepTxt = adv.querySelector('[data-dpk-step]'), bar = adv.querySelector('[data-dpk-progress]');
    var back = adv.querySelector('[data-dpk-back]'), restart = adv.querySelector('[data-dpk-restart]');
    var answers = [null, null, null], step = 0;

    function show(i) {
      step = i;
      steps.forEach(function (s, k) { s.hidden = k !== i; });
      result.hidden = i < steps.length;
      back.hidden = i === 0 || i >= steps.length;
      restart.hidden = i < steps.length;
      bar.style.width = (Math.min(i, steps.length) / steps.length * 100) + '%';
      stepTxt.textContent = i < steps.length ? 'Question ' + (i + 1) + ' sur ' + steps.length : 'Votre pack';
    }

    /* Plus le score est bas, mieux le pack correspond : ouvertures à protéger,
       caméras extérieures (en manquer pèse plus qu'en avoir une de trop), puis prix. */
    function score(c, contacts, ext, price) {
      var miss = Math.max(0, ext - c.ext), extra = Math.max(0, c.ext - ext);
      return Math.abs(c.contacts - contacts) * 10 + miss * 40 + extra * 20 + price / 5000;
    }

    function recommend() {
      var contacts = +answers[0], ext = +answers[1], slug = answers[2];
      var pool = slug === 'elite' ? elites : cards;
      var key = slug === 'elite' ? 'elite' : slug;
      var ranked = pool.filter(function (c) { return c.v[key]; }).map(function (c) {
        return { c: c, d: c.v[key], s: score(c, contacts, ext, c.v[key].price) };
      }).sort(function (a, b) { return a.s - b.s; });
      if (!ranked.length) return;
      if (slug !== 'elite') applyCentrale(slug);
      var best = ranked[0], alt = ranked[1];
      var d = best.d, c = best.c;

      var img = result.querySelector('[data-r-img]');
      if (d.img) { img.src = d.img; img.removeAttribute('srcset'); img.alt = d.alt || c.name; }
      result.querySelector('[data-r-name]').textContent = c.name;
      var why = [];
      if (c.contacts) why.push(c.contacts + ' contacteur' + (c.contacts > 1 ? 's' : '') + ' pour vos ouvertures');
      why.push(c.ext ? c.ext + ' caméra' + (c.ext > 1 ? 's' : '') + ' extérieure' + (c.ext > 1 ? 's' : '') : 'caméra intérieure incluse');
      if (c.smoke) why.push(c.smoke + ' détecteur' + (c.smoke > 1 ? 's' : '') + ' de fumée');
      result.querySelector('[data-r-why]').textContent = (c.ideal ? c.ideal + '. ' : '') + why.join(', ') + '.';
      result.querySelector('[data-r-price]').textContent = euros(d.price);
      var p = pct(d.price, d.ref), s = result.querySelector('[data-r-ref]'), t = result.querySelector('[data-r-pct]');
      s.hidden = !p; s.textContent = p ? euros(d.ref) : '';
      t.hidden = !p; t.textContent = '-' + p + ' %';
      result.querySelector('[data-r-alma]').textContent = alma(d.price);
      var add = result.querySelector('[data-r-add]');
      add.setAttribute('data-dpk-add', d.id); add.disabled = !d.available; add.textContent = d.available ? 'Ajouter au panier' : 'Indisponible';
      result.querySelector('[data-r-link]').href = c.elite ? c.url : linkFor(c, slug);

      var altBox = result.querySelector('[data-r-alt]');
      if (alt) {
        var al = altBox.querySelector('[data-r-alt-link]');
        al.textContent = alt.c.name; al.href = '#' + alt.c.el.id;
        altBox.querySelector('[data-r-alt-price]').textContent = '(' + euros(alt.d.price) + ')';
        altBox.hidden = false;
      } else { altBox.hidden = true; }

      cards.concat(elites).forEach(function (x) { x.el.classList.toggle('is-match', x === c); });
      show(steps.length);
    }

    steps.forEach(function (s, i) {
      $$('.dpk-opt', s).forEach(function (o) {
        o.addEventListener('click', function () {
          answers[i] = o.getAttribute('data-v');
          $$('.dpk-opt', s).forEach(function (x) { x.setAttribute('aria-pressed', x === o ? 'true' : 'false'); });
          if (i + 1 < steps.length) show(i + 1); else recommend();
          var focusEl = i + 1 < steps.length ? steps[i + 1].querySelector('h2') : result.querySelector('h3');
          if (focusEl) { focusEl.setAttribute('tabindex', '-1'); focusEl.focus({ preventScroll: true }); }
        });
      });
    });
    back.addEventListener('click', function () { if (step > 0) show(step - 1); });
    restart.addEventListener('click', function () {
      answers = [null, null, null];
      $$('.dpk-opt', adv).forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
      cards.concat(elites).forEach(function (x) { x.el.classList.remove('is-match'); });
      show(0);
    });
    show(0);
  }
})();
</script>

