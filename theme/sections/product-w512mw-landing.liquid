  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      /* Reveal-on-scroll */
      var revealEls = root.querySelectorAll('.w512-reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
      }

      /* Pack Duo selector: every card/toggle on the page (data-pack-option)
         shares one quantity field and updates every "Ajouter au panier"
         button label (.w512-atc-label) in sync, wherever it appears. */
      var packOptions = root.querySelectorAll('[data-pack-option]');
      var packQtyInput = root.querySelector('#W512Qty-{{ section.id }}');
      var atcLabels = root.querySelectorAll('.w512-atc-label');
      var packLabels = { '1': root.dataset.label1, '2': root.dataset.label2 };

      function selectPackQty(qty) {
        packOptions.forEach(function (el) {
          var isMatch = el.getAttribute('data-qty') === qty;
          el.classList.toggle('is-selected', isMatch);
          el.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        });
        if (packQtyInput) packQtyInput.value = qty;
        atcLabels.forEach(function (label) { label.textContent = packLabels[qty]; });
      }

      packOptions.forEach(function (el) {
        el.addEventListener('click', function () {
          selectPackQty(el.getAttribute('data-qty'));
        });
      });

      /* Sticky add-to-cart bar: show once the hero CTA has scrolled out of view */
      var heroCta = root.querySelector('#W512HeroCta-{{ section.id }}');
      var stickyBar = root.querySelector('#W512Sticky-{{ section.id }}');
      if (heroCta && stickyBar && 'IntersectionObserver' in window) {
        var stickyIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            stickyBar.classList.toggle('is-shown', !entry.isIntersecting);
          });
        }, { threshold: 0, rootMargin: '-64px 0px 0px 0px' });
        stickyIo.observe(heroCta);
      }
    })();
  </script>
