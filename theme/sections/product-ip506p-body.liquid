{%- doc -%}
  Body half of the bespoke IP506P product page (photo onward). Paired with
  product-ip506p-hero.liquid — see that file's doc comment for why the page
  is split in two, and why fixed element ids are used instead of
  section.id-scoped ones.
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'IP506Form'

  assign gallery = product.images
  assign hero_image = gallery[0] | default: product.featured_image
  assign feat_image_vision = gallery[8] | default: hero_image
  assign feat_image_rotation = gallery[3] | default: hero_image
  assign feat_image_audio = gallery[4] | default: hero_image

  assign has_compare = false
  if variant.compare_at_price > variant.price
    assign has_compare = true
  endif
-%}

<div class="ip506">
  {%- comment -%} Product photo {%- endcomment -%}
  {%- if hero_image -%}
    <div class="ip506-wrap">
      <div class="ip506-hero__media ip506-reveal">
        {{ hero_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600,900,1200,1600', alt: product.title }}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Trust strip {%- endcomment -%}
  <div class="ip506-wrap">
    <div class="ip506-strip ip506-reveal">
      <div class="ip506-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Installation en 2 minutes
      </div>
      <div class="ip506-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Sans abonnement, à vie
      </div>
      <div class="ip506-strip__item ip506-strip__item--highlight">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Mode Vie Privée mécanique
      </div>
      <div class="ip506-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Garantie 2 ans
      </div>
    </div>
  </div>

  {%- comment -%} Privacy — the star feature {%- endcomment -%}
  <section class="ip506-section">
    <div class="ip506-wrap">
      <div class="ip506-privacy ip506-reveal">
        <div>
          <span class="ip506-privacy__eyebrow">Vie privée par design</span>
          <h2>La seule caméra qui se ferme quand vous êtes là.</h2>
          <p>
            Contrairement à un simple arrêt logiciel, l'IP506P se replie
            <strong>mécaniquement</strong> sur elle-même en Mode Vie Privée&nbsp;:
            l'objectif est physiquement masqué et la capture vidéo est coupée.
            Un repère visuel immédiat pour toute la famille&nbsp;— on voit tout de
            suite si la caméra surveille ou non.
          </p>
          <ul>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Fermeture mécanique réelle, pas juste un voyant logiciel</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Idéale pour une chambre, un salon ou une entrée</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Réactivable en un geste depuis l'app Daewoo Home Connect</li>
          </ul>
        </div>
        <div class="ip506-shutter-wrap">
          <div class="ip506-shutter" aria-hidden="true">
            <div class="ip506-shutter__lens"></div>
            <div class="ip506-shutter__lid ip506-shutter__lid--top"></div>
            <div class="ip506-shutter__lid ip506-shutter__lid--bottom"></div>
          </div>
          <span class="ip506-shutter__status">Mode Vie Privée</span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Feature — Vision & détection {%- endcomment -%}
  <section class="ip506-section ip506-section--alt">
    <div class="ip506-wrap">
      <div class="ip506-feature ip506-reveal">
        <div class="ip506-feature__media">
          {{ feat_image_vision | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', alt: 'Vision nocturne de la caméra IP506P' }}
        </div>
        <div class="ip506-feature__body">
          <span class="ip506-feature__num">VISION & DÉTECTION</span>
          <h2>Elle voit tout, de jour comme de nuit.</h2>
          <p class="ip506-feature__text">
            Résolution Full HD 1080p pour une image claire et fluide, avec vision
            nocturne infrarouge discrète même en faible luminosité. Le filtrage
            corps humain ne détecte que les vraies présences, pour éviter les
            fausses alertes.
          </p>
          <ul>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Full HD 1080p</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Vision nocturne infrarouge</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Filtrage corps humain intelligent</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Feature — Rotation motorisée {%- endcomment -%}
  <section class="ip506-section">
    <div class="ip506-wrap">
      <div class="ip506-feature ip506-feature--reverse ip506-reveal">
        <div class="ip506-feature__media">
          {{ feat_image_rotation | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', alt: 'Rotation de la caméra IP506P' }}
        </div>
        <div class="ip506-feature__body">
          <span class="ip506-feature__num">ROTATION MOTORISÉE</span>
          <h2>Elle couvre toute la pièce, toute seule.</h2>
          <p class="ip506-feature__text">
            Rotation motorisée étendue&nbsp;: 355° à l'horizontale et 160° à la
            verticale. Le suivi de mouvement automatique garde une personne dans
            le cadre pendant tous ses déplacements.
          </p>
          <ul>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>355° horizontal · 160° vertical</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Suivi de mouvement automatique</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Feature — Audio & sirène {%- endcomment -%}
  <section class="ip506-section ip506-section--alt">
    <div class="ip506-wrap">
      <div class="ip506-feature ip506-reveal">
        <div class="ip506-feature__media">
          {{ feat_image_audio | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', alt: 'Audio bidirectionnel de la caméra IP506P' }}
        </div>
        <div class="ip506-feature__body">
          <span class="ip506-feature__num">ALERTES & AUDIO</span>
          <h2>Prévenue tout de suite. Prête à réagir.</h2>
          <p class="ip506-feature__text">
            Notification instantanée avec photo dès qu'un mouvement ou un bruit
            inhabituel est détecté. Micro et haut-parleur intégrés pour parler à
            distance, et sirène 60&nbsp;dB pour dissuader en cas de besoin.
          </p>
          <ul>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Notification instantanée avec photo</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Audio bidirectionnel</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Sirène 60&nbsp;dB intégrée</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Alarm compatibility {%- endcomment -%}
  <section class="ip506-section">
    <div class="ip506-wrap">
      <div class="ip506-privacy ip506-reveal">
        <div>
          <span class="ip506-privacy__eyebrow">Compatibilité totale</span>
          <h2>Un système, pas juste une caméra.</h2>
          <p>
            L'IP506P s'intègre parfaitement à toutes les alarmes Daewoo Security
            (AM301, AM302, PA501Z, Vigilia, SA501), ou fonctionne seule via
            l'application Daewoo Home Connect.
          </p>
        </div>
        <ul>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Compatible avec toutes les alarmes Daewoo Security</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Scénarios automatisés (ex&nbsp;: Mode Vie Privée si alarme désarmée)</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Fonctionne aussi seule, sans centrale</li>
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} Mid-page CTA band {%- endcomment -%}
  <div class="ip506-wrap">
    <div class="ip506-band ip506-reveal">
      <h2>Surveillez votre intérieur, en toute discrétion</h2>
      <p>Livraison rapide, garantie 2 ans, et une installation qui prend deux minutes.</p>
      {%- render 'ip506p-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
    </div>
  </div>

  {%- comment -%} Specs {%- endcomment -%}
  <section class="ip506-section">
    <div class="ip506-wrap">
      <div class="ip506-specs__head ip506-reveal">
        <h2>En résumé</h2>
        <p>Tout ce qu'il faut savoir sur l'IP506P.</p>
      </div>
      <dl class="ip506-specs__grid ip506-reveal">
        <div class="ip506-specs__item">
          <dt>Alimentation</dt>
          <dd>Câble USB-C 2&nbsp;m fourni, prise secteur 220V</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Vision nocturne</dt>
          <dd>Infrarouge, Full HD 1080p</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Rotation</dt>
          <dd>355° horizontal · 160° vertical, motorisée</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Vie privée</dt>
          <dd>Fermeture mécanique de l'objectif</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Sirène</dt>
          <dd>60&nbsp;dB intégrée</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Stockage</dt>
          <dd>Carte microSD (non incluse) ou abonnement de stockage Cloud (plus sécurisé)</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Connectivité</dt>
          <dd>Wi-Fi 2,4&nbsp;GHz</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Compatibilité</dt>
          <dd>AM301, AM302, PA501Z, Vigilia, SA501, ou seule via l'app</dd>
        </div>
        <div class="ip506-specs__item">
          <dt>Référence</dt>
          <dd>IP506P</dd>
        </div>
      </dl>
    </div>
  </section>

  {%- comment -%} Guarantee band {%- endcomment -%}
  <section class="ip506-section ip506-section--alt">
    <div class="ip506-wrap">
      <div class="ip506-guarantee ip506-reveal">
        <div class="ip506-guarantee__item">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z"></path></svg>
          <h3>Garantie 2 ans</h3>
          <p>Sur l'ensemble des produits Daewoo Security.</p>
        </div>
        <div class="ip506-guarantee__item">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="15" height="11" rx="2"></rect><path d="M18 10h2.2a1 1 0 0 1 .9.6L23 14v4h-5"></path><circle cx="7.5" cy="18.5" r="1.5"></circle><circle cx="17.5" cy="18.5" r="1.5"></circle></svg>
          <h3>Expédié sous 2 jours</h3>
          <p>Livraison rapide depuis la France.</p>
        </div>
        <div class="ip506-guarantee__item">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path></svg>
          <h3>Retour sous 14 jours</h3>
          <p>Changez d'avis facilement, sans justification.</p>
        </div>
        <div class="ip506-guarantee__item">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
          <h3>Sans abonnement</h3>
          <p>Votre caméra vous appartient, à vie.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} FAQ {%- endcomment -%}
  <section class="ip506-section">
    <div class="ip506-wrap">
      <div class="ip506-faq ip506-reveal">
        <h2>Questions fréquentes</h2>

        <details>
          <summary>Comment fonctionne le Mode Vie Privée&nbsp;?<span class="ip506-faq__icon">＋</span></summary>
          <p class="ip506-faq__a">La caméra se replie mécaniquement sur elle-même&nbsp;: l'objectif est physiquement masqué et la capture vidéo est coupée. Vous la réactivez en un tap depuis l'application Daewoo Home Connect.</p>
        </details>

        <details>
          <summary>Ai-je besoin d'un abonnement&nbsp;?<span class="ip506-faq__icon">＋</span></summary>
          <p class="ip506-faq__a">Non. Vous pilotez et consultez vos images via l'application Daewoo Home Connect. Un stockage sur carte microSD suffit, sans frais mensuels.</p>
        </details>

        <details>
          <summary>Est-elle compatible avec mon alarme Daewoo&nbsp;?<span class="ip506-faq__icon">＋</span></summary>
          <p class="ip506-faq__a">Oui, l'IP506P est compatible avec les centrales AM301, AM302, PA501Z, Vigilia et SA501. Elle fonctionne aussi de façon autonome, sans centrale, via l'application.</p>
        </details>

        <details>
          <summary>Comment se passe l'installation&nbsp;?<span class="ip506-faq__icon">＋</span></summary>
          <p class="ip506-faq__a">Branchez la caméra au secteur avec le câble USB-C fourni, scannez le QR code dans l'application, et elle est connectée en Wi-Fi en quelques secondes.</p>
        </details>

        <details>
          <summary>Où sont enregistrées les vidéos&nbsp;?<span class="ip506-faq__icon">＋</span></summary>
          <p class="ip506-faq__a">Sur une carte microSD (non incluse) insérée dans la caméra, ou via un abonnement de stockage Cloud pour un accès plus sécurisé à distance.</p>
        </details>

        <details>
          <summary>Est-ce que je vais recevoir trop de fausses alertes&nbsp;?<span class="ip506-faq__icon">＋</span></summary>
          <p class="ip506-faq__a">Non&nbsp;: le filtrage corps humain ne déclenche une notification que pour les vraies présences, pas pour un animal ou une ombre.</p>
        </details>
      </div>
    </div>
  </section>

  {%- comment -%} Final CTA {%- endcomment -%}
  <section class="ip506-section ip506-final">
    <div class="ip506-wrap">
      <div class="ip506-reveal">
        <h2>{{ product.title }}</h2>
        <p>
          {%- if has_compare -%}
            <span class="ip506-hero__compare">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
          <span>{{ variant.price | money }}</span> · Sans abonnement · Garantie 2 ans
        </p>
        <div class="ip506-final__ctas">
          {%- render 'ip506p-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
        </div>
        <p class="ip506-final__legal">Livraison sous 2 jours ouvrés · Retour gratuit sous 14 jours · Service client basé en France</p>
      </div>
    </div>
  </section>

  <script>
    (function () {
      /* Reveal-on-scroll */
      var revealEls = document.querySelectorAll('.ip506-reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
      }
    })();
  </script>
</div>

{% schema %}
{
  "name": "IP506P – Contenu",
  "settings": []
}
{% endschema %}
