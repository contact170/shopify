{%- doc -%}
  Bespoke, comparison-focused collection page for the "Caméras autonomes"
  (cameras-sans-fil) collection. Same Apple-style visual language as the
  W512MW product page: white background, large type, generous whitespace.
  Curates the 3 active cameras by handle so the "good / better / best"
  story stays in a fixed, intentional order regardless of collection sort.
{%- enddoc -%}

{%- liquid
  assign p_w503 = all_products['camera-daewoo-w503-autonome-haute-resolution-wifi-1080p']
  assign p_w503_solaire = all_products['camera-daewoo-w503-avec-panneau-solaire-autonome-haute-resolution-wifi-1080p']
  assign p_w512mw = all_products['camera-w512mw-exterieure-rotative-1440p-avec-panneau-solaire']
-%}

<div id="shopify-section-{{ section.id }}" class="wcams">
  <style>
    #shopify-section-{{ section.id }} .wcams{
      --wcams-navy:#0c1e4a;
      --wcams-navy-dark:#081430;
      --wcams-ink:#1d1d1f;
      --wcams-gray:#6e6e73;
      --wcams-bg-alt:#f5f5f7;
      --wcams-line:#d2d2d7;
      --wcams-success:#037e05;
      font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      color:var(--wcams-ink);
      background:#fff;
      overflow-x:hidden;
    }
    .wcams *{box-sizing:border-box;}
    .wcams .wcams-wrap{max-width:1160px;margin:0 auto;padding:0 24px;}
    .wcams img{max-width:100%;display:block;}
    .wcams h1,.wcams h2,.wcams h3{font-weight:600;letter-spacing:-.02em;line-height:1.1;margin:0;}
    .wcams p{margin:0;}

    /* ---- hero ---- */
    .wcams-hero{padding:88px 0 56px;text-align:center;}
    .wcams-eyebrow{
      display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;
      letter-spacing:.06em;text-transform:uppercase;color:var(--wcams-navy);margin-bottom:16px;
    }
    .wcams-eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--wcams-success);}
    .wcams-hero h1{font-size:clamp(30px,5vw,52px);max-width:820px;margin:0 auto;}
    .wcams .wcams-hero__sub{
      font-size:clamp(16px,2vw,20px);color:var(--wcams-gray);max-width:620px;
      margin:20px auto 0;line-height:1.55;text-align:center;
    }

    /* ---- section rhythm ---- */
    .wcams-section{padding:24px 0 72px;}
    .wcams-section--alt{background:var(--wcams-bg-alt);padding:72px 0;}

    /* ---- trust strip ---- */
    .wcams-strip{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;padding:0 0 56px;}
    .wcams-strip__item{
      display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;
      padding:10px 18px;border-radius:999px;background:var(--wcams-bg-alt);
    }
    .wcams-strip__item svg{color:var(--wcams-navy);flex-shrink:0;}

    /* ---- cards ---- */
    .wcams-grid{display:grid;grid-template-columns:1fr;gap:24px;}
    @media (min-width:860px){.wcams-grid{grid-template-columns:repeat(3,1fr);align-items:stretch;}}
    .wcams-card{
      position:relative;display:flex;flex-direction:column;border:1px solid var(--wcams-line);
      border-radius:24px;overflow:hidden;background:#fff;transition:box-shadow .2s ease,transform .2s ease;
    }
    .wcams-card:hover{box-shadow:0 20px 40px -24px rgba(12,30,74,.25);}
    .wcams-card--featured{border-color:var(--wcams-navy);border-width:2px;}
    .wcams-card__ribbon{
      position:absolute;top:18px;right:18px;z-index:2;font-size:11px;font-weight:700;letter-spacing:.03em;
      color:#fff;background:var(--wcams-navy);padding:6px 12px;border-radius:999px;
    }
    .wcams-card__media{background:var(--wcams-bg-alt);aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;}
    .wcams-card__media img{width:100%;height:100%;object-fit:contain;padding:28px;}
    .wcams-card__body{padding:28px;display:flex;flex-direction:column;flex-grow:1;gap:4px;}
    .wcams-card__eyebrow{font-size:12px;font-weight:700;color:var(--wcams-navy);letter-spacing:.06em;text-transform:uppercase;}
    .wcams-card__body h3{font-size:22px;margin-top:6px;}
    .wcams-card__body h3 a{color:inherit;text-decoration:none;}
    .wcams-card__tagline{color:var(--wcams-gray);font-size:15px;line-height:1.5;margin-top:8px;}
    .wcams-card ul{list-style:none;margin:18px 0 0;padding:0;display:grid;gap:9px;}
    .wcams-card ul li{display:flex;gap:8px;font-size:14px;line-height:1.4;color:var(--wcams-ink);}
    .wcams-card ul li svg{flex-shrink:0;margin-top:2px;color:var(--wcams-success);}
    .wcams-card__price{font-size:24px;font-weight:600;margin-top:20px;}
    .wcams-card__price span{font-size:13px;font-weight:400;color:var(--wcams-gray);}

    /* ---- buttons ---- */
    .wcams-btn{
      position:relative;overflow:hidden;isolation:isolate;width:100%;margin-top:14px;
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      border:none;border-radius:999px;cursor:pointer;font-family:inherit;font-size:15px;font-weight:600;
      padding:13px 22px;background:var(--wcams-navy);color:#fff;
      transition:transform .15s ease,opacity .15s ease;
    }
    .wcams-btn:active{transform:scale(.98);}
    .wcams-btn[disabled]{opacity:.5;cursor:not-allowed;}
    .wcams-btn .btn-fill{position:absolute;inset:0;z-index:-1;background:var(--wcams-navy-dark);transform:translateY(100%);}
    .wcams-btn .btn-text{position:relative;}
    .wcams-card__link{
      display:block;text-align:center;margin-top:12px;font-size:13px;font-weight:600;
      color:var(--wcams-navy);text-decoration:none;
    }
    .wcams-card__link:hover{text-decoration:underline;}

    /* ---- lifestyle banner ---- */
    .wcams-lifestyle{
      position:relative;overflow:hidden;border-radius:32px;
      background:linear-gradient(135deg,#0c1e4a 0%,#5b21b6 48%,#f97316 100%);
      padding:56px 28px;color:#fff;
      display:grid;gap:36px;grid-template-columns:1fr;align-items:center;
      margin-bottom:64px;
    }
    .wcams-lifestyle::before,.wcams-lifestyle::after{
      content:"";position:absolute;border-radius:50%;filter:blur(60px);opacity:.5;pointer-events:none;
    }
    .wcams-lifestyle::before{width:320px;height:320px;background:#38bdf8;top:-120px;left:-80px;}
    .wcams-lifestyle::after{width:280px;height:280px;background:#fb923c;bottom:-100px;right:-60px;}
    .wcams-lifestyle__body{position:relative;z-index:1;text-align:center;}
    .wcams-lifestyle__eyebrow{
      display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;
      letter-spacing:.06em;text-transform:uppercase;color:#fde68a;margin-bottom:14px;
    }
    .wcams-lifestyle h2{color:#fff;font-size:clamp(26px,4vw,38px);max-width:520px;margin:0 auto;}
    .wcams-lifestyle p{color:rgba(255,255,255,.85);margin-top:14px;font-size:16px;line-height:1.55;max-width:460px;margin-left:auto;margin-right:auto;}
    .wcams-lifestyle__chips{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:24px;}
    .wcams-lifestyle__chip{
      display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;
      background:rgba(255,255,255,.14);backdrop-filter:blur(6px);padding:8px 14px;border-radius:999px;
    }
    .wcams-lifestyle__cta{
      display:inline-flex;margin-top:28px;background:#fff;color:var(--wcams-navy);
      border:none;border-radius:999px;padding:14px 28px;font-size:15px;font-weight:700;
      text-decoration:none;transition:transform .15s ease;
    }
    .wcams-lifestyle__cta:hover{transform:scale(1.03);}
    .wcams-lifestyle__media{position:relative;z-index:1;display:flex;justify-content:center;}
    .wcams-lifestyle__media img{max-width:260px;filter:drop-shadow(0 30px 50px rgba(0,0,0,.35));}
    @media (min-width:860px){
      .wcams-lifestyle{grid-template-columns:1.1fr 1fr;padding:72px 64px;text-align:left;}
      .wcams-lifestyle__body{text-align:left;}
      .wcams-lifestyle h2,.wcams-lifestyle p{margin-left:0;margin-right:0;}
      .wcams-lifestyle__chips{justify-content:flex-start;}
      .wcams-lifestyle__media img{max-width:320px;}
    }

    /* ---- comparison table ---- */
    .wcams-compare__head{text-align:center;max-width:640px;margin:0 auto 40px;}
    .wcams-compare__head h2{font-size:clamp(26px,3.4vw,36px);}
    .wcams-compare__head p{margin-top:12px;color:var(--wcams-gray);font-size:16px;}
    .wcams-table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .wcams-table{width:100%;border-collapse:collapse;min-width:640px;background:#fff;border-radius:16px;overflow:hidden;border:1px solid var(--wcams-line);}
    .wcams-table th,.wcams-table td{padding:16px 18px;text-align:left;font-size:14px;border-bottom:1px solid var(--wcams-line);}
    .wcams-table th{background:var(--wcams-bg-alt);font-weight:700;color:var(--wcams-navy);white-space:nowrap;}
    .wcams-table td:first-child,.wcams-table th:first-child{font-weight:600;color:var(--wcams-ink);}
    .wcams-table tr:last-child td{border-bottom:none;}
    .wcams-table td.is-featured,.wcams-table th.is-featured{background:rgba(12,30,74,.04);}
  </style>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="wcams-hero">
    <div class="wcams-wrap">
      <span class="wcams-eyebrow">Daewoo Security · Caméras autonomes</span>
      <h1>Trouvez la caméra faite pour votre extérieur.</h1>
      <p class="wcams-hero__sub">
        Trois caméras 100&nbsp;% sans fil, sans abonnement. Comparez leur autonomie,
        leur vision nocturne et leur portée pour choisir en quelques secondes.
      </p>
    </div>
  </section>

  <div class="wcams-wrap">
    <div class="wcams-strip">
      <div class="wcams-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        100% sans fil
      </div>
      <div class="wcams-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Sans abonnement
      </div>
      <div class="wcams-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Compatible toutes alarmes Daewoo
      </div>
      <div class="wcams-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Garantie 2 ans
      </div>
    </div>
  </div>

  {%- comment -%} Lifestyle banner — adds color to an otherwise all-white/navy page {%- endcomment -%}
  <div class="wcams-wrap">
    <div class="wcams-lifestyle">
      <div class="wcams-lifestyle__body">
        <span class="wcams-lifestyle__eyebrow">Daewoo Security</span>
        <h2>Elle veille sur votre extérieur, jour et nuit.</h2>
        <p>Pluie, soleil ou obscurité totale&nbsp;: nos caméras sans fil restent actives en toutes conditions, sans jamais dépendre d'un abonnement.</p>
        <div class="wcams-lifestyle__chips">
          <span class="wcams-lifestyle__chip">☀️ Jour</span>
          <span class="wcams-lifestyle__chip">🌙 Nuit</span>
          <span class="wcams-lifestyle__chip">🌧️ Toutes météos</span>
        </div>
        <a class="wcams-lifestyle__cta" href="{{ p_w512mw.url | default: '#' }}">Découvrir la W512MW →</a>
      </div>
      {%- if p_w512mw.featured_image -%}
        <div class="wcams-lifestyle__media">
          {{ p_w512mw.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320,480,640', alt: p_w512mw.title }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Product cards {%- endcomment -%}
  <section class="wcams-section">
    <div class="wcams-wrap">
      <div class="wcams-grid">

        {%- comment -%} Card 1 — W503 {%- endcomment -%}
        {%- if p_w503 -%}
          {%- liquid
            assign variant = p_w503.selected_or_first_available_variant
            assign form_id = 'CamForm-' | append: p_w503.id
          -%}
          <div class="wcams-card">
            <a class="wcams-card__media" href="{{ p_w503.url }}">
              {{ p_w503.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: p_w503.title }}
            </a>
            <div class="wcams-card__body">
              <span class="wcams-card__eyebrow">Modèle fixe</span>
              <h3><a href="{{ p_w503.url }}">W503</a></h3>
              <p class="wcams-card__tagline">Autonome et 100% sans fil, avec toute la technologie de détection et de vision nocturne.</p>
              <ul>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Batterie rechargeable intégrée</li>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Vision nocturne couleur et infrarouge</li>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Sirène 75&nbsp;dB et détection humaine jusqu'à 7-8&nbsp;m</li>
              </ul>
              <div class="wcams-card__price">{{ variant.price | money }} <span>· caméra seule</span></div>
              {%- form 'product', p_w503, id: form_id, is: 'product-form' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button type="submit" name="add" class="wcams-btn" is="hover-button"{% unless variant.available %} disabled{% endunless %}>
                  <span class="btn-fill" data-fill aria-hidden="true"></span>
                  <span class="btn-text">{% if variant.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}</span>
                </button>
              {%- endform -%}
              <a class="wcams-card__link" href="{{ p_w503.url }}">Voir la fiche produit →</a>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Card 2 — W503 + panneau solaire {%- endcomment -%}
        {%- if p_w503_solaire -%}
          {%- liquid
            assign variant = p_w503_solaire.selected_or_first_available_variant
            assign form_id = 'CamForm-' | append: p_w503_solaire.id
          -%}
          <div class="wcams-card">
            <a class="wcams-card__media" href="{{ p_w503_solaire.url }}">
              {{ p_w503_solaire.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: p_w503_solaire.title }}
            </a>
            <div class="wcams-card__body">
              <span class="wcams-card__eyebrow">Autonomie prolongée</span>
              <h3><a href="{{ p_w503_solaire.url }}">W503 + Panneau solaire</a></h3>
              <p class="wcams-card__tagline">La même caméra W503, livrée avec son panneau solaire pour une autonomie quasi illimitée.</p>
              <ul>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Panneau solaire inclus</li>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Vision nocturne couleur et infrarouge</li>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Sirène 75&nbsp;dB et détection humaine jusqu'à 7-8&nbsp;m</li>
              </ul>
              <div class="wcams-card__price">{{ variant.price | money }} <span>· panneau inclus</span></div>
              {%- form 'product', p_w503_solaire, id: form_id, is: 'product-form' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button type="submit" name="add" class="wcams-btn" is="hover-button"{% unless variant.available %} disabled{% endunless %}>
                  <span class="btn-fill" data-fill aria-hidden="true"></span>
                  <span class="btn-text">{% if variant.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}</span>
                </button>
              {%- endform -%}
              <a class="wcams-card__link" href="{{ p_w503_solaire.url }}">Voir la fiche produit →</a>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Card 3 — W512MW (featured) {%- endcomment -%}
        {%- if p_w512mw -%}
          {%- liquid
            assign variant = p_w512mw.selected_or_first_available_variant
            assign form_id = 'CamForm-' | append: p_w512mw.id
          -%}
          <div class="wcams-card wcams-card--featured">
            <span class="wcams-card__ribbon">Notre recommandation</span>
            <a class="wcams-card__media" href="{{ p_w512mw.url }}">
              {{ p_w512mw.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: p_w512mw.title }}
            </a>
            <div class="wcams-card__body">
              <span class="wcams-card__eyebrow">Rotative & haute résolution</span>
              <h3><a href="{{ p_w512mw.url }}">W512MW</a></h3>
              <p class="wcams-card__tagline">Rotative et en 1440p, pour une couverture plus large et des images plus détaillées.</p>
              <ul>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Rotative, résolution 1440p</li>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Vision nocturne couleur, sirène 75&nbsp;dB intégrée</li>
                <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>Panneau solaire déporté inclus, détection humaine jusqu'à 7-8&nbsp;m</li>
              </ul>
              <div class="wcams-card__price">{{ variant.price | money }} <span>· panneau inclus</span></div>
              {%- form 'product', p_w512mw, id: form_id, is: 'product-form' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button type="submit" name="add" class="wcams-btn" is="hover-button"{% unless variant.available %} disabled{% endunless %}>
                  <span class="btn-fill" data-fill aria-hidden="true"></span>
                  <span class="btn-text">{% if variant.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}</span>
                </button>
              {%- endform -%}
              <a class="wcams-card__link" href="{{ p_w512mw.url }}">Voir la fiche produit →</a>
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </section>

  {%- comment -%} Comparison table {%- endcomment -%}
  <section class="wcams-section--alt">
    <div class="wcams-wrap">
      <div class="wcams-compare__head">
        <h2>Comparez les 3 modèles</h2>
        <p>De quoi choisir la caméra la mieux adaptée à votre extérieur.</p>
      </div>
      <div class="wcams-table-scroll">
        <table class="wcams-table">
          <thead>
            <tr>
              <th>Modèle</th>
              <th>W503</th>
              <th>W503 + Solaire</th>
              <th class="is-featured">W512MW</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Prix</td>
              <td>{{ p_w503.selected_or_first_available_variant.price | money }}</td>
              <td>{{ p_w503_solaire.selected_or_first_available_variant.price | money }}</td>
              <td class="is-featured">{{ p_w512mw.selected_or_first_available_variant.price | money }}</td>
            </tr>
            <tr>
              <td>Type</td>
              <td>Fixe</td>
              <td>Fixe</td>
              <td class="is-featured">Rotative</td>
            </tr>
            <tr>
              <td>Résolution</td>
              <td>Full HD (1080p)</td>
              <td>Full HD (1080p)</td>
              <td class="is-featured">1440p</td>
            </tr>
            <tr>
              <td>Alimentation</td>
              <td>Batterie rechargeable</td>
              <td>Batterie + panneau solaire inclus</td>
              <td class="is-featured">Batterie + panneau solaire déporté inclus</td>
            </tr>
            <tr>
              <td>Vision nocturne</td>
              <td>Couleur et infrarouge</td>
              <td>Couleur et infrarouge</td>
              <td class="is-featured">Couleur</td>
            </tr>
            <tr>
              <td>Sirène intégrée</td>
              <td>75 dB</td>
              <td>75 dB</td>
              <td class="is-featured">75 dB</td>
            </tr>
            <tr>
              <td>Détection</td>
              <td>Humaine intelligente, jusqu'à 7-8 m</td>
              <td>Humaine intelligente, jusqu'à 7-8 m</td>
              <td class="is-featured">Humaine intelligente, jusqu'à 7-8 m</td>
            </tr>
            <tr>
              <td>Compatible alarmes Daewoo</td>
              <td>Oui</td>
              <td>Oui</td>
              <td class="is-featured">Oui</td>
            </tr>
            <tr>
              <td>Abonnement requis</td>
              <td>Non</td>
              <td>Non</td>
              <td class="is-featured">Non</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Caméras sans fil",
  "settings": []
}
{% endschema %}
