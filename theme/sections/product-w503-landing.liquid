{%- doc -%}
  Bespoke, conversion-focused product page shared by the W503 and the
  W503 + panneau solaire products (same camera, sold with or without the
  bundled solar panel). Apple-style layout, same technique as the W512MW
  page for shared add-to-cart buttons, but with two fixes carried over
  from lessons learned there:
  - the paragraph/heading margin reset uses :where() (zero specificity)
    so it can never fight with a specific element's own centering rule.
  - the hidden shared form includes a real (visually hidden) submit
    button, so the theme's ProductForm custom element always finds one.

  @setting {boolean} includes_solar_panel - toggles solar-panel-specific copy
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'W503Form-' | append: section.id
  assign includes_solar = section.settings.includes_solar_panel

  assign gallery = product.images
  assign hero_image = gallery[0] | default: product.featured_image
  assign feat_image_1 = gallery[1] | default: hero_image
  assign feat_image_2 = gallery[2] | default: hero_image
  assign feat_image_3 = gallery[3] | default: hero_image
  assign feat_image_4 = gallery[4] | default: hero_image

  assign has_compare = false
  if variant.compare_at_price > variant.price
    assign has_compare = true
  endif

  assign price_x2 = variant.price | times: 2
  assign price_pack = variant.price | times: 1.5 | round
-%}

{%- capture pack_label_single -%}Ajouter au panier · {{ variant.price | money }}{%- endcapture -%}
{%- capture pack_label_duo -%}Ajouter le Pack de 2 · {{ price_pack | money }}{%- endcapture -%}

<div id="shopify-section-{{ section.id }}" class="w503">
  <script type="application/json" id="W503Labels-{{ section.id }}">
    { "1": {{ pack_label_single | strip_html | json }}, "2": {{ pack_label_duo | strip_html | json }} }
  </script>
  <style>
    #shopify-section-{{ section.id }} .w503{
      --w503-navy:#0c1e4a;
      --w503-navy-dark:#081430;
      --w503-ink:#1d1d1f;
      --w503-gray:#6e6e73;
      --w503-bg-alt:#f5f5f7;
      --w503-line:#d2d2d7;
      --w503-success:#037e05;
      font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      color:var(--w503-ink);
      background:#fff;
      overflow-x:hidden;
    }
    .w503 *{box-sizing:border-box;}
    .w503 :where(h1,h2,h3,p){margin:0;}
    .w503 .w503-wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
    .w503 img{max-width:100%;display:block;}
    .w503 h1,.w503 h2,.w503 h3{font-weight:600;letter-spacing:-.02em;line-height:1.08;}

    /* ---- sticky bar ---- */
    .w503-sticky{
      position:fixed;left:0;right:0;bottom:0;z-index:60;
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:12px 20px;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
      border-top:1px solid var(--w503-line);
      transform:translateY(110%);transition:transform .35s ease;
    }
    .w503-sticky.is-shown{transform:translateY(0);}
    .w503-sticky__info{display:flex;align-items:center;gap:12px;min-width:0;}
    .w503-sticky__thumb{width:40px;height:40px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--w503-bg-alt);}
    .w503-sticky__thumb img{width:100%;height:100%;object-fit:cover;}
    .w503-sticky__name{font-size:13px;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:50vw;}

    /* ---- section rhythm ---- */
    .w503-section{padding:72px 0;}
    .w503-section--alt{background:var(--w503-bg-alt);}
    .w503-eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
      color:var(--w503-navy);margin-bottom:18px;
    }
    .w503-eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--w503-success);}

    /* ---- hero ---- */
    .w503-hero{padding:96px 0 56px;text-align:center;}
    .w503-hero h1{font-size:clamp(32px,5.6vw,58px);max-width:880px;margin:0 auto;}
    .w503-hero__sub{
      font-size:clamp(17px,2.2vw,21px);color:var(--w503-gray);
      max-width:640px;margin:22px auto 0;line-height:1.5;font-weight:400;text-align:center;
    }
    .w503-hero__cta{margin-top:36px;display:flex;flex-direction:column;align-items:center;gap:12px;}
    .w503-hero__price{font-size:15px;color:var(--w503-gray);}
    .w503-hero__price strong{color:var(--w503-ink);font-size:17px;}
    .w503-hero__compare{text-decoration:line-through;color:var(--w503-gray);margin-right:6px;}
    .w503-hero__rating{margin-top:2px;}
    .w503-hero__rating .product__rating{justify-content:center;}
    .w503-hero__trust{
      margin-top:30px;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;
      font-size:13px;color:var(--w503-gray);
    }
    .w503-hero__trust span{display:inline-flex;align-items:center;gap:6px;}
    .w503-hero__media{margin-top:56px;}
    .w503-hero__media img{width:100%;max-width:820px;margin:0 auto;border-radius:28px;background:var(--w503-bg-alt);}

    /* ---- buttons ---- */
    .w503-btn{
      position:relative;overflow:hidden;isolation:isolate;
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      border:none;border-radius:999px;cursor:pointer;
      font-family:inherit;font-size:16px;font-weight:600;
      padding:15px 30px;min-width:230px;
      transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease;
    }
    .w503-btn:active{transform:scale(.98);}
    .w503-btn[disabled]{opacity:.5;cursor:not-allowed;}
    .w503-btn--primary{background:var(--w503-navy);color:#fff;box-shadow:0 8px 20px -8px rgba(12,30,74,.55);}
    .w503-btn--primary .btn-fill{background:var(--w503-navy-dark);}
    .w503-btn .btn-fill{position:absolute;inset:0;z-index:-1;transform:translateY(100%);}
    .w503-btn__text{position:relative;display:inline-flex;align-items:center;gap:10px;}

    /* ---- pack toggle (1 caméra / Pack Duo) ---- */
    .w503-toggle{display:inline-flex;background:var(--w503-bg-alt);border-radius:999px;padding:4px;gap:4px;}
    .w503-toggle__btn{
      border:none;background:transparent;padding:9px 16px;border-radius:999px;
      font-family:inherit;font-size:13px;font-weight:600;color:var(--w503-gray);cursor:pointer;
      display:inline-flex;align-items:center;gap:6px;white-space:nowrap;
      transition:background .15s ease,color .15s ease;
    }
    .w503-toggle__btn.is-selected{background:var(--w503-navy);color:#fff;}
    .w503-toggle__badge{font-size:11px;font-weight:700;background:#e11d48;color:#fff;padding:2px 7px;border-radius:999px;}
    .w503-toggle--compact{padding:3px;}
    .w503-toggle--compact .w503-toggle__btn{padding:6px 10px;font-size:12px;}
    .w503-hero__toggle{margin-bottom:4px;}
    .w503-band__toggle,.w503-final__toggle{display:flex;justify-content:center;margin-top:30px;margin-bottom:26px;}
    .w503-band .w503-toggle{background:rgba(255,255,255,.15);}
    .w503-band .w503-toggle__btn{color:rgba(255,255,255,.75);}
    .w503-band .w503-toggle__btn.is-selected{background:#fff;color:var(--w503-navy);}
    .w503-sticky__toggle{display:none;}
    @media (min-width:560px){.w503-sticky__toggle{display:block;}}

    /* ---- pack duo ---- */
    .w503-pack__head{text-align:center;max-width:620px;margin:0 auto 40px;}
    .w503-pack__head h2{font-size:clamp(26px,3.4vw,38px);}
    .w503-pack__head p{margin-top:14px;color:var(--w503-gray);font-size:17px;}
    .w503-pack__grid{display:grid;grid-template-columns:1fr;gap:18px;max-width:760px;margin:0 auto;}
    @media (min-width:640px){.w503-pack__grid{grid-template-columns:1fr 1fr;}}
    .w503-pack__card{
      position:relative;display:block;width:100%;text-align:left;cursor:pointer;
      border:2px solid var(--w503-line);border-radius:20px;padding:26px 24px;background:#fff;
      font-family:inherit;transition:border-color .2s ease,box-shadow .2s ease;
    }
    .w503-pack__card:hover{border-color:#b9bcc7;}
    .w503-pack__card.is-selected{border-color:var(--w503-navy);box-shadow:0 0 0 3px rgba(12,30,74,.08);}
    .w503-pack__radio{position:absolute;top:22px;right:22px;width:20px;height:20px;border-radius:50%;border:2px solid var(--w503-line);}
    .w503-pack__card.is-selected .w503-pack__radio{border-color:var(--w503-navy);}
    .w503-pack__card.is-selected .w503-pack__radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--w503-navy);}
    .w503-pack__badge{display:inline-block;font-size:12px;font-weight:700;color:#fff;background:#e11d48;padding:4px 10px;border-radius:999px;margin-bottom:10px;letter-spacing:.02em;}
    .w503-pack__name{display:block;font-size:17px;font-weight:600;margin-bottom:6px;padding-right:32px;}
    .w503-pack__desc{display:block;font-size:14px;color:var(--w503-gray);margin-bottom:14px;}
    .w503-pack__price{display:flex;align-items:baseline;gap:8px;}
    .w503-pack__price strong{font-size:22px;}
    .w503-pack__was{font-size:14px;color:var(--w503-gray);text-decoration:line-through;}
    .w503-pack__cta{margin-top:28px;text-align:center;}
    .w503-pack__cta .w503-btn{margin:0 auto;}
    .w503 .w503-pack__note{margin-top:22px;font-size:13px;color:var(--w503-gray);text-align:center;}
    .w503-pack{padding-bottom:24px;}

    /* ---- trust strip ---- */
    .w503-strip{
      display:flex;flex-wrap:wrap;justify-content:center;gap:14px;
      padding:28px 0;border-top:1px solid var(--w503-line);border-bottom:1px solid var(--w503-line);
    }
    .w503-strip__item{
      display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;
      padding:10px 18px;border-radius:999px;background:var(--w503-bg-alt);
    }
    .w503-strip__item svg{color:var(--w503-navy);flex-shrink:0;}
    .w503-strip__item--highlight{background:var(--w503-navy);color:#fff;}
    .w503-strip__item--highlight svg{color:#fff;}

    /* ---- features ---- */
    .w503-feature{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;padding:64px 0;}
    .w503-feature__media img{border-radius:24px;background:var(--w503-bg-alt);}
    .w503-feature__num{font-size:13px;font-weight:700;color:var(--w503-navy);letter-spacing:.08em;margin-bottom:14px;display:block;}
    .w503-feature h2{font-size:clamp(26px,3.4vw,38px);}
    .w503-feature__text{margin-top:18px;color:var(--w503-gray);font-size:17px;line-height:1.6;max-width:480px;}
    .w503-feature ul{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:12px;max-width:480px;}
    .w503-feature ul li{display:flex;gap:10px;font-size:15px;line-height:1.5;color:var(--w503-ink);}
    .w503-feature ul li svg{flex-shrink:0;margin-top:3px;color:var(--w503-success);}
    @media (min-width:900px){
      .w503-feature{grid-template-columns:1fr 1fr;gap:72px;}
      .w503-feature--reverse .w503-feature__media{order:2;}
      .w503-feature--reverse .w503-feature__body{order:1;}
    }

    /* ---- alarm compatibility highlight band ---- */
    .w503-alarm{
      background:var(--w503-navy);border-radius:28px;padding:56px 40px;color:#fff;
      display:grid;gap:28px;grid-template-columns:1fr;align-items:center;
    }
    @media (min-width:860px){.w503-alarm{grid-template-columns:1.1fr 1fr;padding:64px 56px;}}
    .w503-alarm__eyebrow{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#fde68a;margin-bottom:14px;}
    .w503-alarm h2{color:#fff;font-size:clamp(26px,3.4vw,38px);}
    .w503-alarm p{color:rgba(255,255,255,.78);margin-top:14px;font-size:16px;line-height:1.6;max-width:480px;}
    .w503-alarm ul{list-style:none;margin:0;padding:0;display:grid;gap:14px;}
    .w503-alarm ul li{display:flex;gap:12px;font-size:15px;line-height:1.4;color:#fff;background:rgba(255,255,255,.08);padding:14px 16px;border-radius:14px;}
    .w503-alarm ul li svg{flex-shrink:0;margin-top:2px;color:#fde68a;}

    /* ---- mid CTA band ---- */
    .w503-band{background:var(--w503-navy);color:#fff;border-radius:28px;padding:56px 32px;text-align:center;margin:24px 0;}
    .w503-band h2{color:#fff;font-size:clamp(24px,3vw,34px);max-width:620px;margin:0 auto;}
    .w503-band p{color:rgba(255,255,255,.72);margin-top:14px;font-size:16px;max-width:520px;margin-left:auto;margin-right:auto;}
    .w503-band .w503-btn{margin-top:26px;background:#fff;color:var(--w503-navy);}
    .w503-band .w503-btn .btn-fill{background:#e9e9ee;}

    /* ---- specs ---- */
    .w503-specs__head{text-align:center;max-width:640px;margin:0 auto 48px;}
    .w503-specs__head h2{font-size:clamp(26px,3.4vw,38px);}
    .w503-specs__head p{margin-top:14px;color:var(--w503-gray);font-size:17px;}
    .w503-specs__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--w503-line);border:1px solid var(--w503-line);border-radius:20px;overflow:hidden;}
    .w503-specs__item{background:#fff;padding:24px 28px;}
    .w503-specs__item dt{font-size:13px;font-weight:700;color:var(--w503-navy);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;}
    .w503-specs__item dd{margin:0;font-size:15px;color:var(--w503-ink);line-height:1.5;}
    @media (min-width:700px){.w503-specs__grid{grid-template-columns:1fr 1fr;}}
    @media (min-width:1000px){.w503-specs__grid{grid-template-columns:1fr 1fr 1fr;}}

    /* ---- guarantee band ---- */
    .w503-guarantee{display:grid;grid-template-columns:1fr;gap:28px;text-align:center;}
    @media (min-width:700px){.w503-guarantee{grid-template-columns:repeat(4,1fr);}}
    .w503-guarantee__item{padding:0 12px;}
    .w503-guarantee__item svg{color:var(--w503-navy);margin:0 auto 14px;display:block;}
    .w503-guarantee__item h3{font-size:16px;font-weight:600;}
    .w503-guarantee__item p{margin-top:8px;font-size:14px;color:var(--w503-gray);line-height:1.5;}

    /* ---- faq ---- */
    .w503-faq{max-width:760px;margin:0 auto;}
    .w503-faq h2{text-align:center;font-size:clamp(26px,3.4vw,38px);margin-bottom:40px;}
    .w503-faq details{border-bottom:1px solid var(--w503-line);padding:20px 0;}
    .w503-faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:17px;font-weight:500;}
    .w503-faq summary::-webkit-details-marker{display:none;}
    .w503-faq summary .w503-faq__icon{flex-shrink:0;transition:transform .25s ease;color:var(--w503-navy);}
    .w503-faq details[open] summary .w503-faq__icon{transform:rotate(45deg);}
    .w503-faq__a{margin-top:14px;color:var(--w503-gray);font-size:15px;line-height:1.6;max-width:660px;}

    /* ---- final cta ---- */
    .w503-final{text-align:center;}
    .w503-final h2{font-size:clamp(28px,4vw,44px);max-width:700px;margin:0 auto;}
    .w503-final p{margin-top:16px;color:var(--w503-gray);font-size:17px;}
    .w503-final__ctas{margin-top:32px;display:flex;flex-wrap:wrap;gap:14px;justify-content:center;}
    .w503-final__legal{margin-top:22px;font-size:13px;color:var(--w503-gray);}

    /* ---- reveal-on-scroll ---- */
    .w503-reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
    .w503-reveal.is-visible{opacity:1;transform:none;}
    @media (prefers-reduced-motion:reduce){
      .w503-reveal{opacity:1;transform:none;transition:none;}
      .w503-sticky{transition:none;}
    }
  </style>

  {%- comment -%} Hidden product form shared by every "Add to cart" button on this page {%- endcomment -%}
  {%- form 'product', product, id: form_id, data-type: 'add-to-cart-form', is: 'product-form', class: 'w503-visually-hidden' -%}
    <input type="hidden" name="id" value="{{ variant.id }}" disabled>
    <input type="hidden" name="quantity" value="1" id="W503Qty-{{ section.id }}">
    <button type="submit" name="add" tabindex="-1" aria-hidden="true"></button>
    <div class="product-form__error-message alert alert--error" role="alert" hidden style="position:fixed;left:16px;right:16px;bottom:84px;z-index:70;background:#fff;border:1px solid #e11d48;color:#e11d48;padding:12px 16px;border-radius:12px;font-size:14px;"></div>
  {%- endform -%}
  <style>.w503-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}</style>

  {%- comment -%} Sticky add-to-cart bar {%- endcomment -%}
  <div class="w503-sticky" id="W503Sticky-{{ section.id }}">
    <div class="w503-sticky__info">
      <div class="w503-sticky__thumb">
        {%- if hero_image -%}
          {{ hero_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '80,160' }}
        {%- endif -%}
      </div>
      <div class="w503-sticky__name">{{ product.title }}</div>
    </div>
    {%- unless includes_solar -%}
      <div class="w503-sticky__toggle">
        {%- render 'w503-pack-toggle', compact: true -%}
      </div>
    {%- endunless -%}
    {%- render 'w503-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
  </div>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="w503-hero">
    <div class="w503-wrap">
      <span class="w503-eyebrow">Daewoo Security · W503</span>
      <h1>Elle s'installe où vous voulez.<br>Elle protège comme il faut.</h1>
      <p class="w503-hero__sub">
        {%- if includes_solar -%}
          Caméra extérieure 100&nbsp;% sans fil, livrée avec son panneau solaire pour une autonomie
          quasi illimitée. Compatible avec toutes les alarmes Daewoo Security.
        {%- else -%}
          Caméra extérieure 100&nbsp;% sans fil, batterie rechargeable, vision nocturne couleur et
          infrarouge. Compatible avec toutes les alarmes Daewoo Security.
        {%- endif -%}
      </p>
      <div class="w503-hero__cta">
        {%- unless includes_solar -%}
          <div class="w503-hero__toggle">
            {%- render 'w503-pack-toggle' -%}
          </div>
        {%- endunless -%}
        <div id="W503HeroCta-{{ section.id }}">
          {%- render 'w503-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
        </div>
        <div class="w503-hero__price">
          {%- if has_compare -%}
            <span class="w503-hero__compare">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
          <strong>{{ variant.price | money }}</strong> · paiement sécurisé
        </div>
        <div class="w503-hero__rating">
          {%- render 'product-rating', product: product -%}
        </div>
      </div>
      <div class="w503-hero__trust">
        <span>🔋 100% sans fil</span>
        <span>🚫 Sans abonnement</span>
        <span>🌙 Vision couleur & infrarouge</span>
        <span>🔔 Sirène 75&nbsp;dB</span>
      </div>
      {%- if hero_image -%}
        <div class="w503-hero__media w503-reveal">
          {{ hero_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600,900,1200,1600', alt: product.title }}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} Trust strip {%- endcomment -%}
  <div class="w503-wrap">
    <div class="w503-strip w503-reveal">
      <div class="w503-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Installation en quelques minutes
      </div>
      <div class="w503-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Sans abonnement, à vie
      </div>
      <div class="w503-strip__item w503-strip__item--highlight">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Compatible toutes alarmes Daewoo
      </div>
      <div class="w503-strip__item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Garantie 2 ans
      </div>
    </div>
  </div>

  {%- unless includes_solar -%}
    {%- comment -%} Pack Duo highlight — 2nd camera at -50% {%- endcomment -%}
    <section class="w503-section w503-pack">
      <div class="w503-wrap">
        <div class="w503-pack__head w503-reveal">
          <h2>Économisez avec le Pack Duo</h2>
          <p>Couvrez deux angles de votre extérieur — la 2ᵉ caméra est à -50%.</p>
        </div>

