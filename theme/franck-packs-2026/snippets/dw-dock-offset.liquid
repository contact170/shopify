{%- comment -%}
  Audit S46 (14/11/2026) : sur mobile, la barre de navigation du bas (mobile-dock)
  recouvrait les barres collantes (accueil « Trouver mon alarme », barre d'achat des
  fiches accessoires, barre W512MW). Ce script mesure la hauteur de dock visible
  et remonte ces barres d'autant. Pour annuler : retirer render 'dw-dock-offset'
  dans layout/theme.liquid.
{%- endcomment -%}
<style>
  @media screen and (max-width: 767px) {
    .dwh-collant.est-visible, .w512-sticky.is-shown, .accp-barre.est-visible { bottom: var(--dw-dock-offset, 0px) !important; }
  }
</style>
<script>
  (function () {
    var dock = document.querySelector('nav.mobile-dock');
    if (!dock) return;
    var racine = document.documentElement;
    var attente = 0;
    function mesure() {
      attente = 0;
      var decalage = 0;
      var style = getComputedStyle(dock);
      if (style.display !== 'none' && style.visibility !== 'hidden') {
        decalage = Math.max(0, Math.round(window.innerHeight - dock.getBoundingClientRect().top));
      }
      racine.style.setProperty('--dw-dock-offset', decalage + 'px');
    }
    function planifie() { if (!attente) attente = requestAnimationFrame(mesure); }
    /* suit le dock image par image pendant son animation (~0,5 s) */
    function suit() {
      var n = 0;
      (function boucle() { mesure(); if (++n < 40) requestAnimationFrame(boucle); })();
    }
    addEventListener('scroll', planifie, { passive: true });
    addEventListener('resize', planifie);
    dock.addEventListener('transitionrun', suit);
    /* le dock change d'etat par des classes / attributs (section active, loaded...) */
    if ('MutationObserver' in window) {
      var obs = new MutationObserver(suit);
      obs.observe(dock, { attributes: true });
      var section = dock.closest('.mobile-dock-section');
      if (section) obs.observe(section, { attributes: true });
      var entete = document.querySelector('.header-section');
      if (entete) obs.observe(entete, { attributes: true, attributeFilter: ['class'] });
    }
    dock.addEventListener('transitionend', mesure);
    /* la feuille du dock se charge en differe : nouvelles mesures pendant les premieres secondes */
    addEventListener('load', mesure);
    [300, 1000, 2500].forEach(function (t) { setTimeout(mesure, t); });
    mesure();
  })();
</script>
