          {%- assign acc_variant = acc.variants.first -%}
          {%- if acc.available and acc_variant -%}
            {%- liquid
              assign acc_is_zigbee = true
              case acc_variant.sku
                when 'EXT501ZIG'
                  assign acc_name = 'Amplificateur Zigbee EXT501ZIG'
