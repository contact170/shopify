                  assign acc_why = ''
                  assign acc_is_zigbee = false
              endcase
            -%}
            <div class="pe-acc__card" data-pe-acc data-pe-acc-id="{{ acc_variant.id }}" data-pe-acc-price="{{ acc_variant.price }}">
              {%- if acc.featured_image -%}
