{% render 'dw-home-head' %}

<div class="dwh">
  <section class="dwh-bloc dwh-sombre dwh-final" aria-labelledby="dwh-final-{{ section.id }}">
    <div class="dwh-large">
      {%- if section.settings.notif_title != blank -%}
        <div class="dwh-notif dwh-notif--ok dwh-final__notif" aria-hidden="true">
          <span class="dwh-notif__app">{% render 'dw-home-icon', icon: 'shield' %}</span>
          <span class="dwh-notif__txt">
            <span class="dwh-notif__titre">{{ section.settings.notif_title }}</span>
            <span class="dwh-notif__corps">{{ section.settings.notif_text }}</span>
          </span>
          <span class="dwh-notif__quand">maintenant</span>
        </div>
      {%- endif -%}
      <h2 class="dwh-titre" id="dwh-final-{{ section.id }}">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      <div class="dwh-final__actions">
        <a class="dwh-btn dwh-btn--blanc" href="{{ section.settings.cta_1_link | default: '#dwh-packs' }}">
          {{ section.settings.cta_1_label }}
          {% render 'dw-home-icon', icon: 'arrow' %}
        </a>
        {%- if section.settings.cta_2_label != blank -%}
          <a class="dwh-lien" href="{{ section.settings.cta_2_link }}">{{ section.settings.cta_2_label }} {% render 'dw-home-icon', icon: 'arrow' %}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.meta != blank -%}
        <p class="dwh-final__mentions">{{ section.settings.meta }}</p>
      {%- endif -%}
    </div>
  </section>
  <div class="dwh-espace-collant" aria-hidden="true"></div>
</div>

{% schema %}
{
  "name": "V2 · Appel à l'action",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "notif_title", "label": "Notification (titre)", "default": "Alarme activée" },
    { "type": "text", "id": "notif_text", "label": "Notification (texte)", "default": "Votre maison est protégée" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Prêt à protéger votre maison ?" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Un pack complet, posé par vous ce soir. Et plus jamais d'abonnement." },
    { "type": "text", "id": "cta_1_label", "label": "Bouton principal", "default": "Choisir mon pack" },
    { "type": "url", "id": "cta_1_link", "label": "Lien", "info": "Vide = remonte aux packs." },
    { "type": "text", "id": "cta_2_label", "label": "Lien secondaire", "default": "ou me faire guider en 2 min" },
    { "type": "url", "id": "cta_2_link", "label": "URL" },
    { "type": "text", "id": "meta", "label": "Mentions", "default": "Expédié sous 24 h · Garantie 2 ans · Retour sous 14 jours" }
  ],
  "presets": [{ "name": "V2 · Appel à l'action" }]
}
{% endschema %}
