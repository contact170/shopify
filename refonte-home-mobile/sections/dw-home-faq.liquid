{% render 'dw-home-head' %}

<div class="dwh">
  <section class="dwh-bloc dwh-bloc--porcelaine" aria-labelledby="dwh-faq-{{ section.id }}">
    <div class="dwh-large dwh-deux">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-faq-{{ section.id }}">{{ section.settings.title }}</h2>
      </div>

      <div>
        <div class="dwh-faq">
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="dwh-faq__rep">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
        {%- if section.settings.more_label != blank -%}
          <p class="dwh-faq__plus">{{ section.settings.more_text }} <a class="dwh-lien" href="{{ section.settings.more_link }}">{{ section.settings.more_label }}</a></p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Home V2 · FAQ",
  "tag": "div",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Questions fréquentes"},
    {"type": "text", "id": "title", "label": "Titre", "default": "Tout savoir avant de vous équiper."},
    {"type": "checkbox", "id": "schema_markup", "label": "Données structurées FAQ (SEO)", "default": true},
    {"type": "text", "id": "more_text", "label": "Texte bas de section", "default": "Une autre question ?"},
    {"type": "text", "id": "more_label", "label": "Lien", "default": "Écrivez à notre équipe"},
    {"type": "url", "id": "more_link", "label": "URL"}
  ],
  "blocks": [
    {"type": "qa", "name": "Question", "settings": [{"type": "text", "id": "question", "label": "Question"}, {"type": "richtext", "id": "answer", "label": "Réponse"}]}
  ],
  "presets": [
    {"name": "Home V2 · FAQ", "blocks": [{"type": "qa", "settings": {"question": "Vos alarmes fonctionnent-elles vraiment sans abonnement ?", "answer": "<p>Oui : vous achetez le matériel une fois, il est à vous.</p>"}}]}
  ]
}
{% endschema %}
