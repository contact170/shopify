{% render 'dw-home-head' %}

<div class="dwh">
  <section class="dwh-bloc" aria-labelledby="dwh-vedettes-{{ section.id }}">
    <div class="dwh-large">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-vedettes-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="dwh-vedettes">
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            if p == blank
              continue
            endif
            assign visuel = block.settings.image | default: p.featured_image
            assign nom = block.settings.title | default: p.title
            assign lignes = block.settings.contents | newline_to_br | split: '<br />'
          -%}
          <article class="dwh-vedette" {{ block.shopify_attributes }}>
            <a class="dwh-vedette__visuel" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {%- if visuel != blank -%}
                {{ visuel | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 45vw, 92vw', loading: 'lazy', alt: nom }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="dwh-pack__badge">{{ block.settings.badge }}</span>{%- endif -%}
            </a>
            <div class="dwh-vedette__corps">
              <h3 class="dwh-vedette__nom"><a href="{{ p.url }}">{{ nom }}</a></h3>
              {%- if block.settings.pitch != blank -%}<p class="dwh-vedette__pitch">{{ block.settings.pitch }}</p>{%- endif -%}
              {%- if block.settings.contents != blank -%}
                <p class="dwh-vedette__inclus">{{ section.settings.contents_label }}</p>
                <ul class="dwh-puces dwh-vedette__liste">
                  {%- for ligne in lignes -%}
                    {%- assign l = ligne | strip -%}
                    {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="dwh-pack__prix">
                <div>
                  <span class="dwh-pack__des">{% if p.price_varies %}{{ section.settings.from_label }}{% else %}{{ section.settings.price_label }}{% endif %}</span>
                  <span class="dwh-pack__montant">{{ p.price_min | money }}</span>
                  {%- if p.compare_at_price_min > p.price_min -%}
                    <span class="dwh-vedette__barre">{{ p.compare_at_price_min | money }}</span>
                  {%- endif -%}
                </div>
                <span class="dwh-pack__mois">0&nbsp;€/mois</span>
              </div>
              <a class="dwh-btn dwh-btn--bleu" href="{{ p.url }}">
                {{ section.settings.cta_label }}
                {% render 'dw-home-icon', icon: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.all_label != blank -%}
        <p class="dwh-vedettes__tout">
          <a class="dwh-lien" href="{{ section.settings.all_link }}">{{ section.settings.all_label }} {% render 'dw-home-icon', icon: 'arrow' %}</a>
        </p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Home V2 · Packs vedettes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les plus choisis" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos packs prêts à poser" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "contents_label", "label": "Titre de la liste", "default": "Dans la boîte" },
    { "type": "text", "id": "from_label", "label": "Texte avant le prix (plusieurs versions)", "default": "Dès" },
    { "type": "text", "id": "price_label", "label": "Texte avant le prix (une version)", "default": "Prix" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Voir le pack" },
    { "type": "text", "id": "all_label", "label": "Lien sous les packs", "default": "Voir tous les packs" },
    { "type": "url", "id": "all_link", "label": "URL" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "limit": 3,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Ex. : Le plus vendu" },
        { "type": "text", "id": "title", "label": "Nom court (sinon titre du produit)" },
        { "type": "image_picker", "id": "image", "label": "Photo (sinon celle du produit)" },
        { "type": "text", "id": "pitch", "label": "Phrase d'accroche" },
        { "type": "textarea", "id": "contents", "label": "Contenu du pack", "info": "Un élément par ligne." }
      ]
    }
  ],
  "presets": [{ "name": "Home V2 · Packs vedettes", "blocks": [{ "type": "pack" }, { "type": "pack" }] }]
}
{% endschema %}
