{% render 'dw-home-head' %}
<style>.dwh-vedette:not(.is-visible) { display: none; }</style>

<div class="dwh">
  <section class="dwh-bloc" aria-labelledby="dwh-vedettes-{{ section.id }}">
    <div class="dwh-large">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-vedettes-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- comment -%}
        Rotation : les packs « toujours affichés » passent en premier, puis le script tire au sort
        les autres pour compléter jusqu'à `count` packs (même tirage pendant toute la visite).
        Sans JavaScript, on affiche les premiers packs dans l'ordre de l'éditeur.
      {%- endcomment -%}
      {%- liquid
        assign nb = section.settings.count | default: 2
        assign rang = 0
        assign ordre = ''
        for block in section.blocks
          if block.settings.product != blank and block.settings.pinned
            assign ordre = ordre | append: block.id | append: ','
          endif
        endfor
        for block in section.blocks
          if block.settings.product != blank and block.settings.pinned != true
            assign ordre = ordre | append: block.id | append: ','
          endif
        endfor
        assign ordre = ordre | split: ','
      -%}
      <div class="dwh-vedettes" id="dwh-vedettes-liste-{{ section.id }}" data-dwh-vedettes="{{ nb }}">
        {%- for id in ordre -%}
          {%- liquid
            if id == blank
              continue
            endif
            assign block = nil
            for b in section.blocks
              if b.id == id
                assign block = b
                break
              endif
            endfor
          -%}
          {%- liquid
            assign p = block.settings.product
            if block == nil or p == blank
              continue
            endif
            assign visuel = block.settings.image | default: p.featured_image
            assign nom = block.settings.title | default: p.title
            assign lignes = block.settings.contents | newline_to_br | split: '<br />'
            assign rang = rang | plus: 1
          -%}
          <article class="dwh-vedette{% if rang <= nb %} is-visible{% endif %}" data-pack="{{ p.handle }}"{% if block.settings.pinned %} data-fixe{% endif %} {{ block.shopify_attributes }}>
            <a class="dwh-vedette__visuel" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {%- if visuel != blank -%}
                {{ visuel | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 45vw, 92vw', loading: 'lazy', alt: nom }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="dwh-pack__badge">{{ block.settings.badge }}</span>{%- endif -%}
            </a>
            <div class="dwh-vedette__corps">
              <h3 class="dwh-vedette__nom"><a href="{{ p.url }}">{{ nom }}</a></h3>
              {%- if block.settings.pitch != blank -%}<p class="dwh-vedette__pitch">{{ block.settings.pitch }}</p>{%- endif -%}
              {%- if block.settings.contents != blank -%}
                <p class="dwh-vedette__inclus">{{ section.settings.contents_label }}</p>
                <ul class="dwh-puces dwh-vedette__liste">
                  {%- for ligne in lignes -%}
                    {%- assign l = ligne | strip -%}
                    {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="dwh-pack__prix">
                <div>
                  <span class="dwh-pack__des">{% if p.price_varies %}{{ section.settings.from_label }}{% else %}{{ section.settings.price_label }}{% endif %}</span>
                  <span class="dwh-pack__montant">{{ p.price_min | money }}</span>
                  {%- if p.compare_at_price_min > p.price_min -%}
                    <span class="dwh-vedette__barre">{{ p.compare_at_price_min | money }}</span>
                  {%- endif -%}
                </div>
                <span class="dwh-pack__mois">0&nbsp;€/mois</span>
              </div>
              <a class="dwh-btn dwh-btn--bleu" href="{{ p.url }}">
                {{ section.settings.cta_label }}
                {% render 'dw-home-icon', icon: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.all_label != blank -%}
        <p class="dwh-vedettes__tout">
          <a class="dwh-lien" href="{{ section.settings.all_link }}">{{ section.settings.all_label }} {% render 'dw-home-icon', icon: 'arrow' %}</a>
        </p>
      {%- endif -%}
    </div>
  </section>
</div>

<script>
  (function () {
    var liste = document.getElementById('dwh-vedettes-liste-{{ section.id }}');
    if (!liste) return;
    var nb = parseInt(liste.getAttribute('data-dwh-vedettes'), 10) || 2;
    var packs = Array.prototype.slice.call(liste.querySelectorAll('.dwh-vedette'));
    var fixes = packs.filter(function (el) { return el.hasAttribute('data-fixe'); });
    var autres = packs.filter(function (el) { return !el.hasAttribute('data-fixe'); });
    var cle = 'dwh_vedettes_{{ section.id }}';
    var choisis = null;

    // Même sélection pendant toute la visite : le pack ne change pas si le client revient sur l'accueil.
    try {
      var memo = JSON.parse(sessionStorage.getItem(cle) || 'null');
      if (Array.isArray(memo)) {
        choisis = autres.filter(function (el) { return memo.indexOf(el.getAttribute('data-pack')) > -1; });
      }
    } catch (e) {}

    var place = Math.max(nb - fixes.length, 0);
    if (!choisis || choisis.length !== Math.min(place, autres.length)) {
      var melange = autres.slice();
      for (var i = melange.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = melange[i]; melange[i] = melange[j]; melange[j] = t;
      }
      choisis = melange.slice(0, place);
      try {
        sessionStorage.setItem(cle, JSON.stringify(choisis.map(function (el) { return el.getAttribute('data-pack'); })));
      } catch (e) {}
    }

    var visibles = fixes.slice(0, nb).concat(choisis);
    packs.forEach(function (el) {
      el.classList.toggle('is-visible', visibles.indexOf(el) > -1);
    });

    // Suivi : quels packs ont été montrés, et lesquels ont été cliqués.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'dwh_vedettes_affichees',
      dwh_packs: visibles.map(function (el) { return el.getAttribute('data-pack'); }).join(',')
    });
    visibles.forEach(function (el, index) {
      el.querySelectorAll('a').forEach(function (lien) {
        lien.addEventListener('click', function () {
          window.dataLayer.push({ event: 'dwh_vedette_clic', dwh_pack: el.getAttribute('data-pack'), dwh_position: index + 1 });
        });
      });
    });

    // Éditeur de thème : un pack sélectionné dans la barre latérale s'affiche, même hors tirage.
    document.addEventListener('shopify:block:select', function (e) {
      if (liste.contains(e.target)) e.target.classList.add('is-visible');
    });
  })();
</script>

{% schema %}
{
  "name": "Home V2 · Packs vedettes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les plus choisis" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos packs prêts à poser" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "range", "id": "count", "label": "Nombre de packs affichés", "min": 1, "max": 3, "step": 1, "default": 2, "info": "Les packs « toujours affichés » sont montrés en premier. Les autres places sont tirées au sort parmi les packs restants, une fois par visite." },
    { "type": "text", "id": "contents_label", "label": "Titre de la liste", "default": "Dans la boîte" },
    { "type": "text", "id": "from_label", "label": "Texte avant le prix (plusieurs versions)", "default": "Dès" },
    { "type": "text", "id": "price_label", "label": "Texte avant le prix (une version)", "default": "Prix" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Voir le pack" },
    { "type": "text", "id": "all_label", "label": "Lien sous les packs", "default": "Voir tous les packs" },
    { "type": "url", "id": "all_link", "label": "URL" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "limit": 8,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "checkbox", "id": "pinned", "label": "Toujours affiché", "default": false, "info": "Décoché : le pack entre dans la rotation." },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Ex. : Le plus vendu" },
        { "type": "text", "id": "title", "label": "Nom court (sinon titre du produit)" },
        { "type": "image_picker", "id": "image", "label": "Photo (sinon celle du produit)" },
        { "type": "text", "id": "pitch", "label": "Phrase d'accroche" },
        { "type": "textarea", "id": "contents", "label": "Contenu du pack", "info": "Un élément par ligne." }
      ]
    }
  ],
  "presets": [{ "name": "Home V2 · Packs vedettes", "blocks": [{ "type": "pack" }, { "type": "pack" }] }]
}
{% endschema %}
