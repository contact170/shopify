{% render 'dw-home-head' %}

<div class="dwh">
  <section class="dwh-bloc" aria-labelledby="dwh-atouts-{{ section.id }}">
    <div class="dwh-large dwh-deux">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-atouts-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div>
        <ul class="dwh-atouts">
          {%- for block in section.blocks -%}
            <li class="dwh-atout" {{ block.shopify_attributes }}>
              {% render 'dw-home-icon', icon: block.settings.icon %}
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.link_label != blank -%}
          <p style="margin-top:12px"><a class="dwh-lien" href="{{ section.settings.link }}">{{ section.settings.link_label }} {% render 'dw-home-icon', icon: 'arrow' %}</a></p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Home V2 · Pourquoi nous",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Pourquoi Daewoo Security" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une marque connue depuis 1971. Une équipe en France." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Plus de 60 000 alarmes et caméras vendues. Et quelqu'un pour vous répondre, avant comme après l'achat." },
    { "type": "text", "id": "link_label", "label": "Lien bas de section", "default": "Qui sommes-nous" },
    { "type": "url", "id": "link", "label": "URL", "default": "/pages/a-propos" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Atout",
      "limit": 6,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "shield",
          "options": [
            { "value": "support", "label": "Support" },
            { "value": "wifi-off", "label": "Coupure" },
            { "value": "paw", "label": "Animaux" },
            { "value": "phone", "label": "Smartphone" },
            { "value": "move", "label": "Déménagement" },
            { "value": "plus", "label": "Évolutif" },
            { "value": "bell", "label": "Sirène" },
            { "value": "shield", "label": "Bouclier" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home V2 · Pourquoi nous",
      "blocks": [
        { "type": "feature", "settings": { "icon": "bell", "title": "Une vraie dissuasion", "text": "En cas d'intrusion, la sirène de 110 dB retentit et vous êtes prévenu immédiatement sur votre téléphone." } },
        { "type": "feature", "settings": { "icon": "wifi-off", "title": "Coupure de courant ? Rien ne s'arrête", "text": "La centrale passe sur sa batterie de secours, de 4 h à 20 h selon le modèle." } },
        { "type": "feature", "settings": { "icon": "paw", "title": "Pensé pour les animaux", "text": "Les détecteurs de mouvement ignorent les animaux jusqu'à 10 kg." } },
        { "type": "feature", "settings": { "icon": "move", "title": "Il vous suit si vous déménagez", "text": "Sans fil et sans contrat : idéal aussi pour les locataires." } }
      ]
    }
  ]
}
{% endschema %}
