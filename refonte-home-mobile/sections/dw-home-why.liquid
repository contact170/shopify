{{ 'dw-home.css' | asset_url | stylesheet_tag }}

<div class="dwh">
  <section class="dwh-section{% if section.settings.alt_bg %} dwh-section--alt{% endif %}" aria-labelledby="dwh-why-{{ section.id }}">
    <div class="dwh-wrap">
      <div class="dwh-head dwh-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-h2" id="dwh-why-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="dwh-proof-stats">
        {%- for i in (1..3) -%}
          {%- liquid
            assign k_num = 'stat_' | append: i | append: '_num'
            assign k_label = 'stat_' | append: i | append: '_label'
          -%}
          {%- if section.settings[k_num] != blank -%}
            <div class="dwh-proof-stat">
              <strong>{{ section.settings[k_num] }}</strong>
              <span>{{ section.settings[k_label] }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="dwh-features">
        {%- for block in section.blocks -%}
          <div class="dwh-feature" {{ block.shopify_attributes }}>
            <span class="dwh-feature__icon">{% render 'dw-home-icon', icon: block.settings.icon %}</span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.link_label != blank -%}
        <p class="dwh-faq__more"><a class="dwh-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Home V2 · Pourquoi nous",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Depuis 2015" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une marque française qui reste à vos côtés" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fond bleuté", "default": true },
    { "type": "text", "id": "stat_1_num", "label": "Chiffre 1", "default": "60 000+" },
    { "type": "text", "id": "stat_1_label", "label": "Libellé 1", "default": "foyers équipés" },
    { "type": "text", "id": "stat_2_num", "label": "Chiffre 2", "default": "4,6/5" },
    { "type": "text", "id": "stat_2_label", "label": "Libellé 2", "default": "900+ avis clients" },
    { "type": "text", "id": "stat_3_num", "label": "Chiffre 3", "default": "10 min" },
    { "type": "text", "id": "stat_3_label", "label": "Libellé 3", "default": "pour installer" },
    { "type": "text", "id": "link_label", "label": "Lien bas de section", "default": "En savoir plus sur Daewoo Security" },
    { "type": "url", "id": "link", "label": "URL", "default": "/pages/a-propos" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Argument",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "shield",
          "options": [
            { "value": "support", "label": "Support" },
            { "value": "wifi-off", "label": "Wi-Fi coupé" },
            { "value": "paw", "label": "Animaux" },
            { "value": "phone", "label": "Smartphone" },
            { "value": "tools", "label": "Installation" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "badge", "label": "Garantie" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home V2 · Pourquoi nous",
      "blocks": [
        { "type": "feature", "settings": { "icon": "support", "title": "Un SAV en France, à Mérignac", "text": "Une vraie équipe répond à vos questions avant et après l'achat. Pas de plateforme à l'étranger." } },
        { "type": "feature", "settings": { "icon": "wifi-off", "title": "Wi-Fi coupé ? Toujours protégé", "text": "Batterie de secours intégrée et option 4G : l'alarme reste active même sans internet ni courant." } },
        { "type": "feature", "settings": { "icon": "paw", "title": "Compatible avec vos animaux", "text": "Des détecteurs qui font la différence entre votre chien et un intrus : pas de fausses alertes." } },
        { "type": "feature", "settings": { "icon": "phone", "title": "Une seule app gratuite", "text": "Alarme, caméras et domotique réunies dans une application iOS et Android, sans frais." } }
      ]
    }
  ]
}
{% endschema %}
