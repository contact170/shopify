{% render 'dw-home-head' %}

<div class="dwh">
  <section class="dwh-bloc dwh-bloc--porcelaine" aria-labelledby="dwh-etapes-{{ section.id }}">
    <div class="dwh-large">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-etapes-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <ol class="dwh-etapes">
        {%- for block in section.blocks -%}
          <li class="dwh-etape" {{ block.shopify_attributes }}>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Home V2 · Comment ça marche",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Comment ça marche" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Protégé ce soir, sans technicien." },
    { "type": "textarea", "id": "text", "label": "Texte" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home V2 · Comment ça marche",
      "blocks": [
        { "type": "step", "settings": { "title": "Vous recevez un pack complet", "text": "Expédié sous 24 h. Centrale, détecteurs, sirène : tout est dans la boîte." } },
        { "type": "step", "settings": { "title": "Vous l'installez en moins de 30 minutes", "text": "Sans perçage ni câblage : tout se fixe en adhésif. Vous scannez un QR code, l'application vous guide." } },
        { "type": "step", "settings": { "title": "Vous êtes prévenu où que vous soyez", "text": "Une intrusion ? La sirène retentit et vous recevez une alerte sur votre téléphone, avec la caméra en direct." } }
      ]
    }
  ]
}
{% endschema %}
