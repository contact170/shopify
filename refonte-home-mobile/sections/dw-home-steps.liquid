{{ 'dw-home.css' | asset_url | stylesheet_tag }}

<div class="dwh">
  <section class="dwh-section{% if section.settings.alt_bg %} dwh-section--alt{% endif %}" aria-labelledby="dwh-steps-{{ section.id }}">
    <div class="dwh-wrap">
      <div class="dwh-head dwh-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-h2" id="dwh-steps-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <ol class="dwh-steps">
        {%- for block in section.blocks -%}
          <li class="dwh-step" {{ block.shopify_attributes }}>
            <span class="dwh-step__num" aria-hidden="true"></span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Home V2 · Comment ça marche",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Simple comme 1, 2, 3" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Protégé dès ce soir, sans technicien" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fond bleuté", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home V2 · Comment ça marche",
      "blocks": [
        { "type": "step", "settings": { "title": "Choisissez votre pack", "text": "Selon votre logement, ou composez-le vous-même en 2 minutes avec notre configurateur." } },
        { "type": "step", "settings": { "title": "Installez-le en 10 minutes", "text": "Tout est sans fil : on colle les détecteurs, on branche la centrale, l'application vous guide pas à pas." } },
        { "type": "step", "settings": { "title": "Pilotez tout depuis votre téléphone", "text": "Armez, désarmez, regardez vos caméras et recevez une alerte à la moindre intrusion. Sans payer d'abonnement." } }
      ]
    }
  ]
}
{% endschema %}
