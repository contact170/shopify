{% render 'dw-home-head' %}

{%- liquid
  assign actif = 0
  for block in section.blocks
    if block.settings.featured
      assign actif = forloop.index0
      break
    endif
  endfor
  assign gamme_active = section.blocks[actif]
-%}

<div class="dwh" id="dwh-packs">
  <section class="dwh-bloc dwh-bloc--porcelaine" aria-labelledby="dwh-parcours-titre-{{ section.id }}">
    <div class="dwh-large">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-parcours-titre-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <ol class="dwh-parcours">
        {%- comment -%} Étape 1 : la centrale {%- endcomment -%}
        <li class="dwh-parcours__etape">
          <div class="dwh-parcours__tete">
            <span class="dwh-parcours__num" aria-hidden="true">1</span>
            <div>
              <h3 class="dwh-parcours__titre">{{ section.settings.step1_title }}</h3>
              {%- if section.settings.step1_text != blank -%}<p class="dwh-parcours__texte">{{ section.settings.step1_text }}</p>{%- endif -%}
            </div>
          </div>

          {%- if section.blocks.size > 1 -%}
            <div
              class="dwh-selecteur"
              role="tablist"
              aria-label="{{ section.settings.step1_title | escape }}"
              style="--n: {{ section.blocks.size }}; --i: {{ actif }};"
              data-dwh-selecteur
              hidden
            >
              <span class="dwh-selecteur__curseur" aria-hidden="true"></span>
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  class="dwh-onglet"
                  role="tab"
                  id="dwh-onglet-{{ block.id }}"
                  aria-controls="dwh-pack-{{ block.id }}"
                  aria-selected="{% if forloop.index0 == actif %}true{% else %}false{% endif %}"
                  tabindex="{% if forloop.index0 == actif %}0{% else %}-1{% endif %}"
                  data-nom="{{ block.settings.tab_label | escape }}"
                  data-lien="{{ block.settings.packs_link | default: section.settings.pack_link }}"
                >
                  {{ block.settings.tab_label }}
                  {%- if block.settings.tab_sub != blank -%}<small>{{ block.settings.tab_sub }}</small>{%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="dwh-packs" data-dwh-packs>
            {%- for block in section.blocks -%}
              {%- liquid
                assign p = block.settings.product
                assign visuel = block.settings.image | default: p.featured_image
                assign lien = block.settings.packs_link | default: section.settings.pack_link
              -%}
              <article
                class="dwh-gamme"
                id="dwh-pack-{{ block.id }}"
                role="tabpanel"
                aria-labelledby="dwh-onglet-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <div class="dwh-gamme__visuel">
                  {%- if visuel != blank -%}
                    {{ visuel | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(min-width: 750px) 40vw, 100vw', loading: 'lazy', alt: block.settings.title }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}<span class="dwh-pack__badge">{{ block.settings.badge }}</span>{%- endif -%}
                </div>
                <div class="dwh-gamme__corps">
                  <h4 class="dwh-gamme__nom">{{ block.settings.title }}</h4>
                  {%- if block.settings.description != blank -%}<p class="dwh-gamme__pour">{{ block.settings.description }}</p>{%- endif -%}
                  <ul class="dwh-puces">
                    {%- if block.settings.bullet_1 != blank -%}<li>{{ block.settings.bullet_1 }}</li>{%- endif -%}
                    {%- if block.settings.bullet_2 != blank -%}<li>{{ block.settings.bullet_2 }}</li>{%- endif -%}
                    {%- if block.settings.bullet_3 != blank -%}<li>{{ block.settings.bullet_3 }}</li>{%- endif -%}
                  </ul>
                  {%- if p != blank -%}
                    <div class="dwh-pack__prix">
                      <div>
                        <span class="dwh-pack__des">{{ section.settings.price_label }}</span>
                        <span class="dwh-pack__montant">{{ p.price_min | money }}</span>
                      </div>
                      <span class="dwh-pack__mois">0&nbsp;€/mois</span>
                    </div>
                  {%- endif -%}
                  <a class="dwh-lien" href="{{ lien }}">{{ section.settings.range_link_label }} {{ block.settings.tab_label }} {% render 'dw-home-icon', icon: 'arrow' %}</a>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </li>

        {%- comment -%} Étape 2 : la formule {%- endcomment -%}
        <li class="dwh-parcours__etape">
          <div class="dwh-parcours__tete">
            <span class="dwh-parcours__num" aria-hidden="true">2</span>
            <div>
              <h3 class="dwh-parcours__titre">{{ section.settings.step2_title }}</h3>
              {%- if section.settings.step2_text != blank -%}<p class="dwh-parcours__texte">{{ section.settings.step2_text }}</p>{%- endif -%}
            </div>
          </div>
          <div class="dwh-formules">
            <a class="dwh-formule dwh-formule--pack" href="{{ gamme_active.settings.packs_link | default: section.settings.pack_link }}" data-dwh-lien-packs>
              <span class="dwh-formule__tag">{{ section.settings.pack_tag }}</span>
              <span class="dwh-formule__titre">{{ section.settings.pack_title }}</span>
              <span class="dwh-formule__texte">{{ section.settings.pack_text }}</span>
              <span class="dwh-formule__cta">{{ section.settings.pack_cta }} <span data-dwh-nom-gamme>{{ gamme_active.settings.tab_label }}</span> {% render 'dw-home-icon', icon: 'arrow' %}</span>
            </a>
            <a class="dwh-formule" href="{{ section.settings.config_link }}">
              <span class="dwh-formule__tag">{{ section.settings.config_tag }}</span>
              <span class="dwh-formule__titre">{{ section.settings.config_title }}</span>
              <span class="dwh-formule__texte">{{ section.settings.config_text }}</span>
              <span class="dwh-formule__cta">{{ section.settings.config_cta }} {% render 'dw-home-icon', icon: 'arrow' %}</span>
            </a>
          </div>
        </li>

        {%- comment -%} Étape 3 : réception et installation {%- endcomment -%}
        <li class="dwh-parcours__etape">
          <div class="dwh-parcours__tete">
            <span class="dwh-parcours__num" aria-hidden="true">3</span>
            <div>
              <h3 class="dwh-parcours__titre">{{ section.settings.step3_title }}</h3>
              {%- if section.settings.step3_text != blank -%}<p class="dwh-parcours__texte">{{ section.settings.step3_text }}</p>{%- endif -%}
            </div>
          </div>
        </li>
      </ol>

      <nav class="dwh-liens" aria-label="Besoin d'aide pour choisir">
        {%- if section.settings.quiz_title != blank -%}
          <a href="{{ section.settings.quiz_link }}"><span><b>{{ section.settings.quiz_title }}</b> · {{ section.settings.quiz_text }}</span>{% render 'dw-home-icon', icon: 'arrow' %}</a>
        {%- endif -%}
        {%- if section.settings.compare_label != blank -%}
          <a href="{{ section.settings.compare_link }}"><span><b>{{ section.settings.compare_label }}</b></span>{% render 'dw-home-icon', icon: 'arrow' %}</a>
        {%- endif -%}
        {%- if section.settings.extra_title != blank -%}
          <a href="{{ section.settings.extra_link }}"><span><b>{{ section.settings.extra_title }}</b> · {{ section.settings.extra_text }}</span>{% render 'dw-home-icon', icon: 'arrow' %}</a>
        {%- endif -%}
      </nav>
    </div>
  </section>
</div>

<script>
  (function () {
    var racine = document.getElementById('dwh-packs');
    if (!racine) return;
    var selecteur = racine.querySelector('[data-dwh-selecteur]');
    var liste = racine.querySelector('[data-dwh-packs]');
    if (!selecteur || !liste) return;
    var onglets = Array.prototype.slice.call(selecteur.querySelectorAll('[role="tab"]'));
    var panneaux = Array.prototype.slice.call(liste.querySelectorAll('[role="tabpanel"]'));
    var lienPacks = racine.querySelector('[data-dwh-lien-packs]');
    var nomGamme = racine.querySelector('[data-dwh-nom-gamme]');

    function choisir(i, focus) {
      selecteur.style.setProperty('--i', i);
      onglets.forEach(function (o, j) {
        var actif = i === j;
        o.setAttribute('aria-selected', actif ? 'true' : 'false');
        o.tabIndex = actif ? 0 : -1;
        panneaux[j].hidden = !actif;
      });
      // L'étape 2 suit la centrale choisie à l'étape 1.
      if (lienPacks && onglets[i].dataset.lien) lienPacks.href = onglets[i].dataset.lien;
      if (nomGamme) nomGamme.textContent = onglets[i].dataset.nom;
      if (focus) onglets[i].focus();
    }

    onglets.forEach(function (o, i) {
      o.addEventListener('click', function () { choisir(i); });
      o.addEventListener('keydown', function (e) {
        var n = onglets.length;
        if (e.key === 'ArrowRight') { e.preventDefault(); choisir((i + 1) % n, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); choisir((i - 1 + n) % n, true); }
      });
    });

    selecteur.hidden = false;
    liste.classList.add('est-pilote');
    choisir({{ actif }});
  })();
</script>

{% schema %}
{
  "name": "Home V2 · Parcours achat",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Votre alarme en 3 étapes" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Comment choisir votre alarme ?" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "header", "content": "Étape 1 · Centrale" },
    { "type": "text", "id": "step1_title", "label": "Titre", "default": "Choisissez votre centrale" },
    { "type": "textarea", "id": "step1_text", "label": "Texte", "default": "C'est le cœur de votre alarme. Nos 3 gammes protègent aussi bien un appartement qu'une grande maison : choisissez selon votre façon de l'utiliser." },
    { "type": "text", "id": "price_label", "label": "Texte avant le prix", "default": "Packs dès" },
    { "type": "text", "id": "range_link_label", "label": "Lien sous chaque centrale", "default": "Tout voir en" },
    { "type": "header", "content": "Étape 2 · Formule" },
    { "type": "text", "id": "step2_title", "label": "Titre", "default": "Choisissez votre formule" },
    { "type": "textarea", "id": "step2_text", "label": "Texte" },
    { "type": "text", "id": "pack_tag", "label": "Pack · étiquette", "default": "Le plus simple" },
    { "type": "text", "id": "pack_title", "label": "Pack · titre", "default": "Un pack prêt à poser" },
    { "type": "textarea", "id": "pack_text", "label": "Pack · texte", "default": "Centrale, détecteurs et sirène : tout est dans la boîte. Du pack de départ au pack complet avec caméras." },
    { "type": "text", "id": "pack_cta", "label": "Pack · bouton", "default": "Voir les packs" },
    { "type": "url", "id": "pack_link", "label": "Pack · lien par défaut" },
    { "type": "text", "id": "config_tag", "label": "Sur mesure · étiquette", "default": "Le plus précis" },
    { "type": "text", "id": "config_title", "label": "Sur mesure · titre", "default": "Un système sur mesure" },
    { "type": "textarea", "id": "config_text", "label": "Sur mesure · texte", "default": "Répondez à quelques questions sur votre logement : on vous propose la centrale et les accessoires adaptés." },
    { "type": "text", "id": "config_cta", "label": "Sur mesure · bouton", "default": "Composer mon alarme" },
    { "type": "url", "id": "config_link", "label": "Sur mesure · lien" },
    { "type": "header", "content": "Étape 3 · Réception" },
    { "type": "text", "id": "step3_title", "label": "Titre", "default": "Recevez-la et installez-la vous-même" },
    { "type": "textarea", "id": "step3_text", "label": "Texte", "default": "Expédiée sous 24 h. Installation en moins de 30 minutes, sans perçage ni technicien : l'application vous guide pas à pas." },
    { "type": "header", "content": "Liens d'aide" },
    { "type": "text", "id": "quiz_title", "label": "Quiz · titre", "default": "Encore un doute ?" },
    { "type": "text", "id": "quiz_text", "label": "Quiz · texte", "default": "Faites le quiz" },
    { "type": "url", "id": "quiz_link", "label": "Quiz · lien" },
    { "type": "text", "id": "compare_label", "label": "Comparatif · texte", "default": "Comparer les 3 centrales en détail" },
    { "type": "url", "id": "compare_link", "label": "Comparatif · lien" },
    { "type": "text", "id": "extra_title", "label": "Caméra · titre", "default": "Juste une caméra ?" },
    { "type": "text", "id": "extra_text", "label": "Caméra · texte", "default": "La caméra solaire, notre best-seller" },
    { "type": "url", "id": "extra_link", "label": "Caméra · lien" }
  ],
  "blocks": [
    {
      "type": "gamme",
      "name": "Centrale",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Nom court (onglet)", "default": "Touch" },
        { "type": "text", "id": "tab_sub", "label": "Précision sous l'onglet", "default": "écran tactile" },
        { "type": "checkbox", "id": "featured", "label": "Ouverte par défaut", "default": false },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Ex. : Le plus choisi" },
        { "type": "image_picker", "id": "image", "label": "Photo de la centrale" },
        { "type": "text", "id": "title", "label": "Nom complet", "default": "Centrale Touch" },
        { "type": "textarea", "id": "description", "label": "Idéal si…" },
        { "type": "text", "id": "bullet_1", "label": "Point fort 1" },
        { "type": "text", "id": "bullet_2", "label": "Point fort 2" },
        { "type": "text", "id": "bullet_3", "label": "Point fort 3" },
        { "type": "product", "id": "product", "label": "Pack de départ (pour le prix « dès »)" },
        { "type": "url", "id": "packs_link", "label": "Lien vers les packs de cette gamme" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home V2 · Parcours achat",
      "blocks": [
        { "type": "gamme", "settings": { "tab_label": "Vigilia", "tab_sub": "clavier & appli", "title": "Centrale Vigilia" } },
        { "type": "gamme", "settings": { "tab_label": "Touch", "tab_sub": "écran tactile", "title": "Centrale Touch", "featured": true, "badge": "Le plus choisi" } },
        { "type": "gamme", "settings": { "tab_label": "Élite", "tab_sub": "la plus complète", "title": "Centrale Élite" } }
      ]
    }
  ]
}
{% endschema %}
