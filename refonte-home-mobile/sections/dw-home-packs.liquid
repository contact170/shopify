{% render 'dw-home-head' %}

{%- liquid
  assign actif = 0
  for block in section.blocks
    if block.settings.featured
      assign actif = forloop.index0
      break
    endif
  endfor
-%}

<div class="dwh" id="dwh-packs">
  <section class="dwh-bloc" aria-labelledby="dwh-packs-titre-{{ section.id }}">
    <div class="dwh-large">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-packs-titre-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div
          class="dwh-selecteur"
          role="tablist"
          aria-label="Type de logement"
          style="--n: {{ section.blocks.size }}; --i: {{ actif }};"
          data-dwh-selecteur
          hidden
        >
          <span class="dwh-selecteur__curseur" aria-hidden="true"></span>
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="dwh-onglet"
              role="tab"
              id="dwh-onglet-{{ block.id }}"
              aria-controls="dwh-pack-{{ block.id }}"
              aria-selected="{% if forloop.index0 == actif %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.index0 == actif %}0{% else %}-1{% endif %}"
            >
              {{ block.settings.tab_label }}
              {%- if block.settings.tab_sub != blank -%}<small>{{ block.settings.tab_sub }}</small>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="dwh-packs" data-dwh-packs>
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign nom = block.settings.title | default: p.title
            assign url = p.url | default: '#'
            assign visuel = block.settings.image | default: p.featured_image
          -%}
          <article
            class="dwh-pack{% if block.settings.featured %} dwh-pack--vedette{% endif %}"
            id="dwh-pack-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="dwh-onglet-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <a class="dwh-pack__visuel" href="{{ url }}" tabindex="-1" aria-hidden="true">
              {%- if visuel != blank -%}
                {{ visuel | image_url: width: 900 | image_tag: widths: '450, 700, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: nom }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="dwh-pack__badge">{{ block.settings.badge }}</span>{%- endif -%}
            </a>

            <div class="dwh-pack__corps">
              <div>
                {%- if block.settings.range != blank -%}<p class="dwh-pack__gamme">{{ block.settings.range }}</p>{%- endif -%}
                <h3 class="dwh-pack__nom">{{ nom }}</h3>
                {%- if block.settings.description != blank -%}<p class="dwh-pack__pour">{{ block.settings.description }}</p>{%- endif -%}
              </div>

              <ul class="dwh-puces">
                {%- if block.settings.bullet_1 != blank -%}<li>{{ block.settings.bullet_1 }}</li>{%- endif -%}
                {%- if block.settings.bullet_2 != blank -%}<li>{{ block.settings.bullet_2 }}</li>{%- endif -%}
                {%- if block.settings.bullet_3 != blank -%}<li>{{ block.settings.bullet_3 }}</li>{%- endif -%}
              </ul>

              {%- if p != blank -%}
                <div class="dwh-pack__prix">
                  <div>
                    {%- if p.price_varies -%}<span class="dwh-pack__des">à partir de</span>{%- endif -%}
                    <span class="dwh-pack__montant">{{ p.price_min | money }}</span>
                    {%- if p.compare_at_price_min > p.price_min -%}
                      <span class="dwh-pack__barre">{{ p.compare_at_price_min | money }}</span>
                    {%- endif -%}
                  </div>
                  <span class="dwh-pack__mois">0&nbsp;€/mois</span>
                </div>
                {%- if section.settings.show_alma and p.price_min >= 5000 -%}
                  <p class="dwh-pack__alma">ou 4 × {{ p.price_min | divided_by: 4 | money }} sans frais</p>
                {%- endif -%}
              {%- endif -%}

              <a class="dwh-btn {% if block.settings.featured %}dwh-btn--bleu{% else %}dwh-btn--contour{% endif %}" href="{{ url }}">
                {{ block.settings.cta_label | default: 'Voir ce pack' }}
                {% render 'dw-home-icon', icon: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="dwh-bas-packs">
        {%- if section.settings.config_title != blank -%}
          <a class="dwh-autre" href="{{ section.settings.config_link }}">
            <span class="dwh-autre__ico">{% render 'dw-home-icon', icon: 'sliders' %}</span>
            <span>
              <span class="dwh-autre__titre">{{ section.settings.config_title }}</span>
              <span class="dwh-autre__texte">{{ section.settings.config_text }}</span>
            </span>
            {% render 'dw-home-icon', icon: 'arrow' %}
          </a>
        {%- endif -%}

        <nav class="dwh-liens" aria-label="Autres façons de choisir">
          {%- if section.settings.quiz_title != blank -%}
            <a href="{{ section.settings.quiz_link }}"><span><b>{{ section.settings.quiz_title }}</b> · {{ section.settings.quiz_text }}</span>{% render 'dw-home-icon', icon: 'arrow' %}</a>
          {%- endif -%}
          {%- if section.settings.extra_title != blank -%}
            <a href="{{ section.settings.extra_link }}"><span><b>{{ section.settings.extra_title }}</b> · {{ section.settings.extra_text }}</span>{% render 'dw-home-icon', icon: 'arrow' %}</a>
          {%- endif -%}
          {%- if section.settings.compare_label != blank -%}
            <a href="{{ section.settings.compare_link }}"><span><b>{{ section.settings.compare_label }}</b></span>{% render 'dw-home-icon', icon: 'arrow' %}</a>
          {%- endif -%}
        </nav>
      </div>
    </div>
  </section>
</div>

<script>
  (function () {
    var racine = document.getElementById('dwh-packs');
    if (!racine) return;
    var selecteur = racine.querySelector('[data-dwh-selecteur]');
    var liste = racine.querySelector('[data-dwh-packs]');
    if (!selecteur || !liste) return;
    var onglets = Array.prototype.slice.call(selecteur.querySelectorAll('[role="tab"]'));
    var panneaux = Array.prototype.slice.call(liste.querySelectorAll('[role="tabpanel"]'));

    function choisir(i, focus) {
      selecteur.style.setProperty('--i', i);
      onglets.forEach(function (o, j) {
        var actif = i === j;
        o.setAttribute('aria-selected', actif ? 'true' : 'false');
        o.tabIndex = actif ? 0 : -1;
        panneaux[j].hidden = !actif;
      });
      if (focus) onglets[i].focus();
    }

    onglets.forEach(function (o, i) {
      o.addEventListener('click', function () { choisir(i); });
      o.addEventListener('keydown', function (e) {
        var n = onglets.length;
        if (e.key === 'ArrowRight') { e.preventDefault(); choisir((i + 1) % n, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); choisir((i - 1 + n) % n, true); }
      });
    });

    selecteur.hidden = false;
    liste.classList.add('est-pilote');
    choisir({{ actif }});
  })();
</script>

{% schema %}
{
  "name": "Home V2 · Packs guidés",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Packs complets, prêts à poser" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Quel est votre logement ?" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Choisissez, on vous montre le pack adapté. Tout est dans la boîte pour démarrer, et vous l'agrandirez quand vous voudrez." },
    { "type": "checkbox", "id": "show_alma", "label": "Afficher le paiement en 4× (Alma)", "default": true },
    { "type": "header", "content": "Carte configurateur" },
    { "type": "text", "id": "config_title", "label": "Titre", "default": "Composer mon alarme sur mesure" },
    { "type": "text", "id": "config_text", "label": "Texte", "default": "Quelques questions, on vous propose le système adapté" },
    { "type": "url", "id": "config_link", "label": "Lien" },
    { "type": "header", "content": "Carte quiz" },
    { "type": "text", "id": "quiz_title", "label": "Titre", "default": "Je ne sais pas quoi choisir" },
    { "type": "text", "id": "quiz_text", "label": "Texte", "default": "Répondez au quiz, on vous conseille" },
    { "type": "url", "id": "quiz_link", "label": "Lien" },
    { "type": "header", "content": "Carte caméra seule" },
    { "type": "text", "id": "extra_title", "label": "Titre", "default": "Juste une caméra ?" },
    { "type": "text", "id": "extra_text", "label": "Texte", "default": "Notre best-seller : caméra extérieure solaire, sans fil" },
    { "type": "url", "id": "extra_link", "label": "Lien" },
    { "type": "header", "content": "Lien comparatif" },
    { "type": "text", "id": "compare_label", "label": "Texte", "default": "Comparer les 3 gammes en détail" },
    { "type": "url", "id": "compare_link", "label": "Lien" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Type de logement (onglet)", "default": "Maison" },
        { "type": "text", "id": "tab_sub", "label": "Précision sous l'onglet", "default": "avec jardin" },
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "checkbox", "id": "featured", "label": "Pack mis en avant (ouvert par défaut)", "default": false },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Ex. : Le plus choisi" },
        { "type": "text", "id": "range", "label": "Gamme", "default": "Gamme Touch" },
        { "type": "text", "id": "title", "label": "Nom court", "info": "Vide = titre du produit." },
        { "type": "textarea", "id": "description", "label": "Pour qui ?" },
        { "type": "image_picker", "id": "image", "label": "Image (facultatif)", "info": "Vide = image principale du produit." },
        { "type": "text", "id": "bullet_1", "label": "Point fort 1" },
        { "type": "text", "id": "bullet_2", "label": "Point fort 2" },
        { "type": "text", "id": "bullet_3", "label": "Point fort 3" },
        { "type": "text", "id": "cta_label", "label": "Texte du bouton", "default": "Voir ce pack" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home V2 · Packs guidés",
      "blocks": [
        { "type": "pack", "settings": { "tab_label": "Appartement", "tab_sub": "studio à T3", "range": "Gamme Vigilia" } },
        { "type": "pack", "settings": { "tab_label": "Maison", "tab_sub": "avec jardin", "range": "Gamme Touch", "featured": true, "badge": "Le plus choisi" } },
        { "type": "pack", "settings": { "tab_label": "Grande maison", "tab_sub": "villa, dépendances", "range": "Gamme Élite" } }
      ]
    }
  ]
}
{% endschema %}
