{{ 'dw-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign active_index = 0
  for block in section.blocks
    if block.settings.featured
      assign active_index = forloop.index0
      break
    endif
  endfor
-%}

<div class="dwh" id="dwh-packs">
  <section class="dwh-section{% if section.settings.alt_bg %} dwh-section--alt{% endif %}" aria-labelledby="dwh-packs-title-{{ section.id }}">
    <div class="dwh-wrap">
      <div class="dwh-head dwh-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-h2" id="dwh-packs-title-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="dwh-tabs" role="tablist" aria-label="{{ section.settings.title | escape }}" data-dwh-tabs hidden>
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="dwh-tab"
              role="tab"
              id="dwh-tab-{{ block.id }}"
              aria-controls="dwh-pack-{{ block.id }}"
              aria-selected="{% if forloop.index0 == active_index %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.index0 == active_index %}0{% else %}-1{% endif %}"
            >
              {{ block.settings.tab_label }}
              {%- if block.settings.tab_sub != blank -%}<small>{{ block.settings.tab_sub }}</small>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="dwh-packs" data-dwh-packs>
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign title = block.settings.title | default: p.title
            assign url = p.url | default: '#'
            assign img = block.settings.image | default: p.featured_image
          -%}
          <article
            class="dwh-pack{% if block.settings.featured %} dwh-pack--featured{% endif %}"
            id="dwh-pack-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="dwh-tab-{{ block.id }}"
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <a class="dwh-pack__media" href="{{ url }}" tabindex="-1" aria-hidden="true">
              {%- if img != blank -%}
                {{
                  img
                  | image_url: width: 800
                  | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="dwh-pack__badge">{{ block.settings.badge }}</span>{%- endif -%}
              {%- if block.settings.tab_label != blank -%}<span class="dwh-pack__for">{% render 'dw-home-icon', icon: 'home' %}{{ block.settings.tab_label }}</span>{%- endif -%}
            </a>

            <div class="dwh-pack__body">
              <div>
                {%- if block.settings.range != blank -%}<p class="dwh-pack__range">{{ block.settings.range }}</p>{%- endif -%}
                <h3 class="dwh-pack__title">{{ title }}</h3>
              </div>
              {%- if block.settings.description != blank -%}<p class="dwh-pack__desc">{{ block.settings.description }}</p>{%- endif -%}

              <ul class="dwh-check">
                {%- if block.settings.bullet_1 != blank -%}<li>{{ block.settings.bullet_1 }}</li>{%- endif -%}
                {%- if block.settings.bullet_2 != blank -%}<li>{{ block.settings.bullet_2 }}</li>{%- endif -%}
                {%- if block.settings.bullet_3 != blank -%}<li>{{ block.settings.bullet_3 }}</li>{%- endif -%}
              </ul>

              {%- if p != blank -%}
                <div class="dwh-pack__price">
                  {%- if p.price_varies -%}<span class="dwh-pack__price-from">dès</span>{%- endif -%}
                  <span class="dwh-pack__price-now">{{ p.price_min | money }}</span>
                  {%- if p.compare_at_price_min > p.price_min -%}
                    <span class="dwh-pack__price-was">{{ p.compare_at_price_min | money }}</span>
                    {%- assign save = p.compare_at_price_min | minus: p.price_min | times: 100 | divided_by: p.compare_at_price_min -%}
                    <span class="dwh-pack__price-save">−{{ save }} %</span>
                  {%- endif -%}
                </div>
                {%- if section.settings.show_alma and p.price_min >= 5000 -%}
                  <p class="dwh-pack__alma">ou <b>4 × {{ p.price_min | divided_by: 4 | money }}</b> sans frais</p>
                {%- endif -%}
              {%- endif -%}

              <a class="dwh-btn {% if block.settings.featured %}dwh-btn--primary{% else %}dwh-btn--ghost-dark{% endif %} dwh-pack__cta" href="{{ url }}">
                {{ block.settings.cta_label | default: 'Voir ce pack' }}
                {% render 'dw-home-icon', icon: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="dwh-alt">
        {%- if section.settings.config_title != blank -%}
          <a class="dwh-alt__card dwh-alt__card--strong" href="{{ section.settings.config_link }}">
            <span class="dwh-alt__icon">{% render 'dw-home-icon', icon: 'sliders' %}</span>
            <span>
              <span class="dwh-alt__title">{{ section.settings.config_title }}</span>
              <span class="dwh-alt__text">{{ section.settings.config_text }}</span>
            </span>
            <span class="dwh-alt__arrow">{% render 'dw-home-icon', icon: 'arrow' %}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.quiz_title != blank -%}
          <a class="dwh-alt__card" href="{{ section.settings.quiz_link }}">
            <span class="dwh-alt__icon">{% render 'dw-home-icon', icon: 'quiz' %}</span>
            <span>
              <span class="dwh-alt__title">{{ section.settings.quiz_title }}</span>
              <span class="dwh-alt__text">{{ section.settings.quiz_text }}</span>
            </span>
            <span class="dwh-alt__arrow">{% render 'dw-home-icon', icon: 'arrow' %}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.extra_title != blank -%}
          <a class="dwh-alt__card" href="{{ section.settings.extra_link }}">
            <span class="dwh-alt__icon">{% render 'dw-home-icon', icon: 'camera' %}</span>
            <span>
              <span class="dwh-alt__title">{{ section.settings.extra_title }}</span>
              <span class="dwh-alt__text">{{ section.settings.extra_text }}</span>
            </span>
            <span class="dwh-alt__arrow">{% render 'dw-home-icon', icon: 'arrow' %}</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.compare_label != blank -%}
        <p class="dwh-compare-link"><a class="dwh-link" href="{{ section.settings.compare_link }}">{{ section.settings.compare_label }}</a></p>
      {%- endif -%}
    </div>
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('dwh-packs');
    if (!root) return;
    var tabs = root.querySelector('[data-dwh-tabs]');
    var wrap = root.querySelector('[data-dwh-packs]');
    if (!tabs || !wrap) return;
    var buttons = Array.prototype.slice.call(tabs.querySelectorAll('[role="tab"]'));
    var panels = Array.prototype.slice.call(wrap.querySelectorAll('[role="tabpanel"]'));

    function select(i, focus) {
      buttons.forEach(function (b, j) {
        var on = i === j;
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) buttons[i].focus();
    }

    buttons.forEach(function (b, i) {
      b.addEventListener('click', function () { select(i); });
      b.addEventListener('keydown', function (e) {
        var n = buttons.length;
        if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % n, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + n) % n, true); }
      });
    });

    tabs.hidden = false;
    wrap.classList.add('is-enhanced');
    select({{ active_index }});
  })();
</script>

{% schema %}
{
  "name": "Home V2 · Packs guidés",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nos packs prêts à installer" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Quel est votre logement ?" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Nos experts ont composé un pack pour chaque situation. Tout est inclus, rien à ajouter pour démarrer." },
    { "type": "checkbox", "id": "alt_bg", "label": "Fond bleuté", "default": false },
    { "type": "checkbox", "id": "show_alma", "label": "Afficher le paiement en 4× (Alma)", "default": true },
    { "type": "header", "content": "Carte configurateur" },
    { "type": "text", "id": "config_title", "label": "Titre", "default": "Composer mon alarme sur-mesure" },
    { "type": "text", "id": "config_text", "label": "Texte", "default": "2 minutes · remise appliquée automatiquement" },
    { "type": "url", "id": "config_link", "label": "Lien", "default": "/pages/configurateur_2" },
    { "type": "header", "content": "Carte quiz" },
    { "type": "text", "id": "quiz_title", "label": "Titre", "default": "Je ne sais pas quoi choisir" },
    { "type": "text", "id": "quiz_text", "label": "Texte", "default": "Répondez à quelques questions, on vous conseille" },
    { "type": "url", "id": "quiz_link", "label": "Lien", "default": "/pages/trouver-mon-alarme-quiz" },
    { "type": "header", "content": "Carte caméra seule" },
    { "type": "text", "id": "extra_title", "label": "Titre", "default": "Juste une caméra ?" },
    { "type": "text", "id": "extra_text", "label": "Texte", "default": "Notre best-seller : caméra extérieure solaire, sans fil" },
    { "type": "url", "id": "extra_link", "label": "Lien", "default": "/products/camera-w512mw-exterieure-rotative-1440p-avec-panneau-solaire" },
    { "type": "header", "content": "Lien comparatif" },
    { "type": "text", "id": "compare_label", "label": "Texte", "default": "Comparer les 3 gammes en détail" },
    { "type": "url", "id": "compare_link", "label": "Lien", "default": "/pages/comparateur-am301-sa501-pa501z" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Type de logement (onglet)", "default": "Maison" },
        { "type": "text", "id": "tab_sub", "label": "Précision (sous l'onglet)", "default": "4 à 6 pièces" },
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "checkbox", "id": "featured", "label": "Pack mis en avant (ouvert par défaut)", "default": false },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Ex. : Le plus vendu" },
        { "type": "text", "id": "range", "label": "Gamme", "default": "Gamme Touch" },
        { "type": "text", "id": "title", "label": "Titre court", "info": "Vide = titre du produit. Conseillé : un titre court et clair." },
        { "type": "textarea", "id": "description", "label": "Pour qui ?" },
        { "type": "image_picker", "id": "image", "label": "Image (facultatif)", "info": "Vide = image principale du produit." },
        { "type": "text", "id": "bullet_1", "label": "Point fort 1" },
        { "type": "text", "id": "bullet_2", "label": "Point fort 2" },
        { "type": "text", "id": "bullet_3", "label": "Point fort 3" },
        { "type": "text", "id": "cta_label", "label": "Texte du bouton", "default": "Voir ce pack" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home V2 · Packs guidés",
      "blocks": [
        { "type": "pack", "settings": { "tab_label": "Appartement", "tab_sub": "Studio à T3", "range": "Gamme Vigilia" } },
        { "type": "pack", "settings": { "tab_label": "Maison", "tab_sub": "4 à 6 pièces", "range": "Gamme Touch", "featured": true, "badge": "Le plus choisi" } },
        { "type": "pack", "settings": { "tab_label": "Grande maison", "tab_sub": "Villa, dépendances", "range": "Gamme Élite" } }
      ]
    }
  ]
}
{% endschema %}
