{% render 'dw-home-head' %}

{%- liquid
  assign mensuel = section.settings.competitor_monthly
  assign mois = section.settings.years | times: 12
  assign total = mensuel | times: mois
-%}

<div class="dwh">
  <section class="dwh-bloc dwh-sombre" aria-labelledby="dwh-calcul-{{ section.id }}">
    <div class="dwh-large dwh-deux">
      <div class="dwh-entete">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-titre" id="dwh-calcul-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div>
        <div class="dwh-calcul attend" data-dwh-calcul>
          <p class="dwh-surtitre" style="margin:0">Abonnements payés en {{ section.settings.years }} ans</p>

          <div class="dwh-ligne">
            <div class="dwh-ligne__tete">
              <span class="dwh-ligne__nom">{{ section.settings.them_label }}</span>
              <span class="dwh-ligne__val">{{ total }}&nbsp;€*</span>
            </div>
            <div class="dwh-jauge" aria-hidden="true"><div class="dwh-jauge__rempli" style="--p: 1"></div></div>
          </div>

          <div class="dwh-ligne dwh-ligne--nous">
            <div class="dwh-ligne__tete">
              <span class="dwh-ligne__nom">{{ section.settings.us_label }}</span>
              <span class="dwh-ligne__val">0&nbsp;€</span>
            </div>
            <div class="dwh-jauge" aria-hidden="true"><div class="dwh-jauge__rempli" style="--p: 0.012"></div></div>
          </div>

          <p class="dwh-calcul__note">{{ section.settings.us_note }}</p>
        </div>

        {%- if section.settings.cta_label != blank -%}
          <p style="margin-top:24px"><a class="dwh-lien" href="{{ section.settings.cta_link | default: '#dwh-packs' }}">{{ section.settings.cta_label }} {% render 'dw-home-icon', icon: 'arrow' %}</a></p>
        {%- endif -%}
        {%- if section.settings.footnote != blank -%}
          <p class="dwh-mention">{{ section.settings.footnote | replace: '[mensuel]', mensuel }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

<script>
  (function () {
    var calcul = document.currentScript && document.currentScript.previousElementSibling
      ? document.currentScript.previousElementSibling.querySelector('[data-dwh-calcul]')
      : null;
    if (!calcul) return;
    if (!('IntersectionObserver' in window)) { calcul.classList.remove('attend'); return; }
    var io = new IntersectionObserver(function (e) {
      if (e[0].isIntersecting) { calcul.classList.remove('attend'); io.disconnect(); }
    }, { rootMargin: '0px 0px -25% 0px' });
    io.observe(calcul);
  })();
</script>

{% schema %}
{
  "name": "Home V2 · Sans abonnement",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le calcul est vite fait" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Achetez une fois. Protégé à vie." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Pas de contrat, pas d'engagement, pas de prélèvement chaque mois. Le matériel est à vous, et il vous suit si vous déménagez." },
    { "type": "text", "id": "them_label", "label": "Ligne concurrence", "default": "Alarme avec télésurveillance" },
    { "type": "range", "id": "competitor_monthly", "label": "Prix mensuel de référence (€)", "min": 10, "max": 80, "step": 1, "default": 35, "info": "À vérifier avant mise en ligne." },
    { "type": "range", "id": "years", "label": "Durée (ans)", "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "text", "id": "us_label", "label": "Ligne Daewoo", "default": "Daewoo Security" },
    { "type": "textarea", "id": "us_note", "label": "Note sous le calcul", "default": "Notifications, sirène et pilotage à distance depuis l'application Daewoo Home Connect : inclus, sans frais mensuels." },
    { "type": "text", "id": "cta_label", "label": "Lien", "default": "Voir les packs" },
    { "type": "url", "id": "cta_link", "label": "URL du lien" },
    { "type": "text", "id": "footnote", "label": "Mention", "default": "*Sur la base d'un abonnement de télésurveillance à [mensuel] € par mois, tarif indicatif constaté en France.", "info": "[mensuel] est remplacé par le prix mensuel ci-dessus." }
  ],
  "presets": [{ "name": "Home V2 · Sans abonnement" }]
}
{% endschema %}
