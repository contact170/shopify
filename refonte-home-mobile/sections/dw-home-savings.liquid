{{ 'dw-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign monthly = section.settings.competitor_monthly
  assign months = section.settings.years | times: 12
  assign total = monthly | times: months
-%}

<div class="dwh">
  <section class="dwh-section dwh-section--navy" aria-labelledby="dwh-savings-{{ section.id }}">
    <div class="dwh-wrap">
      <div class="dwh-head dwh-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="dwh-h2" id="dwh-savings-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="dwh-lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="dwh-savings">
        <div class="dwh-savings__col">
          <p class="dwh-savings__label">{{ section.settings.them_label }}</p>
          <p class="dwh-savings__big">{{ monthly }} €<small> / mois*</small></p>
          <p class="dwh-savings__note">Soit environ <strong>{{ total }} €</strong> sur {{ section.settings.years }} ans. {{ section.settings.them_note }}</p>
        </div>
        <div class="dwh-savings__col dwh-savings__col--us">
          <p class="dwh-savings__label">{{ section.settings.us_label }}</p>
          <p class="dwh-savings__big">0 €<small> / mois</small></p>
          <p class="dwh-savings__note">{{ section.settings.us_note }}</p>
        </div>
      </div>

      {%- if section.settings.cta_label != blank -%}
        <div class="dwh-btns" style="margin-top:20px;justify-content:center">
          <a class="dwh-btn dwh-btn--light" href="{{ section.settings.cta_link | default: '#dwh-packs' }}">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <p class="dwh-savings__foot">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Home V2 · Sans abonnement",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Zéro abonnement, vraiment" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Payez une fois. Soyez protégé pour toujours." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Pas de contrat, pas d'engagement, pas de mauvaise surprise sur votre relevé bancaire." },
    { "type": "text", "id": "them_label", "label": "Colonne concurrence · titre", "default": "Alarme avec télésurveillance" },
    { "type": "range", "id": "competitor_monthly", "label": "Prix mensuel concurrent (€)", "min": 10, "max": 80, "step": 1, "default": 35, "info": "À vérifier avant mise en ligne." },
    { "type": "range", "id": "years", "label": "Durée de comparaison (ans)", "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "text", "id": "them_note", "label": "Colonne concurrence · note", "default": "Avec un engagement souvent de 24 à 48 mois." },
    { "type": "text", "id": "us_label", "label": "Colonne Daewoo · titre", "default": "Alarme Daewoo Security" },
    { "type": "text", "id": "us_note", "label": "Colonne Daewoo · note", "default": "Vous achetez le matériel une seule fois, il vous appartient. Application et alertes gratuites, à vie." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Voir les packs" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "text", "id": "footnote", "label": "Mention", "default": "*Tarif mensuel indicatif des offres de télésurveillance grand public en France." }
  ],
  "presets": [{ "name": "Home V2 · Sans abonnement" }]
}
{% endschema %}
