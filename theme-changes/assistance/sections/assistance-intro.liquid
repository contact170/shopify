<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ai-accent: {{ section.settings.accent_color }};
  }

  #shopify-section-{{ section.id }} .ai-wrap {
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ai-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ai-accent);
    border: 1px solid color-mix(in srgb, var(--ai-accent) 30%, transparent);
    background: color-mix(in srgb, var(--ai-accent) 7%, transparent);
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: 22px;
  }

  #shopify-section-{{ section.id }} .ai-title {
    font-size: clamp(1.9rem, 3.2vw, 2.9rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 18px;
  }

  #shopify-section-{{ section.id }} .ai-lede {
    font-size: 17px;
    line-height: 1.65;
    opacity: .78;
    max-width: 62ch;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .ai-steps {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 3 }}, minmax(0, 1fr));
    gap: 20px;
    margin-top: 46px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .ai-step {
    position: relative;
    padding: 30px 26px 28px;
    border-radius: 20px;
    border: 1px solid rgba(12, 30, 74, .10);
    background: rgba(255, 255, 255, .72);
    box-shadow: 0 18px 40px -30px rgba(12, 30, 74, .55);
  }

  #shopify-section-{{ section.id }} .ai-step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ai-accent);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .ai-step__title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  #shopify-section-{{ section.id }} .ai-step__text {
    font-size: 15px;
    line-height: 1.6;
    opacity: .74;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ai-callout {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
    margin-top: 24px;
    padding: 22px 26px;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--ai-accent) 22%, transparent);
    background: color-mix(in srgb, var(--ai-accent) 6%, transparent);
  }

  #shopify-section-{{ section.id }} .ai-callout svg {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    color: var(--ai-accent);
  }

  #shopify-section-{{ section.id }} .ai-callout p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .ai-steps {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 34px;
    }
    #shopify-section-{{ section.id }} .ai-step {
      padding: 24px 22px;
    }
    #shopify-section-{{ section.id }} .ai-callout {
      padding: 20px;
    }
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width relative">
    <div class="ai-wrap">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ai-eyebrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          {{ section.settings.eyebrow | escape }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="ai-title">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="ai-lede rte">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="ai-steps">
          {%- for block in section.blocks -%}
            <div class="ai-step" {{ block.shopify_attributes }}>
              <span class="ai-step__num">{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <p class="ai-step__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ai-step__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.callout != blank -%}
        <div class="ai-callout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 4 6v6c0 5 3.4 9.2 8 10 4.6-.8 8-5 8-10V6l-8-4z"></path>
            <path d="M12 8v5"></path>
            <path d="M12 16h.01"></path>
          </svg>
          <div class="rte">{{ section.settings.callout }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Assistance – Introduction",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Étiquette",
      "default": "Espace assistance"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Besoin d'aide ? Vous êtes au bon endroit."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Balise du titre",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Texte d'introduction",
      "default": "<p>Vous trouverez sur cette page tout ce qu'il faut pour installer, configurer et dépanner votre matériel Daewoo Security : Franck, notre assistant disponible 24h/24, la base de connaissances complète (manuels, notices, questions fréquentes) et le contact direct avec nos techniciens.</p>"
    },
    {
      "type": "richtext",
      "id": "callout",
      "label": "Encadré important",
      "default": "<p><strong>Avant de commencer, munissez-vous de la référence de votre produit.</strong> Elle figure sur l'étiquette à l'arrière de l'appareil, dans l'application ou sur votre facture (par exemple SA501, AM302, PA501Z, W512MW, WKE501). C'est l'information qui nous permet de vous répondre juste, du premier coup.</p>"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent",
      "default": "#0b61cd"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacement haut",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacement bas",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Séparateur",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Posez votre question à Franck"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Notre assistant répond immédiatement, 24h/24 et 7j/7.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Assistance – Introduction",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ],
  "disabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
