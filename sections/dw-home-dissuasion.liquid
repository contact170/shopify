{%- comment -%}
  Page d'accueil : bandeau « canon à fumée » vers la page Dissuasion.
  Texte à gauche, photo à droite avec un voile de brouillard animé (CSS
  seulement, pas de vidéo). L'animation s'arrête si le visiteur a demandé
  moins d'animations. Le prix est lu sur le produit.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.produit
  assign img = section.settings.image | default: p.featured_image
  assign lien = section.settings.lien | default: '/collections/dissuasion'
-%}
{% render 'dw-home-head' %}
<div class="dwh dwhd" id="dwhd-{{ section.id }}">
  <section class="dwhd__bande" aria-labelledby="dwhd-titre-{{ section.id }}">
    <div class="dwhd__grille">
      <div class="dwhd__texte">
        {%- if section.settings.pastille != blank -%}<p class="dwhd__pastille"><span aria-hidden="true"></span>{{ section.settings.pastille }}</p>{%- endif -%}
        <h2 class="dwh-titre dwhd__titre" id="dwhd-titre-{{ section.id }}">{{ section.settings.titre }}</h2>
        {%- if section.settings.texte != blank -%}<p class="dwhd__chapo">{{ section.settings.texte }}</p>{%- endif -%}
        <div class="dwhd__actions">
          <a class="dwh-btn dwhd__btn" href="{{ lien }}">
            {{ section.settings.bouton }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          {%- if p != blank -%}<p class="dwhd__prix">{{ section.settings.mention_prix }} <b>{{ p.price_min | money }}</b></p>{%- endif -%}
        </div>
      </div>
      <a class="dwhd__visuel" href="{{ lien }}" tabindex="-1">
        {%- if img -%}
          {{ img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'low', widths: '480,720,960,1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image_alt }}
        {%- endif -%}
        <span class="dwhd__fondu"></span>
        <span class="dwhd__brume dwhd__brume--1"></span>
        <span class="dwhd__brume dwhd__brume--2"></span>
        <span class="dwhd__brume dwhd__brume--3"></span>
        {%- if section.settings.badge_chiffre != blank -%}
          <span class="dwhd__badge"><b>{{ section.settings.badge_chiffre }}</b>{{ section.settings.badge_texte }}</span>
        {%- endif -%}
      </a>
    </div>
  </section>
</div>

<style>
  .dwhd .dwhd__bande{position:relative;overflow:hidden;background:#0a1330;color:#fff;}
  .dwhd .dwhd__grille{display:grid;}
  .dwhd .dwhd__texte{position:relative;z-index:2;padding:32px 20px 36px;}
  .dwhd .dwhd__pastille{display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;padding:6px 13px;border-radius:999px;
    background:rgba(255,255,255,.08);box-shadow:inset 0 0 0 1px rgba(255,255,255,.14);font-size:12.5px;font-weight:700;
    letter-spacing:.06em;text-transform:uppercase;color:#ff8a7e;}
  .dwhd .dwhd__pastille span{width:7px;height:7px;border-radius:50%;background:#ff4d3d;box-shadow:0 0 0 3px rgba(255,77,61,.22);}
  .dwhd .dwhd__titre{color:#fff;font-size:clamp(30px,6.4vw,44px);}
  .dwhd .dwhd__chapo{margin-top:12px;max-width:44ch;font-size:16px;line-height:1.55;color:var(--brume,#b5bdd6);}
  .dwhd .dwhd__actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:22px;}
  .dwhd .dwhd__btn{width:auto;padding-inline:28px;background:#fff;color:#0a1330;}
  @media (hover:hover) and (pointer:fine){.dwhd .dwhd__btn:hover{background:#e9edf8;}}
  .dwhd .dwhd__btn svg{width:18px;height:18px;}
  .dwhd .dwhd__prix{margin:0;font-size:15px;color:var(--brume,#b5bdd6);}
  .dwhd .dwhd__prix b{color:#fff;font-weight:700;}

  /* Visuel + brouillard */
  .dwhd .dwhd__visuel{position:relative;display:block;height:200px;overflow:hidden;order:-1;}
  .dwhd .dwhd__visuel img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:62% 14%;}
  .dwhd .dwhd__fondu{position:absolute;inset:0;background:linear-gradient(0deg,#0a1330 0%,rgba(10,19,48,.15) 45%,rgba(10,19,48,0) 70%);}
  .dwhd .dwhd__brume{position:absolute;top:-20%;bottom:-20%;width:90%;pointer-events:none;filter:blur(18px);opacity:.75;
    background:
      radial-gradient(40% 35% at 30% 40%,rgba(255,255,255,.55),transparent 70%),
      radial-gradient(35% 30% at 70% 60%,rgba(235,240,250,.45),transparent 70%),
      radial-gradient(30% 28% at 50% 20%,rgba(255,255,255,.35),transparent 70%);
    animation:dwhd-derive 26s linear infinite;}
  .dwhd .dwhd__brume--1{left:-30%;}
  .dwhd .dwhd__brume--2{left:10%;opacity:.55;animation-duration:34s;animation-delay:-12s;}
  .dwhd .dwhd__brume--3{left:40%;opacity:.45;animation-duration:42s;animation-delay:-24s;}
  @keyframes dwhd-derive{
    0%{transform:translateX(-25%) scale(1);}
    50%{transform:translateX(15%) scale(1.15);}
    100%{transform:translateX(-25%) scale(1);}
  }
  .dwhd .dwhd__badge{position:absolute;right:16px;bottom:16px;z-index:2;display:flex;align-items:center;gap:8px;padding:8px 12px;
    border-radius:14px;background:rgba(255,255,255,.94);color:#0a1330;font-size:13px;font-weight:600;line-height:1.2;
    box-shadow:0 10px 26px rgba(0,0,0,.3);}
  .dwhd .dwhd__badge b{font-size:22px;font-weight:800;color:#ff4d3d;letter-spacing:-.03em;}

  @media (min-width:750px){
    .dwhd .dwhd__grille{grid-template-columns:1.05fr .95fr;align-items:stretch;}
    .dwhd .dwhd__texte{padding:44px 40px 44px max(40px, calc((100vw - 1120px) / 2));align-self:center;}
    .dwhd .dwhd__visuel{order:0;height:auto;min-height:280px;}
    .dwhd .dwhd__fondu{background:linear-gradient(90deg,#0a1330 0%,rgba(10,19,48,.35) 30%,rgba(10,19,48,0) 60%);}
  }
  @media (prefers-reduced-motion:reduce){.dwhd .dwhd__brume{animation:none;}}
</style>

{% schema %}
{
  "name": "Home V2 · Canon à fumée",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "produit", "label": "Produit (prix)" },
    { "type": "text", "id": "pastille", "label": "Pastille", "default": "Dissuasion active" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Le cambrioleur ne voit plus rien." },
    { "type": "textarea", "id": "texte", "label": "Texte" },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Découvrir la dissuasion" },
    { "type": "url", "id": "lien", "label": "Lien", "info": "Vide = page Dissuasion." },
    { "type": "text", "id": "mention_prix", "label": "Texte avant le prix", "default": "dès" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Vide = photo du produit." },
    { "type": "text", "id": "image_alt", "label": "Description de la photo (texte alternatif)", "default": "Canon à fumée Daewoo F502W en fonctionnement" },
    { "type": "text", "id": "badge_chiffre", "label": "Badge : chiffre", "default": "8 s" },
    { "type": "text", "id": "badge_texte", "label": "Badge : texte", "default": "pièce opaque" }
  ],
  "presets": [ { "name": "Home V2 · Canon à fumée" } ]
}
{% endschema %}
