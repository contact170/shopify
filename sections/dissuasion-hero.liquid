{{ 'acc-premium.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Page collection Dissuasion : en-tete immersif.
  Texte a gauche (H1, accroche, chiffres cles, boutons), photo a droite.
  Le produit mis en avant fournit le prix, la note et le lien.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.produit
  if p == blank
    assign p = collection.products.first
  endif
  assign img = section.settings.image | default: p.featured_image
  assign note = p.metafields.reviews.rating.value.rating
  assign nb_avis = p.metafields.reviews.rating_count.value
  assign titre_page = collection.title | default: page_title
  assign alt_img = section.settings.image_alt | default: img.alt | default: titre_page
-%}
<style>
  .dh{position:relative;background:var(--accp-nuit);color:#fff;overflow:hidden}
  .dh::before{content:"";position:absolute;inset:auto -20% -40% auto;width:70vw;height:70vw;max-width:900px;max-height:900px;
    background:radial-gradient(closest-side,rgba(26,79,171,.45),transparent);pointer-events:none}
  .dh .accp-wrap{position:relative;max-width:1180px;padding-top:clamp(18px,2.4vw,28px);padding-bottom:clamp(40px,6vw,84px)}
  .dh-fil{margin:0 0 clamp(22px,3.4vw,40px);padding:0;list-style:none;display:flex;gap:8px;font-size:14px;color:#9aa4c2}
  .dh-fil a{color:#9aa4c2;text-decoration:none}
  .dh-fil a:hover{color:#fff}
  .dh-fil li+li::before{content:"/";margin-right:8px;color:#4a5578}
  .dh-grille{display:grid;gap:clamp(28px,4vw,56px);align-items:center}
  @media(min-width:900px){.dh-grille{grid-template-columns:1.05fr .95fr}}
  .dh-pastille{display:inline-flex;align-items:center;gap:9px;margin:0;padding:7px 15px 7px 13px;border-radius:980px;
    background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);font-size:13px;font-weight:600;
    letter-spacing:.09em;text-transform:uppercase;color:#ff8a7e}
  .dh-pastille::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accp-alerte);
    box-shadow:0 0 0 3px rgba(255,77,61,.22)}
  .accp .dh h1{margin:20px 0 0;font-size:clamp(38px,5.6vw,66px);line-height:1.02;letter-spacing:-.035em;color:#fff;text-wrap:balance}
  .dh h1 .dh-cle{display:block;margin-bottom:12px;font-size:clamp(17px,1.9vw,21px);font-weight:500;letter-spacing:-.01em;line-height:1.3;color:#9aa4c2}
  .dh-chapo{margin:20px 0 0;max-width:46ch;font-size:clamp(18px,2vw,21px);line-height:1.6;color:#b5bdd6;text-wrap:pretty}
  .dh-chiffres{list-style:none;margin:clamp(26px,3.4vw,36px) 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
    gap:10px;max-width:520px}
  .dh-chiffres li{padding:14px 14px 13px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09)}
  .dh-chiffres b{display:block;font-size:clamp(24px,2.8vw,32px);font-weight:600;letter-spacing:-.03em;line-height:1;color:#fff}
  .dh-chiffres span{display:block;margin-top:7px;font-size:14px;line-height:1.35;color:#9aa4c2}
  .dh-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;margin-top:clamp(26px,3.4vw,36px)}
  .dh .accp-bouton{background:#fff;color:var(--accp-nuit)}
  .dh .accp-bouton:hover{color:var(--accp-nuit);filter:none;background:#e9edf8}
  .dh-lien{display:inline-flex;align-items:center;gap:9px;color:#fff;text-decoration:none;font-size:17px;font-weight:500}
  .dh-lien svg{flex:0 0 auto}
  .dh-lien:hover{text-decoration:underline}
  .dh-prix{margin:18px 0 0;font-size:15px;color:#9aa4c2}
  .dh-prix b{color:#fff;font-weight:600}
  .dh-note{display:inline-flex;align-items:center;gap:8px;margin-left:6px}
  .dh .accp-etoiles{color:#3a4566}
  .dh .accp-etoiles i{color:#fff}
  .dh-visuel{position:relative;margin:0}
  .dh-visuel img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:24px;display:block;
    box-shadow:0 30px 80px rgba(0,0,0,.45)}
  @media(max-width:899px){.dh-visuel img{aspect-ratio:4/3}}
  .dh-badge{position:absolute;left:clamp(14px,2vw,22px);bottom:clamp(14px,2vw,22px);display:flex;align-items:center;gap:12px;
    padding:12px 16px;border-radius:16px;background:rgba(255,255,255,.94);color:var(--accp-encre);
    box-shadow:0 10px 30px rgba(0,0,0,.25);backdrop-filter:blur(6px)}
  .dh-badge b{font-size:28px;font-weight:600;letter-spacing:-.04em;line-height:1;color:var(--accp-alerte)}
  .dh-badge span{font-size:14px;line-height:1.3;font-weight:500}
</style>

<div class="accp">
  <section class="dh">
    <div class="accp-wrap">
      <ol class="dh-fil">
        <li><a href="{{ routes.root_url }}">Accueil</a></li>
        <li aria-current="page">{{ titre_page }}</li>
      </ol>

      <div class="dh-grille">
        <div>
          {%- if section.settings.surtitre != blank -%}<p class="dh-pastille">{{ section.settings.surtitre }}</p>{%- endif -%}
          <h1>
            {%- if section.settings.mot_cle != blank -%}<span class="dh-cle">{{ section.settings.mot_cle }}</span> {% endif -%}
            {{ section.settings.titre | default: titre_page }}
          </h1>
          {%- if section.settings.chapo != blank -%}<p class="dh-chapo">{{ section.settings.chapo }}</p>{%- endif -%}

          {%- if section.settings.chiffre_1 != blank -%}
            <ul class="dh-chiffres">
              {%- if section.settings.chiffre_1 != blank -%}<li><b>{{ section.settings.chiffre_1 }}</b><span>{{ section.settings.legende_1 }}</span></li>{%- endif -%}
              {%- if section.settings.chiffre_2 != blank -%}<li><b>{{ section.settings.chiffre_2 }}</b><span>{{ section.settings.legende_2 }}</span></li>{%- endif -%}
              {%- if section.settings.chiffre_3 != blank -%}<li><b>{{ section.settings.chiffre_3 }}</b><span>{{ section.settings.legende_3 }}</span></li>{%- endif -%}
            </ul>
          {%- endif -%}

          <div class="dh-actions">
            {%- if p != blank -%}
              <a class="accp-bouton" href="{{ p.url }}">{{ section.settings.bouton | default: 'Découvrir' }}</a>
            {%- endif -%}
            {%- if section.settings.lien_2_texte != blank and section.settings.lien_2_url != blank -%}
              <a class="dh-lien" href="{{ section.settings.lien_2_url }}">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M10 8.5v7l6-3.5-6-3.5z" fill="currentColor" stroke="none"/></svg>
                {{ section.settings.lien_2_texte }}
              </a>
            {%- endif -%}
          </div>

          {%- if p != blank -%}
            <p class="dh-prix">
              {{ section.settings.mention_prix }} <b>{{ p.price | money }}</b>
              {%- if note != blank and nb_avis > 0 -%}
                {%- assign largeur = note | times: 20 -%}
                <span class="dh-note">
                  · <span class="accp-etoiles" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;<i style="width:{{ largeur }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</i></span>
                  <span>{{ note | replace: '.', ',' }}/5 · {{ nb_avis }} avis</span>
                </span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>

        {%- if img != blank -%}
          <figure class="dh-visuel">
            {{ img | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500,700,900,1100', sizes: '(min-width: 900px) 46vw, 92vw', alt: alt_img }}
            {%- if section.settings.badge_chiffre != blank -%}
              <figcaption class="dh-badge"><b>{{ section.settings.badge_chiffre }}</b><span>{{ section.settings.badge_texte | newline_to_br }}</span></figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{%- comment -%} Fil d'Ariane : les donnees structurees sont deja fournies par le theme. {%- endcomment -%}

{% schema %}
{
  "name": "Dissuasion — en-tete",
  "settings": [
    { "type": "product", "id": "produit", "label": "Produit mis en avant", "info": "Prix, note et lien du bouton. Vide = premier produit de la collection." },
    { "type": "text", "id": "surtitre", "label": "Pastille", "default": "Dissuasion active" },
    { "type": "text", "id": "mot_cle", "label": "Debut du titre (mot-cle)", "default": "Canon a fumee anti-intrusion" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Le cambriolage s'arrete en 8 secondes." },
    { "type": "textarea", "id": "chapo", "label": "Accroche" },
    { "type": "header", "content": "Chiffres cles" },
    { "type": "text", "id": "chiffre_1", "label": "Chiffre 1" },
    { "type": "text", "id": "legende_1", "label": "Legende 1" },
    { "type": "text", "id": "chiffre_2", "label": "Chiffre 2" },
    { "type": "text", "id": "legende_2", "label": "Legende 2" },
    { "type": "text", "id": "chiffre_3", "label": "Chiffre 3" },
    { "type": "text", "id": "legende_3", "label": "Legende 3" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "bouton", "label": "Bouton principal (vers le produit)", "default": "Decouvrir le canon a fumee" },
    { "type": "text", "id": "lien_2_texte", "label": "Lien secondaire" },
    { "type": "text", "id": "lien_2_url", "label": "Adresse du lien secondaire", "info": "Ex. #video pour descendre jusqu'a la video." },
    { "type": "text", "id": "mention_prix", "label": "Mention avant le prix", "default": "A partir de" },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Vide = photo du produit." },
    { "type": "text", "id": "image_alt", "label": "Description de la photo" },
    { "type": "text", "id": "badge_chiffre", "label": "Badge : chiffre", "default": "8 s" },
    { "type": "textarea", "id": "badge_texte", "label": "Badge : texte", "default": "pour une piece\nentierement opaque" }
  ],
  "presets": [ { "name": "Dissuasion — en-tete" } ]
}
{% endschema %}
