{%- doc -%}
  Bespoke "shop by category" page for the Daewoo Vigilia / Touch accessory
  collection (handle: compatible-gamme-vigilia-touch). v2 design pass.

  Signature element: the category selector is styled as a control-panel
  "zone" rail, not a generic pill filter — each category is a tile with an
  LED indicator, an icon, and a count set in a monospace "digital readout"
  face, echoing the actual AM301 Touch keypad/screen vernacular this
  collection's products belong to. Selecting a category visually "arms"
  that zone (lit green LED + glow). This is the one deliberate risk this
  page takes; everything else (product grid, cards) stays quiet so that
  signature reads clearly, per the site's existing light, low-drama tone
  on catalog pages.

  Secondary, restrained echo of the same vernacular: product image hover
  reveals a two-corner "detection frame" bracket (camera-viewfinder /
  sensor-zone reticle), not a full 4-corner frame — quieter, still legible
  as the same idea.

  Loops `collection.products` directly (NOT `all_products[handle]` — that
  object silently caps at 20 unique handles per page, which broke an
  earlier version of this file). `collection.products` has no such cap
  and returns up to 50 products without a `paginate` block, which covers
  this collection's 31 products — add paginate if it ever grows past 50.

  Four duplicate/"gratuit" 0,00 € SKUs present in the live collection are
  excluded by handle (see excluded_handles) — they exist for other flows
  (upsells/configurators), not direct browsing. Every remaining product
  gets an explicit category via handle arrays + if/elsif (default
  "accessoires" for anything unmapped), since neither `product_type` nor
  `tags` are populated consistently enough on this catalog to group by
  automatically.

  Category filtering is instant client-side show/hide (no page reload).
  Deliberately NOT position:sticky on the zone rail — avoids the
  sticky-bar/header z-index overlap class of bug already fixed the hard
  way on the product landing pages, without being able to verify this
  theme's live header height/z-index here.

  Each card is its own independent product-form with a quantity stepper,
  reusing the theme's existing ProductForm custom element (assets/theme.js,
  registered globally as `product-form`) — add-to-cart and opening the
  cart drawer need no bespoke JS at all, only the stepper and the
  category-filter toggle do.
{%- enddoc -%}

{%- liquid
  assign excluded_handles = "daewoo-pack-de-2-badges-rfid-wrf301,cadeau-detecteur-de-fuite-deau-wwf301-compatible-touch-am301-am302,cadeau-detecteur-de-fumee-wsd301-compatible-touch-vigilia-am30x,configurateur-sirene-interieure-sans-fil-100-db-wis305-alimentation-electrique-batterie-de-secours-copie-1" | split: ","
  assign detecteurs_handles = "detecteur-de-mouvement-wps301,detecteur-de-mouvement-animaux-compatible-touch-vigilia-am30x,detecteur-de-vibration-wvd301,detecteur-de-mouvement-exterieur-wmo301,detecteur-de-fumee-wsd301,detecteur-de-fuite-deau-wwf301-compatible-avec-les-centrale-am301-am302,daewoo-barrieres-infrarouge-pour-alarme-am301-am302" | split: ","
  assign contacteurs_handles = "contacteur-de-porte-wds301,contacteur-2-en-1-porte-et-vibrations-compatible-avec-lalarme-am301-am302,contacteur-de-porte-de-garage-wdg301" | split: ","
  assign sirenes_handles = "sirene-exterieure-wos305-filaire-compatible-panneau-solaire,sirene-exterieure-wos305s-sirene-avec-batterie-de-secours-et-panneau-solaire,sirene-filaire-wos301-compatible-avec-lalarme-am301-am302,sirene-exterieure-solaire-wos301s,sirene-interieure-sans-fil-100-db-wis305,panneau-solaire-spwos305-compatible-avec-lasirene-wos305,adaptateur-secteur-wos301s" | split: ","
  assign telecommandes_handles = "clavier-wke301-avec-2-badges-rfid,pack-de-2-badges-rfid-wrf301,telecommande-compatible-vigilia-touch,telecommande-wrc301" | split: ","
  assign centrale_handles = "centrale-touch-am301-avec-ecran-tactile-4-3" | split: ","
  assign amplificateur_handles = "amplificateur-de-signal-radio-compatible-avec-la-gamme-am301" | split: ","
  assign sim_handles = "carte-sim-m2m-afone-1-an-prepaye-pour-centrale-vigilia,carte-sim-m2m-afone-1-an-prepaye,carte-m2m-afone-40-min-ou-100-sms" | split: ","

  assign count_detecteurs = 0
  assign count_contacteurs = 0
  assign count_sirenes = 0
  assign count_telecommandes = 0
  assign count_centrale = 0
  assign count_amplificateur = 0
  assign count_sim = 0
  assign count_accessoires = 0
  assign total_count = 0

  for product in collection.products
    if excluded_handles contains product.handle
      continue
    endif
    assign total_count = total_count | plus: 1
    if detecteurs_handles contains product.handle
      assign count_detecteurs = count_detecteurs | plus: 1
    elsif contacteurs_handles contains product.handle
      assign count_contacteurs = count_contacteurs | plus: 1
    elsif sirenes_handles contains product.handle
      assign count_sirenes = count_sirenes | plus: 1
    elsif telecommandes_handles contains product.handle
      assign count_telecommandes = count_telecommandes | plus: 1
    elsif centrale_handles contains product.handle
      assign count_centrale = count_centrale | plus: 1
    elsif amplificateur_handles contains product.handle
      assign count_amplificateur = count_amplificateur | plus: 1
    elsif sim_handles contains product.handle
      assign count_sim = count_sim | plus: 1
    else
      assign count_accessoires = count_accessoires | plus: 1
    endif
  endfor

  assign total_count_str = total_count
  if total_count < 10
    assign total_count_str = total_count | prepend: "0"
  endif
  assign count_detecteurs_str = count_detecteurs
  if count_detecteurs < 10
    assign count_detecteurs_str = count_detecteurs | prepend: "0"
  endif
  assign count_contacteurs_str = count_contacteurs
  if count_contacteurs < 10
    assign count_contacteurs_str = count_contacteurs | prepend: "0"
  endif
  assign count_sirenes_str = count_sirenes
  if count_sirenes < 10
    assign count_sirenes_str = count_sirenes | prepend: "0"
  endif
  assign count_telecommandes_str = count_telecommandes
  if count_telecommandes < 10
    assign count_telecommandes_str = count_telecommandes | prepend: "0"
  endif
  assign count_centrale_str = count_centrale
  if count_centrale < 10
    assign count_centrale_str = count_centrale | prepend: "0"
  endif
  assign count_amplificateur_str = count_amplificateur
  if count_amplificateur < 10
    assign count_amplificateur_str = count_amplificateur | prepend: "0"
  endif
  assign count_sim_str = count_sim
  if count_sim < 10
    assign count_sim_str = count_sim | prepend: "0"
  endif
  assign count_accessoires_str = count_accessoires
  if count_accessoires < 10
    assign count_accessoires_str = count_accessoires | prepend: "0"
  endif
-%}

<div id="shopify-section-{{ section.id }}" class="vts">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&display=swap');

    #shopify-section-{{ section.id }} .vts{
      --vts-navy:#0c1e4a;
      --vts-navy-deep:#071228;
      --vts-panel:#12161f;
      --vts-ink:#171b23;
      --vts-gray:#5b6270;
      --vts-paper:#eef1f6;
      --vts-line:#dde3ec;
      --vts-green:#037e05;
      --vts-green-glow:#22c55e;
      --vts-green-soft:#e6f5ea;
      --vts-amber:#f79009;
      --vts-red:#c0362c;
      --vts-red-soft:#fbe9e7;
      --vts-cta:#ffd814;
      --vts-cta-hover:#f7ca00;
      --vts-cta-border:#fcd200;
      --vts-cta-ink:#0f1111;
      --vts-mono:'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      font-family:'Poppins', sans-serif;
      color:var(--vts-ink);
      background:#fff;
    }
    .vts *{box-sizing:border-box;}
    .vts .vts-wrap{max-width:1240px;margin:0 auto;padding:0 24px;}
    .vts img{max-width:100%;display:block;}
    .vts button{font-family:inherit;}

    /* ---- status readout strip ---- */
    .vts-readout{background:var(--vts-panel);color:#fff;padding:11px 0;}
    .vts-readout__row{
      display:flex;align-items:center;flex-wrap:wrap;gap:8px 14px;
      font-family:var(--vts-mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;
    }
    .vts-readout__status{display:inline-flex;align-items:center;gap:8px;color:#fff;font-weight:600;}
    .vts-readout__dot{
      width:7px;height:7px;border-radius:50%;background:var(--vts-green-glow);flex-shrink:0;
      animation:vts-pulse 2.4s ease-in-out infinite;
    }
    .vts-readout__sep{color:rgba(255,255,255,.28);}
    .vts-readout__meta{color:rgba(255,255,255,.62);font-weight:500;}
    @keyframes vts-pulse{
      0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.55);}
      50%{box-shadow:0 0 0 5px rgba(34,197,94,0);}
    }

    /* ---- intro ---- */
    .vts-hero{padding:40px 0 30px;background:var(--vts-paper);text-align:center;}
    .vts-eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      font-size:12.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;
      color:var(--vts-green);margin-bottom:14px;
    }
    .vts-eyebrow::before{content:"";width:14px;height:2px;background:var(--vts-green);}
    .vts-hero h1{
      font-weight:700;letter-spacing:-.02em;line-height:1.12;margin:0;
      font-size:clamp(26px,4.6vw,40px);max-width:720px;margin:0 auto;color:var(--vts-navy-deep);
    }
    .vts-hero__sub{
      font-size:clamp(15px,1.8vw,17px);color:var(--vts-gray);
      max-width:600px;margin:16px auto 0;line-height:1.55;
    }

    /* ---- zone selector (signature) ----
       Not position:sticky (see file doc comment). Horizontal scroll on
       narrow screens keeps every zone one tap away without wrapping into
       a tall block above the grid. */
    .vts-filters{padding:24px 0 22px;border-bottom:1px solid var(--vts-line);}
    .vts-filters__label{
      font-family:var(--vts-mono);font-size:11px;font-weight:600;letter-spacing:.12em;
      text-transform:uppercase;color:var(--vts-gray);margin:0 0 12px;
    }
    .vts-filters__row{
      display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;
      scrollbar-width:none;-ms-overflow-style:none;
    }
    .vts-filters__row::-webkit-scrollbar{display:none;}

    .vts-zone{
      flex-shrink:0;display:flex;flex-direction:column;gap:10px;
      width:124px;padding:13px 14px 12px;border-radius:14px;
      border:1px solid var(--vts-line);background:#fff;cursor:pointer;text-align:left;
      transition:border-color .15s ease,background .15s ease,box-shadow .2s ease;
    }
    .vts-zone__top{display:flex;align-items:center;justify-content:space-between;}
    .vts-zone__led{
      width:8px;height:8px;border-radius:50%;background:transparent;
      border:1.5px solid var(--vts-line);flex-shrink:0;transition:all .2s ease;
    }
    .vts-zone__icon{color:var(--vts-navy);opacity:.65;display:flex;transition:color .2s ease,opacity .2s ease;}
    .vts-zone__label{
      font-size:12.5px;font-weight:600;color:var(--vts-ink);line-height:1.3;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em;
    }
    .vts-zone__count{
      font-family:var(--vts-mono);font-size:12.5px;font-weight:600;letter-spacing:.03em;
      color:var(--vts-gray);background:var(--vts-paper);border-radius:6px;padding:2px 7px;
      align-self:flex-start;transition:background .2s ease,color .2s ease;
    }
    .vts-zone:hover{border-color:var(--vts-navy);}
    .vts-zone.is-active{
      border-color:var(--vts-green);background:var(--vts-green-soft);
      box-shadow:0 8px 20px -14px rgba(3,126,5,.45);
    }
    .vts-zone.is-active .vts-zone__led{
      background:var(--vts-green-glow);border-color:var(--vts-green-glow);
      box-shadow:0 0 0 4px rgba(34,197,94,.22);
    }
    .vts-zone.is-active .vts-zone__icon{color:var(--vts-green);opacity:1;}
    .vts-zone.is-active .vts-zone__count{background:var(--vts-navy);color:#fff;}

    /* ---- grid ---- */
    .vts-grid-section{padding:30px 0 72px;}
    .vts-count{font-size:13.5px;color:var(--vts-gray);margin-bottom:18px;}
    .vts-count strong{font-family:var(--vts-mono);color:var(--vts-ink);font-weight:600;}
    .vts-grid{
      display:grid;grid-template-columns:repeat(2,1fr);gap:16px;
    }
    @media (min-width:700px){.vts-grid{grid-template-columns:repeat(3,1fr);gap:20px;}}
    @media (min-width:1080px){.vts-grid{grid-template-columns:repeat(4,1fr);}}

    .vts-card{
      display:flex;flex-direction:column;
      border:1px solid var(--vts-line);border-radius:18px;overflow:hidden;background:#fff;
      transition:box-shadow .2s ease,transform .2s ease;
    }
    .vts-card:hover{box-shadow:0 16px 32px -20px rgba(7,18,40,.25);transform:translateY(-2px);}
    .vts-card.is-hidden{display:none;}

    .vts-card__media{position:relative;display:block;aspect-ratio:1/1;background:var(--vts-paper);overflow:hidden;}
    .vts-card__media img{width:100%;height:100%;object-fit:contain;padding:14px;}
    .vts-card--oos .vts-card__media img{opacity:.45;}
    .vts-card__badge{
      position:absolute;top:10px;left:10px;font-size:11px;font-weight:700;
      padding:5px 10px;border-radius:999px;letter-spacing:.02em;
    }
    .vts-card__badge--oos{background:var(--vts-red-soft);color:var(--vts-red);}

    /* detection-frame corners: quiet echo of the zone-rail LED motif */
    .vts-card__media::before,.vts-card__media::after{
      content:"";position:absolute;width:14px;height:14px;opacity:0;
      transition:opacity .2s ease;pointer-events:none;
    }
    .vts-card__media::before{top:8px;left:8px;border-top:2px solid var(--vts-green);border-left:2px solid var(--vts-green);}
    .vts-card__media::after{bottom:8px;right:8px;border-bottom:2px solid var(--vts-green);border-right:2px solid var(--vts-green);}
    .vts-card:hover .vts-card__media::before,.vts-card:hover .vts-card__media::after{opacity:1;}

    /* "view details" cue — always visible (not hover-only) so it also
       works as a discovery hint on touch devices with no hover state */
    .vts-card__view{
      position:absolute;bottom:8px;right:8px;width:28px;height:28px;border-radius:50%;
      display:flex;align-items:center;justify-content:center;pointer-events:none;
      background:rgba(255,255,255,.92);color:var(--vts-navy);
      box-shadow:0 4px 10px -4px rgba(7,18,40,.4);
      transition:transform .2s ease,background .2s ease,color .2s ease;
    }
    .vts-card:hover .vts-card__view{transform:scale(1.1);background:var(--vts-navy);color:#fff;}

    .vts-card__body{padding:14px 14px 16px;display:flex;flex-direction:column;gap:8px;flex:1;}
    .vts-card__title{
      font-size:13.5px;font-weight:600;line-height:1.4;color:var(--vts-ink);text-decoration:none;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.8em;
    }
    .vts-card__title:hover{color:var(--vts-navy);}
    .vts-card__price{font-size:16px;font-weight:700;color:var(--vts-navy-deep);}

    .vts-card__form{margin-top:auto;display:flex;flex-direction:column;gap:8px;}
    .vts-qty{
      display:inline-flex;align-items:center;justify-content:space-between;
      border:1px solid var(--vts-line);border-radius:10px;overflow:hidden;height:38px;
    }
    .vts-qty__btn{
      width:36px;height:100%;border:none;background:var(--vts-paper);color:var(--vts-navy);
      font-size:16px;line-height:1;cursor:pointer;flex-shrink:0;
    }
    .vts-qty__btn:hover{background:var(--vts-line);}
    .vts-qty__input{
      width:100%;border:none;text-align:center;font-family:var(--vts-mono);font-size:13.5px;font-weight:600;
      color:var(--vts-ink);-moz-appearance:textfield;background:#fff;
    }
    .vts-qty__input::-webkit-outer-spin-button,.vts-qty__input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}

    .vts-add{
      position:relative;overflow:hidden;isolation:isolate;
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      border:1px solid var(--vts-cta-border);border-radius:10px;cursor:pointer;height:40px;
      font-family:inherit;font-size:13.5px;font-weight:600;
      background:var(--vts-cta);color:var(--vts-cta-ink);
      transition:transform .15s ease,opacity .15s ease;
    }
    .vts-add:active{transform:scale(.98);}
    .vts-add .btn-fill{position:absolute;inset:0;z-index:-1;transform:translateY(100%);background:var(--vts-cta-hover);}
    .vts-add__text{position:relative;display:inline-flex;align-items:center;gap:8px;}

    .vts-card__unavailable{
      margin-top:auto;font-size:12.5px;font-weight:600;color:var(--vts-gray);
      background:var(--vts-paper);border-radius:10px;padding:10px;text-align:center;
    }

    .vts-zone:focus-visible,.vts-add:focus-visible,.vts-qty__btn:focus-visible,
    .vts-card__title:focus-visible{outline:2px solid var(--vts-navy);outline-offset:2px;}

    @media (prefers-reduced-motion:reduce){
      .vts-card{transition:none;}
      .vts-readout__dot{animation:none;}
    }
  </style>

  {%- comment -%} Status readout strip {%- endcomment -%}
  <div class="vts-readout">
    <div class="vts-wrap">
      <div class="vts-readout__row">
        <span class="vts-readout__status"><span class="vts-readout__dot" aria-hidden="true"></span>Système en ligne</span>
        <span class="vts-readout__sep">·</span>
        <span class="vts-readout__meta">{{ total_count_str }} accessoires disponibles</span>
        <span class="vts-readout__sep">·</span>
        <span class="vts-readout__meta">Compatible AM301 Touch &amp; Vigilia AM30x</span>
      </div>
    </div>
  </div>

  {%- comment -%} Intro {%- endcomment -%}
  <section class="vts-hero">
    <div class="vts-wrap">
      <span class="vts-eyebrow">Daewoo Security</span>
      <h1>Chaque zone de votre maison, son accessoire</h1>
      <p class="vts-hero__sub">
        Détecteurs, sirènes, contacteurs, télécommandes et accessoires compatibles avec votre
        centrale Vigilia ou Touch. Sélectionnez une zone, réglez la quantité, ajoutez au panier.
      </p>
    </div>
  </section>

  {%- comment -%} Zone selector {%- endcomment -%}
  <div class="vts-filters">
    <div class="vts-wrap">
      <p class="vts-filters__label">Sélectionner une zone</p>
      <div class="vts-filters__row" role="group" aria-label="Filtrer par catégorie">
        <button type="button" class="vts-zone is-active" data-filter="all" aria-pressed="true">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg></span>
          </span>
          <span class="vts-zone__label">Tous</span>
          <span class="vts-zone__count">{{ total_count_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="detecteurs" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"></circle><path d="M8 8a5.66 5.66 0 0 1 8 0"></path><path d="M5 5a10 10 0 0 1 14 0"></path></svg></span>
          </span>
          <span class="vts-zone__label">Détecteurs</span>
          <span class="vts-zone__count">{{ count_detecteurs_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="contacteurs" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="10" height="18" rx="1"></rect><circle cx="12" cy="12" r="1"></circle><path d="M15 3l4 2v16l-4-2"></path></svg></span>
          </span>
          <span class="vts-zone__label">Contacteurs</span>
          <span class="vts-zone__count">{{ count_contacteurs_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="sirenes" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg></span>
          </span>
          <span class="vts-zone__label">Sirènes</span>
          <span class="vts-zone__count">{{ count_sirenes_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="telecommandes" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="15" r="3.2"></circle><path d="M9.3 12.7L18 4"></path><path d="M14.5 8.2l2.3 2.3"></path><path d="M17.2 5.5l2.3 2.3"></path></svg></span>
          </span>
          <span class="vts-zone__label">Contrôle d&#8217;accès</span>
          <span class="vts-zone__count">{{ count_telecommandes_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="centrale" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"></rect><path d="M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"></path></svg></span>
          </span>
          <span class="vts-zone__label">Centrale</span>
          <span class="vts-zone__count">{{ count_centrale_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="amplificateur" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"></path><path d="M8.5 20v-6"></path><path d="M15.5 20v-6"></path><path d="M5 20v-3"></path><path d="M19 20v-3"></path><path d="M8.5 8a5 5 0 0 1 7 0"></path><path d="M5.5 5a9 9 0 0 1 13 0"></path></svg></span>
          </span>
          <span class="vts-zone__label">Amplificateur</span>
          <span class="vts-zone__count">{{ count_amplificateur_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="sim" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h6l4 4v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"></path><rect x="9.5" y="9" width="5" height="4" rx="1"></rect></svg></span>
          </span>
          <span class="vts-zone__label">Cartes SIM</span>
          <span class="vts-zone__count">{{ count_sim_str }}</span>
        </button>
        <button type="button" class="vts-zone" data-filter="accessoires" aria-pressed="false">
          <span class="vts-zone__top">
            <span class="vts-zone__led" aria-hidden="true"></span>
            <span class="vts-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8-5.1-4.7 6.9-.8L12 2z"></path></svg></span>
          </span>
          <span class="vts-zone__label">Accessoires</span>
          <span class="vts-zone__count">{{ count_accessoires_str }}</span>
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Product grid {%- endcomment -%}
  <section class="vts-grid-section">
    <div class="vts-wrap">
      <p class="vts-count" aria-live="polite"><strong data-visible-count>{{ total_count }}</strong> accessoire{{ total_count | pluralize: '', 's' }} affiché{{ total_count | pluralize: '', 's' }}</p>
      <div class="vts-grid">
        {%- for product in collection.products -%}
          {%- if excluded_handles contains product.handle -%}{%- continue -%}{%- endif -%}
          {%- assign card_cat = "accessoires" -%}
          {%- if detecteurs_handles contains product.handle -%}
            {%- assign card_cat = "detecteurs" -%}
          {%- elsif contacteurs_handles contains product.handle -%}
            {%- assign card_cat = "contacteurs" -%}
          {%- elsif sirenes_handles contains product.handle -%}
            {%- assign card_cat = "sirenes" -%}
          {%- elsif telecommandes_handles contains product.handle -%}
            {%- assign card_cat = "telecommandes" -%}
          {%- elsif centrale_handles contains product.handle -%}
            {%- assign card_cat = "centrale" -%}
          {%- elsif amplificateur_handles contains product.handle -%}
            {%- assign card_cat = "amplificateur" -%}
          {%- elsif sim_handles contains product.handle -%}
            {%- assign card_cat = "sim" -%}
          {%- endif -%}
          {%- assign card_variant = product.selected_or_first_available_variant -%}
          {%- assign card_form_id = "VTSForm-" | append: forloop.index | append: "-" | append: section.id -%}
          <div class="vts-card{% unless card_variant.available %} vts-card--oos{% endunless %}" data-category="{{ card_cat }}">
            <a href="{{ product.url }}" class="vts-card__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,375,500', alt: product.title, sizes: '(min-width: 1080px) 25vw, (min-width: 700px) 33vw, 50vw' }}
              {%- endif -%}
              {%- unless card_variant.available -%}
                <span class="vts-card__badge vts-card__badge--oos">Rupture de stock</span>
              {%- endunless -%}
              <span class="vts-card__view" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </span>
            </a>
            <div class="vts-card__body">
              <a href="{{ product.url }}" class="vts-card__title">{{ product.title }}</a>
              <div class="vts-card__price">{{ card_variant.price | money }}</div>

              {%- if card_variant.available -%}
                {%- form 'product', product, is: 'product-form', id: card_form_id, class: 'vts-card__form' -%}
                  <input type="hidden" name="id" value="{{ card_variant.id }}">
                  <div class="vts-qty" data-qty>
                    <button type="button" class="vts-qty__btn" data-qty-decrease aria-label="Diminuer la quantité">−</button>
                    <input type="number" class="vts-qty__input" name="quantity" value="1" min="1" inputmode="numeric" data-qty-input aria-label="Quantité, {{ product.title }}">
                    <button type="button" class="vts-qty__btn" data-qty-increase aria-label="Augmenter la quantité">+</button>
                  </div>
                  <button type="submit" class="vts-add" is="hover-button">
                    <span class="btn-fill" data-fill aria-hidden="true"></span>
                    <span class="btn-text vts-add__text">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.5 3h2l2.7 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21.5 8H6"></path></svg>
                      Ajouter
                    </span>
                  </button>
                {%- endform -%}
              {%- else -%}
                <div class="vts-card__unavailable">Indisponible pour le moment</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      /* Quantity steppers */
      root.querySelectorAll('[data-qty]').forEach(function (wrap) {
        var input = wrap.querySelector('[data-qty-input]');
        var dec = wrap.querySelector('[data-qty-decrease]');
        var inc = wrap.querySelector('[data-qty-increase]');
        function clamp(v) {
          v = parseInt(v, 10);
          if (isNaN(v) || v < 1) v = 1;
          return v;
        }
        dec.addEventListener('click', function () {
          input.value = clamp(parseInt(input.value, 10) - 1);
        });
        inc.addEventListener('click', function () {
          input.value = clamp(parseInt(input.value, 10) + 1);
        });
        input.addEventListener('change', function () {
          input.value = clamp(input.value);
        });
      });

      /* Zone (category) filter — instant client-side show/hide */
      var zones = root.querySelectorAll('[data-filter]');
      var cards = root.querySelectorAll('.vts-card');
      var countEl = root.querySelector('[data-visible-count]');
      function applyFilter(filter) {
        var visible = 0;
        cards.forEach(function (card) {
          var match = filter === 'all' || card.getAttribute('data-category') === filter;
          card.classList.toggle('is-hidden', !match);
          if (match) visible++;
        });
        if (countEl) countEl.textContent = visible;
      }
      zones.forEach(function (zone) {
        zone.addEventListener('click', function () {
          zones.forEach(function (z) {
            z.classList.remove('is-active');
            z.setAttribute('aria-pressed', 'false');
          });
          zone.classList.add('is-active');
          zone.setAttribute('aria-pressed', 'true');
          applyFilter(zone.getAttribute('data-filter'));
        });
      });
    })();
  </script>
</div>

