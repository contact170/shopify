{%- comment -%}
  Mise en avant de l'offre « Pack Sécurité Intégrale » sur la page d'accueil (style home V2).
  - Un bloc « centrale » par pack : prix lu sur le produit, valeur de référence saisie à la main.
  - La section disparaît seule après la date de fin.
{%- endcomment -%}
{%- liquid
  assign maintenant = 'now' | date: '%s' | plus: 0
  assign actif = true
  if section.settings.end_date != blank
    assign fin = section.settings.end_date | date: '%s' | plus: 0
    if maintenant > fin
      assign actif = false
    endif
  endif
  if request.design_mode
    assign actif = true
  endif

  assign centrales = section.blocks | where: 'type', 'centrale'
  assign c0 = centrales | first
  assign p0 = c0.settings.product
  assign lien = section.settings.cta_link | default: '/pages/offre-speciale'

  assign prix_min = 0
  assign eco_max = 0
  assign pct_max = 0
  for block in centrales
    assign pr = block.settings.product.price
    if pr
      if prix_min == 0 or pr < prix_min
        assign prix_min = pr
      endif
      if block.settings.ref_value != blank
        assign ref = block.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
        assign eco = ref | minus: pr
        if eco > eco_max
          assign eco_max = eco
          assign pct_max = eco | times: 100.0 | divided_by: ref | floor
        endif
      endif
    endif
  endfor

  assign visuel = section.settings.image | default: p0.featured_image
-%}
{%- if actif -%}
{%- liquid
  # Centrale la moins chère : c'est elle qui porte le « dès » et son prix barré
  assign ref_min = 0
  for block in centrales
    if block.settings.product.price == prix_min and block.settings.ref_value != blank
      assign ref_min = block.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
    endif
  endfor
-%}
{% render 'dw-home-head' %}
<div class="dwh psih" id="PsiHome-{{ section.id }}" data-fin="{{ section.settings.end_date | escape }}">
  <section class="dwh-bloc psih__bloc" aria-labelledby="PsiHomeTitre-{{ section.id }}">
    <div class="dwh-large psih__grille">

      <div class="psih__tete">
        <p class="psih__pastille"><span class="psih__point" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
        {%- if section.settings.end_date != blank -%}
          <div class="psih__compte" data-psih-compte aria-label="Temps restant avant la fin de l'offre">
            <span class="psih__case"><b data-psih-j>--</b><small>jours</small></span>
            <span class="psih__case"><b data-psih-h>--</b><small>heures</small></span>
            <span class="psih__case"><b data-psih-m>--</b><small>min</small></span>
            <span class="psih__case"><b data-psih-s>--</b><small>sec</small></span>
          </div>
        {%- endif -%}
        <h2 class="dwh-titre psih__titre" id="PsiHomeTitre-{{ section.id }}">{{ section.settings.title }}</h2>
      </div>

      <a class="psih__visuel" href="{{ lien }}" tabindex="-1" aria-hidden="true" data-psih-visuel>
        {%- if pct_max > 0 -%}<span class="psih__remise"><small data-psih-remise-av>jusqu'à</small><b data-psih-remise>-{{ pct_max }}&nbsp;%</b></span>{%- endif -%}
        {%- if visuel -%}
          {{ visuel | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 750px) 540px, 100vw', alt: '', data-psih-img: '' }}
        {%- endif -%}
      </a>

      <div class="psih__offre">
        {%- if prix_min > 0 -%}
          <div class="psih__prixbloc">
            <p class="psih__des" data-psih-des>{{ section.settings.price_label }}</p>
            <p class="psih__ligne">
              <b class="psih__grand" data-psih-prix>{{ prix_min | money }}</b>
              {%- if ref_min > prix_min -%}<s class="psih__barre" data-psih-barre>{{ ref_min | money }}</s>{%- endif -%}
            </p>
            {%- if eco_max > 0 -%}<p class="psih__eco" data-psih-eco>Jusqu'à <b>{{ eco_max | money }}</b> d'économie</p>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.text != blank -%}<p class="psih__texte">{{ section.settings.text }}</p>{%- endif -%}
        {%- assign puces = section.settings.bullets | newline_to_br | split: '<br />' -%}
        {%- if section.settings.bullets != blank -%}
          <ul class="dwh-puces psih__puces">
            {%- for puce in puces -%}{%- assign t = puce | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if centrales.size > 0 -%}
          <p class="psih__choix-titre">{{ section.settings.choice_label }}</p>
          <ul class="psih__choix">
            {%- for block in centrales -%}
              {%- liquid
                assign p = block.settings.product
                assign ref = 0
                if block.settings.ref_value != blank
                  assign ref = block.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
                endif
                assign url_centrale = lien
                if block.settings.slug != blank
                  assign url_centrale = lien | append: '?centrale=' | append: block.settings.slug
                endif
                assign pct = 0
                assign eco_c = 0
                if p and ref > p.price
                  assign eco_c = ref | minus: p.price
                  assign pct = eco_c | times: 100.0 | divided_by: ref | floor
                endif
                assign photo_c = block.settings.image | default: p.featured_image
              -%}
              <li {{ block.shopify_attributes }}>
                <button type="button" class="psih__carte" aria-pressed="false" data-psih-choix="{{ forloop.index0 }}"
                  {% if photo_c %}data-src="{{ photo_c | image_url: width: 900 }}" data-srcset="{{ photo_c | image_url: width: 400 }} 400w, {{ photo_c | image_url: width: 600 }} 600w, {{ photo_c | image_url: width: 900 }} 900w, {{ photo_c | image_url: width: 1200 }} 1200w"{% endif %}
                  data-url="{{ url_centrale }}" data-nom="{{ block.settings.label | escape }}" data-pct="{{ pct }}"
                  data-prix="{% if p %}{{ p.price | money | strip_html }}{% endif %}"
                  data-barre="{% if ref > 0 %}{{ ref | money | strip_html }}{% endif %}"
                  data-eco="{% if eco_c > 0 %}{{ eco_c | money | strip_html }}{% endif %}">
                  {%- if block.settings.badge != blank -%}<span class="psih__badge">{{ block.settings.badge }}</span>{%- endif -%}
                  <span class="psih__nom">{{ block.settings.label }}</span>
                  <span class="psih__sous">{{ block.settings.sub }}</span>
                  <span class="psih__prix">
                    {%- if p -%}<b>{{ p.price | money }}</b>{%- endif -%}
                    {%- if p and ref > p.price -%}<s>{{ ref | money }}</s>{%- endif -%}
                  </span>
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="psih__cta">
          <a class="dwh-btn psih__btn" href="{{ lien }}" data-psih-cta>
            <span data-psih-cta-texte>{{ section.settings.cta_label }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          {%- if section.settings.note != blank -%}<p class="psih__note">{{ section.settings.note }}</p>{%- endif -%}
        </div>
      </div>

    </div>
  </section>
</div>

<style>
  .psih .psih__bloc{position:relative;overflow:hidden;color:#fff;padding:56px 16px;
    background:radial-gradient(90% 70% at 90% 10%,rgba(21,82,214,.45),transparent 60%),radial-gradient(70% 60% at 0% 100%,rgba(225,29,72,.25),transparent 60%),#0a1330;}
  .psih .psih__grille{display:grid;gap:24px;grid-template-areas:"tete" "visuel" "offre";align-items:center;}
  .psih .psih__tete{grid-area:tete;}
  .psih .psih__visuel{grid-area:visuel;}
  .psih .psih__offre{grid-area:offre;}

  .psih .psih__pastille{display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;background:#e11d48;color:#fff;font-size:12.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
  .psih .psih__point{width:8px;height:8px;border-radius:50%;background:#fff;animation:psih-pulse 1.6s infinite;}
  @keyframes psih-pulse{0%{box-shadow:0 0 0 0 rgba(255,255,255,.7);}70%{box-shadow:0 0 0 8px rgba(255,255,255,0);}100%{box-shadow:0 0 0 0 rgba(255,255,255,0);}}
  .psih .psih__compte{display:flex;gap:8px;margin-top:16px;}
  .psih .psih__case{display:flex;flex-direction:column;align-items:center;min-width:62px;padding:10px 8px 8px;border-radius:14px;background:rgba(255,255,255,.08);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12);}
  .psih .psih__case b{font-size:26px;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;}
  .psih .psih__case small{margin-top:4px;font-size:11px;color:var(--brume);text-transform:uppercase;letter-spacing:.06em;}
  .psih .psih__titre{margin-top:20px;color:#fff;font-size:clamp(30px,7vw,48px);}
  .psih .psih__titre em{color:var(--brume);}

  .psih .psih__visuel{position:relative;display:block;border-radius:24px;overflow:visible;background:#fff;box-shadow:0 30px 60px -20px rgba(0,0,0,.6);}
  .psih .psih__visuel img{width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;border-radius:24px;transition:opacity 200ms ease;}
  .psih .psih__visuel img.is-changing{opacity:.25;}
  .psih .psih__remise{position:absolute;top:-14px;left:-6px;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;width:96px;height:96px;border-radius:50%;background:#e11d48;color:#fff;transform:rotate(-10deg);box-shadow:0 12px 24px -8px rgba(225,29,72,.8);}
  .psih .psih__remise small{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;line-height:1;}
  .psih .psih__remise b{font-size:26px;line-height:1.05;font-weight:800;}

  .psih .psih__des{font-size:15px;color:var(--brume);}
  .psih .psih__ligne{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px;margin-top:2px;}
  .psih .psih__grand{font-size:clamp(52px,13vw,76px);line-height:1;font-weight:800;letter-spacing:-.03em;color:#fff;}
  .psih .psih__barre{font-size:22px;color:var(--brume);text-decoration-thickness:2px;}
  .psih .psih__eco{display:inline-block;margin-top:14px;padding:8px 14px;border-radius:12px;background:#ffd500;color:#0a1330;font-size:16px;font-weight:600;}
  .psih .psih__eco b{font-weight:800;}
  .psih .psih__texte{margin-top:20px;font-size:16px;line-height:1.55;color:var(--brume);}
  .psih .psih__puces{margin-top:16px;}
  .psih .psih__puces li{color:#fff;}

  .psih .psih__choix-titre{margin-top:28px;margin-bottom:16px;font-size:14px;font-weight:600;color:var(--brume);}
  .psih .psih__choix{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .psih .psih__carte{position:relative;min-width:0;width:100%;height:100%;display:flex;flex-direction:column;gap:2px;padding:14px 14px 12px;border:0;border-radius:16px;text-align:left;font:inherit;cursor:pointer;color:#fff;background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.16);transition:box-shadow 200ms ease,background-color 200ms ease,transform 160ms var(--ease-out);}
  .psih .psih__carte:active{transform:scale(.98);}
  @media (hover:hover) and (pointer:fine){.psih .psih__carte:hover{box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.5);}}
  .psih .psih__carte[aria-pressed="true"]{background:rgba(255,213,0,.1);box-shadow:inset 0 0 0 2px #ffd500;}
  .psih .psih__badge{position:absolute;top:-9px;left:12px;font-size:10.5px;font-weight:700;color:#fff;background:#e11d48;padding:2px 8px;border-radius:999px;}
  .psih .psih__nom{font-weight:700;font-size:16px;}
  .psih .psih__sous{font-size:13px;color:var(--brume);}
  .psih .psih__prix{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;margin-top:6px;}
  .psih .psih__prix b{font-size:17px;}
  .psih .psih__prix s{font-size:12.5px;color:var(--brume);}

  .psih .psih__cta{margin-top:24px;}
  .psih .psih__btn{background:#ffd500;color:#0a1330;font-weight:700;box-shadow:0 14px 34px -10px rgba(255,213,0,.6);}
  @media (hover:hover) and (pointer:fine){.psih .psih__btn:hover{background:#ffe24d;}}
  .psih .psih__note{margin-top:12px;font-size:12.5px;line-height:1.45;color:var(--brume);}
  .psih :focus-visible{outline-color:#ffd500;}
  .psih [hidden]{display:none !important;}

  @media (min-width:750px){
    .psih .psih__bloc{padding:80px 24px;}
    .psih .psih__grille{grid-template-columns:1.05fr 1fr;grid-template-areas:"tete visuel" "offre visuel";column-gap:56px;row-gap:8px;align-items:start;}
    .psih .psih__visuel{align-self:center;}
    .psih .psih__prixbloc{margin-top:18px;}
    .psih .psih__remise{width:112px;height:112px;top:-22px;left:-22px;}
    .psih .psih__remise b{font-size:30px;}
    .psih .psih__cta .dwh-btn{width:auto;min-width:320px;}
  }
  @media (min-width:1100px){.psih .psih__choix{grid-template-columns:repeat(4,1fr);}}
  @media (max-width:389px){.psih .psih__case{min-width:0;flex:1;}}
  @media (prefers-reduced-motion:reduce){.psih .psih__point{animation:none;}}
</style>

<script>
  (function () {
    var racine = document.getElementById('PsiHome-{{ section.id }}');
    if (!racine) return;
    /* Choix de la centrale : écouteur unique sur le document, pour continuer à marcher
       quand l'éditeur de thème recharge la section */
    if (!window.psihChoixInstalle) {
      window.psihChoixInstalle = true;
      document.addEventListener('click', function (e) {
        var c = e.target.closest && e.target.closest('[data-psih-choix]');
        if (!c) return;
        var bloc = c.closest('.psih');
        if (!bloc) return;
        var q = function (sel) { return bloc.querySelector(sel); };
        bloc.querySelectorAll('[data-psih-choix]').forEach(function (x) { x.setAttribute('aria-pressed', x === c ? 'true' : 'false'); });
        var img = q('[data-psih-img]') || q('.psih__visuel img');
        var src = c.getAttribute('data-src');
        if (img && src && img.getAttribute('src') !== src) {
          img.classList.add('is-changing');
          var fini = function () { img.classList.remove('is-changing'); img.removeEventListener('load', fini); };
          img.addEventListener('load', fini);
          img.setAttribute('srcset', c.getAttribute('data-srcset') || src);
          img.setAttribute('src', src);
          img.loading = 'eager';
          setTimeout(fini, 1500);
        }
        var nom = c.getAttribute('data-nom');
        var cta = q('[data-psih-cta]');
        if (cta) cta.href = c.getAttribute('data-url');
        var ctaTexte = q('[data-psih-cta-texte]');
        if (ctaTexte) ctaTexte.textContent = 'Je profite du pack ' + nom;
        var des = q('[data-psih-des]');
        if (des) des.textContent = 'Pack Sécurité Intégrale ' + nom;
        var prix = q('[data-psih-prix]');
        if (prix && c.getAttribute('data-prix')) prix.textContent = c.getAttribute('data-prix');
        var barre = q('[data-psih-barre]');
        if (barre) { barre.textContent = c.getAttribute('data-barre'); barre.hidden = !c.getAttribute('data-barre'); }
        var eco = q('[data-psih-eco]');
        if (eco) {
          eco.hidden = !c.getAttribute('data-eco');
          eco.textContent = '';
          eco.appendChild(document.createTextNode('Vous économisez '));
          var b = document.createElement('b'); b.textContent = c.getAttribute('data-eco'); eco.appendChild(b);
        }
        var pct = parseInt(c.getAttribute('data-pct'), 10);
        var remise = q('[data-psih-remise]');
        var av = q('[data-psih-remise-av]');
        if (remise) { remise.parentNode.hidden = !(pct > 0); remise.textContent = '-' + pct + ' %'; }
        if (av) av.textContent = 'soit';
      });
    }

    /* Compte à rebours en cases */
    var fin = Date.parse(racine.getAttribute('data-fin') || '');
    if (!fin) return;
    var enEdition = {{ request.design_mode | json }};
    var cases = {
      j: racine.querySelector('[data-psih-j]'), h: racine.querySelector('[data-psih-h]'),
      m: racine.querySelector('[data-psih-m]'), s: racine.querySelector('[data-psih-s]')
    };
    var deux = function (n) { return (n < 10 ? '0' : '') + n; };
    function tic() {
      var s = Math.floor((fin - Date.now()) / 1000);
      if (s <= 0) {
        if (!enEdition) { racine.remove(); return; }
        s = 0;
      }
      if (cases.j) cases.j.textContent = Math.floor(s / 86400);
      if (cases.h) cases.h.textContent = deux(Math.floor(s % 86400 / 3600));
      if (cases.m) cases.m.textContent = deux(Math.floor(s % 3600 / 60));
      if (cases.s) cases.s.textContent = deux(s % 60);
      setTimeout(tic, 1000);
    }
    tic();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Offre PSI · accueil",
  "tag": "div",
  "class": "psih-section",
  "settings": [
    { "type": "text", "id": "end_date", "label": "Fin de l'offre", "default": "2026-10-31T23:59:59+01:00", "info": "La section disparaît automatiquement après cette date." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Offre spéciale · jusqu'au 31 octobre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Alarme, 2 caméras et sirène solaire. <em>Le Pack Sécurité Intégrale.</em>" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Tout pour protéger la maison, dedans comme dehors, dans une seule boîte. Et plus jamais d'abonnement." },
    { "type": "textarea", "id": "bullets", "label": "Points clés (un par ligne)", "default": "4 contacteurs d'ouverture et 1 détecteur de mouvement\n1 caméra intérieure et 1 caméra extérieure solaire\nSirène extérieure solaire, sans câble\nInstallé par vous, sans abonnement à vie" },
    { "type": "text", "id": "price_label", "label": "Texte au-dessus du prix", "default": "Le pack complet, dès" },
    { "type": "text", "id": "choice_label", "label": "Titre du choix de centrale", "default": "Choisissez votre centrale" },
    { "type": "image_picker", "id": "image", "label": "Visuel", "info": "Vide : photo du premier pack." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "J'en profite" },
    { "type": "text", "id": "cta_link", "label": "Lien du bouton", "default": "/pages/offre-speciale" },
    { "type": "textarea", "id": "note", "label": "Mention sous le bouton", "default": "Prix barré : valeur des mêmes éléments achetés séparément sur notre site. Offre valable jusqu'au 31 octobre 2026 inclus." }
  ],
  "blocks": [
    {
      "type": "centrale",
      "name": "Centrale",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Pack" },
        { "type": "text", "id": "label", "label": "Nom", "default": "Vigilia" },
        { "type": "text", "id": "sub", "label": "Sous-titre", "default": "Wi-Fi" },
        { "type": "text", "id": "badge", "label": "Badge (optionnel)" },
        { "type": "text", "id": "slug", "label": "Identifiant sur la page offre", "info": "vigilia, vigilia-plus, touch ou touch-xl" },
        { "type": "text", "id": "ref_value", "label": "Valeur achetée séparément", "info": "Ex. 433,08" },
        { "type": "image_picker", "id": "image", "label": "Visuel (optionnel)", "info": "Vide : photo principale du pack." }
      ]
    }
  ],
  "presets": [ { "name": "Offre PSI · accueil" } ]
}
{% endschema %}
