{% comment %} ── Configurateur : parcours 2 minutes + remise jusqu'à -25 % ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .tcg * { box-sizing:border-box; margin:0; padding:0; }
  .tcg { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#eef2f8; color:#0b1220; padding:88px 24px; position:relative; overflow:hidden; }
  .tcg::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(760px 360px at 12% 0%,rgba(47,123,255,.10),transparent 62%),
               radial-gradient(680px 340px at 88% 100%,rgba(232,160,44,.12),transparent 62%); }
  .tcg-inner { position:relative; z-index:2; max-width:1180px; margin:0 auto;
    display:grid; grid-template-columns:1.02fr .98fr; gap:56px; align-items:center; }

  .tcg-eyebrow { display:inline-flex; align-items:center; gap:9px; font-size:11px; font-weight:600; letter-spacing:.16em;
    text-transform:uppercase; padding:8px 16px; border-radius:99px; background:#fff; border:1px solid #dfe5ef;
    color:#4a5a75; margin-bottom:22px; box-shadow:0 2px 8px rgba(11,18,32,.05); }
  .tcg-eyebrow svg { width:14px; height:14px; fill:none; stroke:#2f7bff; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
  .tcg-title { font-size:clamp(27px,3.5vw,41px); font-weight:600; letter-spacing:-.03em; line-height:1.12; margin-bottom:8px; }
  .tcg-title em { font-style:normal; font-weight:600; color:#8f5d0c; }
  .tcg-sub { font-size:16px; color:#4a5a75; font-weight:300; line-height:1.68; margin:16px 0 26px; max-width:520px; }

  .tcg-steps { display:grid; gap:14px; margin-bottom:30px; max-width:520px; }
  .tcg-step { display:flex; gap:15px; align-items:flex-start; }
  .tcg-num { flex:0 0 30px; height:30px; border-radius:9px; background:#fff; border:1px solid #dfe5ef;
    display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:600; color:#1c5fd0;
    box-shadow:0 2px 8px rgba(11,18,32,.05); }
  .tcg-st { font-size:14.5px; font-weight:500; color:#0b1220; line-height:1.4; }
  .tcg-sd { font-size:13.5px; font-weight:300; color:#4a5a75; line-height:1.55; margin-top:3px; }

  .tcg-btns { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:22px; }
  .tcg-b { display:inline-flex; align-items:center; gap:9px; padding:15px 26px; border-radius:10px;
    font-size:14.5px; font-weight:600; text-decoration:none; transition:transform .18s, box-shadow .18s, border-color .18s; }
  .tcg-b:hover { transform:translateY(-2px); }
  .tcg-b svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  .tcg-b--1 { background:#0b1220; color:#fff; box-shadow:0 12px 30px -10px rgba(11,18,32,.45); }
  .tcg-b--2 { background:#fff; color:#0b1220; border:1px solid #dfe5ef; }
  .tcg-b--2:hover { border-color:#b9c7dd; }
  .tcg-mini { display:flex; gap:20px; flex-wrap:wrap; font-size:12.5px; color:#5a6982; font-weight:300; }
  .tcg-mini span { display:inline-flex; align-items:center; gap:7px; }
  .tcg-mini svg { width:13px; height:13px; fill:none; stroke:#2f7bff; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }

  /* ── Colonne remise ── */
  .tcg-side { position:relative; }
  .tcg-medal { position:relative; background:#0b1220; border-radius:24px; padding:38px 32px 34px; text-align:center;
    box-shadow:0 34px 70px -28px rgba(11,18,32,.55); overflow:hidden; }
  .tcg-medal::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(420px 220px at 50% 0%,rgba(232,160,44,.30),transparent 66%); }
  .tcg-medal > * { position:relative; z-index:2; }
  .tcg-mlabel { font-size:11px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; color:#e8a02c; }
  .tcg-mpre { font-size:15px; font-weight:300; color:#cfd8e8; margin-top:14px; }
  .tcg-mbig { font-size:clamp(56px,7.4vw,80px); font-weight:600; letter-spacing:-.045em; line-height:1; color:#fff; margin:2px 0 10px; }
  .tcg-msub { font-size:14px; font-weight:300; color:#cfd8e8; line-height:1.6; max-width:320px; margin:0 auto; }

  .tcg-card { margin-top:-18px; background:#fff; border:1px solid #dfe5ef; border-radius:22px; padding:30px 26px 26px;
    box-shadow:0 22px 50px -28px rgba(11,18,32,.30); position:relative; z-index:3; }
  .tcg-ct { font-size:11px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:#626f86; margin-bottom:16px; }
  .tcg-list { display:grid; gap:12px; }
  .tcg-li { display:flex; gap:11px; align-items:flex-start; font-size:13.5px; font-weight:300; color:#4a5a75; line-height:1.5; }
  .tcg-li b { font-weight:500; color:#0b1220; }
  .tcg-li svg { flex:0 0 15px; width:15px; height:15px; margin-top:2px; fill:none; stroke:#0f9d63; stroke-width:2.8; stroke-linecap:round; stroke-linejoin:round; }
  .tcg-note { margin-top:18px; padding-top:16px; border-top:1px solid #eef1f7; font-size:12px; font-weight:300; color:#626f86; line-height:1.55; }

  @media (max-width:960px) { .tcg-inner { grid-template-columns:1fr; gap:44px; } .tcg-side { max-width:480px; margin:0 auto; width:100%; } }
  @media (max-width:600px) { .tcg { padding:66px 20px; } .tcg-medal { padding:32px 24px 30px; } .tcg-card { padding:26px 20px 22px; } }
</style>

<section class="tcg" aria-label="Configurateur Daewoo Security">
  <div class="tcg-inner">
    <div>
      <span class="tcg-eyebrow"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>Configurateur · 2 minutes</span>
      <h2 class="tcg-title">Composez votre système sur mesure,<br>avec <em>jusqu'à 25 % de remise</em>.</h2>
      <p class="tcg-sub">Quelques questions sur votre logement et vos habitudes suffisent&nbsp;: le configurateur assemble la centrale Touch ou Touch XL et les accessoires qui vous correspondent — puis applique la remise à votre configuration.</p>

      <div class="tcg-steps">
        <div class="tcg-step"><span class="tcg-num">1</span><div><p class="tcg-st">Décrivez votre logement</p><p class="tcg-sd">Type de bien, nombre d'ouvertures à protéger, présence d'animaux.</p></div></div>
        <div class="tcg-step"><span class="tcg-num">2</span><div><p class="tcg-st">Recevez votre configuration</p><p class="tcg-sd">Centrale, détecteurs, télécommandes et caméras : tout est proposé en une liste claire.</p></div></div>
        <div class="tcg-step"><span class="tcg-num">3</span><div><p class="tcg-st">Ajustez et profitez de la remise</p><p class="tcg-sd">Vous restez libre d'ajouter ou de retirer un accessoire avant de valider.</p></div></div>
      </div>

      <div class="tcg-btns">
        <a class="tcg-b tcg-b--1" href="https://daewoo-security.fr/pages/configurateur_2">
          Configurer mon système
          <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a class="tcg-b tcg-b--2" href="https://daewoo-security.fr/pages/pack-alarmes?_pos=1&amp;_psq=pack&amp;_ss=e&amp;_v=1.0">
          Voir les packs prêts à poser
          <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="tcg-mini">
        <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Sans abonnement</span>
        <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Sans engagement</span>
        <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Retour gratuit 14 jours</span>
      </div>
    </div>

    <div class="tcg-side">
      <div class="tcg-medal">
        <p class="tcg-mlabel">Remise configurateur</p>
        <p class="tcg-mpre">jusqu'à</p>
        <p class="tcg-mbig">−25&nbsp;%</p>
        <p class="tcg-msub">La remise s'applique à l'ensemble de votre configuration&nbsp;: centrale et accessoires compris.</p>
      </div>
      <div class="tcg-card">
        <p class="tcg-ct">Ce que fait le configurateur</p>
        <div class="tcg-list">
          <p class="tcg-li"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Il choisit entre <b>Touch et Touch XL</b> selon votre logement et votre confort d'usage.</span></p>
          <p class="tcg-li"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Il calcule le <b>nombre de détecteurs</b> nécessaires, sans surdimensionner.</span></p>
          <p class="tcg-li"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Il n'ajoute que des accessoires <b>compatibles</b> avec la centrale retenue.</span></p>
          <p class="tcg-li"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Il applique la <b>remise la plus avantageuse</b> à votre panier, jusqu'à 25 %.</span></p>
        </div>
        <p class="tcg-note">Vous hésitez encore&nbsp;? Notre assistant répond 7j/7 et l'équipe SAV, basée en France, prend le relais 5j/7 par chat ou par e-mail.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Touch — Configurateur",
  "settings": []
}
{% endschema %}
