{% comment %} ── Bandeau configurateur (repris de la page d'origine) ── {% endcomment %}
<style>
  .ds-banner {
    --ds-primary: #0b5fff;
    --ds-primary-dark: #0a47c2;
    --ds-trust-from: #0b5fff;
    --ds-trust-to: #00b894;
    --ds-bg: #f5f8ff;
    --ds-card: #ffffff;
    --ds-text: #0f172a;
    --ds-muted: #475569;
    --ds-border: #e2e8f0;
    --ds-warning: #f59e0b;

    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background:
      radial-gradient(1200px 400px at 0% 0%, rgba(11, 95, 255, 0.10), transparent 60%),
      radial-gradient(900px 400px at 100% 100%, rgba(0, 184, 148, 0.10), transparent 60%),
      var(--ds-bg);
    border: 1px solid var(--ds-border);
    padding: 40px 28px;
    margin: 24px auto;
    max-width: 1180px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--ds-text);
    box-sizing: border-box;
  }
  .ds-banner * { box-sizing: border-box; }
  .ds-banner-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .ds-banner { padding: 56px 48px; }
    .ds-banner-grid { grid-template-columns: 1.15fr 1fr; gap: 48px; }
  }
  .ds-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid rgba(11, 95, 255, 0.20);
    color: var(--ds-primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
  }
  .ds-chip-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: linear-gradient(135deg, var(--ds-trust-from), var(--ds-trust-to));
  }
  .ds-title {
    margin: 18px 0 0;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ds-title .ds-gradient {
    background: linear-gradient(135deg, var(--ds-trust-from), var(--ds-trust-to));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ds-subtitle {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ds-muted);
    max-width: 580px;
  }
  .ds-cta-row {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ds-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 26px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--ds-trust-from), var(--ds-trust-to));
    color: #ffffff !important;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none !important;
    box-shadow: 0 14px 30px rgba(11, 95, 255, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 0;
    cursor: pointer;
  }
  .ds-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px rgba(11, 95, 255, 0.36);
  }
  .ds-btn-primary svg { transition: transform 0.2s ease; }
  .ds-btn-primary:hover svg { transform: translateX(4px); }
  .ds-trust-row {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    color: var(--ds-muted);
    font-size: 14px;
  }
  .ds-trust-row strong { color: var(--ds-text); }
  .ds-trust-item { display: inline-flex; align-items: center; gap: 8px; }
  .ds-icon-primary { color: var(--ds-primary); }
  .ds-icon-warning { color: var(--ds-warning); fill: var(--ds-warning); }

  /* Mock card */
  .ds-mock-wrap {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }
  .ds-mock-glow {
    position: absolute;
    inset: -22px;
    border-radius: 36px;
    background: linear-gradient(135deg, var(--ds-trust-from), var(--ds-trust-to));
    opacity: 0.18;
    filter: blur(40px);
    z-index: 0;
  }
  .ds-mock {
    position: relative;
    z-index: 1;
    background: var(--ds-card);
    border: 1px solid var(--ds-border);
    border-radius: 24px;
    padding: 22px;
    box-shadow: 0 30px 60px -20px rgba(15, 23, 42, 0.18);
  }
  .ds-mock-head {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 12px; font-weight: 700; color: var(--ds-muted);
  }
  .ds-mock-head .ds-step-pct { color: var(--ds-primary); }
  .ds-progress {
    margin-top: 10px;
    width: 100%; height: 6px; border-radius: 999px; overflow: hidden;
    background: #eef2f8;
  }
  .ds-progress-fill {
    width: 14%; height: 100%;
    background: linear-gradient(135deg, var(--ds-trust-from), var(--ds-trust-to));
  }
  .ds-mock-question {
    margin-top: 22px;
    font-size: 18px; font-weight: 700; color: var(--ds-text);
  }
  .ds-mock-options { margin-top: 14px; display: grid; gap: 10px; }
  .ds-mock-opt {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid var(--ds-border);
    background: var(--ds-card);
    font-size: 14px; font-weight: 600; color: var(--ds-text);
  }
  .ds-mock-opt.is-active {
    border-color: var(--ds-primary);
    background: rgba(11, 95, 255, 0.06);
    box-shadow: 0 0 0 3px rgba(11, 95, 255, 0.18);
  }
  .ds-mock-tip {
    margin-top: 18px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #f1f5fb;
    color: var(--ds-muted);
    font-size: 12px;
  }
</style>

<section class="ds-banner" aria-label="Configurateur d'alarme Daewoo Security">
  <div class="ds-banner-grid">
    <div>
      <span class="ds-chip">
        <span class="ds-chip-dot" aria-hidden="true"></span>
        Configurateur intelligent · 2 minutes
      </span>

      <h2 class="ds-title">
        Trouvez l'alarme
        <span class="ds-gradient">parfaite pour votre logement</span>
        en 7 questions.
      </h2>

      <p class="ds-subtitle">
        Sans abonnement. Sans engagement. Sans risque de vous tromper.
        Notre assistant compose le pack idéal et applique automatiquement votre remise.
      </p>

      <div class="ds-cta-row">
        <a class="ds-btn-primary"
           href=https://daewoo-security.fr/pages/configurateur_2>
          Démarrer le configurateur
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

      <div class="ds-trust-row">
        <span class="ds-trust-item">
          <svg class="ds-icon-primary" width="16" height="16" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span><strong>60 000+</strong> foyers protégés</span>
        </span>
        <span class="ds-trust-item">
          <svg class="ds-icon-warning" width="16" height="16" viewBox="0 0 24 24"
               stroke="currentColor" stroke-width="1.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <span><strong>4.7/5</strong> sur les avis vérifiés</span>
        </span>
        <span class="ds-trust-item">
          <svg class="ds-icon-primary" width="16" height="16" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span><strong>Garantie 2 ans</strong> · Livraison 48h</span>
        </span>
      </div>
    </div>

    <div class="ds-mock-wrap" aria-hidden="true">
      <div class="ds-mock-glow"></div>
      <div class="ds-mock">
        <div class="ds-mock-head">
          <span>Étape 1 sur 7</span>
          <span class="ds-step-pct">14%</span>
        </div>
        <div class="ds-progress"><div class="ds-progress-fill"></div></div>
        <div class="ds-mock-question">
          Quel type de logement souhaitez-vous protéger ?
        </div>
        <div class="ds-mock-options">
          <div class="ds-mock-opt">Appartement</div>
          <div class="ds-mock-opt is-active">
            Maison
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="#0b5fff" stroke-width="2.4"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div class="ds-mock-opt">Villa / grande propriété</div>
        </div>
        <div class="ds-mock-tip">
          💡 7 questions simples, réponse instantanée à chaque étape
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Touch — Configurateur",
  "settings": []
}
{% endschema %}
