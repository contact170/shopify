              {%- endif -%}
              <div class="pe-acc__body">
                <span class="pe-acc__ref{% unless acc_is_zigbee %} pe-acc__ref--plain{% endunless %}">{% if acc_is_zigbee %}Zigbee 3.0{% else %}Compatible Élite{% endif %}</span>
                <span class="pe-acc__name">{{ acc_name }}</span>
                <p class="pe-acc__why">{{ acc_why }}</p>
                <span class="pe-acc__price">{{ acc_variant.price | money }}</span>
                <div class="pe-step">
                  <button type="button" data-pe-minus aria-label="Retirer un {{ acc_name }}" disabled>−</button>
                  <span class="pe-step__qty" data-pe-qty aria-live="polite" aria-label="Quantité : {{ acc_name }}">0</span>
                  <button type="button" data-pe-plus aria-label="Ajouter un {{ acc_name }}">+</button>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

