        {%- for acc_handle in acc_handles -%}
          {%- assign acc = all_products[acc_handle] -%}
          {%- assign acc_variant = acc.variants.first -%}
          {%- if acc.available and acc_variant -%}
            {%- liquid
              assign acc_is_zigbee = true
              case acc_variant.sku
                when 'EXT501ZIG'
                  assign acc_name = 'Amplificateur Zigbee EXT501ZIG'
                  assign acc_why = "Le seul moyen d'étendre la portée du réseau : branché sur une prise, il relaie le signal vers un garage, une dépendance ou un étage éloigné."
                when 'DAWDS502Z'
                  assign acc_name = "Contacteur d'ouverture WDS502Z"
                  assign acc_why = "Une porte ou une fenêtre de plus à surveiller. Le pack en compte déjà 5 — comptez-en un par ouverture accessible."
                when 'DAWVD502Z'
                  assign acc_name = 'Détecteur de vibration WVD502Z'
                  assign acc_why = "Une baie vitrée de plus : l'alarme part au premier choc, avant que la vitre ne cède."
                when 'DAWSD501'
                  assign acc_name = 'Détecteur de fumée WSD501'
                  assign acc_why = "Le seul risque que l'alarme ne couvre pas encore. Alerte sur votre téléphone, même quand vous êtes absent."
                  assign acc_is_zigbee = false
                else
                  assign acc_name = acc.title
                  assign acc_why = ''
                  assign acc_is_zigbee = false
              endcase
            -%}
            <div class="pe-acc__card" data-pe-acc data-pe-acc-id="{{ acc_variant.id }}" data-pe-acc-price="{{ acc_variant.price }}">
              {%- if acc.featured_image -%}
                <div class="pe-acc__photo">
                  {{ acc.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240,360,480', alt: acc_name }}
