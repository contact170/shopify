{% comment %} ── Comparatif alarmes — intro ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .cpi * { box-sizing:border-box; margin:0; padding:0; }
  .cpi { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#fff; color:#0b1220; padding:86px 24px 92px; position:relative; overflow:hidden; }
  .cpi::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(720px 360px at 12% -10%,rgba(224,145,43,.13),transparent 62%),
               radial-gradient(720px 360px at 88% -10%,rgba(18,160,173,.13),transparent 62%),
               radial-gradient(680px 340px at 50% 118%,rgba(47,111,224,.10),transparent 62%); }
  .cpi-inner { position:relative; z-index:2; max-width:1080px; margin:0 auto; text-align:center; }
  .cpi-eyebrow { display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:600;
    letter-spacing:.2em; text-transform:uppercase; color:#5d6a7a; margin-bottom:20px; }
  .cpi-eyebrow::before,.cpi-eyebrow::after { content:''; width:28px; height:1px; background:#c9d2dc; }
  .cpi-title { font-size:clamp(30px,4.4vw,52px); font-weight:600; letter-spacing:-.04em; line-height:1.08;
    margin-bottom:20px; color:#0b1220; }
  .cpi-sub { font-size:16.5px; font-weight:400; line-height:1.7; color:#43505e; max-width:660px; margin:0 auto 40px; }
  .cpi-sub b { color:#0b1220; font-weight:600; }

  .cpi-rail { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; max-width:880px; margin:0 auto 34px; }
  .cpi-c { position:relative; background:#fff; border:1px solid #e3e8ee; border-radius:16px;
    padding:22px 20px 24px; text-align:left; box-shadow:0 16px 40px -32px rgba(11,18,32,.42); overflow:hidden; }
  .cpi-c::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; }
  .cpi-c--v::before { background:#e0912b; } .cpi-c--t::before { background:#2f6fe0; } .cpi-c--e::before { background:#12a0ad; }
  .cpi-n { font-size:17px; font-weight:600; letter-spacing:-.02em; margin-bottom:6px; color:#0b1220; }
  .cpi-d { font-size:13.4px; font-weight:400; color:#43505e; line-height:1.55; margin-bottom:16px; min-height:42px; }
  .cpi-p { font-size:12px; font-weight:400; color:#5d6a7a; padding-top:14px; border-top:1px solid #eef1f5; }
  .cpi-p b { display:block; font-size:21px; font-weight:600; color:#0b1220; letter-spacing:-.025em; margin-top:2px; }

  .cpi-note { display:inline-flex; align-items:center; gap:9px; font-size:13.5px; font-weight:400; color:#43505e;
    background:#f4f6f8; border:1px solid #e3e8ee; border-radius:99px; padding:11px 22px; }
  .cpi-note svg { width:16px; height:16px; flex:none; fill:none; stroke:#0f8a5f; stroke-width:2.9; stroke-linecap:round; stroke-linejoin:round; }
  .cpi-note b { color:#0b1220; font-weight:600; }

  @media (max-width:820px) { .cpi-rail { grid-template-columns:1fr; max-width:420px; } .cpi-d { min-height:0; } }
  @media (max-width:600px) { .cpi { padding:68px 20px 74px; } }
</style>

<section class="cpi">
  <div class="cpi-inner">
    <span class="cpi-eyebrow">Comparatif des alarmes Daewoo</span>
    <h1 class="cpi-title">Trois gammes.<br>Une seule question à se poser.</h1>
    <p class="cpi-sub">Vigilia, Touch et Élite protègent toutes votre logement de la même façon&nbsp;: détection, sirène, alertes sur le téléphone, <b>sans abonnement</b>. Ce qui les sépare tient en trois points — et c'est exactement ce que compare cette page.</p>

    <div class="cpi-rail">
      <div class="cpi-c cpi-c--v">
        <p class="cpi-n">Vigilia</p>
        <p class="cpi-d">Un clavier tactile sur la centrale. L'essentiel, tout de suite.</p>
        <p class="cpi-p">Kit de départ<b>139,90 €</b></p>
      </div>
      <div class="cpi-c cpi-c--t">
        <p class="cpi-n">Touch &amp; Touch XL</p>
        <p class="cpi-d">Un écran tactile couleur pour tout piloter du bout du doigt.</p>
        <p class="cpi-p">Kit de départ<b>199,90 €</b></p>
      </div>
      <div class="cpi-c cpi-c--e">
        <p class="cpi-n">Élite</p>
        <p class="cpi-d">Aucun écran, mais elle reste joignable quand Internet est coupé.</p>
        <p class="cpi-p">Kit de départ<b>299,90 €</b></p>
      </div>
    </div>

    <span class="cpi-note">
      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Les trois gammes sont <b>sans abonnement</b> et <b>garanties 2 ans</b>.</span>
    </span>
  </div>
</section>

{% schema %}
{
  "name": "Comparatif — Intro",
  "settings": []
}
{% endschema %}
