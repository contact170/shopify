    {%- comment -%} ================= TABLEAU COMPARATIF ================= {%- endcomment -%}
    <div class="dsx-block" id="dsx-comparatif">
      <h2 class="dsx-h2">Tableau comparatif des quatre centrales</h2>
      <p class="dsx-p">
        Faites défiler le tableau horizontalement sur mobile. La colonne des caractéristiques
        reste visible.
      </p>

      <div class="dsx-table-scroll" tabindex="0" role="region" aria-label="Tableau comparatif des centrales Daewoo Security">
        <table class="dsx-table">
          <thead>
            <tr>
              <th scope="col" class="dsx-col-label">Caractéristique</th>
              <th scope="col">Vigilia</th>
              <th scope="col">Touch<span class="dsx-ref">AM301</span></th>
              <th scope="col">Touch XL<span class="dsx-ref">AM302</span></th>
              <th scope="col">Élite<span class="dsx-ref">PA501Z</span></th>
            </tr>
          </thead>

          {%- assign groups = 'Identification|Interface et commandes|Connectivité|Radio et accessoires|Alimentation et autonomie|Capacités du système|Sirène et modes|Application mobile|Caractéristiques physiques' | split: '|' -%}

          {%- for group in groups -%}
            {%- case forloop.index -%}
              {%- when 1 -%}{%- assign current_rows = rows_identification -%}
              {%- when 2 -%}{%- assign current_rows = rows_interface -%}
              {%- when 3 -%}{%- assign current_rows = rows_connectivite -%}
              {%- when 4 -%}{%- assign current_rows = rows_radio -%}
              {%- when 5 -%}{%- assign current_rows = rows_alimentation -%}
              {%- when 6 -%}{%- assign current_rows = rows_capacites -%}
              {%- when 7 -%}{%- assign current_rows = rows_sirene -%}
              {%- when 8 -%}{%- assign current_rows = rows_application -%}
              {%- when 9 -%}{%- assign current_rows = rows_physique -%}
            {%- endcase -%}

            <tbody>
              <tr class="dsx-group">
                <th scope="colgroup" colspan="5">{{ group }}</th>
              </tr>

              {%- assign lines = current_rows | strip | split: '
' -%}
              {%- for line in lines -%}
                {%- assign cells = line | strip | split: SEP -%}
                {%- if cells.size < 5 -%}{%- continue -%}{%- endif -%}
                {%- assign src = cells[5] | strip -%}
                <tr>
                  <th scope="row" class="dsx-col-label">
                    {{ cells[0] | strip }}
                    {%- if src == 'M' -%}<span class="dsx-badge dsx-badge--m" title="Valeur issue du manuel officiel">M</span>
                    {%- elsif src == 'F' -%}<span class="dsx-badge dsx-badge--f" title="Valeur issue de la fiche produit">F</span>
                    {%- elsif src == 'X' -%}<span class="dsx-badge dsx-badge--x" title="Valeur en cours de vérification">?</span>
                    {%- endif -%}
                  </th>
                  {%- for i in (1..4) -%}
                    {%- assign val = cells[i] | strip -%}
                    <td
                      {%- if val == 'Oui' %} class="dsx-yes"{% elsif val == 'Non' %} class="dsx-no"{% elsif val contains 'Non documenté' or val == 'À confirmer' %} class="dsx-unknown"{% endif -%}
                    >{{ val }}</td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          {%- endfor -%}
        </table>
      </div>
    </div>

