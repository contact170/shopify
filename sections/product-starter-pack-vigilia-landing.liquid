  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      /* Reveal-on-scroll */
      var revealEls = root.querySelectorAll('.pv-reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
      }

      /* Connectivity toggle: every toggle button and comparison card
         (data-pv-connectivity) shares one hidden variant-id field and
         updates every "Ajouter au panier" price/compare display,
         wherever they appear on the page. */
      var dataScript = root.querySelector('#PVData-{{ section.id }}');
      var variantData = {};
      if (dataScript) {
        try { variantData = JSON.parse(dataScript.textContent); } catch (e) { /* keep empty */ }
      }
      var keyToVariantId = {};
      Object.keys(variantData).forEach(function (id) {
        keyToVariantId[variantData[id].key] = id;
      });

      var toggleEls = root.querySelectorAll('[data-pv-connectivity]');
      var variantIdInput = root.querySelector('#PVVariantId-{{ section.id }}');
      var priceAmounts = root.querySelectorAll('.pv-price-amount');
      var priceCompares = root.querySelectorAll('.pv-price-compare');

      function selectConnectivity(key) {
        var variantId = keyToVariantId[key];
        if (!variantId) return;
        var data = variantData[variantId];

        toggleEls.forEach(function (el) {
          var isMatch = el.getAttribute('data-pv-connectivity') === key;
          el.classList.toggle('is-selected', isMatch);
          el.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        });
        if (variantIdInput) variantIdInput.value = variantId;
        priceAmounts.forEach(function (el) { el.textContent = data.price; });
        priceCompares.forEach(function (el) {
          el.textContent = data.compare;
          el.classList.toggle('is-visible', !!data.hasCompare);
        });
      }

      toggleEls.forEach(function (el) {
        el.addEventListener('click', function () {
          selectConnectivity(el.getAttribute('data-pv-connectivity'));
        });
      });

      /* Sticky add-to-cart bar: shown once the hero CTA has scrolled out of
         view, but hidden again whenever any real "Ajouter au panier" button
         on the page (hero, mid band, or final CTA) is close to the viewport
         — otherwise the fixed bar can sit on top of one of those buttons
         and swallow the tap. The CSS also backs this up with pointer-events
         and physical spacing, in case this JS timing is ever off. */
      var stickyCtaIds = ['PVHeroCta-{{ section.id }}', 'PVBandCta-{{ section.id }}', 'PVFinalCta-{{ section.id }}'];
      var stickyBar = root.querySelector('#PVSticky-{{ section.id }}');
      if (stickyBar && 'IntersectionObserver' in window) {
        var ctaVisible = {};
        function updateStickyVisibility() {
          var anyCtaVisible = Object.keys(ctaVisible).some(function (key) {
            return ctaVisible[key];
          });
          stickyBar.classList.toggle('is-shown', !anyCtaVisible);
        }
        var stickyIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            ctaVisible[entry.target.id] = entry.isIntersecting;
          });
          updateStickyVisibility();
        }, { threshold: 0, rootMargin: '-64px 0px -90px 0px' });
        stickyCtaIds.forEach(function (id) {
          var el = document.getElementById(id);
          if (el) { ctaVisible[id] = false; stickyIo.observe(el); }
        });
      }

      /* Force-hide the sticky bar while the theme's cart drawer is open —
         the drawer renders at a lower z-index than this bar, so without
         this the bar sits on top of the drawer's own checkout button.
         The drawer element (#CartDrawer) can be inserted/upgraded into the
         DOM after this inline script runs, so looking it up once here and
         observing that single node is a load-order race — it can silently
         never attach. Observing document.body's whole subtree instead
         means we react to the drawer's `open`/`hidden` attributes no
         matter when it shows up, re-checking its live state each time. */
      if (stickyBar) {
        var updateForCartDrawer = function () {
          var cartDrawerEl = document.getElementById('CartDrawer');
          stickyBar.classList.toggle('pv-sticky--suppressed', !!cartDrawerEl && !cartDrawerEl.hidden);
        };
        updateForCartDrawer();
        if ('MutationObserver' in window) {
          new MutationObserver(updateForCartDrawer).observe(document.body, {
            attributes: true,
            attributeFilter: ['hidden', 'open'],
            subtree: true
          });
        }
      }

      /* Hero photo carousel: clicking a thumbnail swaps the main image */
      var heroImg = document.getElementById('PVHeroImg-{{ section.id }}');
      var thumbs = root.querySelectorAll('[data-pv-thumb]');
      if (heroImg && thumbs.length) {
        thumbs.forEach(function (thumb) {
          thumb.addEventListener('click', function () {
            heroImg.src = thumb.getAttribute('data-full');
            heroImg.srcset = thumb.getAttribute('data-full-srcset');
            thumbs.forEach(function (t) { t.classList.remove('is-active'); });
            thumb.classList.add('is-active');
          });
        });
      }
    })();
  </script>
</div>

