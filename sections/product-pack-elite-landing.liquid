  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      /* Reveal-on-scroll */
      var revealEls = root.querySelectorAll('.pel-reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
      }

      /* Sticky add-to-cart bar: shown once the hero CTA has scrolled out of
         view, but hidden again whenever any real "Ajouter au panier" button
         on the page (hero, mid band, or final CTA) is close to the viewport
         — otherwise the fixed bar can sit on top of one of those buttons
         and swallow the tap. */
      var stickyCtaIds = ['PELHeroCta-{{ section.id }}', 'PELBandCta-{{ section.id }}', 'PELFinalCta-{{ section.id }}'];
      var stickyBar = root.querySelector('#PELSticky-{{ section.id }}');
      if (stickyBar && 'IntersectionObserver' in window) {
        var ctaVisible = {};
        function updateStickyVisibility() {
          var anyCtaVisible = Object.keys(ctaVisible).some(function (key) {
            return ctaVisible[key];
          });
          stickyBar.classList.toggle('is-shown', !anyCtaVisible);
        }
        var stickyIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            ctaVisible[entry.target.id] = entry.isIntersecting;
          });
          updateStickyVisibility();
        }, { threshold: 0, rootMargin: '-64px 0px -90px 0px' });
        stickyCtaIds.forEach(function (id) {
          var el = document.getElementById(id);
          if (el) { ctaVisible[id] = false; stickyIo.observe(el); }
        });
      }

      /* Force-hide the sticky bar while the theme's cart drawer is open —
         the drawer renders at a lower z-index than this bar, so without
         this the bar sits on top of the drawer's own checkout button.
         Observes document.body's whole subtree (not a single cached
         element reference) so it works regardless of when #CartDrawer
         actually appears/upgrades in the DOM. */
      if (stickyBar) {
        var updateForCartDrawer = function () {
          var cartDrawerEl = document.getElementById('CartDrawer');
          stickyBar.classList.toggle('pel-sticky--suppressed', !!cartDrawerEl && !cartDrawerEl.hidden);
        };
        updateForCartDrawer();
        if ('MutationObserver' in window) {
          new MutationObserver(updateForCartDrawer).observe(document.body, {
            attributes: true,
            attributeFilter: ['hidden', 'open'],
            subtree: true
          });
        }
      }
    })();
  </script>
</div>

