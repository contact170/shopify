{%- doc -%}
  Bespoke, conversion-focused product page for the Daewoo Pack Élite
  (OFFRE EXCLUSIVE | Pack Élite — handle
  offre-exclusive-pack-elite-compatible-animaux-sans-abonnement).

  Distinct design system from the other bespoke landing pages
  (sections/product-w512mw-landing.liquid, product-pack-vigilia-landing.liquid,
  product-starter-pack-vigilia-landing.liquid): navy + off-white + a brass/gold
  accent unique to this "Élite" tier, Poppins throughout, and a signature
  "resilience gauge" component (Wi-Fi → Ethernet → 4G+GSM) that visualises
  this product's real differentiator — triple connectivity with automatic
  failover — instead of a generic icon grid.

  Single real variant (no WiFi/GSM toggle needed: this pack always ships
  with the 4G+GSM centrale), so the JS here is simpler than the toggle-based
  pages — no PVData variant-swap logic required.

  Carries forward the sticky-bar-vs-cart-drawer fixes learned on the other
  landing pages: pointer-events gating, safe-area padding, physical bottom
  clearance on the final section, and a document-level MutationObserver
  (not a single cached element reference) for cart-drawer suppression.
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'PELForm-' | append: section.id

  assign has_compare = false
  if variant.compare_at_price > variant.price
    assign has_compare = true
  endif

  assign discount_pct = 0
  if has_compare
    assign savings = variant.compare_at_price | minus: variant.price
    assign discount_pct = savings | times: 100 | divided_by: variant.compare_at_price | round
  endif

  assign gallery = product.images
  assign hero_image = product.featured_image | default: gallery[0]
  assign feat_image_connectivity = gallery[4] | default: hero_image
  assign feat_image_zigbee = gallery[5] | default: hero_image
-%}

<div id="shopify-section-{{ section.id }}" class="pel">
  <style>
    #shopify-section-{{ section.id }} .pel{
      --pel-navy:#0c1e4a;
      --pel-navy-deep:#071228;
      --pel-ink:#171b23;
      --pel-gray:#5b6270;
      --pel-paper:#f5f6fa;
      --pel-line:#dde1ea;
      --pel-gold:#ad8438;
      --pel-gold-soft:#f4ead9;
      font-family:'Poppins', sans-serif;
      color:var(--pel-ink);
      background:#fff;
      overflow-x:hidden;
    }
    .pel *{box-sizing:border-box;}
    .pel .pel-wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
    .pel img{max-width:100%;display:block;}

    /* ---- sticky bar ---- */
    .pel-sticky{
      position:fixed;left:0;right:0;bottom:0;z-index:60;
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:12px 20px calc(12px + env(safe-area-inset-bottom, 0px)) 20px;
      background:rgba(255,255,255,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
      border-top:1px solid var(--pel-line);
      transform:translateY(110%);transition:transform .35s ease;
      pointer-events:none;
    }
    .pel-sticky.is-shown{transform:translateY(0);pointer-events:auto;}
    /* Forced hidden while the theme's cart drawer is open (it renders at a
       lower z-index than this bar and would otherwise hide behind it). */
    .pel-sticky.pel-sticky--suppressed{transform:translateY(110%) !important;pointer-events:none !important;}
    .pel-sticky__info{display:flex;align-items:center;gap:12px;min-width:0;}
    .pel-sticky__thumb{width:40px;height:40px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--pel-paper);}
    .pel-sticky__thumb img{width:100%;height:100%;object-fit:cover;}
    .pel-sticky__text{min-width:0;}
    .pel-sticky__name{font-size:13px;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:40vw;}
    .pel-sticky__price{font-size:12px;color:var(--pel-gray);margin-top:2px;}

    /* ---- section rhythm ---- */
    .pel-section{padding:72px 0;}
    .pel-section--alt{background:var(--pel-paper);}
    .pel-eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      font-size:12.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
      color:var(--pel-gold);margin-bottom:16px;
    }
    .pel-eyebrow::before{content:"";width:16px;height:2px;background:var(--pel-gold);}
    .pel h1,.pel h2,.pel h3{font-weight:700;letter-spacing:-.02em;line-height:1.1;margin:0;}
    .pel h2{font-weight:600;letter-spacing:-.015em;}
    .pel p{margin:0;}

    /* ---- hero ---- */
    .pel-hero{padding:88px 0 48px;background:var(--pel-navy-deep);color:#fff;text-align:center;}
    .pel-hero .pel-eyebrow{color:var(--pel-gold);}
    .pel-hero h1{font-size:clamp(30px,6.4vw,52px);max-width:820px;margin:0 auto;color:#fff;}
    .pel-hero__sub{
      font-size:clamp(16px,2vw,19px);color:rgba(255,255,255,.72);
      max-width:620px;margin:20px auto 0;line-height:1.55;font-weight:400;
    }
    .pel-hero__price-row{margin-top:32px;display:flex;flex-direction:column;align-items:center;gap:14px;}
    .pel-hero__badge{
      display:inline-flex;align-items:center;gap:6px;
      background:var(--pel-gold);color:var(--pel-navy-deep);
      font-size:13px;font-weight:700;letter-spacing:.02em;
      padding:6px 14px;border-radius:999px;
    }
    .pel-hero__price{font-size:15px;color:rgba(255,255,255,.75);}
    .pel-price-compare{text-decoration:line-through;color:rgba(255,255,255,.5);margin-right:8px;}
    .pel-hero__price strong{color:#fff;font-size:24px;font-weight:700;}
    .pel-hero__cta{margin-top:6px;}
    .pel-hero__media{margin-top:44px;}
    .pel-hero__media img{
      width:100%;max-width:600px;margin:0 auto;border-radius:24px;
      background:rgba(255,255,255,.05);
    }

    /* ---- resilience gauge (signature component) ----
       CSS grid keeps the dots/links row and the labels row on the same
       column tracks, so each label sits exactly under its own dot instead
       of being centered against a node block that includes the label
       itself (which would drift the connecting line off-center). */
    .pel-resilience{
      display:grid;
      grid-template-columns:auto minmax(18px,64px) auto minmax(18px,64px) auto;
      align-items:center;
      max-width:440px;
      margin:34px auto 0;
    }
    .pel-resilience__dot{width:9px;height:9px;border-radius:50%;background:var(--pel-gold);justify-self:center;}
    .pel-resilience__link{height:2px;background:var(--pel-gold);opacity:.55;}
    .pel-resilience__label{
      grid-row:2;margin-top:8px;
      font-size:11.5px;font-weight:600;letter-spacing:.03em;color:rgba(255,255,255,.85);
      white-space:nowrap;text-align:center;
    }
    .pel-resilience__label--wifi{grid-column:1;}
    .pel-resilience__label--eth{grid-column:3;}
    .pel-resilience__label--gsm{grid-column:5;}
    .pel-resilience__caption{
      margin-top:16px;font-size:13.5px;color:rgba(255,255,255,.6);
      max-width:380px;margin-left:auto;margin-right:auto;line-height:1.5;
    }

    /* ---- buttons ---- */
    .pel-btn{
      position:relative;overflow:hidden;isolation:isolate;
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      border:none;border-radius:999px;cursor:pointer;
      font-family:inherit;font-size:16px;font-weight:600;
      padding:16px 32px;min-width:250px;
      transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease;
    }
    .pel-btn:active{transform:scale(.98);}
    .pel-btn[disabled]{opacity:.5;cursor:not-allowed;}
    .pel-btn--primary{background:var(--pel-gold);color:var(--pel-navy-deep);box-shadow:0 10px 24px -10px rgba(173,132,56,.55);}
    .pel-btn--primary .btn-fill{background:#c69a4c;}
    .pel-btn .btn-fill{position:absolute;inset:0;z-index:-1;transform:translateY(100%);}
    .pel-btn__text{position:relative;display:inline-flex;align-items:center;gap:10px;}
    .pel-btn--ghost{background:transparent;color:var(--pel-navy);border:1.5px solid var(--pel-navy);padding:14px 30px;box-shadow:none;min-width:0;}
    .pel-btn--sm{min-width:0;padding:11px 22px;font-size:14px;}

    /* ---- trust strip ---- */
    .pel-strip{
      display:flex;flex-wrap:wrap;justify-content:center;gap:12px;
      padding:26px 0;border-bottom:1px solid var(--pel-line);
    }
    .pel-strip__item{
      display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:500;
      padding:9px 16px;border-radius:999px;background:var(--pel-paper);
    }
    .pel-strip__item svg{color:var(--pel-navy);flex-shrink:0;}

    /* ---- why grid (avantages clés) ---- */
    .pel-why__head{text-align:center;max-width:640px;margin:0 auto 40px;}
    .pel-why__head h2{font-size:clamp(26px,3.6vw,36px);}
    .pel-why__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--pel-line);border:1px solid var(--pel-line);border-radius:20px;overflow:hidden;}
    .pel-why__item{background:#fff;padding:22px 24px;display:flex;gap:14px;align-items:flex-start;}
    .pel-why__item svg{flex-shrink:0;margin-top:2px;color:var(--pel-gold);}
    .pel-why__item p{font-size:15px;font-weight:500;line-height:1.5;}
    @media (min-width:700px){.pel-why__grid{grid-template-columns:1fr 1fr;}}

    /* ---- comment ça marche (real 4-step sequence — numbering earns its
       place here since order genuinely matters) ---- */
    .pel-steps__head{text-align:center;max-width:640px;margin:0 auto 40px;}
    .pel-steps__head h2{font-size:clamp(26px,3.6vw,36px);}
    .pel-steps__head p{margin-top:14px;color:var(--pel-gray);font-size:17px;}
    .pel-steps__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--pel-line);border:1px solid var(--pel-line);border-radius:20px;overflow:hidden;}
    .pel-steps__item{background:#fff;padding:26px 24px;}
    .pel-steps__num{display:block;font-size:13px;font-weight:700;color:var(--pel-gold);letter-spacing:.06em;margin-bottom:10px;}
    .pel-steps__item h3{font-size:16.5px;font-weight:600;margin-bottom:8px;}
    .pel-steps__item p{font-size:14px;color:var(--pel-gray);line-height:1.55;}
    @media (min-width:700px){.pel-steps__grid{grid-template-columns:1fr 1fr;}}
    @media (min-width:1000px){.pel-steps__grid{grid-template-columns:repeat(4,1fr);}}

    /* ---- social proof ---- */
    .pel-testimonial{max-width:640px;margin:0 auto;text-align:center;}
    .pel-testimonial__text{font-size:19px;line-height:1.55;color:var(--pel-ink);font-weight:500;}

    /* ---- pack contents ---- */
    .pel-contents__head{text-align:center;max-width:640px;margin:0 auto 40px;}
    .pel-contents__head h2{font-size:clamp(26px,3.6vw,36px);}
    .pel-contents__head p{margin-top:14px;color:var(--pel-gray);font-size:17px;}
    .pel-contents__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--pel-line);border:1px solid var(--pel-line);border-radius:20px;overflow:hidden;}
    .pel-contents__item{background:#fff;padding:20px 22px;display:flex;gap:14px;align-items:flex-start;}
    .pel-contents__qty{flex-shrink:0;width:32px;height:32px;border-radius:50%;background:var(--pel-navy);color:#fff;font-size:12.5px;font-weight:700;display:flex;align-items:center;justify-content:center;}
    .pel-contents__name{font-size:14.5px;font-weight:600;line-height:1.4;}
    .pel-contents__desc{margin-top:3px;font-size:13px;color:var(--pel-gray);line-height:1.5;}
    @media (min-width:700px){.pel-contents__grid{grid-template-columns:1fr 1fr;}}

    /* ---- features ---- */
    .pel-feature{
      display:grid;grid-template-columns:1fr;gap:40px;align-items:center;
      padding:56px 0;
    }
    .pel-feature__media img{border-radius:24px;background:var(--pel-paper);}
    .pel-feature__num{font-size:12.5px;font-weight:700;color:var(--pel-gold);letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;display:block;}
    .pel-feature h2{font-size:clamp(24px,3.4vw,34px);}
    .pel-feature__text{margin-top:16px;color:var(--pel-gray);font-size:16.5px;line-height:1.6;max-width:480px;}
    .pel-feature__note{margin-top:12px;font-size:13.5px;color:var(--pel-gray);font-style:italic;max-width:480px;}
    .pel-feature ul{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:11px;max-width:480px;}
    .pel-feature ul li{display:flex;gap:10px;font-size:15px;line-height:1.5;color:var(--pel-ink);}
    .pel-feature ul li svg{flex-shrink:0;margin-top:3px;color:var(--pel-navy);}
    @media (min-width:900px){
      .pel-feature{grid-template-columns:1fr 1fr;gap:72px;}
      .pel-feature--reverse .pel-feature__media{order:2;}
      .pel-feature--reverse .pel-feature__body{order:1;}
    }

    /* ---- mid CTA band ---- */
    .pel-band{
      background:var(--pel-navy-deep);color:#fff;border-radius:28px;
      padding:52px 32px;text-align:center;margin:24px 0;
    }
    .pel-band h2{color:#fff;font-size:clamp(23px,3vw,32px);max-width:600px;margin:0 auto;}
    .pel-band p{color:rgba(255,255,255,.68);margin-top:14px;font-size:15.5px;max-width:480px;margin-left:auto;margin-right:auto;}
    .pel-band .pel-btn{margin-top:26px;}

    /* ---- specs ---- */
    .pel-specs__head{text-align:center;max-width:640px;margin:0 auto 44px;}
    .pel-specs__head h2{font-size:clamp(26px,3.6vw,36px);}
    .pel-specs__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--pel-line);border:1px solid var(--pel-line);border-radius:20px;overflow:hidden;}
    .pel-specs__item{background:#fff;padding:22px 26px;}
    .pel-specs__item dt{font-size:12.5px;font-weight:700;color:var(--pel-gold);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;}
    .pel-specs__item dd{margin:0;font-size:14.5px;color:var(--pel-ink);line-height:1.55;white-space:pre-line;}
    @media (min-width:700px){.pel-specs__grid{grid-template-columns:1fr 1fr;}}
    @media (min-width:1000px){.pel-specs__grid{grid-template-columns:1fr 1fr 1fr;}}

    /* ---- guarantee band ---- */
    .pel-guarantee{display:grid;grid-template-columns:1fr;gap:26px;text-align:center;}
    @media (min-width:700px){.pel-guarantee{grid-template-columns:repeat(4,1fr);}}
    .pel-guarantee__item{padding:0 12px;}
    .pel-guarantee__item svg{color:var(--pel-navy);margin:0 auto 14px;display:block;}
    .pel-guarantee__item h3{font-size:15.5px;font-weight:600;}
    .pel-guarantee__item p{margin-top:8px;font-size:13.5px;color:var(--pel-gray);line-height:1.5;}

    /* ---- faq ---- */
    .pel-faq{max-width:760px;margin:0 auto;}
    .pel-faq h2{text-align:center;font-size:clamp(26px,3.6vw,36px);margin-bottom:36px;}
    .pel-faq details{border-bottom:1px solid var(--pel-line);padding:18px 0;}
    .pel-faq summary{
      cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;
      font-size:16.5px;font-weight:500;
    }
    .pel-faq summary::-webkit-details-marker{display:none;}
    .pel-faq summary .pel-faq__icon{flex-shrink:0;transition:transform .25s ease;color:var(--pel-gold);}
    .pel-faq details[open] summary .pel-faq__icon{transform:rotate(45deg);}
    .pel-faq__a{margin-top:12px;color:var(--pel-gray);font-size:14.5px;line-height:1.6;max-width:660px;}

    /* ---- final cta ---- */
    .pel-final{
      text-align:center;background:var(--pel-navy-deep);color:#fff;
      /* physical clearance so the real button here can never end up
         underneath the fixed sticky bar at max scroll, regardless of the
         JS visibility toggle — kept on the section itself, after the
         legal line, so it doesn't create a gap between the button and
         the legal text above it */
      padding-bottom:calc(72px + 90px + env(safe-area-inset-bottom, 0px));
    }
    .pel-final h2{font-size:clamp(26px,4vw,42px);max-width:680px;margin:0 auto;color:#fff;}
    .pel-final p{margin-top:14px;color:rgba(255,255,255,.68);font-size:16px;}
    .pel-final__ctas{margin-top:30px;display:flex;flex-wrap:wrap;gap:14px;justify-content:center;}
    .pel-final__legal{margin-top:22px;font-size:12.5px;color:rgba(255,255,255,.5);}

    /* ---- reveal-on-scroll ---- */
    .pel-reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
    .pel-reveal.is-visible{opacity:1;transform:none;}
    @media (prefers-reduced-motion:reduce){
      .pel-reveal{opacity:1;transform:none;transition:none;}
      .pel-sticky{transition:none;}
    }
  </style>

  {%- comment -%} Hidden product form shared by every "Add to cart" button on this page {%- endcomment -%}
  {%- form 'product', product, id: form_id, data-type: 'add-to-cart-form', is: 'product-form', class: 'pel-visually-hidden' -%}
    <input type="hidden" name="id" value="{{ variant.id }}">
    <input type="hidden" name="quantity" value="1">
    {%- comment -%}
      The theme's ProductForm custom element looks up its own submit button
      with `this.querySelector('[type="submit"]')` — since every real
      "Ajouter au panier" button on this page lives outside this hidden
      form (linked via form="…"), that lookup would return null and throw
      before the cart request is ever sent. This dummy button keeps that
      lookup valid.
    {%- endcomment -%}
    <button type="submit" name="add" tabindex="-1" aria-hidden="true"></button>
    <div class="product-form__error-message alert alert--error" role="alert" hidden style="position:fixed;left:16px;right:16px;bottom:84px;z-index:70;background:#fff;border:1px solid #e11d48;color:#e11d48;padding:12px 16px;border-radius:12px;font-size:14px;"></div>
  {%- endform -%}
  <style>.pel-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}</style>

  {%- comment -%} Sticky add-to-cart bar {%- endcomment -%}
  <div class="pel-sticky" id="PELSticky-{{ section.id }}">
    <div class="pel-sticky__info">
      <div class="pel-sticky__thumb">
        {%- if hero_image -%}
          {{ hero_image | image_url: width: 80 | image_tag: loading: 'lazy', widths: '80,160' }}
        {%- endif -%}
      </div>
      <div class="pel-sticky__text">
        <div class="pel-sticky__name">Pack Élite</div>
        <div class="pel-sticky__price">
          {%- if has_compare -%}<span style="text-decoration:line-through;color:#98a0ad;">{{ variant.compare_at_price | money }}</span> {%- endif -%}
          {{ variant.price | money }}
        </div>
      </div>
    </div>
    {%- render 'pel-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: false -%}
  </div>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="pel-hero">
    <div class="pel-wrap">
      <span class="pel-eyebrow">Daewoo Security · Offre exclusive</span>
      <h1>Pack Élite — la protection qui ne coupe jamais.</h1>
      <p class="pel-hero__sub">
        La solution la plus avancée de Daewoo Security&nbsp;: triple connectivité, technologie
        Zigbee et vidéosurveillance extérieure autonome, sans abonnement.
      </p>

      <div class="pel-resilience" role="img" aria-label="Triple connectivité : Wi-Fi, Ethernet et 4G+ GSM de secours">
        <span class="pel-resilience__dot" aria-hidden="true"></span>
        <span class="pel-resilience__link" aria-hidden="true"></span>
        <span class="pel-resilience__dot" aria-hidden="true"></span>
        <span class="pel-resilience__link" aria-hidden="true"></span>
        <span class="pel-resilience__dot" aria-hidden="true"></span>
        <span class="pel-resilience__label pel-resilience__label--wifi" aria-hidden="true">Wi-Fi</span>
        <span class="pel-resilience__label pel-resilience__label--eth" aria-hidden="true">Ethernet</span>
        <span class="pel-resilience__label pel-resilience__label--gsm" aria-hidden="true">4G+ GSM</span>
      </div>
      <p class="pel-resilience__caption">Si une connexion tombe, la centrale bascule automatiquement sur la suivante — vos alertes ne s'arrêtent jamais.</p>

      <div class="pel-hero__price-row">
        {%- if has_compare -%}<span class="pel-hero__badge">-{{ discount_pct }}% aujourd'hui</span>{%- endif -%}
        <div id="PELHeroCta-{{ section.id }}" class="pel-hero__cta">
          {%- render 'pel-atc-button', form_id: form_id, variant: variant, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
        </div>
        <div class="pel-hero__price">
          {%- if has_compare -%}<span class="pel-price-compare">{{ variant.compare_at_price | money }}</span>{%- endif -%}
          <strong>{{ variant.price | money }}</strong> · paiement sécurisé
        </div>
        <div class="pel-hero__rating">
          {%- render 'product-rating', product: product -%}
        </div>
      </div>

      {%- if hero_image -%}
        <div class="pel-hero__media pel-reveal">
          {{ hero_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '600,900,1200', alt: product.title }}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} Trust strip {%- endcomment -%}
  <div class="pel-wrap">
    <div class="pel-strip pel-reveal">
      <div class="pel-strip__item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Sans abonnement, à vie
      </div>
      <div class="pel-strip__item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        Compatible jusqu'à 100 accessoires
      </div>
      <div class="pel-strip__item">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
