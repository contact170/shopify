      </div>
      <a class="elx-all" href="https://daewoo-security.fr/collections/gamme-elite-accessoires">
        Tous les accessoires Élite
        <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

