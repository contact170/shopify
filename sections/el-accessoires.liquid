{% comment %} ── Accessoires compatibles Élite — grille sans défilement ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .elx * { box-sizing:border-box; margin:0; padding:0; }
  .elx { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#fff; color:#0d1520; padding:92px 24px 96px; }
  .elx-inner { max-width:1180px; margin:0 auto; }
  .elx-head { display:flex; justify-content:space-between; align-items:flex-end; gap:32px; flex-wrap:wrap; margin-bottom:40px; }
  .elx-eyebrow { display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:600;
    letter-spacing:.2em; text-transform:uppercase; color:#5c6a75; margin-bottom:14px; }
  .elx-eyebrow::before { content:''; width:34px; height:1px; background:linear-gradient(90deg,#12a0ad,rgba(18,160,173,0)); }
  .elx-title { font-size:clamp(26px,3.4vw,38px); font-weight:600; letter-spacing:-.035em; line-height:1.12; margin-bottom:12px; }
  .elx-sub { font-size:15px; color:#4b5a63; font-weight:300; line-height:1.65; max-width:540px; }
  .elx-sub b { color:#0d1520; font-weight:500; }
  .elx-all { display:inline-flex; align-items:center; gap:9px; padding:13px 22px; border-radius:9px;
    border:1px solid #d9e0df; background:#fff; color:#0d1520; font-size:13.5px; font-weight:600;
    text-decoration:none; white-space:nowrap; transition:border-color .18s, transform .18s; }
  .elx-all:hover { border-color:#0a6068; transform:translateY(-2px); }
  .elx-all svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }

  .elx-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  .elx-i { display:flex; flex-direction:column; border:1px solid #e2e7e6; border-radius:14px; overflow:hidden;
    background:#fff; text-decoration:none; color:inherit; transition:border-color .18s, transform .18s, box-shadow .18s; }
  .elx-i:hover { border-color:#0a6068; transform:translateY(-3px); box-shadow:0 16px 34px -22px rgba(13,21,32,.36); }
  .elx-thumb { background:#f1f3f2; border-bottom:1px solid #e9edec; padding:12px; overflow:hidden; }
  .elx-thumb img { width:100%; height:132px; object-fit:contain; display:block; }
  .elx-txt { padding:15px 16px 17px; display:flex; flex-direction:column; flex:1; }
  .elx-cat { display:block; font-size:10px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;
    color:#0a6068; margin-bottom:7px; }
  .elx-nm { display:block; font-size:13.5px; font-weight:500; line-height:1.4; color:#0d1520; margin-bottom:10px; flex:1; }
  .elx-pr { display:block; font-size:14px; font-weight:600; color:#0d1520; letter-spacing:-.01em; }

  .elx-note { margin-top:26px; padding:20px 24px; border-radius:14px; background:#f1f3f2; border:1px solid #e2e7e6;
    font-size:13.8px; color:#4b5a63; font-weight:300; line-height:1.62; }
  .elx-note b { color:#0d1520; font-weight:500; }

  @media (max-width:1000px) { .elx-grid { grid-template-columns:repeat(3,1fr); } }
  @media (max-width:760px)  { .elx-grid { grid-template-columns:repeat(2,1fr); } .elx { padding:72px 20px; } }
  @media (max-width:420px)  { .elx-grid { grid-template-columns:1fr; } }
</style>

<section class="elx">
