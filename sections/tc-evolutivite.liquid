<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .tce * { box-sizing:border-box; margin:0; padding:0; }
  .tce { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#05080f; color:#eaf0fb; padding:92px 0; position:relative; overflow:hidden; }
  .tce::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(800px 420px at 78% 20%,rgba(245,181,68,.13),transparent 62%); }
  .tce-inner { position:relative; z-index:2; max-width:1160px; margin:0 auto; padding:0 24px; }
  .tce-head { display:grid; grid-template-columns:1.1fr .9fr; gap:48px; align-items:end; margin-bottom:44px; }
  .tce-eyebrow { font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:#8fa1bd; margin-bottom:14px; }
  .tce-title { font-size:clamp(26px,3.4vw,40px); font-weight:600; letter-spacing:-.03em; line-height:1.12; }
  .tce-title em { font-style:normal; color:#ffcd72; }
  .tce-sub { font-size:15px; color:#a0b0cb; font-weight:300; line-height:1.7; }
  .tce-sub b { color:#eaf0fb; font-weight:500; }
  .tce-rail { display:flex; gap:16px; overflow-x:auto; scroll-snap-type:x mandatory;
    padding:4px 24px 20px max(24px, calc((100% - 1160px) / 2 + 24px));
    -webkit-overflow-scrolling:touch; scrollbar-width:thin; }
  .tce-rail::-webkit-scrollbar { height:5px; }
  .tce-rail::-webkit-scrollbar-thumb { background:rgba(255,255,255,.16); border-radius:99px; }
  .tce-item { scroll-snap-align:start; flex:0 0 216px; border:1px solid rgba(255,255,255,.10); border-radius:16px;
    background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.012)); overflow:hidden;
    text-decoration:none; color:inherit; transition:transform .2s, border-color .2s; display:block; }
  .tce-item:hover { transform:translateY(-4px); border-color:rgba(77,163,255,.42); }
  .tce-item-img { height:150px; background:#0c1424; display:flex; align-items:center; justify-content:center; padding:14px; }
  .tce-item-img img { max-width:100%; max-height:100%; object-fit:contain; display:block; }
  .tce-item-b { padding:16px 17px 19px; }
  .tce-ref { font-size:10.5px; font-weight:700; letter-spacing:.14em; color:#7cbcff; display:block; margin-bottom:6px; }
  .tce-nm { font-size:14px; font-weight:600; letter-spacing:-.015em; line-height:1.35; margin-bottom:6px; }
  .tce-pr { font-size:13px; color:#93a5c2; font-weight:300; }
  .tce-foot { max-width:1160px; margin:0 auto; padding:24px 24px 0; display:flex; gap:16px; align-items:center; flex-wrap:wrap; position:relative; z-index:2; }
  .tce-btn { display:inline-flex; align-items:center; gap:9px; padding:14px 24px; border-radius:10px;
    background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16); color:#eaf0fb;
    font-size:14px; font-weight:600; text-decoration:none; transition:background .18s, transform .18s; }
  .tce-btn:hover { background:rgba(255,255,255,.13); transform:translateY(-2px); }
  .tce-hint { font-size:13px; color:#8093b3; font-weight:300; }
  @media (max-width:900px) { .tce-head { grid-template-columns:1fr; gap:20px; } .tce { padding:72px 0; } }
</style>

