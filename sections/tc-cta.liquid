{% comment %} ── Bandeau de conversion final ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .tcc * { box-sizing:border-box; margin:0; padding:0; }
  .tcc { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#fff; color:#0b1220; padding:84px 24px; position:relative; overflow:hidden; text-align:center;
    border-top:1px solid #eef1f7; }
  .tcc::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(700px 340px at 30% 0%,rgba(47,123,255,.09),transparent 62%),
               radial-gradient(600px 320px at 76% 100%,rgba(232,160,44,.08),transparent 62%); }
  .tcc-inner { position:relative; z-index:2; max-width:720px; margin:0 auto; }
  .tcc-tag { display:inline-flex; align-items:center; gap:9px; font-size:11px; font-weight:600; letter-spacing:.16em;
    text-transform:uppercase; padding:8px 16px; border-radius:99px; background:#fff;
    border:1px solid #dfe5ef; color:#4a5a75; margin-bottom:22px; box-shadow:0 2px 8px rgba(11,18,32,.05); }
  .tcc-tag svg { width:14px; height:14px; fill:none; stroke:#0f9d63; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
  .tcc-title { font-size:clamp(27px,3.6vw,42px); font-weight:600; color:#0b1220; letter-spacing:-.03em; line-height:1.12; margin-bottom:16px; }
  .tcc-sub { font-size:16px; color:#4a5a75; font-weight:300; line-height:1.65; margin-bottom:32px; max-width:600px; margin-left:auto; margin-right:auto; }
  .tcc-btns { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-bottom:28px; }
  .tcc-b { display:inline-flex; align-items:center; gap:9px; padding:15px 26px; border-radius:10px;
    font-size:14.5px; font-weight:600; text-decoration:none; transition:transform .18s, box-shadow .18s; }
  .tcc-b:hover { transform:translateY(-2px); }
  .tcc-b svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  .tcc-b--1 { background:#0b1220; color:#fff; box-shadow:0 12px 30px -10px rgba(11,18,32,.45); }
  .tcc-b--2 { background:#fff; color:#0b1220; border:1px solid #dfe5ef; }
  .tcc-b--2:hover { border-color:#b9c7dd; }
  .tcc-mini { display:flex; gap:22px; justify-content:center; flex-wrap:wrap; font-size:12.5px; color:#5a6982; font-weight:300; }
  .tcc-mini span { display:inline-flex; align-items:center; gap:7px; }
  .tcc-mini svg { width:13px; height:13px; fill:none; stroke:#2f7bff; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
  @media (max-width:600px) { .tcc { padding:66px 20px; } }
</style>

<section class="tcc">
  <div class="tcc-inner">
    <span class="tcc-tag"><svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Sans abonnement · Sans engagement</span>
    <h2 class="tcc-title">Touch ou Touch XL,<br>votre maison est protégée ce soir.</h2>
    <p class="tcc-sub">Choisissez un pack prêt à poser, ou laissez le configurateur composer votre système en 2 minutes. Expédition rapide, retour gratuit sous 14 jours.</p>
    <div class="tcc-btns">
      <a class="tcc-b tcc-b--1" href="https://daewoo-security.fr/pages/pack-alarmes?_pos=1&_psq=pack&_ss=e&_v=1.0">
        Voir tous les packs
        <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a class="tcc-b tcc-b--2" href="https://daewoo-security.fr/pages/configurateur_2">
        Configurer mon système
        <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <div class="tcc-mini">
      <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Garantie 2 ans</span>
      <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>SAV en France, assistant 7j/7</span>
      <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Retour gratuit 14 jours</span>
      <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Application incluse à vie</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Touch — CTA final",
  "settings": []
}
{% endschema %}
