      <div class="pv-faq pv-reveal">
        <h2>Questions fréquentes</h2>
        {%- for item in faq_items -%}
          {%- assign qa = item | split: '|' -%}
          <details>
            <summary>{{ qa[0] | replace: ' ?', '&nbsp;?' }}<span class="pv-faq__icon" aria-hidden="true">＋</span></summary>
            <p class="pv-faq__a">{{ qa[1] | replace: ' :', '&nbsp;:' }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ Rendez-vous conseiller ============ {%- endcomment -%}
  <section class="pv-section">
    <div class="pv-wrap">
      <div class="pv-appt pv-reveal">
        <div>
          <p class="pv-appt__eyebrow">Encore une question&nbsp;?</p>
          <h3>Parlez à un conseiller Daewoo Security</h3>
          <p class="pv-appt__sub">Par téléphone ou en visio, pour vous aider à choisir la bonne centrale — sans engagement.</p>
        </div>
        <a href="https://calendly.com/contact-daewoo-security/30min" target="_blank" rel="noopener" class="pv-btn pv-btn--ghost">
          <span class="pv-btn__text">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
            Réserver un appel gratuit
          </span>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ============ Appel final ============ {%- endcomment -%}
  <section class="pv-section pv-final">
    <div class="pv-wrap">
      <div class="pv-reveal">
        <h2>L'offre se termine le 31 octobre.</h2>
        <p>
          <span class="pv-price-compare{% if eco0 > 0 %} is-visible{% endif %}" data-psi-barre>{{ ref0 | money }}</span>
          <span class="pv-price-amount">{{ v0.price | money }}</span> · Sans abonnement · Garantie 2 ans
        </p>
        <div class="pv-final__ctas">
          {%- render 'pv-atc-button', form_id: form_id, variant: v0, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
        </div>
        {%- render 'pv-trust-row', has_rating: has_rating, rating_value: rating_value, rating_max: rating_max, rating_count: rating_count, rating_pct: rating_pct, reviews_anchor: reviews_anchor -%}
        <p class="pv-final__legal">Expédié sous 24 h · Retour sous 14 jours · Service client basé en France</p>
      </div>
    </div>
  </section>

  {%- comment -%} Modale Alma {%- endcomment -%}
  <dialog class="pv-modal" id="PVAlmaModal-{{ section.id }}">
    <div class="pv-modal__inner">
      <button type="button" class="pv-modal__close" aria-label="Fermer" data-pv-modal-close>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="M6 6l12 12"></path></svg>
      </button>
      <img class="pv-alma-badge-lg" src="https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Badge-CB-Alma-orange.png?v=1785858203" width="75" height="30" alt="Alma" loading="lazy">
      <h3>Payez en plusieurs fois</h3>
      <p>Choisissez votre échéancier au moment du paiement, sans engagement.</p>
      <div class="pv-alma-plans">
        <div class="pv-alma-plan"><div><div class="pv-alma-plan__title">3x sans frais</div><div class="pv-alma-plan__note">Dès le premier euro d'achat</div></div><div class="pv-alma-plan__amount" data-pv-alma-3x>—</div></div>
        <div class="pv-alma-plan"><div><div class="pv-alma-plan__title">4x sans frais</div><div class="pv-alma-plan__note">À partir de 100&nbsp;€ d'achat</div></div><div class="pv-alma-plan__amount" data-pv-alma-4x>—</div></div>
        <div class="pv-alma-plan" data-pv-alma-10x-wrap hidden><div><div class="pv-alma-plan__title">10x avec frais</div><div class="pv-alma-plan__note">À partir de 200&nbsp;€ d'achat · 7,34&nbsp;% de frais</div></div><div class="pv-alma-plan__amount" data-pv-alma-10x>—</div></div>
      </div>
      <p class="pv-modal__legal">Simulation pour un achat de <strong data-pv-alma-total>—</strong>. Le paiement en plusieurs fois est proposé par Alma au moment du paiement, sous réserve d'acceptation de votre dossier.</p>
    </div>
  </dialog>

  {%- comment -%} Modale « tous les avis » {%- endcomment -%}
  <dialog class="pv-modal pv-modal--reviews" id="PVReviewsModal-{{ section.id }}">
    <div class="pv-modal__inner">
      <button type="button" class="pv-modal__close" aria-label="Fermer" data-pv-modal-close>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="M6 6l12 12"></path></svg>
      </button>
      <h3>Tous les avis clients</h3>
      {%- if has_rating -%}<p><strong>{{ rating_value }}/5</strong> sur {{ rating_count }} avis vérifiés</p>{%- endif -%}
      <div class="pv-all-reviews" data-pv-all-reviews-list></div>
    </div>
  </dialog>

  <script type="application/json" id="PVAllReviews-{{ section.id }}">
    {%- render 'pv-avis-vigilia' -%}
  </script>

  {%- liquid
    assign fin_iso = ''
    if section.settings.end_date != blank
      assign fin_iso = section.settings.end_date | date: '%Y-%m-%d'
    endif
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProductGroup",
    "name": "Pack Sécurité Intégrale",
    "productGroupID": "PSI",
    "description": {{ section.settings.summary | append: ' ' | append: section.settings.sub | strip | json }},
    "brand": { "@type": "Brand", "name": "Daewoo Security" },
    "url": {{ canonical_url | json }},
    "hasVariant": [
      {%- for block in centrales -%}
        {%- liquid
          assign p = block.settings.product
          assign v = p.selected_or_first_available_variant
          assign img_ld = p.featured_image | image_url: width: 1200 | prepend: 'https:'
        -%}
        {
          "@type": "Product",
          "name": {{ block.settings.title | json }},
          "sku": {{ v.sku | json }},
          "description": {{ block.settings.description | json }},
          "brand": { "@type": "Brand", "name": "Daewoo Security" },
          {%- if p.featured_image %}"image": {{ img_ld | json }},{% endif %}
          "url": {{ shop.url | append: p.url | json }},
          "offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: p.url | json }},
            "price": {{ v.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | default: 'EUR' | json }},
            {%- if fin_iso != '' %}"priceValidUntil": {{ fin_iso | json }},{% endif %}
            "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": "Nos packs", "item": {{ shop.url | append: '/pages/pack-alarmes' | json }} },
      { "@type": "ListItem", "position": 3, "name": "Pack Sécurité Intégrale · Offre spéciale", "item": {{ canonical_url | json }} }
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for item in faq_items -%}
        {%- assign qa = item | split: '|' -%}
        { "@type": "Question", "name": {{ qa[0] | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ qa[1] | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>

  <script>
    (function () {
      var root = document.getElementById('PSI-{{ section.id }}');
      if (!root) return;

      /* Apparition au défilement */
      var reveal = root.querySelectorAll('.pv-reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        reveal.forEach(function (el) { io.observe(el); });
      } else {
        reveal.forEach(function (el) { el.classList.add('is-visible'); });
      }

      /* Données par centrale */
      var data = {};
      try { data = JSON.parse(document.getElementById('PVData-{{ section.id }}').textContent); } catch (e) {}
      var parCle = {};
      Object.keys(data).forEach(function (id) { data[id].id = id; parCle[data[id].key] = data[id]; });
      var champ = document.getElementById('PVVariantId-{{ section.id }}');
      var choix = root.querySelectorAll('[data-pv-connectivity]');
      function horsComparatif(el) { return !el.closest('.pv-compare__price'); }

      function choisir(cle, depuisClic) {
        var d = parCle[cle];
        if (!d) return;
        choix.forEach(function (el) {
          var ok = el.getAttribute('data-pv-connectivity') === cle;
          el.classList.toggle('is-selected', ok);
          el.setAttribute('aria-pressed', ok ? 'true' : 'false');
        });
        if (champ) champ.value = d.id;
        root.querySelectorAll('[data-psi-idx]').forEach(function (el) { el.hidden = el.getAttribute('data-psi-idx') !== String(d.idx); });
        root.querySelectorAll('[data-psi-sim]').forEach(function (el) { el.hidden = !d.sim; });
        root.querySelectorAll('[data-psi-rfid]').forEach(function (el) { el.hidden = !d.rfid; });
        Array.prototype.filter.call(root.querySelectorAll('.pv-price-amount'), horsComparatif).forEach(function (el) { el.textContent = d.price; });
        root.querySelectorAll('[data-psi-barre]').forEach(function (el) { el.textContent = d.compare; el.classList.toggle('is-visible', d.hasCompare); });
        root.querySelectorAll('[data-psi-eco]').forEach(function (el) { el.hidden = !d.hasCompare; });
        root.querySelectorAll('[data-psi-saving]').forEach(function (el) { el.textContent = d.saving; });
        root.querySelectorAll('[data-psi-sku]').forEach(function (el) { el.textContent = d.sku; });
        root.querySelectorAll('[data-psi-nom]').forEach(function (el) { el.textContent = d.nom; });
        root.querySelectorAll('[data-psi-thumb]').forEach(function (el) { if (d.thumb) { el.src = d.thumb; el.removeAttribute('srcset'); } });
        root.querySelectorAll('button[form="{{ form_id }}"]').forEach(function (b) { b.disabled = !d.available; });
        if (depuisClic && history.replaceState) {
          var url = new URL(location.href);
          url.searchParams.set('centrale', cle);
          history.replaceState(history.state, '', url.toString());
        }
      }
      choix.forEach(function (el) {
        el.addEventListener('click', function () {
          choisir(el.getAttribute('data-pv-connectivity'), true);
          /* Depuis le comparatif, on remonte au bouton d'achat */
          if (el.classList.contains('pv-compare__card')) {
            var cta = document.getElementById('PVHeroCta-{{ section.id }}');
            if (cta) cta.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });
      var voulu = new URLSearchParams(location.search).get('centrale');
      if (voulu && parCle[voulu]) choisir(voulu, false);

      /* Bandeau carte SIM : ajout direct au panier, puis ouverture du tiroir */
      root.querySelectorAll('[data-psi-ajout]').forEach(function (b) {
        b.addEventListener('click', function () {
          if (b.getAttribute('aria-busy') === 'true') return;
          b.setAttribute('aria-busy', 'true');
          var racineUrl = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
          fetch(racineUrl + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(b.getAttribute('data-psi-ajout')), quantity: 1 }] })
          })
            .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })
            .then(function () {
              if (window.theme && theme.pubsub && theme.pubsub.PUB_SUB_EVENTS) {
                fetch(racineUrl + 'cart.js').then(function (r) { return r.json(); }).then(function (cart) {
                  theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, { source: 'offre-psi', cart: cart });
                }).catch(function () {});
              }
              if (document.querySelector('cart-drawer')) {
                document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: true } }));
              } else {
                window.location.href = {{ routes.cart_url | json }};
              }
            })
            .catch(function (e) { alert((e && (e.description || e.message)) || "La carte SIM n'a pas pu être ajoutée au panier. Merci de réessayer."); })
            .finally(function () { b.removeAttribute('aria-busy'); });
        });
      });

      /* Vignettes : changent la grande photo du pack affiché */
      root.querySelectorAll('[data-pv-thumb]').forEach(function (t) {
        t.addEventListener('click', function () {
          var bloc = t.closest('.pv-hero__media');
          var img = bloc.querySelector('[data-psi-hero]');
          if (img) { img.src = t.getAttribute('data-full'); img.srcset = t.getAttribute('data-full-srcset'); }
          bloc.querySelectorAll('[data-pv-thumb]').forEach(function (x) { x.classList.toggle('is-active', x === t); });
        });
      });

      /* Comptes à rebours */
      root.querySelectorAll('[data-psi-compte]').forEach(function (c) {
        var fin = Date.parse(c.getAttribute('data-fin'));
        var temps = c.querySelector('[data-psi-temps]');
        var deux = function (n) { return (n < 10 ? '0' : '') + n; };
        function tic() {
          var s = Math.floor((fin - Date.now()) / 1000);
          if (isNaN(fin) || s <= 0) {
            c.querySelector('[data-psi-encours]').hidden = true;
            c.querySelector('[data-psi-fini]').hidden = false;
            return false;
          }
          temps.textContent = Math.floor(s / 86400) + ' j ' + deux(Math.floor(s % 86400 / 3600)) + ' h ' + deux(Math.floor(s % 3600 / 60)) + ' min ' + deux(s % 60) + ' s';
          return true;
        }
        if (tic()) { var t = setInterval(function () { if (!tic()) clearInterval(t); }, 1000); }
      });

      /* Barre d'achat collante : visible une fois le bouton du haut dépassé */
      var heroCta = document.getElementById('PVHeroCta-{{ section.id }}');
      var sticky = document.getElementById('PVSticky-{{ section.id }}');
      if (heroCta && sticky && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (e) {
          sticky.classList.toggle('is-shown', !e[0].isIntersecting && e[0].boundingClientRect.top < 0);
        }, { rootMargin: '-64px 0px 0px 0px' }).observe(heroCta);
      }

      /* Avis : 8 avis de 4 ou 5 étoiles, textes verbatim, et la liste complète dans la modale */
      var avis = [];
      try { avis = JSON.parse(document.getElementById('PVAllReviews-{{ section.id }}').textContent); } catch (e) {}
      function carteAvis(a, classe) {
        var el = document.createElement('div');
        el.className = classe;
        var etoiles = document.createElement('div');
        etoiles.className = classe + '__stars';
        etoiles.setAttribute('aria-hidden', 'true');
        etoiles.textContent = '★★★★★'.slice(0, a.r) + '☆☆☆☆☆'.slice(0, 5 - a.r);
        var texte = document.createElement('p');
        texte.className = classe + '__text';
        texte.textContent = a.t;
        var meta = document.createElement('p');
        meta.className = classe + '__meta';
        var nom = document.createElement('strong');
        nom.textContent = a.n;
        meta.appendChild(nom);
        var reste = [a.c, a.d].filter(Boolean).join(' · ');
        if (reste) meta.appendChild(document.createTextNode(' · ' + reste));
        el.appendChild(etoiles); el.appendChild(texte); el.appendChild(meta);
        return el;
      }
      var piste = root.querySelector('[data-psi-avis]');
      if (piste) {
        avis.filter(function (a) { return a.r >= 4 && a.t.length > 60 && a.t.length < 260; }).slice(0, 8)
          .forEach(function (a) { piste.appendChild(carteAvis(a, 'pv-review-card')); });
      }

      /* Modales (Alma, tous les avis) */
      function ouvrir(d) { if (d && d.showModal) { d.showModal(); requestAnimationFrame(function () { d.classList.add('is-open'); }); } }
      function fermer(d) { d.classList.remove('is-open'); d.close(); }
      root.querySelectorAll('.pv-modal').forEach(function (d) {
        d.querySelectorAll('[data-pv-modal-close]').forEach(function (b) { b.addEventListener('click', function () { fermer(d); }); });
        d.addEventListener('click', function (e) { if (e.target === d) fermer(d); });
      });
      var alma = document.getElementById('PVAlmaModal-{{ section.id }}');
      function euros(c) { return (c / 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; }
      root.querySelectorAll('[data-pv-alma-open]').forEach(function (b) {
        b.addEventListener('click', function () {
          var d = champ && data[champ.value];
          var c = d ? d.priceCents : {{ v0.price | json }};
          alma.querySelector('[data-pv-alma-total]').textContent = euros(c);
          alma.querySelector('[data-pv-alma-3x]').textContent = '3 x ' + euros(Math.round(c / 3));
          alma.querySelector('[data-pv-alma-4x]').textContent = '4 x ' + euros(Math.round(c / 4));
          var dix = c >= 20000;
          alma.querySelector('[data-pv-alma-10x-wrap]').hidden = !dix;
          if (dix) alma.querySelector('[data-pv-alma-10x]').textContent = '10 x ' + euros(Math.round(c * 1.0734 / 10));
          ouvrir(alma);
        });
      });
      var modaleAvis = document.getElementById('PVReviewsModal-{{ section.id }}');
      var listeFaite = false;
      root.querySelectorAll('[data-pv-reviews-open]').forEach(function (b) {
        b.addEventListener('click', function () {
          if (!listeFaite) {
            var liste = modaleAvis.querySelector('[data-pv-all-reviews-list]');
            avis.forEach(function (a) { liste.appendChild(carteAvis(a, 'pv-all-review')); });
            listeFaite = true;
          }
          ouvrir(modaleAvis);
        });
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Offre PSI · page pack",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "end_date", "label": "Fin de l'offre", "default": "2026-10-31T23:59:59+01:00", "info": "Format : 2026-10-31T23:59:59+01:00 (heure de Paris). Vide = compte à rebours masqué." },
    { "type": "text", "id": "title", "label": "Titre (H1)", "default": "Pack Sécurité Intégrale" },
    { "type": "text", "id": "tagline", "label": "Accroche", "default": "Alarme maison sans fil, 2 caméras et sirène solaire. Sans abonnement." },
    { "type": "textarea", "id": "summary", "label": "Résumé sous l'accroche", "default": "Une centrale au choix, 4 contacteurs, 1 détecteur de mouvement, 1 télécommande, 2 caméras, 1 sirène solaire et 2 autocollants." },
    { "type": "image_picker", "id": "stickers_image", "label": "Photo des 2 autocollants (contenu du pack)", "info": "Le produit Shopify est un lot de 10 : sa photo n'est pas utilisée ici." },
    { "type": "textarea", "id": "sub", "label": "Texte sous le bouton", "default": "Tout pour protéger votre maison, dedans comme dehors. Vous l'installez vous-même, sans technicien, et vous ne payez jamais d'abonnement." }
  ],
  "blocks": [
    {
      "type": "centrale",
      "name": "Centrale",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit du pack" },
        { "type": "text", "id": "slug", "label": "Identifiant (URL ?centrale=…)", "default": "vigilia" },
        { "type": "text", "id": "tab_label", "label": "Nom court", "default": "Vigilia" },
        { "type": "text", "id": "tab_sub", "label": "Précision sous le nom", "default": "Wi-Fi" },
        { "type": "text", "id": "badge", "label": "Badge (optionnel)" },
        { "type": "text", "id": "title", "label": "Nom complet (barre d'achat)", "default": "Pack Sécurité Intégrale · Vigilia" },
        { "type": "textarea", "id": "description", "label": "Pour qui (comparatif)" },
        { "type": "text", "id": "bullet_1", "label": "Point fort 1" },
        { "type": "text", "id": "bullet_2", "label": "Point fort 2" },
        { "type": "text", "id": "bullet_3", "label": "Point fort 3" },
        { "type": "text", "id": "ref_value", "label": "Valeur des éléments achetés séparément (€)", "info": "Ex. : 456,79. Sert au prix barré, au % et à l'économie." },
        { "type": "checkbox", "id": "has_sim", "label": "Carte SIM 4G", "default": false },
        { "type": "checkbox", "id": "has_rfid", "label": "Badges RFID inclus", "default": false },
        { "type": "header", "content": "Centrale dans « Tout ce qu'il faut »" },
        { "type": "text", "id": "centrale_name", "label": "Nom", "default": "Centrale Vigilia" },
        { "type": "text", "id": "centrale_note", "label": "Description" },
        { "type": "image_picker", "id": "centrale_image", "label": "Photo de la centrale" },
        { "type": "product", "id": "centrale_product", "label": "ou produit centrale (sa photo)" },
        { "type": "header", "content": "En résumé" },
        { "type": "text", "id": "spec_centrale", "label": "Centrale" },
        { "type": "text", "id": "spec_connectivite", "label": "Connectivité" },
        { "type": "text", "id": "spec_batterie", "label": "Batterie de secours" }
      ]
    }
  ],
  "presets": [{ "name": "Offre PSI · page pack" }]
}
{% endschema %}
