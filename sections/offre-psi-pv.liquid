{%- doc -%}
  Page de l'offre spéciale « Pack Sécurité Intégrale » (PSI), même présentation
  que les pages packs Vigilia (sections/product-vig501-landing.liquid, style pv).

  Un seul formulaire produit caché pour toute la page : le choix de la centrale
  (Vigilia, Vigilia +, Touch, Touch XL) change la variante envoyée au panier,
  les prix, les photos et les textes qui dépendent de la centrale.
  Les quatre packs sont des produits distincts, réglés dans les blocs « Centrale ».

  Contrat partagé avec snippets/pv-accessoires.liquid et assets/pv-accessoires.js :
  JSON #PVData-…, champ #PVVariantId-…, et attribut data-pv-connectivity sur les
  boutons de choix, pour que le total « pack + accessoires » suive la centrale.

  Présélection par l'URL : ?centrale=vigilia | vigilia-plus | touch | touch-xl
{%- enddoc -%}

{%- liquid
  assign centrales = section.blocks | where: 'type', 'centrale'
  assign c0 = centrales | first
  assign p0 = c0.settings.product
  assign v0 = p0.selected_or_first_available_variant
  assign form_id = 'PVForm-' | append: section.id

  capture pv_stats
    render 'pv-avis-vigilia', mode: 'stats'
  endcapture
  assign pv_ch = pv_stats | strip | split: '~|~'
  assign rating_count = pv_ch[0] | plus: 0
  if rating_count > 0
    assign has_rating = true
    assign rating_value = pv_ch[1] | times: 1.0 | round: 2
    assign rating_max = 5.0
    assign rating_pct = rating_value | times: 100.0 | divided_by: rating_max
  else
    assign has_rating = false
    assign rating_value = 0
    assign rating_max = 5
    assign rating_pct = 0
  endif
  assign reviews_anchor = 'PVReviews-' | append: section.id

  # Visuels des encarts : photos produit lues sur les fiches, jamais recopiées.
  assign img_camera = all_products['camera-w512mw-exterieure-rotative-1440p-avec-panneau-solaire'].featured_image
  assign img_sirene = all_products['sirene-exterieure-wos305s-sirene-avec-batterie-de-secours-et-panneau-solaire'].featured_image
  assign img_sim = images['03_AM302_protection_GSM_91149927-6f9e-43fc-ba24-f2ecaacf43ee.webp'] | default: p0.featured_image
  assign img_app = images['04_AM302_pilotage_distance_3e4f16e1-c909-4be6-b84a-c8166387e6fa.webp'] | default: p0.featured_image
-%}

<div class="pv" id="PSI-{{ section.id }}" data-psi="{{ section.id }}">

  <nav class="pv-wrap pv-bread" aria-label="Fil d'Ariane">
    <ol>
      <li><a href="{{ routes.root_url }}">Accueil</a></li>
      <li><a href="/pages/pack-alarmes">Nos packs</a></li>
      <li aria-current="page">Pack Sécurité Intégrale · Offre spéciale</li>
    </ol>
  </nav>

  {%- comment -%} Données par centrale : lues par le script de la page et par pv-accessoires.js {%- endcomment -%}
  <script type="application/json" id="PVData-{{ section.id }}">
    {
      {%- for block in centrales -%}
        {%- liquid
          assign p = block.settings.product
          assign v = p.selected_or_first_available_variant
          assign ref = 0
          if block.settings.ref_value != blank
            assign ref = block.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
          endif
          assign eco = ref | minus: p.price
        -%}
        "{{ v.id }}": {
          "key": {{ block.settings.slug | json }},
          "idx": {{ forloop.index0 }},
          "price": {{ v.price | money | strip_html | json }},
          "compare": {{ ref | money | strip_html | json }},
          "hasCompare": {% if eco > 0 %}true{% else %}false{% endif %},
          "saving": {{ eco | money | strip_html | json }},
          "priceCents": {{ v.price | json }},
          "sku": {{ v.sku | json }},
          "nom": {{ block.settings.title | json }},
          "available": {{ v.available | json }},
          "sim": {{ block.settings.has_sim | json }},
          "rfid": {{ block.settings.has_rfid | json }},
          "thumb": {{ p.featured_image | image_url: width: 80 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>

  <style>
    .pv{
      --pv-navy:#0c1e4a;
      --pv-navy-dark:#081430;
      --pv-ink:#1d1d1f;
      --pv-gray:#6e6e73;
      --pv-bg-alt:#f5f5f7;
      --pv-line:#d2d2d7;
      --pv-success:#037e05;
      --pv-promo:#e11d48;
      font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      color:var(--pv-ink);
      background:#fff;
      overflow-x:hidden;
    }
    .pv *{box-sizing:border-box;}
    .pv [hidden]{display:none !important;}
    .pv .pv-wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
    .pv img{max-width:100%;display:block;}
    .pv h1,.pv h2,.pv h3{font-weight:600;letter-spacing:-.02em;line-height:1.08;margin:0;}
    .pv :where(p){margin:0;}

    /* ---- fil d'Ariane ---- */
    .pv .pv-bread{padding-top:18px;padding-bottom:0;}
    .pv-bread{font-size:12px;line-height:1.5;color:var(--pv-gray);}
    .pv-bread ol{list-style:none;margin:0;padding:0;display:flex;flex-wrap:nowrap;align-items:center;min-width:0;}
    .pv-bread li{min-width:0;flex:0 1 auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .pv-bread li:first-child{flex:0 0 auto;}
    .pv-bread li + li::before{content:"/";margin:0 7px;color:var(--pv-line);}
    .pv-bread a{color:var(--pv-gray);text-decoration:underline;text-decoration-color:var(--pv-line);text-decoration-thickness:1px;text-underline-offset:3px;}
    .pv-bread li[aria-current]{color:var(--pv-ink);}

    /* ---- rythme des sections ---- */
    .pv-section{padding:72px 0;}
    .pv-section--alt{background:var(--pv-bg-alt);}
    .pv-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--pv-navy);margin-bottom:18px;}
    .pv-eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--pv-success);}
    .pv-ref{font-weight:700;color:var(--pv-ink);}
    .pv-head{text-align:center;max-width:640px;margin:0 auto 44px;}
    .pv-head h2{font-size:clamp(26px,3.4vw,38px);}
    .pv-head p{margin-top:14px;color:var(--pv-gray);font-size:17px;line-height:1.5;}

    /* ---- compte à rebours ---- */
    .psi-compte{display:inline-flex;align-items:center;flex-wrap:wrap;justify-content:center;gap:6px 10px;margin-bottom:18px;padding:8px 14px;border-radius:999px;background:#fff1f3;color:var(--pv-promo);font-size:13px;font-weight:600;}
    .psi-compte__point{width:7px;height:7px;border-radius:50%;background:var(--pv-promo);box-shadow:0 0 0 3px rgba(225,29,72,.18);}
    .psi-compte__temps{font-variant-numeric:tabular-nums;color:var(--pv-ink);}
    .psi-compte--sombre{background:rgba(255,255,255,.12);color:#fff;}
    .psi-compte--sombre .psi-compte__temps{color:#fff;}

    /* ---- hero ---- */
    .pv-hero{padding:56px 0 56px;text-align:center;}
    .pv-hero h1{font-size:clamp(34px,6vw,60px);max-width:900px;margin:0 auto;}
    .pv .pv-hero__tagline{display:block;line-height:1.3;letter-spacing:0;font-size:clamp(18px,2.6vw,26px);color:var(--pv-navy);max-width:820px;margin:14px auto 0;font-weight:500;font-style:italic;}
    .pv .pv-hero__summary{font-size:14px;color:var(--pv-gray);max-width:660px;margin:12px auto 0;line-height:1.5;}
    .pv .pv-hero__sub{font-size:clamp(17px,2.2vw,22px);color:var(--pv-gray);max-width:660px;margin:28px auto 0;line-height:1.5;}
    .pv-hero__media{position:relative;margin:40px auto 0;max-width:640px;}
    .pv-hero__img{position:relative;aspect-ratio:1/1;border-radius:28px;overflow:hidden;background:var(--pv-bg-alt);}
    .pv-hero__img img{width:100%;height:100%;object-fit:cover;}
    .psi-remise{position:absolute;top:16px;left:16px;z-index:1;padding:8px 14px;border-radius:999px;background:var(--pv-promo);color:#fff;font-size:15px;font-weight:700;letter-spacing:.01em;box-shadow:0 8px 20px -8px rgba(225,29,72,.6);}
    .pv-thumbs{display:flex;justify-content:center;gap:10px;margin:14px auto 0;max-width:640px;overflow-x:auto;padding:2px 2px 6px;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
    .pv-thumbs::-webkit-scrollbar{display:none;}
    .pv-thumbs__item{flex-shrink:0;width:56px;height:56px;padding:0;border-radius:12px;overflow:hidden;background:var(--pv-bg-alt);border:2px solid transparent;cursor:pointer;opacity:.6;transition:opacity .15s ease,border-color .15s ease;}
    .pv-thumbs__item img{width:100%;height:100%;object-fit:cover;}
    .pv-thumbs__item.is-active{opacity:1;border-color:var(--pv-navy);}

    /* ---- choix de la centrale ---- */
    .psi-choix{margin:32px auto 0;max-width:640px;text-align:left;}
    .psi-choix__titre{font-size:15px;font-weight:600;margin-bottom:24px;text-align:center;}
    .psi-choix__grille{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .psi-carte{position:relative;display:flex;flex-direction:column;gap:2px;width:100%;min-height:92px;padding:14px 14px 12px;border:2px solid var(--pv-line);border-radius:16px;background:#fff;font-family:inherit;text-align:left;color:var(--pv-ink);cursor:pointer;-webkit-tap-highlight-color:transparent;transition:border-color .15s ease,box-shadow .15s ease;}
    .psi-carte.is-selected{border-color:var(--pv-navy);box-shadow:0 0 0 3px rgba(12,30,74,.08);}
    .psi-carte__radio{position:absolute;top:14px;right:14px;width:18px;height:18px;border-radius:50%;border:2px solid var(--pv-line);}
    .psi-carte.is-selected .psi-carte__radio{border-color:var(--pv-navy);}
    .psi-carte.is-selected .psi-carte__radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--pv-navy);}
    .psi-carte__nom{font-size:16px;font-weight:600;padding-right:24px;}
    .psi-carte__sous{font-size:12.5px;color:var(--pv-gray);}
    .psi-carte__prix{margin-top:auto;padding-top:8px;font-size:15px;font-weight:700;}
    .psi-carte__badge{position:absolute;top:-10px;left:12px;font-size:11px;font-weight:700;color:#fff;background:var(--pv-promo);padding:3px 8px;border-radius:999px;}

    /* ---- prix + achat ---- */
    .pv-hero__cta{margin-top:24px;display:flex;flex-direction:column;align-items:center;gap:14px;}
    .pv-hero__price{font-size:15px;color:var(--pv-gray);}
    .pv-hero__price strong{color:var(--pv-ink);font-size:22px;}
    .pv-price-compare{text-decoration:line-through;color:var(--pv-gray);margin-right:6px;display:none;}
    .pv-price-compare.is-visible{display:inline;}
    .psi-eco{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:#e8f5e9;color:var(--pv-success);font-size:13.5px;font-weight:700;}
    .psi-eco[hidden]{display:none;}

    /* ---- badges avis + paiements (pv-trust-row) ---- */
    .pv-rating-badge{display:inline-flex;align-items:center;gap:8px;text-decoration:none;background:var(--pv-bg-alt);border:1px solid var(--pv-line);border-radius:999px;padding:8px 16px;font-size:13.5px;color:var(--pv-ink);}
    .pv-rating-badge__stars{position:relative;display:inline-block;font-size:14px;line-height:1;letter-spacing:1px;color:var(--pv-line);}
    .pv-rating-badge__stars-bg{display:block;}
    .pv-rating-badge__stars-fg{position:absolute;top:0;left:0;overflow:hidden;white-space:nowrap;color:#f5a623;}
    .pv-rating-badge__score{font-weight:700;}
    .pv-rating-badge__sep{color:var(--pv-line);}
    .pv-rating-badge__count{color:var(--pv-gray);}
    .pv-rating-badge__chevron{color:var(--pv-gray);flex-shrink:0;}
    .pv-hero__rating{margin-top:6px;}
    .pv-pay{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px;margin-top:14px;}
    .pv-pay__methods{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:6px;}
    .pv-pay__icon{height:22px;width:auto;border-radius:4px;box-shadow:0 0 0 1px var(--pv-line);}
    .pv-pay__alma{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid var(--pv-line);border-radius:8px;background:#fff;cursor:pointer;font-family:inherit;}
    .pv-pay__alma-logo{height:20px;width:auto;display:block;}
    .pv-pay__alma-text{font-size:11.5px;color:var(--pv-gray);font-weight:500;}
    .pv-pay__alma-info{color:var(--pv-line);flex-shrink:0;}

    /* ---- boutons ---- */
    .pv-btn{position:relative;overflow:hidden;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;gap:10px;border:none;border-radius:999px;cursor:pointer;font-family:inherit;font-size:16px;font-weight:600;padding:15px 30px;min-width:230px;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease,opacity .15s ease;}
    .pv-btn:active{transform:scale(.98);}
    .pv-btn[disabled]{opacity:.5;cursor:not-allowed;}
    .pv-btn--primary{background:var(--pv-navy);color:#fff;box-shadow:0 8px 20px -8px rgba(12,30,74,.55);}
    .pv-btn--primary .btn-fill{background:var(--pv-navy-dark);}
    .pv-btn .btn-fill{position:absolute;inset:0;z-index:-1;transform:translateY(100%);}
    .pv-btn__text{position:relative;display:inline-flex;align-items:center;gap:10px;}
    .pv-btn--ghost{background:transparent;color:var(--pv-navy);border:1.5px solid var(--pv-navy);padding:13px 28px;box-shadow:none;min-width:0;}

    /* ---- bande de confiance ---- */
    .pv-hero__trust{margin-top:26px;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;font-size:13px;color:var(--pv-gray);}
    .pv-strip{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;padding:28px 0;border-top:1px solid var(--pv-line);border-bottom:1px solid var(--pv-line);}
    .pv-strip__item{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;padding:10px 18px;border-radius:999px;background:var(--pv-bg-alt);}
    .pv-strip__item svg{color:var(--pv-navy);flex-shrink:0;}

    /* ---- contenu du pack ---- */
    .pv-contents__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--pv-line);border:1px solid var(--pv-line);border-radius:20px;overflow:hidden;}
    .pv-contents__item{background:#fff;padding:18px 20px;display:flex;gap:14px;align-items:center;}
    .pv-contents__photo{flex-shrink:0;width:56px;height:56px;border-radius:12px;background:var(--pv-bg-alt);overflow:hidden;}
    .pv-contents__photo--icone{display:flex;align-items:center;justify-content:center;color:var(--pv-navy);}
    .pv-contents__photo img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;}
    .pv-contents__qty{flex-shrink:0;width:34px;height:34px;border-radius:50%;background:var(--pv-navy);color:#fff;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;}
    .pv-contents__qty--offert{background:var(--pv-success);}
    .pv-contents__txt{min-width:0;flex:1;}
    .pv-contents__name{font-size:15px;font-weight:600;line-height:1.4;}
    .pv-contents__desc{margin-top:2px;font-size:13.5px;color:var(--pv-gray);line-height:1.5;}
    .psi-total{margin-top:16px;text-align:center;font-size:14px;color:var(--pv-gray);}
    .psi-total strong{color:var(--pv-ink);}

    /* ---- comparatif des centrales ---- */
    .pv-compare__grid{display:grid;grid-template-columns:1fr;gap:14px;max-width:1040px;margin:0 auto;}
    .pv-compare__card{position:relative;display:flex;flex-direction:column;width:100%;text-align:left;cursor:pointer;border:2px solid var(--pv-line);border-radius:20px;padding:24px 22px;background:#fff;font-family:inherit;color:var(--pv-ink);transition:border-color .2s ease,box-shadow .2s ease;}
    .pv-compare__card.is-selected{border-color:var(--pv-navy);box-shadow:0 0 0 3px rgba(12,30,74,.08);}
    .pv-compare__radio{position:absolute;top:24px;right:22px;width:20px;height:20px;border-radius:50%;border:2px solid var(--pv-line);}
    .pv-compare__card.is-selected .pv-compare__radio{border-color:var(--pv-navy);}
    .pv-compare__card.is-selected .pv-compare__radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--pv-navy);}
    .pv-compare__name{display:block;font-size:18px;font-weight:600;margin-bottom:4px;padding-right:32px;}
    .pv-compare__pour{display:block;font-size:13.5px;color:var(--pv-gray);margin-bottom:14px;}
    .pv-compare__card ul{list-style:none;margin:0 0 16px;padding:0;display:grid;gap:9px;}
    .pv-compare__card ul li{display:flex;gap:9px;font-size:14px;line-height:1.5;}
    .pv-compare__card ul li svg{flex-shrink:0;margin-top:3px;color:var(--pv-success);}
    .pv-compare__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px;padding-top:14px;border-top:1px solid var(--pv-line);margin-top:auto;}
    .pv-compare__price strong{font-size:22px;}
    .pv-compare__price s{color:var(--pv-gray);font-size:14px;}
    .pv-compare__note{font-size:13px;line-height:1.5;color:var(--pv-gray);margin:0 0 16px;padding:10px 12px;background:#f3f4f6;border-radius:8px;}
    @media (min-width:700px){.pv-compare__grid{grid-template-columns:1fr 1fr;}}
    @media (min-width:1000px){.pv-compare__grid{grid-template-columns:repeat(4,1fr);}}

    /* ---- encarts de fonctionnalité ---- */
    .pv-feature{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;}
    .pv-feature__media{border-radius:24px;overflow:hidden;background:var(--pv-bg-alt);aspect-ratio:1/1;}
    .pv-feature__media img{width:100%;height:100%;object-fit:cover;}
    .pv-feature__num{font-size:13px;font-weight:700;color:var(--pv-navy);letter-spacing:.08em;margin-bottom:14px;display:block;}
    .pv-feature h2{font-size:clamp(26px,3.4vw,38px);}
    .pv-feature__text{margin-top:18px;color:var(--pv-gray);font-size:17px;line-height:1.6;max-width:480px;}
    .pv-feature ul{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:12px;max-width:480px;}
    .pv-feature ul li{display:flex;gap:10px;font-size:15px;line-height:1.5;}
    .pv-feature ul li svg{flex-shrink:0;margin-top:3px;color:var(--pv-success);}
    .psi-modes{display:inline-flex;gap:4px;margin-top:22px;padding:4px;border-radius:999px;background:var(--pv-bg-alt);}
    .psi-modes span{padding:8px 14px;border-radius:999px;font-size:13px;font-weight:600;color:var(--pv-gray);}
    .psi-modes .is-on{background:var(--pv-navy);color:#fff;}
    .pv-section--alt .psi-modes{background:#fff;}
    @media (min-width:900px){
      .pv-feature{grid-template-columns:1fr 1fr;gap:72px;}
      .pv-feature--reverse .pv-feature__media{order:2;}
      .pv-feature--reverse .pv-feature__body{order:1;}
    }

    /* ---- bande d'appel au milieu ---- */
    .pv-band{background:var(--pv-navy);color:#fff;border-radius:28px;padding:56px 32px;text-align:center;margin:24px 0;}
    .pv-band h2{color:#fff;font-size:clamp(24px,3vw,34px);max-width:620px;margin:0 auto;}
    .pv-band p{color:rgba(255,255,255,.72);margin:14px auto 0;font-size:16px;max-width:520px;}
    .pv-band .pv-btn{margin-top:26px;background:#fff;color:var(--pv-navy);}
    .pv-band .pv-btn .btn-fill{background:#e9e9ee;}
    .pv-band .pv-rating-badge{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.2);color:#fff;}
    .pv-band .pv-rating-badge__count{color:rgba(255,255,255,.7);}

    /* ---- en résumé ---- */
    .pv-specs__grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--pv-line);border:1px solid var(--pv-line);border-radius:20px;overflow:hidden;margin:0;}
    .pv-specs__item{background:#fff;padding:22px 24px;}
    .pv-specs__item dt{font-size:13px;font-weight:700;color:var(--pv-navy);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;}
    .pv-specs__item dd{margin:0;font-size:15px;line-height:1.5;white-space:pre-line;}
    @media (min-width:700px){.pv-specs__grid{grid-template-columns:1fr 1fr;}}
    @media (min-width:1000px){.pv-specs__grid{grid-template-columns:1fr 1fr 1fr;}}

    /* ---- garanties ---- */
    .pv-guarantee{display:grid;grid-template-columns:1fr 1fr;gap:28px 16px;text-align:center;}
    @media (min-width:700px){.pv-guarantee{grid-template-columns:repeat(4,1fr);}}
    .pv-guarantee__item svg{color:var(--pv-navy);margin:0 auto 14px;display:block;}
    .pv-guarantee__item h3{font-size:16px;font-weight:600;}
    .pv-guarantee__item p{margin-top:8px;font-size:14px;color:var(--pv-gray);line-height:1.5;}

    /* ---- avis ---- */
    .pv-reviews__summary{margin-top:14px;display:inline-flex;align-items:center;gap:8px;font-size:14px;color:var(--pv-gray);}
    .pv-reviews__summary strong{color:var(--pv-ink);}
    .pv-reviews__track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 4px 18px;-webkit-overflow-scrolling:touch;}
    .pv-review-card{scroll-snap-align:start;flex-shrink:0;width:min(280px,80vw);background:#fff;border:1px solid var(--pv-line);border-radius:20px;padding:24px;display:flex;flex-direction:column;gap:14px;}
    .pv-review-card__stars{color:#f5a623;font-size:15px;letter-spacing:2px;}
    .pv-review-card__text{font-size:14.5px;line-height:1.6;flex:1;}
    .pv-review-card__text::before{content:"“";}
    .pv-review-card__text::after{content:"”";}
    .pv-review-card__meta{font-size:13px;color:var(--pv-gray);}
    .pv-review-card__meta strong{color:var(--pv-ink);font-weight:600;}
    .pv-reviews__all-btn{margin-top:16px;font-family:inherit;font-size:13.5px;font-weight:600;color:var(--pv-navy);background:none;border:none;text-decoration:underline;text-underline-offset:3px;cursor:pointer;padding:4px;}

    /* ---- modales ---- */
    .pv-modal{border:none;border-radius:24px;padding:0;max-width:420px;width:calc(100% - 40px);box-shadow:0 40px 80px -20px rgba(0,0,0,.35);color:var(--pv-ink);}
    .pv-modal::backdrop{background:rgba(8,20,48,.55);}
    .pv-modal__inner{position:relative;padding:32px 28px 28px;opacity:0;transform:translateY(16px) scale(.97);transition:opacity .28s ease,transform .28s cubic-bezier(.16,1,.3,1);}
    .pv-modal.is-open .pv-modal__inner{opacity:1;transform:none;}
    .pv-modal__close{position:absolute;top:16px;right:16px;width:32px;height:32px;border:none;border-radius:50%;background:var(--pv-bg-alt);color:var(--pv-ink);cursor:pointer;display:flex;align-items:center;justify-content:center;}
    .pv-alma-badge-lg{display:block;height:30px;width:auto;margin-bottom:10px;}
    .pv-modal h3{font-size:21px;}
    .pv-modal__inner > p{margin-top:8px;color:var(--pv-gray);font-size:14px;line-height:1.5;}
    .pv-alma-plans{margin-top:22px;display:grid;gap:10px;}
    .pv-alma-plan{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border:1px solid var(--pv-line);border-radius:14px;}
    .pv-alma-plan__title{font-size:14px;font-weight:600;}
    .pv-alma-plan__note{font-size:12px;color:var(--pv-gray);margin-top:2px;}
    .pv-alma-plan__amount{font-size:15px;font-weight:700;white-space:nowrap;}
    .pv-modal__legal{margin-top:20px;font-size:12px;color:var(--pv-gray);line-height:1.5;}
    .pv-modal--reviews .pv-modal__inner{max-height:min(640px,80vh);display:flex;flex-direction:column;}
    .pv-all-reviews{margin-top:16px;overflow-y:auto;display:flex;flex-direction:column;gap:16px;padding-right:4px;}
    .pv-all-review{border-bottom:1px solid var(--pv-line);padding-bottom:16px;}
    .pv-all-review__stars{color:#f5a623;font-size:13px;letter-spacing:1px;}
    .pv-all-review__text{margin-top:6px;font-size:13.5px;line-height:1.55;}
    .pv-all-review__meta{margin-top:6px;font-size:12px;color:var(--pv-gray);}

    /* ---- faq ---- */
    .pv-faq{max-width:760px;margin:0 auto;}
    .pv-faq h2{text-align:center;font-size:clamp(26px,3.4vw,38px);margin-bottom:32px;}
    .pv-faq details{border-bottom:1px solid var(--pv-line);padding:18px 0;}
    .pv-faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:17px;font-weight:500;}
    .pv-faq summary::-webkit-details-marker{display:none;}
    .pv-faq__icon{flex-shrink:0;transition:transform .25s ease;color:var(--pv-navy);}
    .pv-faq details[open] .pv-faq__icon{transform:rotate(45deg);}
    .pv-faq__a{margin-top:12px;color:var(--pv-gray);font-size:15px;line-height:1.6;}

    /* ---- rendez-vous + appel final ---- */
    .pv-appt{display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px;max-width:620px;margin:0 auto;padding:32px 24px;border-radius:24px;background:var(--pv-bg-alt);border:1px solid var(--pv-line);}
    .pv-appt__eyebrow{font-size:13px;font-weight:600;color:var(--pv-success);margin-bottom:6px;}
    .pv-appt h3{font-size:clamp(19px,2.4vw,23px);}
    .pv-appt__sub{margin-top:8px;color:var(--pv-gray);font-size:14.5px;line-height:1.55;}
    @media (min-width:700px){.pv-appt{flex-direction:row;text-align:left;justify-content:space-between;gap:28px;max-width:820px;}}
    .pv-final{text-align:center;}
    .pv-final h2{font-size:clamp(28px,4vw,44px);max-width:700px;margin:0 auto;}
    .pv-final p{margin-top:16px;color:var(--pv-gray);font-size:17px;}
    .pv-final__ctas{margin-top:28px;display:flex;justify-content:center;}
    .pv-final__legal{margin-top:22px;font-size:13px;color:var(--pv-gray);}

    /* ---- barre d'achat collante ---- */
    .pv-sticky{position:fixed;left:0;right:0;bottom:0;z-index:60;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:rgba(255,255,255,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:1px solid var(--pv-line);transform:translateY(110%);transition:transform .35s ease;}
    .pv-sticky.is-shown{transform:none;}
    .pv-sticky__info{display:flex;align-items:center;gap:10px;min-width:0;}
    .pv-sticky__thumb{width:40px;height:40px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--pv-bg-alt);}
    .pv-sticky__thumb img{width:100%;height:100%;object-fit:cover;}
    .pv-sticky__text{min-width:0;}
    .pv-sticky__name{font-size:13px;font-weight:600;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .pv-sticky__price{font-size:13px;color:var(--pv-gray);}
    .pv-sticky__price strong{color:var(--pv-ink);}

    /* ---- apparition au défilement ---- */
    .pv-reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
    .pv-reveal.is-visible{opacity:1;transform:none;}
    .pv-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}

    /* ==== Mobile d'abord : tout ce qui suit resserre la page sous 700 px ==== */
    @media (max-width:699px){
      .pv .pv-wrap{padding:0 16px;}
      .pv .pv-bread{padding-top:12px;}
      .pv-bread{font-size:11.5px;}
      .pv-bread li:first-child,.pv-bread li:nth-child(2)::before{display:none;}
      .pv-section{padding:48px 0;}
      .pv-head{margin-bottom:28px;}
      .pv-head p{font-size:16px;}
      .pv-hero{padding:20px 0 40px;}
      .pv-hero h1{font-size:32px;}
      .pv .pv-hero__tagline{font-size:18px;margin-top:10px;}
      .pv-hero__media{margin-top:22px;}
      .pv-hero__img{border-radius:20px;}
      .psi-remise{top:12px;left:12px;font-size:14px;padding:7px 12px;}
      .psi-compte{flex-wrap:nowrap;gap:8px;padding:7px 12px;font-size:12px;margin-bottom:14px;text-align:left;}
      .psi-compte__point{flex-shrink:0;}
      .pv .pv-hero__summary{display:none;}
      .pv-hero__img{aspect-ratio:4/3;}
      .pv-hero__img img{object-fit:contain;}
      .pv-thumbs{justify-content:flex-start;}
      .pv-thumbs__item{width:48px;height:48px;}
      .pv-strip{display:grid;grid-template-columns:1fr 1fr;}
      .pv-strip__item{justify-content:center;text-align:center;font-size:12.5px;padding:8px 10px;}
      .psi-choix{margin-top:22px;}
      .pv-hero__cta{margin-top:18px;}
      .pv-hero__cta .pv-btn,.pv-final .pv-btn,.pv-band .pv-btn{width:100%;min-width:0;}
      .pv .pv-hero__sub{font-size:16px;margin-top:22px;}
      .pv-hero__trust{display:none;}
      .pv-strip{gap:8px;padding:18px 0;border:0;}
      .pv-strip__item{font-size:13px;padding:8px 14px;}
      .pv-contents__item{padding:14px 16px;}
      .pv-contents__photo{width:48px;height:48px;}
      .pv-compare__card{padding:18px 16px;}
      .pv-compare__note{display:none;}
      .pv-compare__card ul{gap:6px;margin-bottom:12px;}
      .pv-feature{gap:22px;}
      .pv-feature__media{border-radius:20px;}
      .pv-feature__text{font-size:16px;margin-top:14px;}
      .pv-band{padding:36px 20px;border-radius:22px;margin:0;}
      .pv-specs__item{padding:18px 20px;}
      .pv-faq summary{font-size:16px;}
      .pv-sticky .pv-btn{min-width:0;padding:12px 16px;font-size:14.5px;white-space:nowrap;flex-shrink:0;}
    }
    @media (prefers-reduced-motion:reduce){
      .pv-reveal{opacity:1;transform:none;transition:none;}
      .pv-sticky{transition:none;}
    }
    /* ---- bandeau carte SIM ---- */
    .psi-sim{margin-top:40px;display:grid;grid-template-columns:1fr;gap:20px;align-items:center;background:#fff;border:1px solid var(--pv-line);border-radius:20px;padding:24px;}
    .psi-sim__tag{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--pv-navy);background:var(--pv-bg-alt);border-radius:999px;padding:4px 10px;margin-bottom:10px;}
    .psi-sim__intro h3{margin:0 0 8px;font-size:20px;line-height:1.25;color:var(--pv-ink);}
    .psi-sim__intro p{font-size:14px;line-height:1.5;color:var(--pv-gray);}
    .psi-sim__offres{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .psi-sim__offre{position:relative;display:flex;flex-direction:column;gap:4px;border:1.5px solid var(--pv-line);border-radius:16px;padding:16px;}
    .psi-sim__offre--top{border-color:var(--pv-navy);}
    .psi-sim__reco{position:absolute;top:-10px;left:12px;font-size:11px;font-weight:700;color:#fff;background:var(--pv-navy);padding:3px 8px;border-radius:999px;}
    .psi-sim__nom{font-size:16px;font-weight:700;color:var(--pv-ink);}
    .psi-sim__detail{font-size:13px;line-height:1.4;color:var(--pv-gray);flex-grow:1;}
    .psi-sim__prix{font-size:22px;font-weight:700;color:var(--pv-navy);margin:6px 0 10px;}
    .psi-sim__btn{font-family:inherit;font-size:15px;font-weight:600;border-radius:999px;padding:11px 16px;cursor:pointer;background:transparent;color:var(--pv-navy);border:1.5px solid var(--pv-navy);transition:opacity .15s ease;}
    .psi-sim__btn[aria-busy="true"],.psi-sim__btn:disabled{opacity:.55;cursor:default;}
    @media (min-width:900px){.psi-sim{grid-template-columns:1fr 1.1fr;gap:32px;padding:32px;}}
    @media (max-width:699px){.psi-sim{margin-top:28px;padding:20px 16px;}.psi-sim__offre{padding:14px 12px;}.psi-sim__intro h3{font-size:18px;}}
  </style>

  {%- comment -%} Formulaire produit caché, partagé par tous les boutons « Ajouter au panier » {%- endcomment -%}
  {%- if p0 != blank -%}
    {%- form 'product', p0, id: form_id, data-type: 'add-to-cart-form', is: 'product-form', class: 'pv-visually-hidden' -%}
      <input type="hidden" name="id" value="{{ v0.id }}" id="PVVariantId-{{ section.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" name="add" tabindex="-1" aria-hidden="true"></button>
      <div class="product-form__error-message alert alert--error" role="alert" hidden style="position:fixed;left:16px;right:16px;bottom:84px;z-index:70;background:#fff;border:1px solid #e11d48;color:#e11d48;padding:12px 16px;border-radius:12px;font-size:14px;"></div>
    {%- endform -%}
  {%- endif -%}

  {%- comment -%} Barre d'achat collante {%- endcomment -%}
  <div class="pv-sticky" id="PVSticky-{{ section.id }}">
    <div class="pv-sticky__info">
      <div class="pv-sticky__thumb">
        {%- if p0.featured_image -%}{{ p0.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', data-psi-thumb: '', alt: '' }}{%- endif -%}
      </div>
      <div class="pv-sticky__text">
        <div class="pv-sticky__name" data-psi-nom>{{ c0.settings.title }}</div>
        <div class="pv-sticky__price"><strong class="pv-price-amount">{{ v0.price | money }}</strong></div>
      </div>
    </div>
    {%- render 'pv-atc-button', form_id: form_id, variant: v0, label: 'Ajouter au panier', style: 'primary', show_price: false -%}
  </div>

  {%- comment -%} ============ Hero ============ {%- endcomment -%}
  <section class="pv-hero">
    <div class="pv-wrap">
      {%- if section.settings.end_date != blank -%}
        <div class="psi-compte" data-psi-compte data-fin="{{ section.settings.end_date | escape }}">
          <span class="psi-compte__point" aria-hidden="true"></span>
          <span data-psi-encours>Offre spéciale · se termine dans <span class="psi-compte__temps" data-psi-temps>—</span></span>
          <span data-psi-fini hidden>Cette offre est terminée</span>
        </div>
      {%- endif -%}
      <h1>{{ section.settings.title }}{% if section.settings.tagline != blank %} <span class="pv-hero__tagline">{{ section.settings.tagline }}</span>{% endif %}</h1>
      <p class="pv-hero__summary">{{ section.settings.summary }}</p>

      {%- comment -%} Photos du pack choisi {%- endcomment -%}
      {%- for block in centrales -%}
        {%- liquid
          assign p = block.settings.product
          assign galerie = p.images
          assign ref = 0
          if block.settings.ref_value != blank
            assign ref = block.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
          endif
          assign eco = ref | minus: p.price
          assign pct = 0
          if eco > 0
            assign pct = eco | times: 100.0 | divided_by: ref | floor
          endif
        -%}
        <div class="pv-hero__media" data-psi-idx="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
          <div class="pv-hero__img">
            {%- if pct > 0 -%}<span class="psi-remise">-{{ pct }}&nbsp;%</span>{%- endif -%}
            {%- if p.featured_image -%}
              {%- assign chargement = 'lazy' -%}
              {%- if forloop.first -%}{%- assign chargement = 'eager' -%}{%- endif -%}
              {{ p.featured_image | image_url: width: 1200 | image_tag: loading: chargement, widths: '400,600,900,1200', sizes: '(min-width: 700px) 640px, 100vw', data-psi-hero: '', alt: block.settings.title }}
            {%- endif -%}
          </div>
          {%- if galerie.size > 1 -%}
            <div class="pv-thumbs" role="group" aria-label="Photos du {{ block.settings.title | escape }}">
              {%- for img in galerie limit: 6 -%}
                <button type="button" class="pv-thumbs__item{% if forloop.first %} is-active{% endif %}" data-pv-thumb
                  data-full="{{ img | image_url: width: 1200 }}"
                  data-full-srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
                  aria-label="Photo {{ forloop.index }} sur {{ galerie.size | at_most: 6 }}">
                  {%- assign alt_img = img.alt | default: block.settings.title -%}
                  {{ img | image_url: width: 120 | image_tag: loading: 'lazy', alt: alt_img }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%} Choix de la centrale : 2 × 2 sur mobile {%- endcomment -%}
      <div class="psi-choix" role="group" aria-labelledby="PSIChoix-{{ section.id }}">
        <p class="psi-choix__titre" id="PSIChoix-{{ section.id }}">Choisissez votre centrale</p>
        <div class="psi-choix__grille">
          {%- for block in centrales -%}
            <button type="button" class="psi-carte{% if forloop.first %} is-selected{% endif %}" data-pv-connectivity="{{ block.settings.slug }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              <span class="psi-carte__radio" aria-hidden="true"></span>
              {%- if block.settings.badge != blank -%}<span class="psi-carte__badge">{{ block.settings.badge }}</span>{%- endif -%}
              <span class="psi-carte__nom">{{ block.settings.tab_label }}</span>
              <span class="psi-carte__sous">{{ block.settings.tab_sub }}</span>
              <span class="psi-carte__prix">{{ block.settings.product.price | money }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="pv-hero__cta">
        <div id="PVHeroCta-{{ section.id }}" style="width:100%;display:flex;justify-content:center;">
          {%- render 'pv-atc-button', form_id: form_id, variant: v0, label: 'Ajouter au panier', style: 'primary', show_price: true -%}
        </div>
        {%- liquid
          assign ref0 = 0
          if c0.settings.ref_value != blank
            assign ref0 = c0.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
          endif
          assign eco0 = ref0 | minus: v0.price
        -%}
        <div class="pv-hero__price">
          <span class="pv-price-compare{% if eco0 > 0 %} is-visible{% endif %}" data-psi-barre>{{ ref0 | money }}</span>
          <strong class="pv-price-amount">{{ v0.price | money }}</strong> · 0&nbsp;€ d'abonnement
        </div>
        <span class="psi-eco" data-psi-eco {% unless eco0 > 0 %}hidden{% endunless %}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
          Vous économisez <span data-psi-saving>{{ eco0 | money }}</span>
        </span>
        {%- render 'pv-trust-row', has_rating: has_rating, rating_value: rating_value, rating_max: rating_max, rating_count: rating_count, rating_pct: rating_pct, reviews_anchor: reviews_anchor -%}
      </div>

      <p class="pv-hero__sub">{{ section.settings.sub }}</p>
      <div class="pv-hero__trust">
        <span>🔒 Sans abonnement</span>
        <span>📷 2 caméras incluses</span>
        <span>☀️ Sirène solaire extérieure</span>
        <span>🧩 Évolutif</span>
      </div>
    </div>
  </section>

  {%- comment -%} Bande de confiance {%- endcomment -%}
  <div class="pv-wrap">
    <div class="pv-strip pv-reveal">
      {%- assign coches = "Installation sans technicien|Sans abonnement, à vie|Expédié sous 24 h|Garantie 2 ans" | split: '|' -%}
      {%- for c in coches -%}
        <div class="pv-strip__item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>{{ c }}</div>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ============ Contenu du pack ============ {%- endcomment -%}
  <section class="pv-section">
    <div class="pv-wrap">
      <div class="pv-head pv-reveal">
        <h2>Tout ce qu'il faut, dans une seule boîte</h2>
        <p>Le même équipement complet, quelle que soit la centrale choisie&nbsp;: intérieur, extérieur, jour et nuit.</p>
      </div>
      <div class="pv-contents__grid pv-reveal">
        {%- for block in centrales -%}
          {%- assign photo = block.settings.centrale_image | default: block.settings.centrale_product.featured_image -%}
          <div class="pv-contents__item" data-psi-idx="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
            <span class="pv-contents__qty">1×</span>
            {%- if photo -%}<span class="pv-contents__photo">{{ photo | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
            <div class="pv-contents__txt">
              <div class="pv-contents__name">{{ block.settings.centrale_name }}</div>
              <div class="pv-contents__desc">{{ block.settings.centrale_note }}</div>
            </div>
          </div>
        {%- endfor -%}
        {%- liquid
          capture elements
            echo "4|Contacteurs d'ouverture et de vibration WDV301|2-en-1, pour portes, fenêtres et surfaces vitrées|contacteur-2-en-1-porte-et-vibrations-compatible-avec-lalarme-am301-am302|"
            echo "~1|Détecteur de mouvement WPS305|Compatible animaux jusqu'à 10 kg|detecteur-de-mouvement-animaux-compatible-touch-vigilia-am30x|"
            echo "~1|Télécommande WRC305|Armement et désarmement en un geste|telecommande-compatible-vigilia-touch|"
            echo "~2|Badges RFID WRF301|Inclus avec la Vigilia : on passe le badge devant la centrale, elle se désarme sans code. Idéal pour les enfants|pack-de-2-badges-rfid-wrf301|rfid"
            echo "~1|Caméra intérieure IP506P|Rotative, Full HD, mode vie privée|camera-interieure-rotative-ip506p|"
            echo "~1|Caméra extérieure solaire W512MW|Rotative, 1440p, panneau solaire inclus|camera-w512mw-exterieure-rotative-1440p-avec-panneau-solaire|"
            echo "~1|Sirène extérieure solaire WOS305S|Dissuasive, rechargée par le soleil, sans câble|sirene-exterieure-wos305s-sirene-avec-batterie-de-secours-et-panneau-solaire|"
            echo "~2|Autocollants « Maison sous surveillance »|Dissuasion dès l'entrée|autocollants-propriete-sous-video-surveillance-x10|"
          endcapture
          assign lignes = elements | split: '~'
        -%}
        {%- for ligne in lignes -%}
          {%- assign c = ligne | split: '|' -%}
          {%- assign photo = all_products[c[3]].featured_image -%}
          {%- if c[3] == 'autocollants-propriete-sous-video-surveillance-x10' -%}
            {%- comment -%} Le produit Shopify est un lot de 10 : on n'affiche que la photo des 2 autocollants du pack {%- endcomment -%}
            {%- assign photo = section.settings.stickers_image -%}
          {%- endif -%}
          <div class="pv-contents__item"{% if c[4] == 'rfid' %} data-psi-rfid{% unless c0.settings.has_rfid %} hidden{% endunless %}{% endif %}>
            <span class="pv-contents__qty{% if c[4] == 'rfid' %} pv-contents__qty--offert{% endif %}">{{ c[0] }}×</span>
