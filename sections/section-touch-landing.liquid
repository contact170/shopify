{{ 'touch-landing.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Section : Pack Touch AM301 — Landing page complète
  Charge le CSS dédié dans le <head> via le template page.touch.liquid
{%- liquid
  # Le prix du pack etait repete en dur a cinq endroits de cette page,
  # barre de navigation et FAQ comprises.
  assign p_pack = all_products['offre-exclusive-pack-touch-compatible-animaux-sans-abonnement']
  assign prix_pack = '499,90 €'
  # Le prix barre etait fige a 699,90 EUR alors que la fiche en porte un
  # autre : deux pages annoncaient des remises differentes pour le meme
  # pack. Il vient de la fiche, et disparait si l'offre se termine.
  assign prix_pack_barre = ''
  if p_pack != blank
    assign prix_pack = p_pack.price | money
    if p_pack.compare_at_price > p_pack.price
      assign prix_pack_barre = p_pack.compare_at_price | money
    endif
  endif
-%}

{%- endcomment -%}



