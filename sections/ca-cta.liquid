{% comment %} ── CTA final — configurateur / contact ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .cak * { box-sizing:border-box; margin:0; padding:0; }
  .cak { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#fff; color:#0b1220; padding:20px 24px 96px; }
  .cak-inner { max-width:1100px; margin:0 auto; }
  .cak-box { position:relative; overflow:hidden; background:#0b1220; border-radius:24px; padding:64px 40px 60px; text-align:center; }
  .cak-box::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(600px 300px at 15% 0%,rgba(224,145,43,.22),transparent 62%),
               radial-gradient(600px 300px at 85% 0%,rgba(18,160,173,.22),transparent 62%),
               radial-gradient(600px 320px at 50% 120%,rgba(47,111,224,.20),transparent 62%); }
  .cak-c { position:relative; z-index:2; max-width:660px; margin:0 auto; }
  .cak-eyebrow { display:inline-block; font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase;
    color:#8f9dad; margin-bottom:16px; }
  .cak-title { font-size:clamp(26px,3.6vw,40px); font-weight:600; letter-spacing:-.035em; line-height:1.14; color:#fff; margin-bottom:16px; }
  .cak-sub { font-size:15.5px; color:#b3bdc9; font-weight:300; line-height:1.7; margin-bottom:32px; }
  .cak-sub b { color:#fff; font-weight:500; }
  .cak-btns { display:flex; flex-wrap:wrap; gap:12px; justify-content:center; margin-bottom:34px; }
  .cak-b { display:inline-flex; align-items:center; gap:9px; padding:15px 28px; border-radius:9px;
    font-size:14px; font-weight:600; text-decoration:none; transition:transform .18s; }
  .cak-b:hover { transform:translateY(-2px); }
  .cak-b--1 { background:#fff; color:#0b1220; }
  .cak-b--2 { background:transparent; color:#fff; border:1px solid rgba(255,255,255,.28); }
  .cak-b svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  .cak-mini { display:flex; flex-wrap:wrap; gap:10px 26px; justify-content:center; }
  .cak-mini span { display:inline-flex; align-items:center; gap:8px; font-size:13px; color:#b3bdc9; font-weight:300; }
  .cak-mini svg { width:15px; height:15px; fill:none; stroke:#5ad1a5; stroke-width:2.8; stroke-linecap:round; stroke-linejoin:round; }

  @media (max-width:600px) { .cak { padding:10px 20px 76px; } .cak-box { padding:48px 22px 46px; border-radius:20px; } }
</style>

<section class="cak">
  <div class="cak-inner">
    <div class="cak-box">
      <div class="cak-c">
        <span class="cak-eyebrow">Toujours hésitant&nbsp;?</span>
        <h2 class="cak-title">Laissez-nous composer votre système.</h2>
        <p class="cak-sub">Sept questions sur votre logement et vos habitudes, et le configurateur choisit la gamme, la centrale et le nombre de détecteurs — avec <b>jusqu’à 25&nbsp;% de remise</b> sur l’ensemble. Vous restez libre d’ajuster avant de valider.</p>
        <div class="cak-btns">
          <a class="cak-b cak-b--1" href="/pages/configurateur_2">Configurer mon système
            <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
          <a class="cak-b cak-b--2" href="/pages/nous-contacter">Poser une question
            <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
        <div class="cak-mini">
          <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Sans abonnement</span>
          <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Garantie 2 ans</span>
          <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Retour gratuit</span>
          <span><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>SAV en France</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Choisir — CTA",
  "settings": []
}
{% endschema %}
