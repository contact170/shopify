{% comment %} ── Touch vs Touch XL : confrontation des 2 centrales + tableau comparatif ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .tcd * { box-sizing:border-box; margin:0; padding:0; }
  .tcd { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#eef2f8; color:#0b1220; padding:92px 24px 96px; position:relative; }
  .tcd-inner { position:relative; z-index:2; max-width:1200px; margin:0 auto; }
  .tcd-head { text-align:center; margin-bottom:52px; }
  .tcd-eyebrow { display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:600;
    letter-spacing:.2em; text-transform:uppercase; color:#5a6982; margin-bottom:18px; }
  .tcd-eyebrow::before,.tcd-eyebrow::after { content:''; width:30px; height:1px; background:#c6d0e0; }
  .tcd-title { font-size:clamp(28px,3.8vw,44px); font-weight:600; line-height:1.1; letter-spacing:-.03em;
    color:#0b1220; margin-bottom:16px; }
  .tcd-sub { font-size:16px; color:#4a5a75; font-weight:300; max-width:600px; margin:0 auto; line-height:1.6; }

  /* ── les 2 panneaux ── */
  .tcd-versus { display:grid; grid-template-columns:1fr auto 1fr; gap:0; align-items:stretch; }
  .tcd-card { padding:0 0 34px; border:1px solid #dfe5ef; background:#fff; position:relative; overflow:hidden;
    box-shadow:0 18px 44px -26px rgba(11,18,32,.30); }
  .tcd-card--l, .tcd-card--r { border-radius:22px; }
  .tcd-band { height:4px; border-radius:22px 22px 0 0; }
  .tcd-card--l .tcd-band { background:linear-gradient(90deg,#1c5fd0,#7cb2ff); }
  .tcd-card--r .tcd-band { background:linear-gradient(90deg,#c9860f,#f3c169); }
  .tcd-pad { padding:32px 34px 0; }
  .tcd-ref { display:inline-block; font-size:10.5px; font-weight:700; letter-spacing:.18em; text-transform:uppercase;
    padding:6px 12px; border-radius:6px; margin-bottom:16px; }
  .tcd-card--l .tcd-ref { color:#1c5fd0; background:rgba(47,123,255,.10); }
  .tcd-card--r .tcd-ref { color:#8f5d0c; background:rgba(232,160,44,.14); }
  .tcd-name { font-size:29px; font-weight:600; color:#0b1220; letter-spacing:-.025em; line-height:1.15; margin-bottom:8px; }
  .tcd-for { font-size:14px; color:#5a6982; font-weight:300; margin-bottom:24px; }
  .tcd-shot { border-radius:16px; overflow:hidden; border:1px solid #e6ebf3; margin-bottom:26px; }
  .tcd-card--l .tcd-shot { background:#f4f7fc; } .tcd-card--r .tcd-shot { background:#fbf7ef; }
  .tcd-shot img { width:100%; height:270px; object-fit:cover; display:block; }
  .tcd-screen { display:flex; align-items:baseline; gap:9px; margin-bottom:22px; padding-bottom:22px; border-bottom:1px solid #eef1f7; }
  .tcd-screen b { font-size:42px; font-weight:600; letter-spacing:-.04em; line-height:1; }
  .tcd-card--l .tcd-screen b { color:#1c5fd0; } .tcd-card--r .tcd-screen b { color:#8f5d0c; }
  .tcd-screen span { font-size:13px; color:#5a6982; font-weight:300; }
  .tcd-keys { display:flex; flex-direction:column; gap:13px; margin-bottom:28px; }
  .tcd-key { display:flex; gap:11px; align-items:flex-start; font-size:14px; color:#4a5a75; font-weight:300; line-height:1.45; }
  .tcd-key b { font-weight:600; color:#0b1220; }
  .tcd-key svg { width:16px; height:16px; flex:none; margin-top:3px; fill:none; stroke-width:2.4; stroke-linecap:round; stroke-linejoin:round; }
  .tcd-card--l .tcd-key svg { stroke:#2f7bff; } .tcd-card--r .tcd-key svg { stroke:#d9931f; }
  .tcd-foot { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  .tcd-price { font-size:13px; color:#5a6982; font-weight:300; }
  .tcd-price b { display:block; font-size:26px; font-weight:600; color:#0b1220; letter-spacing:-.02em; }
  .tcd-buy { display:inline-flex; align-items:center; gap:8px; padding:13px 22px; border-radius:10px;
    font-size:13.5px; font-weight:600; text-decoration:none; transition:transform .18s, box-shadow .18s; }
  .tcd-buy:hover { transform:translateY(-2px); }
  .tcd-card--l .tcd-buy { background:#1c5fd0; color:#fff; box-shadow:0 10px 24px -8px rgba(28,95,208,.55); }
  .tcd-card--r .tcd-buy { background:#0b1220; color:#fff; box-shadow:0 10px 24px -8px rgba(11,18,32,.5); }

  .tcd-vs { display:flex; align-items:center; justify-content:center; padding:0 6px; }
  .tcd-vs span { width:56px; height:56px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    background:#fff; border:1px solid #dfe5ef; box-shadow:0 6px 18px -6px rgba(11,18,32,.22);
    font-size:12px; font-weight:700; letter-spacing:.1em; color:#5a6982; }

  /* ── tableau comparatif ── */
  .tct { background:#fff; padding:92px 24px; font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; }
  .tct * { box-sizing:border-box; margin:0; padding:0; }
  .tct-inner { max-width:1000px; margin:0 auto; }
  .tct-eyebrow { font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:#5a6982; margin-bottom:14px; }
  .tct-title { font-size:clamp(25px,3.2vw,36px); font-weight:600; color:#0b1220; letter-spacing:-.03em; line-height:1.15; margin-bottom:12px; }
  .tct-sub { font-size:15.5px; color:#4a5a75; font-weight:300; line-height:1.6; margin-bottom:38px; max-width:620px; }
  .tct-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:16px; border:1px solid #dfe5ef; background:#fff; }
  .tct-table { width:100%; border-collapse:collapse; min-width:640px; }
  .tct-table th, .tct-table td { padding:17px 20px; text-align:left; border-bottom:1px solid #eef1f7; font-size:14.5px; }
  .tct-table thead th { position:sticky; top:0; background:#fff; padding-top:24px; padding-bottom:20px; border-bottom:2px solid #e4e9f2; }
  .tct-th-label { font-size:11px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:#626f86; }
  .tct-th-model { display:block; font-size:17px; font-weight:600; color:#0b1220; letter-spacing:-.02em; margin-top:5px; }
  .tct-th-model small { display:block; font-size:12px; font-weight:400; color:#626f86; margin-top:3px; letter-spacing:0; }
  .tct-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:8px; vertical-align:middle; }
  .tct-dot--b { background:#2f7bff; } .tct-dot--g { background:#e8a02c; }
  .tct-table tbody th { font-weight:500; color:#4a5a75; width:34%; background:#fafbfd; }
  .tct-table td { color:#0b1220; font-weight:500; }
  .tct-table tr:last-child th, .tct-table tr:last-child td { border-bottom:0; }
  .tct-win { display:inline-flex; align-items:center; gap:7px; }
  .tct-win svg { width:15px; height:15px; fill:none; stroke:#0f9d63; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
  .tct-no { color:#626f86; font-weight:400; }
  .tct-badge { display:inline-block; font-size:10.5px; font-weight:600; letter-spacing:.06em; text-transform:uppercase;
    padding:3px 8px; border-radius:5px; margin-left:8px; background:rgba(232,160,44,.14); color:#8f5d0c; }
  .tct-hint { font-size:12.5px; color:#626f86; font-weight:300; margin-top:16px; }

  @media (max-width:900px) {
    .tcd-versus { grid-template-columns:1fr; }
    .tcd-vs { padding:14px 0; position:relative; }
    .tcd { padding:72px 20px 76px; }
    .tct { padding:72px 20px; }
    .tcd-pad { padding:28px 24px 0; }
  }
</style>

<section class="tcd" id="tc-duel">
  <div class="tcd-inner">
    <div class="tcd-head">
      <span class="tcd-eyebrow">Touch ou Touch XL</span>
      <h2 class="tcd-title">Deux centrales.<br>Une seule différence qui compte&nbsp;: l'écran.</h2>
      <p class="tcd-sub">Même technologie, mêmes accessoires, même application. Ce qui change, c'est la taille de l'écran, la puissance de la sirène et l'autonomie de la batterie de secours.</p>
    </div>

    <div class="tcd-versus">
      <!-- TOUCH AM301 -->
      <div class="tcd-card tcd-card--l">
        <div class="tcd-band"></div>
        <div class="tcd-pad">
          <span class="tcd-ref">AM301 · Touch</span>
          <h3 class="tcd-name">Centrale Touch</h3>
          <p class="tcd-for">Appartement, maison de plain-pied, résidence secondaire</p>
          <div class="tcd-shot">
            <img src="https://cdn.shopify.com/s/files/1/0326/3132/4811/files/8734bc42-ff99-47e9-97d1-34e38b0a4397.jpg?v=1770108612" alt="Centrale d'alarme Daewoo Touch AM301 écran tactile 4,3 pouces" loading="lazy" width="700" height="540">
          </div>
          <div class="tcd-screen"><b>4,3''</b><span>écran tactile couleur</span></div>
          <div class="tcd-keys">
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Sirène intégrée <b>95 dB</b></span></div>
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Batterie de secours <b>≈ 4 heures</b></span></div>
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Wi-Fi 2,4 GHz + <b>GSM 4G en option</b></span></div>
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Format compact, <b>discret dans l'entrée</b></span></div>
          </div>
          <div class="tcd-foot">
            <span class="tcd-price">Pack de départ<b>199,90 €</b></span>
            <a class="tcd-buy" href="https://daewoo-security.fr/products/alarme-daewoo-wifi-gsm-4g-starter-pack-am301?variant=51276200051028">Choisir la Touch →</a>
          </div>
        </div>
      </div>

      <div class="tcd-vs"><span>VS</span></div>

      <!-- TOUCH XL AM302 -->
      <div class="tcd-card tcd-card--r">
        <div class="tcd-band"></div>
        <div class="tcd-pad">
          <span class="tcd-ref">AM302 · Touch XL</span>
          <h3 class="tcd-name">Centrale Touch XL</h3>
          <p class="tcd-for">Grande maison, pavillon sur plusieurs niveaux, villa</p>
          <div class="tcd-shot">
            <img src="https://cdn.shopify.com/s/files/1/0326/3132/4811/files/a294d81e-81d9-4c35-b5a6-9a58f34e5402.jpg?v=1770108612" alt="Centrale d'alarme Daewoo Touch XL AM302 écran tactile 7 pouces" loading="lazy" width="700" height="540">
          </div>
          <div class="tcd-screen"><b>7''</b><span>écran tactile couleur</span></div>
          <div class="tcd-keys">
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Sirène intégrée <b>100 dB</b></span></div>
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Batterie de secours <b>≈ 20 heures</b></span></div>
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Wi-Fi 2,4 GHz + <b>GSM 4G en option</b></span></div>
            <div class="tcd-key"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg><span>Grand écran&nbsp;: <b>lecture immédiate des zones</b></span></div>
          </div>
          <div class="tcd-foot">
            <span class="tcd-price">Pack de départ<b>299,90 €</b></span>
            <a class="tcd-buy" href="https://daewoo-security.fr/products/alarme-daewoo-wifi-gsm-4g-starter-pack-am301?variant=51276200083796">Choisir la Touch XL →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="tct">
  <div class="tct-inner">
    <p class="tct-eyebrow">Comparatif détaillé</p>
    <h2 class="tct-title">Ligne par ligne, ce qui sépare la Touch de la Touch XL</h2>
    <p class="tct-sub">Les deux centrales partagent la même plateforme radio, la même application et les mêmes accessoires. Voici les seuls points sur lesquels elles diffèrent réellement — et tout ce qu'elles ont en commun.</p>

    <div class="tct-scroll">
      <table class="tct-table">
        <thead>
          <tr>
            <th><span class="tct-th-label">Caractéristique</span></th>
            <th><span class="tct-th-label"><span class="tct-dot tct-dot--b"></span>AM301</span><span class="tct-th-model">Touch<small>À partir de 199,90 €</small></span></th>
            <th><span class="tct-th-label"><span class="tct-dot tct-dot--g"></span>AM302</span><span class="tct-th-model">Touch XL<small>À partir de 299,90 €</small></span></th>
          </tr>
        </thead>
        <tbody>
          <tr><th>Écran tactile couleur</th><td>4,3 pouces</td><td>7 pouces <span class="tct-badge">+2,7'' de diagonale</span></td></tr>
          <tr><th>Sirène intégrée</th><td>95 dB</td><td>100 dB</td></tr>
          <tr><th>Batterie de secours</th><td>≈ 4 heures</td><td>≈ 20 heures</td></tr>
          <tr><th>Connexion Wi-Fi 2,4 GHz</th><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Inclus</span></td><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Inclus</span></td></tr>
          <tr><th>GSM 4G (carte SIM en option)</th><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Disponible</span></td><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Disponible</span></td></tr>
          <tr><th>Alertes SMS en cas de coupure Internet</th><td>Avec carte SIM</td><td>Avec carte SIM</td></tr>
          <tr><th>Clavier &amp; lecteur de badges RFID intégrés</th><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Oui</span></td><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Oui</span></td></tr>
          <tr><th>Nombre d'accessoires maximum</th><td>Jusqu'à 90</td><td>Jusqu'à 90</td></tr>
          <tr><th>Caméras &amp; objets connectés</th><td>Illimité (via l'app)</td><td>Illimité (via l'app)</td></tr>
          <tr><th>Modes Total / Partiel / Désarmé</th><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Oui</span></td><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Oui</span></td></tr>
          <tr><th>Détection d'arrachement</th><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Oui</span></td><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Oui</span></td></tr>
          <tr><th>Alexa &amp; Google Home</th><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Compatible</span></td><td><span class="tct-win"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Compatible</span></td></tr>
          <tr><th>Abonnement obligatoire</th><td class="tct-no">Aucun</td><td class="tct-no">Aucun</td></tr>
        </tbody>
      </table>
    </div>
    <p class="tct-hint">↔ Faites glisser le tableau horizontalement sur mobile. Prix indiqués pour les packs de départ, hors promotions en cours.</p>
  </div>
</section>

