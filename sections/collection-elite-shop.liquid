          <span class="das-zone__count">{{ count_detecteurs_str }}</span>
        </button>
        <button type="button" class="das-zone" data-filter="contacteurs" aria-pressed="false">
          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="10" height="18" rx="1"></rect><circle cx="12" cy="12" r="1"></circle><path d="M15 3l4 2v16l-4-2"></path></svg></span>
          </span>
          <span class="das-zone__label">Contacteurs</span>
          <span class="das-zone__count">{{ count_contacteurs_str }}</span>
        </button>
        <button type="button" class="das-zone" data-filter="sirenes" aria-pressed="false">
          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg></span>
          </span>
          <span class="das-zone__label">Sirènes</span>
          <span class="das-zone__count">{{ count_sirenes_str }}</span>
        </button>
        <button type="button" class="das-zone" data-filter="acces" aria-pressed="false">
          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="15" r="3.2"></circle><path d="M9.3 12.7L18 4"></path><path d="M14.5 8.2l2.3 2.3"></path><path d="M17.2 5.5l2.3 2.3"></path></svg></span>
          </span>
          <span class="das-zone__label">Contrôle d&#8217;accès</span>
          <span class="das-zone__count">{{ count_acces_str }}</span>
        </button>
        <button type="button" class="das-zone" data-filter="amplificateur" aria-pressed="false">
          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"></path><path d="M8.5 20v-6"></path><path d="M15.5 20v-6"></path><path d="M5 20v-3"></path><path d="M19 20v-3"></path><path d="M8.5 8a5 5 0 0 1 7 0"></path><path d="M5.5 5a9 9 0 0 1 13 0"></path></svg></span>
          </span>
          <span class="das-zone__label">Amplificateur</span>
          <span class="das-zone__count">{{ count_amplificateur_str }}</span>
        </button>
        <button type="button" class="das-zone" data-filter="sim" aria-pressed="false">
          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h6l4 4v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"></path><rect x="9.5" y="9" width="5" height="4" rx="1"></rect></svg></span>
          </span>
          <span class="das-zone__label">Cartes SIM</span>
          <span class="das-zone__count">{{ count_sim_str }}</span>
        </button>
        <button type="button" class="das-zone" data-filter="accessoires" aria-pressed="false">
          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8-5.1-4.7 6.9-.8L12 2z"></path></svg></span>
          </span>
          <span class="das-zone__label">Accessoires</span>
          <span class="das-zone__count">{{ count_accessoires_str }}</span>
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Product grid {%- endcomment -%}
  <section class="das-grid-section">
    <div class="das-wrap">
      <div class="das-zignote is-visible" data-zignote>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-5"></path><path d="M12 8h.01"></path></svg>
        <p><strong>Bon à savoir&nbsp;—&nbsp;Zigbee.</strong> Nos accessoires Zigbee sont alimentés par pile (et non sur secteur) : ils communiquent en direct avec la centrale, mais ne relaient pas le signal vers les autres appareils du réseau. Pas de fonctionnement en maillage (mesh).</p>
      </div>
      <p class="das-count" aria-live="polite"><strong data-visible-count>{{ total_count }}</strong> accessoire{{ total_count | pluralize: '', 's' }} affiché{{ total_count | pluralize: '', 's' }}</p>
      <div class="das-grid">
        {%- for product in collection.products -%}
          {%- if excluded_handles contains product.handle -%}{%- continue -%}{%- endif -%}
          {%- assign card_cat = "accessoires" -%}
          {%- if zigbee_handles contains product.handle -%}
            {%- assign card_cat = "zigbee" -%}
          {%- elsif detecteurs_handles contains product.handle -%}
            {%- assign card_cat = "detecteurs" -%}
          {%- elsif contacteurs_handles contains product.handle -%}
            {%- assign card_cat = "contacteurs" -%}
          {%- elsif sirenes_handles contains product.handle -%}
            {%- assign card_cat = "sirenes" -%}
          {%- elsif acces_handles contains product.handle -%}
            {%- assign card_cat = "acces" -%}
          {%- elsif amplificateur_handles contains product.handle -%}
            {%- assign card_cat = "amplificateur" -%}
          {%- elsif sim_handles contains product.handle -%}
            {%- assign card_cat = "sim" -%}
          {%- endif -%}
          {%- assign card_variant = product.selected_or_first_available_variant -%}
          {%- assign card_form_id = "DASForm-" | append: forloop.index | append: "-" | append: section.id -%}
          <div class="das-card{% unless card_variant.available %} das-card--oos{% endunless %}" data-category="{{ card_cat }}">
            <a href="{{ product.url }}" class="das-card__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,375,500', alt: product.title, sizes: '(min-width: 1080px) 25vw, (min-width: 700px) 33vw, 50vw' }}
              {%- endif -%}
              {%- if card_cat == "zigbee" -%}
                <span class="das-card__badge das-card__badge--zig">Zigbee</span>
              {%- endif -%}
              {%- unless card_variant.available -%}
                <span class="das-card__badge das-card__badge--oos">Rupture de stock</span>
              {%- endunless -%}
              <span class="das-card__view" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </span>
            </a>
            <div class="das-card__body">
              <a href="{{ product.url }}" class="das-card__title">{{ product.title }}</a>
              <div class="das-card__price">{{ card_variant.price | money }}</div>

              {%- if card_variant.available -%}
                {%- form 'product', product, is: 'product-form', id: card_form_id, class: 'das-card__form' -%}
                  <input type="hidden" name="id" value="{{ card_variant.id }}">
                  <div class="das-qty" data-qty>
                    <button type="button" class="das-qty__btn" data-qty-decrease aria-label="Diminuer la quantité">−</button>
                    <input type="number" class="das-qty__input" name="quantity" value="1" min="1" inputmode="numeric" data-qty-input aria-label="Quantité, {{ product.title }}">
                    <button type="button" class="das-qty__btn" data-qty-increase aria-label="Augmenter la quantité">+</button>
                  </div>
                  <button type="submit" class="das-add" is="hover-button">
                    <span class="btn-fill" data-fill aria-hidden="true"></span>
                    <span class="btn-text das-add__text">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.5 3h2l2.7 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21.5 8H6"></path></svg>
                      Ajouter
                    </span>
                  </button>
                {%- endform -%}
              {%- else -%}
                <div class="das-card__unavailable">Indisponible pour le moment</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      /* Quantity steppers */
      root.querySelectorAll('[data-qty]').forEach(function (wrap) {
        var input = wrap.querySelector('[data-qty-input]');
        var dec = wrap.querySelector('[data-qty-decrease]');
        var inc = wrap.querySelector('[data-qty-increase]');
        function clamp(v) {
          v = parseInt(v, 10);
          if (isNaN(v) || v < 1) v = 1;
          return v;
        }
        dec.addEventListener('click', function () {
          input.value = clamp(parseInt(input.value, 10) - 1);
        });
        inc.addEventListener('click', function () {
          input.value = clamp(parseInt(input.value, 10) + 1);
        });
        input.addEventListener('change', function () {
          input.value = clamp(input.value);
        });
      });

      /* Zone (category) filter — instant client-side show/hide */
      var zones = root.querySelectorAll('[data-filter]');
      var cards = root.querySelectorAll('.das-card');
      var countEl = root.querySelector('[data-visible-count]');
      var zignote = root.querySelector('[data-zignote]');
      function applyFilter(filter) {
        var visible = 0;
        cards.forEach(function (card) {
          var match = filter === 'all' || card.getAttribute('data-category') === filter;
          card.classList.toggle('is-hidden', !match);
          if (match) visible++;
        });
        if (countEl) countEl.textContent = visible;
        if (zignote) zignote.classList.toggle('is-visible', filter === 'all' || filter === 'zigbee');
      }
      zones.forEach(function (zone) {
        zone.addEventListener('click', function () {
          zones.forEach(function (z) {
            z.classList.remove('is-active');
            z.setAttribute('aria-pressed', 'false');
          });
          zone.classList.add('is-active');
          zone.setAttribute('aria-pressed', 'true');
          applyFilter(zone.getAttribute('data-filter'));
        });
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Élite accessories shop",
  "settings": []
}
{% endschema %}
