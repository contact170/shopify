          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="1.6"></circle><circle cx="19" cy="6" r="1.6"></circle><circle cx="19" cy="18" r="1.6"></circle><path d="M6.4 11.2L17.6 6.8M6.4 12.8L17.6 17.2"></path></svg></span>
          </span>
          <span class="das-zone__label">Zigbee</span>
          <span class="das-zone__count">{{ count_zigbee_str }}</span>
        </button>
        <button type="button" class="das-zone" data-filter="detecteurs" aria-pressed="false">
          <span class="das-zone__top">
            <span class="das-zone__led" aria-hidden="true"></span>
            <span class="das-zone__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"></circle><path d="M8 8a5.66 5.66 0 0 1 8 0"></path><path d="M5 5a10 10 0 0 1 14 0"></path></svg></span>
