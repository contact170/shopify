{%- comment -%}
  Page « Guides d'installation » : présente les 4 guides pas à pas
  (Vigilia, Touch AM301, Touch XL AM302, Élite PA501Z).
  Une carte par guide (bloc « Guide »), un rappel « Avant de commencer »
  et un bloc d'aide. Si le visiteur a déjà commencé un guide, sa carte
  affiche « Reprendre l'installation » : les guides mémorisent leur
  progression dans le navigateur sous la clé « vg-<handle de la page> ».
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign guides = section.blocks | where: 'type', 'guide'
  assign avants = section.blocks | where: 'type', 'avant'
-%}

<style>
  #hg-{{ sid }} {
    --hg-navy: #0c1e4a;
    --hg-blue: #0b61cd;
    --hg-blue-soft: #e8f0fd;
    --hg-green: #16a34a;
    --hg-green-soft: #e9f8ef;
    --hg-bg: #f2f3ff;
    --hg-card: #ffffff;
    --hg-muted: #55617f;
    --hg-line: rgba(12, 30, 74, .1);
    --hg-shadow: 0 1px 2px rgba(12,30,74,.06), 0 8px 24px rgba(12,30,74,.06);
    --hg-shadow-hover: 0 2px 4px rgba(12,30,74,.08), 0 16px 36px rgba(12,30,74,.12);
    --hg-ease: cubic-bezier(.23, 1, .32, 1);
    background: var(--hg-bg);
    color: var(--hg-navy);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-size: 16px;
    line-height: 1.55;
  }
  #hg-{{ sid }} *, #hg-{{ sid }} *::before, #hg-{{ sid }} *::after { box-sizing: border-box; }
  #hg-{{ sid }} .hg-wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  #hg-{{ sid }} h1, #hg-{{ sid }} h2, #hg-{{ sid }} h3 { color: var(--hg-navy); margin: 0; letter-spacing: -.02em; line-height: 1.15; }
  #hg-{{ sid }} p { margin: 0; }
  #hg-{{ sid }} img { max-width: 100%; height: auto; display: block; }
  #hg-{{ sid }} .hg-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Fil d'Ariane */
  #hg-{{ sid }} .hg-crumbs { font-size: 14px; color: var(--hg-muted); margin-bottom: 20px; }
  #hg-{{ sid }} .hg-crumbs a { color: var(--hg-muted); text-decoration: none; }
  #hg-{{ sid }} .hg-crumbs a:hover { color: var(--hg-blue); text-decoration: underline; }
  #hg-{{ sid }} .hg-crumbs span[aria-hidden] { margin: 0 6px; }

  /* En-tête */
  #hg-{{ sid }} .hg-hero { max-width: 720px; margin-bottom: 32px; }
  #hg-{{ sid }} .hg-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--hg-blue); background: var(--hg-blue-soft); padding: 6px 12px; border-radius: 999px; margin-bottom: 14px; }
  #hg-{{ sid }} .hg-hero h1 { font-size: clamp(30px, 5vw, 46px); line-height: 1.08; letter-spacing: -.03em; margin-bottom: 14px; }
  #hg-{{ sid }} .hg-hero__sub { font-size: 18px; color: var(--hg-muted); margin-bottom: 18px; }
  #hg-{{ sid }} .hg-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  #hg-{{ sid }} .hg-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--hg-card); border: 1px solid var(--hg-line); border-radius: 999px; padding: 6px 12px; font-size: 14px; font-weight: 500; }

  /* Cartes des guides */
  #hg-{{ sid }} .hg-grid { display: grid; gap: 16px; grid-template-columns: 1fr; margin: 0 0 16px; padding: 0; list-style: none; }
  @media (min-width: 750px) { #hg-{{ sid }} .hg-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 1000px) { #hg-{{ sid }} .hg-grid { grid-template-columns: repeat(4, 1fr); } }
  #hg-{{ sid }} .hg-card { position: relative; display: flex; flex-direction: column; height: 100%; background: var(--hg-card); border-radius: 20px; box-shadow: var(--hg-shadow); overflow: hidden; transition: transform .25s var(--hg-ease), box-shadow .25s var(--hg-ease); }
  @media (hover: hover) and (pointer: fine) {
    #hg-{{ sid }} .hg-card:hover { transform: translateY(-3px); box-shadow: var(--hg-shadow-hover); }
    #hg-{{ sid }} .hg-card:hover .hg-card__cta svg { transform: translateX(3px); }
  }
  #hg-{{ sid }} .hg-card:focus-within { outline: 3px solid var(--hg-blue); outline-offset: 3px; }
  #hg-{{ sid }} .hg-card__media { aspect-ratio: 4 / 3; background: #fff; border-bottom: 1px solid var(--hg-line); overflow: hidden; }
  #hg-{{ sid }} .hg-card__media img { width: 100%; height: 100%; object-fit: contain; }
  #hg-{{ sid }} .hg-card__media--cover img { object-fit: cover; }
  /* Mobile : cartes horizontales, photo à gauche du nom */
  @media (max-width: 749px) {
    #hg-{{ sid }} .hg-card { display: grid; grid-template-columns: 104px 1fr; column-gap: 14px; row-gap: 6px; padding: 14px 14px 16px; }
    #hg-{{ sid }} .hg-card__body { display: contents; }
    #hg-{{ sid }} .hg-card__media { grid-column: 1; grid-row: 1 / span 3; align-self: start; aspect-ratio: 1 / 1; border: 1px solid var(--hg-line); border-radius: 14px; }
    #hg-{{ sid }} .hg-card__top, #hg-{{ sid }} .hg-card h2, #hg-{{ sid }} .hg-card__desc { grid-column: 2; }
    #hg-{{ sid }} .hg-card h2 { font-size: 20px; }
    #hg-{{ sid }} .hg-card__desc { font-size: 14px; }
    #hg-{{ sid }} .hg-card__spot, #hg-{{ sid }} .hg-card__meta, #hg-{{ sid }} .hg-card__cta { grid-column: 1 / -1; }
    #hg-{{ sid }} .hg-card__spot { margin-top: 6px; }
  }
  #hg-{{ sid }} .hg-card__body { display: flex; flex-direction: column; gap: 10px; padding: 18px 18px 20px; flex: 1; }
  #hg-{{ sid }} .hg-card__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  #hg-{{ sid }} .hg-card__ref { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--hg-muted); }
  #hg-{{ sid }} .hg-card__badge { display: none; font-size: 12px; font-weight: 600; color: var(--hg-green); background: var(--hg-green-soft); padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
  #hg-{{ sid }} .hg-card.is-started .hg-card__badge { display: inline-block; }
  #hg-{{ sid }} .hg-card h2 { font-size: 22px; }
  #hg-{{ sid }} .hg-card__desc { font-size: 15px; color: var(--hg-muted); }
  #hg-{{ sid }} .hg-card__spot { display: flex; gap: 8px; align-items: flex-start; font-size: 14px; background: var(--hg-bg); border-radius: 12px; padding: 10px 12px; }
  #hg-{{ sid }} .hg-card__spot svg { flex: none; width: 18px; height: 18px; margin-top: 2px; color: var(--hg-blue); }
  #hg-{{ sid }} .hg-card__spot strong { display: block; font-size: 12px; font-weight: 600; color: var(--hg-muted); text-transform: uppercase; letter-spacing: .04em; }
  #hg-{{ sid }} .hg-card__meta { font-size: 14px; color: var(--hg-muted); margin-top: auto; }
  #hg-{{ sid }} .hg-card__cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 18px; border-radius: 999px; background: var(--hg-navy); color: #fff; font-weight: 600; font-size: 15px; text-decoration: none; }
  #hg-{{ sid }} .hg-card__cta svg { width: 18px; height: 18px; transition: transform .2s var(--hg-ease); }
  #hg-{{ sid }} .hg-card__cta::after { content: ""; position: absolute; inset: 0; border-radius: 20px; }
  #hg-{{ sid }} .hg-card__cta:focus-visible { outline: none; }
  #hg-{{ sid }} .hg-card.is-started .hg-card__cta { background: var(--hg-green); }
  #hg-{{ sid }} .hg-note { font-size: 15px; color: var(--hg-muted); margin-bottom: 48px; }
  #hg-{{ sid }} .hg-note a { color: var(--hg-blue); }

  /* Avant de commencer */
  #hg-{{ sid }} .hg-section-title { font-size: clamp(24px, 3.4vw, 30px); margin-bottom: 18px; }
  #hg-{{ sid }} .hg-avant { display: grid; gap: 12px; grid-template-columns: 1fr; margin: 0 0 48px; padding: 0; list-style: none; }
  @media (min-width: 750px) { #hg-{{ sid }} .hg-avant { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  #hg-{{ sid }} .hg-avant li { display: flex; gap: 14px; align-items: flex-start; background: var(--hg-card); border-radius: 16px; padding: 18px; box-shadow: var(--hg-shadow); }
  #hg-{{ sid }} .hg-avant__n { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--hg-blue-soft); color: var(--hg-blue); font-weight: 700; }
  #hg-{{ sid }} .hg-avant h3 { font-size: 17px; margin-bottom: 4px; }
  #hg-{{ sid }} .hg-avant p { font-size: 15px; color: var(--hg-muted); }

  /* Aide */
  #hg-{{ sid }} .hg-help { background: var(--hg-navy); color: #fff; border-radius: 24px; padding: 28px 22px; display: grid; gap: 18px; align-items: center; }
  @media (min-width: 750px) { #hg-{{ sid }} .hg-help { grid-template-columns: 1fr auto; padding: 32px 36px; } }
  #hg-{{ sid }} .hg-help h2 { color: #fff; font-size: clamp(22px, 3vw, 28px); margin-bottom: 6px; }
  #hg-{{ sid }} .hg-help p { color: rgba(255,255,255,.8); }
  #hg-{{ sid }} .hg-help__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  #hg-{{ sid }} .hg-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 20px; border-radius: 999px; font-weight: 600; font-size: 15px; text-decoration: none; transition: background-color .2s ease, transform .15s ease; }
  #hg-{{ sid }} .hg-btn:active { transform: scale(.97); }
  #hg-{{ sid }} .hg-btn--light { background: #fff; color: var(--hg-navy); }
  #hg-{{ sid }} .hg-btn--ghost { color: #fff; border: 1px solid rgba(255,255,255,.4); }
  @media (hover: hover) and (pointer: fine) {
    #hg-{{ sid }} .hg-btn--light:hover { background: var(--hg-blue-soft); }
    #hg-{{ sid }} .hg-btn--ghost:hover { background: rgba(255,255,255,.1); }
  }
  #hg-{{ sid }} .hg-btn:focus-visible { outline: 3px solid #8fb8ff; outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    #hg-{{ sid }} .hg-card, #hg-{{ sid }} .hg-card__cta svg, #hg-{{ sid }} .hg-btn { transition: none; }
    #hg-{{ sid }} .hg-card:hover { transform: none; }
  }
</style>

<div id="hg-{{ sid }}" class="hg">
  <div class="hg-wrap">

    <nav class="hg-crumbs" aria-label="Fil d'Ariane">
      <a href="{{ routes.root_url }}">Accueil</a><span aria-hidden="true">›</span><span aria-current="page">{{ section.settings.title }}</span>
    </nav>

    <header class="hg-hero">
      {%- if section.settings.eyebrow != blank -%}<span class="hg-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.title }}</h1>
      {%- if section.settings.subtitle != blank -%}<div class="hg-hero__sub">{{ section.settings.subtitle }}</div>{%- endif -%}
      <div class="hg-pills">
        {%- if section.settings.pill_1 != blank -%}<span class="hg-pill">{{ section.settings.pill_1 }}</span>{%- endif -%}
        {%- if section.settings.pill_2 != blank -%}<span class="hg-pill">{{ section.settings.pill_2 }}</span>{%- endif -%}
        {%- if section.settings.pill_3 != blank -%}<span class="hg-pill">{{ section.settings.pill_3 }}</span>{%- endif -%}
      </div>
    </header>

    {%- if guides.size > 0 -%}
      <ul class="hg-grid" role="list">
        {%- for b in guides -%}
          {%- liquid
            assign guide_url = b.settings.guide_page.url | default: '#'
            assign guide_handle = b.settings.guide_page.handle
            assign img_alt = "Centrale d'alarme Daewoo " | append: b.settings.name
          -%}
          <li>
            <article class="hg-card" data-hg-key="vg-{{ guide_handle }}" {{ b.shopify_attributes }}>
              <div class="hg-card__media{% if b.settings.image_cover %} hg-card__media--cover{% endif %}">
                {%- if b.settings.image != blank -%}
                  {{ b.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 250px, (min-width: 750px) 50vw, 100vw', widths: '350, 500, 700', alt: img_alt }}
                {%- endif -%}
              </div>
              <div class="hg-card__body">
                <div class="hg-card__top">
                  {%- if b.settings.ref != blank -%}<span class="hg-card__ref">{{ b.settings.ref }}</span>{%- endif -%}
                  <span class="hg-card__badge">En cours</span>
                </div>
                <h2>{{ b.settings.name }}</h2>
                {%- if b.settings.description != blank -%}<p class="hg-card__desc">{{ b.settings.description }}</p>{%- endif -%}
                {%- if b.settings.recognize != blank -%}
                  <p class="hg-card__spot">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <span><strong>Comment la reconnaître</strong>{{ b.settings.recognize }}</span>
                  </p>
                {%- endif -%}
                {%- if b.settings.meta != blank -%}<p class="hg-card__meta">{{ b.settings.meta }}</p>{%- endif -%}
                <a class="hg-card__cta" href="{{ guide_url }}">
                  <span data-hg-label>{{ section.settings.cta_label }}</span>
                  <span class="hg-sr"> : {{ b.settings.name }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}<div class="hg-note">{{ section.settings.note }}</div>{%- endif -%}

    {%- if avants.size > 0 -%}
      <h2 class="hg-section-title">{{ section.settings.avant_title }}</h2>
      <ol class="hg-avant" role="list">
        {%- for a in avants -%}
          <li {{ a.shopify_attributes }}>
            <span class="hg-avant__n" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3>{{ a.settings.title }}</h3>
              {%- if a.settings.text != blank -%}<p>{{ a.settings.text }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    <div class="hg-help">
      <div>
        <h2>{{ section.settings.help_title }}</h2>
        {%- if section.settings.help_text != blank -%}<p>{{ section.settings.help_text }}</p>{%- endif -%}
      </div>
      <div class="hg-help__actions">
        {%- if section.settings.help_url != blank -%}<a class="hg-btn hg-btn--light" href="{{ section.settings.help_url }}">{{ section.settings.help_label }}</a>{%- endif -%}
        {%- if section.settings.contact_url != blank -%}<a class="hg-btn hg-btn--ghost" href="{{ section.settings.contact_url }}">{{ section.settings.contact_label }}</a>{%- endif -%}
        {%- if section.settings.youtube_url != blank -%}<a class="hg-btn hg-btn--ghost" href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener">▶ Nos vidéos</a>{%- endif -%}
      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('hg-{{ sid }}');
    if (!root) return;
    var resume = {{ section.settings.resume_label | json }};
    root.querySelectorAll('[data-hg-key]').forEach(function (card) {
      var state = null;
      try { state = JSON.parse(localStorage.getItem(card.getAttribute('data-hg-key'))); } catch (e) {}
      if (!state || !state.done) return;
      var started = Object.keys(state.done).some(function (k) { return state.done[k]; });
      if (!started) return;
      card.classList.add('is-started');
      var label = card.querySelector('[data-hg-label]');
      if (label && resume) label.textContent = resume;
    });
  })();
</script>

{%- comment -%} Données structurées : fil d'Ariane et liste des guides {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": {{ shop.url | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ section.settings.title | json }}, "item": {{ shop.url | append: request.path | json }} }
      ]
    },
    {
      "@type": "CollectionPage",
      "name": {{ section.settings.title | json }},
      "url": {{ shop.url | append: request.path | json }},
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {%- for b in guides -%}
            { "@type": "ListItem", "position": {{ forloop.index }}, "name": {{ "Guide d'installation " | append: b.settings.name | json }}, "url": {{ shop.url | append: b.settings.guide_page.url | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
  ]
}
</script>

{% schema %}
{
  "name": "Guides d'installation",
  "tag": "section",
  "class": "section-guides-installation",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Assistance" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Guides d'installation" },
    { "type": "richtext", "id": "subtitle", "label": "Sous-titre" },
    { "type": "text", "id": "pill_1", "label": "Pastille 1" },
    { "type": "text", "id": "pill_2", "label": "Pastille 2" },
    { "type": "text", "id": "pill_3", "label": "Pastille 3" },
    { "type": "text", "id": "cta_label", "label": "Bouton des cartes", "default": "Commencer l'installation" },
    { "type": "text", "id": "resume_label", "label": "Bouton si le guide est déjà commencé", "default": "Reprendre l'installation" },
    { "type": "richtext", "id": "note", "label": "Remarque sous les cartes" },
    { "type": "text", "id": "avant_title", "label": "Titre « Avant de commencer »", "default": "Avant de commencer" },
    { "type": "header", "content": "Aide" },
    { "type": "text", "id": "help_title", "label": "Titre", "default": "Bloqué pendant l'installation ?" },
    { "type": "text", "id": "help_text", "label": "Texte" },
    { "type": "text", "id": "help_label", "label": "Bouton principal", "default": "Demander de l'aide" },
    { "type": "url", "id": "help_url", "label": "Lien du bouton principal" },
    { "type": "text", "id": "contact_label", "label": "Bouton secondaire", "default": "Nous écrire" },
    { "type": "url", "id": "contact_url", "label": "Lien du bouton secondaire" },
    { "type": "url", "id": "youtube_url", "label": "Chaîne YouTube" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide",
      "settings": [
        { "type": "page", "id": "guide_page", "label": "Page du guide" },
        { "type": "text", "id": "name", "label": "Nom de la centrale", "default": "Vigilia" },
        { "type": "text", "id": "ref", "label": "Référence" },
        { "type": "image_picker", "id": "image", "label": "Photo de la centrale" },
        { "type": "checkbox", "id": "image_cover", "label": "Photo d'ambiance (remplir le cadre)", "default": false },
        { "type": "text", "id": "description", "label": "Description courte" },
        { "type": "text", "id": "recognize", "label": "Comment la reconnaître" },
        { "type": "text", "id": "meta", "label": "Détail (ex. nombre d'étapes)" }
      ]
    },
    {
      "type": "avant",
      "name": "Avant de commencer",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Guides d'installation" }]
}
{% endschema %}
