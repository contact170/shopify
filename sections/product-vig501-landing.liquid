  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      /* Reveal-on-scroll */
      var revealEls = root.querySelectorAll('.pv-reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
      }

      /* Connectivity toggle: every toggle button and comparison card
         (data-pv-connectivity) shares one hidden variant-id field and
         updates every "Ajouter au panier" price/compare display and the
         "Configurer mon pack" link, wherever they appear on the page. */
      var dataScript = root.querySelector('#PVData-{{ section.id }}');
      var variantData = {};
      if (dataScript) {
        try { variantData = JSON.parse(dataScript.textContent); } catch (e) { /* keep empty */ }
      }
      var keyToVariantId = {};
      Object.keys(variantData).forEach(function (id) {
        keyToVariantId[variantData[id].key] = id;
      });

      var toggleEls = root.querySelectorAll('[data-pv-connectivity]');
      var variantIdInput = root.querySelector('#PVVariantId-{{ section.id }}');
      var priceAmounts = root.querySelectorAll('.pv-price-amount');
      var priceCompares = root.querySelectorAll('.pv-price-compare');
      var configLinks = root.querySelectorAll('[data-pv-config-link]');

      function selectConnectivity(key) {
        var variantId = keyToVariantId[key];
        if (!variantId) return;
        var data = variantData[variantId];

        toggleEls.forEach(function (el) {
          var isMatch = el.getAttribute('data-pv-connectivity') === key;
          el.classList.toggle('is-selected', isMatch);
          el.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        });
        if (variantIdInput) variantIdInput.value = variantId;
        priceAmounts.forEach(function (el) { el.textContent = data.price; });
        priceCompares.forEach(function (el) {
          el.textContent = data.compare;
          el.classList.toggle('is-visible', !!data.hasCompare);
        });
        configLinks.forEach(function (el) { el.setAttribute('href', data.config); });
      }

      toggleEls.forEach(function (el) {
        el.addEventListener('click', function () {
          selectConnectivity(el.getAttribute('data-pv-connectivity'));
        });
      });

      /* Sticky add-to-cart bar: show once the hero CTA has scrolled out of view */
      var heroCta = root.querySelector('#PVHeroCta-{{ section.id }}');
      var stickyBar = root.querySelector('#PVSticky-{{ section.id }}');
      if (heroCta && stickyBar && 'IntersectionObserver' in window) {
        var stickyIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            stickyBar.classList.toggle('is-shown', !entry.isIntersecting);
          });
        }, { threshold: 0, rootMargin: '-64px 0px 0px 0px' });
        stickyIo.observe(heroCta);
      }
      /* Generic modal open/close (Alma installments + full reviews list),
         both plain dialog elements so Escape/backdrop dismissal and
         focus-trapping come from the browser for free. The .is-open class
         is added a frame after showModal() so the CSS transition on
         .pv-modal__inner actually runs (animating [open] directly isn't
         reliably supported without @starting-style). */
      function openModal(dialogEl) {
        if (!dialogEl || typeof dialogEl.showModal !== 'function') return;
        dialogEl.showModal();
        requestAnimationFrame(function () { dialogEl.classList.add('is-open'); });
      }
      function closeModal(dialogEl) {
        if (!dialogEl) return;
        dialogEl.classList.remove('is-open');
        dialogEl.close();
      }
      root.querySelectorAll('.pv-modal').forEach(function (dialogEl) {
        dialogEl.querySelectorAll('[data-pv-modal-close]').forEach(function (btn) {
          btn.addEventListener('click', function () { closeModal(dialogEl); });
        });
        dialogEl.addEventListener('click', function (e) {
          if (e.target === dialogEl) closeModal(dialogEl);
        });
        dialogEl.addEventListener('close', function () { dialogEl.classList.remove('is-open'); });
      });

      /* Alma installments popup: 3x/4x are always fee-free, 10x only
         applies (and only shows) from 200€, with a real 7.34% fee — kept
         in sync with whichever variant (Wi-Fi / Wi-Fi+GSM) is currently
         selected via the same variantData used for the price toggle. */
      var almaModal = document.getElementById('PVAlmaModal-{{ section.id }}');
      var almaOpenBtn = root.querySelector('[data-pv-alma-open]');
      function formatEuros(cents) {
        return (cents / 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '\u00A0€';
      }
      function updateAlmaAmounts() {
        if (!almaModal) return;
        var cents = null;
        if (variantIdInput && variantData[variantIdInput.value]) {
          cents = variantData[variantIdInput.value].priceCents;
        }
        if (cents == null) cents = {{ variant.price | json }};

        var totalEl = almaModal.querySelector('[data-pv-alma-total]');
        var el3x = almaModal.querySelector('[data-pv-alma-3x]');
        var el4x = almaModal.querySelector('[data-pv-alma-4x]');
        var wrap10x = almaModal.querySelector('[data-pv-alma-10x-wrap]');
        var el10x = almaModal.querySelector('[data-pv-alma-10x]');

        if (totalEl) totalEl.textContent = formatEuros(cents);
        if (el3x) el3x.textContent = '3 x ' + formatEuros(Math.round(cents / 3));
        if (el4x) el4x.textContent = '4 x ' + formatEuros(Math.round(cents / 4));

        var showTenX = cents >= 20000;
        if (wrap10x) wrap10x.hidden = !showTenX;
        if (showTenX && el10x) {
          var totalWithFees = Math.round(cents * 1.0734);
          el10x.textContent = '10 x ' + formatEuros(Math.round(totalWithFees / 10));
        }
      }
      if (almaOpenBtn && almaModal) {
        almaOpenBtn.addEventListener('click', function () {
          updateAlmaAmounts();
          openModal(almaModal);
        });
      }

      /* Full reviews list: rendered once, on first open, from the JSON
         data blob rather than at page load, since it's ~70 entries and
         only needed if a visitor actually asks to see them all. */
      var reviewsModal = document.getElementById('PVReviewsModal-{{ section.id }}');
      var reviewsOpenBtn = root.querySelector('[data-pv-reviews-open]');
      var reviewsListEl = reviewsModal ? reviewsModal.querySelector('[data-pv-all-reviews-list]') : null;
      var reviewsRendered = false;
      function renderAllReviews() {
        if (reviewsRendered || !reviewsListEl) return;
        reviewsRendered = true;
        var dataScript = document.getElementById('PVAllReviews-{{ section.id }}');
        var reviews = [];
        if (dataScript) {
          try { reviews = JSON.parse(dataScript.textContent); } catch (e) { reviews = []; }
        }
        var frag = document.createDocumentFragment();
        reviews.forEach(function (rev) {
          var item = document.createElement('div');
          item.className = 'pv-all-review';

          var stars = document.createElement('div');
          stars.className = 'pv-all-review__stars';
          stars.setAttribute('aria-hidden', 'true');
          stars.textContent = '★★★★★'.slice(0, rev.r) + '☆☆☆☆☆'.slice(0, 5 - rev.r);
          item.appendChild(stars);

          var text = document.createElement('p');
          text.className = 'pv-all-review__text';
          text.textContent = rev.t;
          item.appendChild(text);

          var meta = document.createElement('p');
          meta.className = 'pv-all-review__meta';
          var strong = document.createElement('strong');
          strong.textContent = rev.n;
          meta.appendChild(strong);
          var rest = [rev.c, rev.d].filter(Boolean).join(' · ');
          if (rest) meta.appendChild(document.createTextNode(' · ' + rest));
          item.appendChild(meta);

          frag.appendChild(item);
        });
        reviewsListEl.appendChild(frag);
      }
      if (reviewsOpenBtn && reviewsModal) {
        reviewsOpenBtn.addEventListener('click', function () {
          renderAllReviews();
          openModal(reviewsModal);
        });
      }

    })();
  </script>
</div>

