{% comment %}
  "Comment ça marche" — the same capteur -> centrale -> sirène story the
  hero demonstrates in 3D, restated as a plain-language schematic for
  anyone who scrolls straight past the hero.
{% endcomment %}

<style>
  #how-it-works { position: relative; padding: 100px 24px 120px; background: #04060d; }
  #how-it-works .hiw-inner { max-width: 1180px; margin: 0 auto; }
  #how-it-works .hiw-eyebrow {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: #6f9bff; margin: 0 0 18px;
  }
  #how-it-works h2 {
    font-family: 'Poppins', sans-serif; font-weight: 600; color: #f4f6ff;
    font-size: clamp(26px, 3.4vw, 40px); line-height: 1.15; max-width: 26ch; margin: 0 0 72px;
  }
  #how-it-works .hiw-flow { display: flex; align-items: stretch; gap: 0; }
  @media (max-width: 900px) { #how-it-works .hiw-flow { flex-direction: column; gap: 28px; } }

  #how-it-works .hiw-node {
    flex: 1; border: 1px dashed rgba(111,155,255,0.4); border-radius: 14px;
    padding: 24px 20px; background: rgba(111,155,255,0.05);
    opacity: 0; transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  #how-it-works .hiw-node.is-visible { opacity: 1; transform: translateY(0); }
  #how-it-works .hiw-node-index {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase; color: #6f9bff; margin: 0 0 14px; display: block;
  }
  #how-it-works .hiw-node h3 {
    font-family: 'Poppins', sans-serif; font-weight: 600; color: #f4f6ff; font-size: 16px; margin: 0 0 8px;
  }
  #how-it-works .hiw-node p { color: rgba(244,246,255,0.6); font-size: 13px; line-height: 1.55; margin: 0; }

  #how-it-works .hiw-connector {
    flex: 0 0 44px; display: flex; align-items: center; justify-content: center;
    color: rgba(111,155,255,0.5); font-family: ui-monospace, monospace; font-size: 15px;
  }
  @media (max-width: 900px) {
    #how-it-works .hiw-connector { flex: none; height: 20px; transform: rotate(90deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    #how-it-works .hiw-node { transition: none; opacity: 1; transform: none; }
  }
</style>

<section id="how-it-works">
  <div class="hiw-inner">
    <p class="hiw-eyebrow">{{ section.settings.eyebrow | default: 'Comment fonctionne le système' }}</p>
    <h2>{{ section.settings.heading | default: 'La même logique, du capteur jusqu\'à vous.' }}</h2>

    <div class="hiw-flow">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="hiw-node" {{ block.shopify_attributes }}>
            <span class="hiw-node-index">{{ block.settings.label }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
          {% unless forloop.last %}
            <div class="hiw-connector" aria-hidden="true">→</div>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function () {
    var nodes = document.querySelectorAll('#how-it-works .hiw-node');
    if (!nodes.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      nodes.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var index = Array.prototype.indexOf.call(nodes, entry.target);
            entry.target.style.transitionDelay = (index * 0.12) + 's';
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    nodes.forEach(function (el) { io.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Comment ça marche",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Libellé", "default": "Comment fonctionne le système" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "La même logique, du capteur jusqu'à vous." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "label", "label": "Repère (ex. 01 · CAPTEUR)" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comment ça marche",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "01 · CAPTEUR",
            "title": "Détecte",
            "description": "Contact, vibration ou mouvement — chaque accessoire est choisi pour la pièce où il est installé."
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "02 · CENTRALE",
            "title": "Analyse",
            "description": "Vigilia, Touch ou Élite traite l'information en local, en une fraction de seconde."
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "03 · APPLICATION",
            "title": "Vous alerte",
            "description": "Notification instantanée sur votre smartphone, où que vous soyez."
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "04 · VOUS",
            "title": "Agissez",
            "description": "Armez, désarmez ou déclenchez la sirène à distance, en un geste."
          }
        }
      ]
    }
  ]
}
{% endschema %}
