{% comment %}
  Spatial UI hero — interactive 3D house.
  The zone list below always renders as real, crawlable, no-JS-safe HTML
  (SEO + prefers-reduced-motion fallback). The canvas is a progressive
  enhancement mounted on top of it by assets/spatial-hero.js.
{% endcomment %}

{{ 'spatial-hero.css' | asset_url | stylesheet_tag }}

<section id="spatial-hero" data-section-id="{{ section.id }}" class="relative w-full">
  <div class="relative mx-auto flex min-h-[640px] w-full max-w-[1400px] flex-col px-6 py-16 sm:px-10 lg:px-16">
    <div class="spatial-hero-heading relative z-10 max-w-[46ch]">
      {% if section.settings.eyebrow != blank %}
        <p class="mono mb-4 text-[11px] uppercase tracking-[0.14em] text-blue-soft">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="font-display text-[clamp(28px,4.2vw,48px)] font-semibold leading-[1.05] text-white">
        {{ section.settings.heading }}
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="mt-4 text-[15px] leading-relaxed text-white/60">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div id="spatial-hero-canvas-root" class="pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>
    <div id="spatial-hero-card-layer" class="pointer-events-none absolute inset-0 z-20" aria-hidden="true"></div>
    <div id="spatial-hero-hotspots" class="pointer-events-none absolute inset-0 z-30"></div>

    <p class="spatial-hero-scroll-cue mono pointer-events-none relative z-10 mt-auto self-start text-[11px] text-white/40">
      {{ section.settings.scroll_hint | default: 'Faire défiler ↓' }}
    </p>
  </div>

  <div id="spatial-hero-fallback" class="relative z-10 mx-auto w-full max-w-[1400px] px-6 pb-16 sm:px-10 lg:px-16">
    <h2 class="font-display mb-6 text-[22px] font-semibold text-white">Ce que protège chaque pièce</h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {% for block in section.blocks %}
        {% if block.type == 'zone' %}
          <li {{ block.shopify_attributes }} class="rounded-2xl border border-white/10 bg-white/5 p-4">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'mb-3 h-32 w-full rounded-xl object-cover' }}
            {% else %}
              <img src="{{ block.settings.fallback_image_url }}" alt="{{ block.settings.title }}" loading="lazy" width="300" height="128" class="mb-3 h-32 w-full rounded-xl object-cover">
            {% endif %}
            <p class="mono text-[10px] uppercase tracking-[0.08em] text-blue-soft">{{ block.settings.eyebrow }}</p>
            <h3 class="font-display text-[15px] font-semibold text-white">{{ block.settings.title }}</h3>
            <p class="mt-1 text-[13px] text-white/60">{{ block.settings.description }}</p>
            <p class="mt-2 text-[12px] text-white/40">{{ block.settings.price }} · réf. {{ block.settings.sku }}</p>
            <a href="{{ block.settings.link | default: '#' }}" class="mt-3 inline-block text-[12px] font-medium text-blue-soft">Découvrir →</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  {%- assign zone_json_parts = '' -%}
  {%- assign has_entry = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'zone' and block.settings.zone_id != blank -%}
      {%- assign img_url = block.settings.image | image_url: width: 400 -%}
      {%- if block.settings.image == blank -%}{%- assign img_url = block.settings.fallback_image_url -%}{%- endif -%}
      {%- capture entry -%}
        "{{ block.settings.zone_id }}":{
          "id":{{ block.settings.zone_id | json }},
          {%- if block.settings.eyebrow != blank -%}"eyebrow":{{ block.settings.eyebrow | json }},{%- endif -%}
          {%- if block.settings.title != blank -%}"title":{{ block.settings.title | json }},{%- endif -%}
          {%- if block.settings.description != blank -%}"description":{{ block.settings.description | json }},{%- endif -%}
          {%- if block.settings.price != blank -%}"price":{{ block.settings.price | json }},{%- endif -%}
          {%- if block.settings.sku != blank -%}"sku":{{ block.settings.sku | json }},{%- endif -%}
          "image":{{ img_url | json }},
          "link":{{ block.settings.link | default: '#' | json }}
        }
      {%- endcapture -%}
      {%- unless has_entry -%}{%- assign has_entry = true -%}{%- else -%}{%- assign zone_json_parts = zone_json_parts | append: ',' -%}{%- endunless -%}
      {%- assign zone_json_parts = zone_json_parts | append: entry -%}
    {%- endif -%}
  {%- endfor -%}
  <script type="application/json" id="spatial-hero-data">{ {{ zone_json_parts }} }</script>
</section>

<script src="{{ 'spatial-hero.js' | asset_url }}" defer="defer"></script>

