{%- comment -%}
  Offre spéciale « Pack Sécurité Intégrale » : bandeau + achat + contenu du pack + fonctions.
  Même langage visuel que la home V2 (dw-home.css), complété par offre-psi.css.
  Un bloc « Centrale » par pack (PSI-VIGILIA, PSI-VIGILIA+, PSI-AM301, PSI-AM302).
  Présélection via l'URL : ?centrale=vigilia | vigilia-plus | touch | touch-xl
{%- endcomment -%}
{% render 'dw-home-head' %}
{{ 'offre-psi.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign centrales = section.blocks | where: 'type', 'centrale'
  assign objets = section.blocks | where: 'type', 'objet'
  assign fonctions = section.blocks | where: 'type', 'fonction'
  assign c0 = centrales | first
  assign nb = centrales.size | at_least: 1

  # Note et nombre d'avis Judge.me, comme sur la home.
  assign preuve = section.settings.proof
  assign avis_brut = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
  assign note_brute = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
  assign nb_avis = avis_brut | plus: 0
  if nb_avis >= 1000
    assign milliers = nb_avis | divided_by: 1000
    assign reste = nb_avis | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
    assign avis_txt = milliers | append: '&#8239;' | append: reste
  else
    assign avis_txt = nb_avis | append: ''
  endif
  assign note_txt = note_brute | plus: 0 | round: 1 | append: '' | replace: '.', ','
  if nb_avis == 0
    if preuve contains '[avis]' or preuve contains '[note]'
      assign preuve = blank
    endif
  else
    assign preuve = preuve | replace: '[avis]', avis_txt | replace: '[note]', note_txt
  endif
-%}

<div class="dwh psi" id="psi-achat" data-psi="{{ section.id }}">

  {%- comment -%} ============ Bandeau de l'offre ============ {%- endcomment -%}
  {%- if section.settings.end_date != blank -%}
    <div class="psi-bandeau" data-psi-compte data-fin="{{ section.settings.end_date | escape }}">
      <span class="psi-bandeau__pastille">{{ section.settings.band_label }}</span>
      <span class="psi-bandeau__texte" data-psi-encours>{{ section.settings.band_text }}</span>
      <span class="psi-compte" data-psi-encours aria-hidden="true">
        <span><b data-j>–</b><small>j</small></span>
        <span><b data-h>–</b><small>h</small></span>
        <span><b data-m>–</b><small>min</small></span>
        <span><b data-s>–</b><small>s</small></span>
      </span>
      <span class="psi-bandeau__texte" data-psi-fini hidden>{{ section.settings.ended_text }}</span>
    </div>
  {%- endif -%}

  {%- comment -%} ============ Achat ============ {%- endcomment -%}
  <section class="psi-hero" id="dwh-packs" aria-labelledby="psi-titre-{{ section.id }}">
    <div class="psi-hero__grille">

      <div class="psi-tete">
        {%- if preuve != blank -%}
          <p class="dwh-hero__note"><span class="dwh-etoiles" aria-hidden="true">★★★★★</span> {{ preuve }}</p>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="dwh-titre" id="psi-titre-{{ section.id }}">{{ section.settings.title }}</h1>
        {%- if section.settings.text != blank -%}<p class="dwh-chapo">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      {%- comment -%} Galerie : une par pack, images du produit {%- endcomment -%}
      <div class="psi-galerie">
        {%- for block in centrales -%}
          {%- liquid
            assign p = block.settings.product
            assign images = p.media | where: 'media_type', 'image'
            assign ref = 0
            if block.settings.ref_value != blank
              assign ref = block.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
            endif
            assign eco = ref | minus: p.price
            assign pct = 0
            if eco > 0
              assign pct = eco | times: 100.0 | divided_by: ref | floor
            endif
          -%}
          <div data-psi-idx="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
            <div class="psi-galerie__cadre">
              {%- if pct > 0 -%}
                <span class="psi-remise">-{{ pct }}&nbsp;%<small>{{ section.settings.discount_label }}</small></span>
              {%- endif -%}
              {%- if images.size > 0 -%}
                {%- for m in images limit: 5 -%}
                  {%- assign alt = m.alt | default: p.title -%}
                  <div class="psi-galerie__image{% if forloop.first %} est-visible{% endif %}" data-psi-image="{{ forloop.index0 }}">
                    {{ m.preview_image | image_url: width: 1100 | image_tag: widths: '400, 600, 800, 1100', sizes: '(min-width: 750px) 560px, 100vw', loading: 'eager', alt: alt }}
                  </div>
                {%- endfor -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            {%- if images.size > 1 -%}
              <div class="psi-vignettes">
                {%- for m in images limit: 5 -%}
                  <button type="button" class="psi-vignette" data-psi-vignette="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    {{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Choix de la centrale, prix, ajout au panier {%- endcomment -%}
      <div class="psi-achat">
        <p class="psi-choix-label" id="psi-choix-{{ section.id }}">{{ section.settings.choose_label }}</p>
        <div class="dwh-selecteur" role="tablist" aria-labelledby="psi-choix-{{ section.id }}" style="--n: {{ nb }}; --i: 0;" data-psi-selecteur>
          <span class="dwh-selecteur__curseur" aria-hidden="true"></span>
          {%- for block in centrales -%}
            <button
              type="button"
              class="dwh-onglet"
              role="tab"
              id="psi-onglet-{{ block.id }}"
              aria-controls="psi-panneau-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-psi-onglet="{{ forloop.index0 }}"
              data-slug="{{ block.settings.slug | default: block.settings.tab_label | handleize }}"
              data-sim="{{ block.settings.has_sim }}"
              data-rfid="{{ block.settings.has_rfid }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_label }}
              {%- if block.settings.tab_sub != blank -%}<small>{{ block.settings.tab_sub }}</small>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in centrales -%}
          {%- liquid
            assign p = block.settings.product
            assign v = p.selected_or_first_available_variant
            assign ref = 0
            if block.settings.ref_value != blank
              assign ref = block.settings.ref_value | remove: ' ' | remove: '€' | replace: ',', '.' | times: 100 | round
            endif
            assign eco = ref | minus: p.price
          -%}
          <div
            class="psi-panneau{% if forloop.first %} est-actif{% endif %}"
            id="psi-panneau-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="psi-onglet-{{ block.id }}"
            data-psi-idx="{{ forloop.index0 }}"
            data-prix="{{ p.price | money | escape }}"
            data-nom="{{ block.settings.title | escape }}"
            data-variante="{{ v.id }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- if block.settings.description != blank -%}<p class="psi-panneau__pour">{{ block.settings.description }}</p>{%- endif -%}
            <ul class="dwh-puces">
              {%- if block.settings.bullet_1 != blank -%}<li>{{ block.settings.bullet_1 }}</li>{%- endif -%}
              {%- if block.settings.bullet_2 != blank -%}<li>{{ block.settings.bullet_2 }}</li>{%- endif -%}
              {%- if block.settings.bullet_3 != blank -%}<li>{{ block.settings.bullet_3 }}</li>{%- endif -%}
            </ul>

            {%- if p == blank -%}
              <p class="psi-valeur">Sélectionnez le produit « {{ block.settings.tab_label }} » dans l'éditeur de thème.</p>
            {%- else -%}
              <div class="psi-prix">
                <div class="dwh-pack__prix">
                  <div>
                    <span class="dwh-pack__des">{{ section.settings.price_label }}</span>
                    <span class="dwh-pack__montant">{{ p.price | money }}</span>
                    {%- if eco > 0 -%}<s class="dwh-pack__barre">{{ ref | money }}</s>{%- endif -%}
                  </div>
                  <span class="dwh-pack__mois">0&nbsp;€/mois</span>
                </div>
                {%- if eco > 0 -%}
                  <p class="psi-eco">{% render 'dw-home-icon', icon: 'euro' %}Vous économisez {{ eco | money }}</p>
                {%- endif -%}
                <button type="button" class="dwh-btn dwh-btn--bleu" data-psi-ajout="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
                  {%- if v.available -%}
                    {{ section.settings.cta_label }}
                    {% render 'dw-home-icon', icon: 'arrow' %}
                  {%- else -%}
                    {{ section.settings.soldout_label }}
                  {%- endif -%}
                </button>
                {%- if eco > 0 -%}
                  {%- assign ref_txt = ref | money -%}
                  <p class="psi-valeur">{{ section.settings.value_note | replace: '[valeur]', ref_txt }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        <ul class="psi-rassure">
          {%- if section.settings.trust_1 != blank -%}<li>{% render 'dw-home-icon', icon: 'box' %}{{ section.settings.trust_1 }}</li>{%- endif -%}
          {%- if section.settings.trust_2 != blank -%}<li>{% render 'dw-home-icon', icon: 'badge' %}{{ section.settings.trust_2 }}</li>{%- endif -%}
          {%- if section.settings.trust_3 != blank -%}<li>{% render 'dw-home-icon', icon: 'return' %}{{ section.settings.trust_3 }}</li>{%- endif -%}
          {%- if section.settings.trust_4 != blank -%}<li>{% render 'dw-home-icon', icon: 'support' %}{{ section.settings.trust_4 }}</li>{%- endif -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} ============ Dans la boîte ============ {%- endcomment -%}
  {%- if objets.size > 0 -%}
    <section class="dwh-bloc dwh-bloc--porcelaine" aria-labelledby="psi-boite-{{ section.id }}">
      <div class="dwh-large">
        <div class="dwh-entete">
          {%- if section.settings.box_eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.box_eyebrow }}</p>{%- endif -%}
          <h2 class="dwh-titre" id="psi-boite-{{ section.id }}">{{ section.settings.box_title }}</h2>
          {%- if section.settings.box_text != blank -%}<p class="dwh-chapo">{{ section.settings.box_text }}</p>{%- endif -%}
        </div>

        <ul class="psi-boite">
          {%- for block in objets -%}
            {%- if block.settings.is_centrale -%}
              {%- comment -%} La centrale suit le choix du client {%- endcomment -%}
              {%- for c in centrales -%}
                {%- assign visuel = c.settings.centrale_image | default: c.settings.centrale_product.featured_image -%}
                <li class="psi-objet psi-objet--centrale" data-psi-idx="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
                  <span class="psi-objet__qte">×{{ block.settings.qty }}</span>
                  <div class="psi-objet__visuel">
                    {%- if visuel != blank -%}
                      {{ visuel | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '(min-width: 750px) 50vw, 45vw', loading: 'lazy', alt: c.settings.centrale_name }}
                    {%- else -%}
                      {% render 'dw-home-icon', icon: 'shield' %}
                    {%- endif -%}
                  </div>
                  <div class="psi-objet__corps">
                    <p class="psi-objet__nom">{{ c.settings.centrale_name }}</p>
                    {%- if c.settings.centrale_note != blank -%}<p class="psi-objet__ref">{{ c.settings.centrale_note }}</p>{%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- assign visuel = block.settings.image | default: block.settings.product.featured_image -%}
              <li
                class="psi-objet{% if block.settings.rfid_only %} psi-objet--offert{% endif %}"
                {% if block.settings.rfid_only %}data-psi-rfid{% unless c0.settings.has_rfid %} hidden{% endunless %}{% endif %}
                {{ block.shopify_attributes }}
              >
                <span class="psi-objet__qte">×{{ block.settings.qty }}</span>
                <div class="psi-objet__visuel">
                  {%- if visuel != blank -%}
                    {{ visuel | image_url: width: 500 | image_tag: widths: '200, 350, 500', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.name }}
                  {%- else -%}
                    {% render 'dw-home-icon', icon: 'box' %}
                  {%- endif -%}
                </div>
                <div class="psi-objet__corps">
                  <p class="psi-objet__nom">{{ block.settings.name }}</p>
                  {%- if block.settings.note != blank -%}<p class="psi-objet__ref">{{ block.settings.note }}</p>{%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.settings.box_footer != blank -%}
          <p class="psi-boite__pied">{{ section.settings.box_footer }}</p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============ Au quotidien ============ {%- endcomment -%}
  {%- if fonctions.size > 0 -%}
    <section class="dwh-bloc" aria-labelledby="psi-fonctions-{{ section.id }}">
      <div class="dwh-large dwh-deux">
        <div class="dwh-entete">
          {%- if section.settings.features_eyebrow != blank -%}<p class="dwh-surtitre">{{ section.settings.features_eyebrow }}</p>{%- endif -%}
          <h2 class="dwh-titre" id="psi-fonctions-{{ section.id }}">{{ section.settings.features_title }}</h2>
          {%- if section.settings.features_text != blank -%}<p class="dwh-chapo">{{ section.settings.features_text }}</p>{%- endif -%}
        </div>

        <div class="psi-fonctions">
          {%- for block in fonctions -%}
            <article
              class="psi-fonction{% if block.settings.dark %} psi-fonction--sombre{% endif %}"
              {% if block.settings.sim_only %}data-psi-sim{% unless c0.settings.has_sim %} hidden{% endunless %}{% endif %}
              {{ block.shopify_attributes }}
            >
              <span class="psi-fonction__ico" aria-hidden="true">
                {%- if block.settings.icon == 'horloge' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9.5 2.5h5"/></svg>
                {%- else -%}
                  {% render 'dw-home-icon', icon: block.settings.icon %}
                {%- endif -%}
              </span>
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              {%- if block.settings.modes != blank -%}
                {%- assign modes = block.settings.modes | split: ',' -%}
                <p class="psi-modes" aria-hidden="true">
                  {%- for mode in modes -%}
                    {%- assign m = mode | strip -%}
                    {%- if m != blank -%}<span{% if m contains '*' %} class="est-actif"{% endif %}>{{ m | remove: '*' }}</span>{%- endif -%}
                  {%- endfor -%}
                </p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============ Barre collante (mobile) ============ {%- endcomment -%}
  {%- if c0.settings.product != blank -%}
    <div class="dwh-collant" data-psi-collant aria-hidden="true">
      <div class="psi-collant__infos">
        <b data-psi-collant-prix>{{ c0.settings.product.price | money }}</b>
        <small data-psi-collant-nom>{{ c0.settings.title }}</small>
      </div>
      <button type="button" class="dwh-btn dwh-btn--bleu psi-collant__btn" data-psi-collant-ajout tabindex="-1">{{ section.settings.sticky_label }}</button>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var racine = document.querySelector('[data-psi="{{ section.id }}"]');
    if (!racine) return;

    var onglets = Array.prototype.slice.call(racine.querySelectorAll('[data-psi-onglet]'));
    var selecteur = racine.querySelector('[data-psi-selecteur]');
    var collant = racine.querySelector('[data-psi-collant]');
    var actif = 0;

    /* ---------- Ajout au panier : ouvre le panier latéral du thème ---------- */
    function ajouter(id, bouton) {
      if (!id) return Promise.resolve();
      if (bouton) bouton.setAttribute('aria-busy', 'true');
      var racineUrl = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      return fetch(racineUrl + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }] })
      })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw d; return d; }); })
        .then(function () {
          if (window.theme && theme.pubsub && theme.pubsub.PUB_SUB_EVENTS) {
            fetch(racineUrl + 'cart.js').then(function (r) { return r.json(); }).then(function (cart) {
              theme.pubsub.publish(theme.pubsub.PUB_SUB_EVENTS.cartUpdate, { source: 'offre-psi', cart: cart });
            }).catch(function () {});
          }
          if (document.querySelector('cart-drawer')) {
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { open: true } }));
          } else {
            window.location.href = {{ routes.cart_url | json }};
          }
        })
        .catch(function (e) {
          alert((e && (e.description || e.message)) || 'Ce produit n\'a pas pu être ajouté au panier. Merci de réessayer.');
          throw e;
        })
        .finally(function () { if (bouton) bouton.removeAttribute('aria-busy'); });
    }
    window.DaewooPsiAjouter = ajouter;

    racine.addEventListener('click', function (e) {
      var b = e.target.closest('[data-psi-ajout]');
      if (b) ajouter(b.getAttribute('data-psi-ajout'), b).catch(function () {});
    });

    /* ---------- Pas de carte orpheline sur 2 colonnes ---------- */
    function equilibrer() {
      [['.psi-fonction', 'psi-fonction--large'], ['.psi-objet:not(.psi-objet--centrale)', 'psi-objet--large']].forEach(function (r) {
        var cartes = Array.prototype.filter.call(racine.querySelectorAll(r[0]), function (c) { return !c.hidden; });
        cartes.forEach(function (c, k) { c.classList.toggle(r[1], cartes.length % 2 === 1 && k === cartes.length - 1); });
      });
    }
    equilibrer();

    /* ---------- Choix de la centrale ---------- */
    function choisir(i, depuisClic) {
      var onglet = onglets[i];
      if (!onglet) return;
      actif = i;
      onglets.forEach(function (o, k) {
        o.setAttribute('aria-selected', k === i ? 'true' : 'false');
        o.tabIndex = k === i ? 0 : -1;
      });
      selecteur.style.setProperty('--i', i);
      racine.querySelectorAll('[data-psi-idx]').forEach(function (el) {
        var visible = el.getAttribute('data-psi-idx') === String(i);
        el.hidden = !visible;
        if (el.classList.contains('psi-panneau')) el.classList.toggle('est-actif', visible);
      });
      var sim = onglet.getAttribute('data-sim') === 'true';
      var rfid = onglet.getAttribute('data-rfid') === 'true';
      racine.querySelectorAll('[data-psi-sim]').forEach(function (el) { el.hidden = !sim; });
      racine.querySelectorAll('[data-psi-rfid]').forEach(function (el) { el.hidden = !rfid; });
      equilibrer();

      var panneau = racine.querySelector('.psi-panneau[data-psi-idx="' + i + '"]');
      if (collant && panneau) {
        collant.querySelector('[data-psi-collant-prix]').textContent = panneau.getAttribute('data-prix');
        collant.querySelector('[data-psi-collant-nom]').textContent = panneau.getAttribute('data-nom');
      }
      if (depuisClic && window.history && history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('centrale', onglet.getAttribute('data-slug'));
        history.replaceState(history.state, '', url.toString());
      }
    }

    onglets.forEach(function (o, i) {
      o.addEventListener('click', function () { choisir(i, true); });
      o.addEventListener('keydown', function (e) {
        var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        var n = (i + d + onglets.length) % onglets.length;
        choisir(n, true);
        onglets[n].focus();
      });
    });

    var voulu = new URLSearchParams(window.location.search).get('centrale');
    if (voulu) onglets.forEach(function (o, i) { if (o.getAttribute('data-slug') === voulu) choisir(i, false); });

    /* ---------- Galerie : vignettes ---------- */
    racine.addEventListener('click', function (e) {
      var v = e.target.closest('[data-psi-vignette]');
      if (!v) return;
      var bloc = v.closest('[data-psi-idx]');
      var n = v.getAttribute('data-psi-vignette');
      bloc.querySelectorAll('[data-psi-image]').forEach(function (img) { img.classList.toggle('est-visible', img.getAttribute('data-psi-image') === n); });
      bloc.querySelectorAll('[data-psi-vignette]').forEach(function (x) { x.setAttribute('aria-current', x === v ? 'true' : 'false'); });
    });

    /* ---------- Compte à rebours ---------- */
    var compte = racine.querySelector('[data-psi-compte]');
    if (compte) {
      var fin = Date.parse(compte.getAttribute('data-fin'));
      var champs = { j: compte.querySelector('[data-j]'), h: compte.querySelector('[data-h]'), m: compte.querySelector('[data-m]'), s: compte.querySelector('[data-s]') };
      var deux = function (n) { return (n < 10 ? '0' : '') + n; };
      var tic = function () {
        var reste = fin - Date.now();
        if (isNaN(fin) || reste <= 0) {
          compte.querySelectorAll('[data-psi-encours]').forEach(function (el) { el.hidden = true; });
          compte.querySelector('[data-psi-fini]').hidden = false;
          return false;
        }
        var s = Math.floor(reste / 1000);
        champs.j.textContent = Math.floor(s / 86400);
        champs.h.textContent = deux(Math.floor((s % 86400) / 3600));
        champs.m.textContent = deux(Math.floor((s % 3600) / 60));
        champs.s.textContent = deux(s % 60);
        return true;
      };
      if (tic()) { var t = setInterval(function () { if (!tic()) clearInterval(t); }, 1000); }
    }

    /* ---------- Barre collante : visible une fois le bloc d'achat passé ---------- */
    if (collant && 'IntersectionObserver' in window) {
      var bouton = collant.querySelector('[data-psi-collant-ajout]');
      bouton.addEventListener('click', function () {
        var panneau = racine.querySelector('.psi-panneau[data-psi-idx="' + actif + '"]');
        ajouter(panneau && panneau.getAttribute('data-variante'), bouton).catch(function () {});
      });
      var achatPasse = false;
      var masques = new Set();
      var maj = function () {
        var visible = achatPasse && masques.size === 0;
        collant.classList.toggle('est-visible', visible);
        collant.setAttribute('aria-hidden', visible ? 'false' : 'true');
        bouton.tabIndex = visible ? 0 : -1;
      };
      new IntersectionObserver(function (e) {
        achatPasse = !e[0].isIntersecting && e[0].boundingClientRect.top < 0;
        maj();
      }).observe(racine.querySelector('.psi-achat'));
      var io = new IntersectionObserver(function (entrees) {
        entrees.forEach(function (e) { e.isIntersecting ? masques.add(e.target) : masques.delete(e.target); });
        maj();
      }, { rootMargin: '-35% 0px -35% 0px' });
      document.querySelectorAll('.dwh-final, footer, .footer').forEach(function (el) { io.observe(el); });
    }
  })();
</script>

