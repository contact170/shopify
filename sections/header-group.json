    "custom_liquid_ArzAHN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "<div id=\"top-banner\">\n  <div class=\"tb-inner\">\n    <span class=\"tb-badge\">Daewoo</span>\n    <div class=\"tb-ticker-wrapper\">\n      <div class=\"tb-ticker-track\">\n        <!-- Bloc 1 -->\n        <span class=\"tb-text\">\n          Le spécialiste de l'alarme sans abonnement &nbsp;·&nbsp; Pack alarme complet avec caméra à partir de <strong>139.90€ TTC</strong>\n        </span>\n        <a href=\"https://daewoo-security.fr/products/daewoo-vigilia-starter-pack?_pos=1&_psq=VIGILIA&_psid=324a8a3d4&_ss=e\" class=\"tb-link\">\n          Voir le pack →\n        </a>\n        <span class=\"tb-sep\">&nbsp;&nbsp;·&nbsp;&nbsp;</span>\n        <!-- Bloc 2 (copie pour boucle fluide) -->\n        <span class=\"tb-text\">\n          Le spécialiste de l'alarme sans abonnement &nbsp;·&nbsp; Pack alarme complet avec caméra à partir de <strong>139.90€ TTC</strong>\n        </span>\n        <a href=\"https://daewoo-security.fr/products/daewoo-vigilia-starter-pack?_pos=1&_psq=VIGILIA&_psid=324a8a3d4&_ss=e\" class=\"tb-link\">\n          Voir le pack →\n        </a>\n        <span class=\"tb-sep\">&nbsp;&nbsp;·&nbsp;&nbsp;</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  #top-banner {\n    width: 100%;\n    background: #0a0f2e;\n    border-bottom: 1px solid rgba(255,255,255,.08);\n    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);\n  }\n  #top-banner .tb-inner {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    max-width: 1280px;\n    margin: 0 auto;\n    height: 36px;\n    padding: 0 24px;\n    overflow: hidden;\n  }\n  #top-banner .tb-badge {\n    background: #1a4bdb;\n    color: #fff;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n    padding: 3px 8px;\n    border-radius: 3px;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  /* Ticker */\n  #top-banner .tb-ticker-wrapper {\n    overflow: hidden;\n    flex: 1;\n    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);\n    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);\n  }\n  #top-banner .tb-ticker-track {\n    display: inline-flex;\n    align-items: center;\n    gap: 20px;\n    white-space: nowrap;\n    animation: tb-scroll 20s linear infinite;\n  }\n  #top-banner .tb-ticker-track:hover {\n    animation-play-state: paused;\n  }\n  @keyframes tb-scroll {\n    0%   { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  #top-banner .tb-text {\n    font-size: 12.5px;\n    font-weight: 400;\n    color: rgba(255,255,255,.75);\n    white-space: nowrap;\n  }\n  #top-banner .tb-text strong {\n    font-weight: 800;\n    color: #ffd500;\n  }\n  #top-banner .tb-link {\n    font-size: 11.5px;\n    font-weight: 700;\n    color: #fff;\n    text-decoration: underline;\n    text-underline-offset: 2px;\n    white-space: nowrap;\n    flex-shrink: 0;\n    transition: opacity .15s;\n  }\n  #top-banner .tb-link:hover { opacity: .7; }\n  #top-banner .tb-sep {\n    color: rgba(255,255,255,.3);\n  }\n\n  /* ✅ Fix mobile */\n  @media (max-width: 640px) {\n    #top-banner .tb-inner {\n      gap: 8px;\n      padding: 0 12px;\n      height: 36px;\n      overflow: hidden;\n    }\n    #top-banner .tb-badge {\n      display: none;\n    }\n    #top-banner .tb-text {\n      font-size: 11px;\n      white-space: nowrap; /* empêche le retour à la ligne */\n      text-align: left;\n    }\n    #top-banner .tb-ticker-track {\n      animation-duration: 15s;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #top-banner .tb-ticker-track { animation: none; }\n  }\n</style>",
