  {%- comment -%}
    ── contenu du pack ──
    Deux formats de métachamp acceptés, décrits en tête de fichier. Une
    ligne sans quantité en tête est traitée comme une note de bas de bloc
    (« Piles, visserie et notices inclus »), pas comme un article.
  {%- endcomment -%}
  {%- if lignes_contenu.size > 0 and contenu_brut != blank -%}
    <section class="pv-section">
      <div class="pv-wrap">
        <div class="pv-contents__head pv-reveal">
          <span class="pv-eyebrow">Dans la boîte</span>
          <h2>Tout ce qu'il faut, dans un seul carton</h2>
          <p>
            {%- if nb_acc > 0 -%}
              La centrale {{ modele }}, {{ nb_acc }} accessoires
              {%- if nb_cam_ext > 0 %}, dont la protection extérieure{% endif %},
              et de quoi installer l'ensemble sans rien acheter d'autre.
            {%- else -%}
              De quoi installer l'ensemble sans rien acheter d'autre.
            {%- endif -%}
          </p>
        </div>

        <div class="pv-contents__grid pv-reveal">
          {%- assign notes = "" -%}
          {%- for ligne_brute in lignes_contenu -%}
            {%- liquid
              assign ligne = ligne_brute | strip_html | strip
              if ligne == blank
                continue
              endif
              if ligne contains "•"
                assign ligne = ligne | replace_first: "•", "" | strip
              endif

              assign qte = ""
              assign nom = ligne
              assign precision = ""

              if ligne contains "|"
                assign morceaux = ligne | split: "|"
                assign nom = morceaux[0] | strip
                assign precision = morceaux[1] | strip
              endif

              assign premier = nom | slice: 0
              if nom contains "×"
                assign deux = nom | split: "×"
                assign qte = deux[0] | strip
                assign nom = deux[1] | strip
              elsif "0123456789" contains premier
                assign mots = nom | split: " "
                assign qte = mots[0] | strip
                assign nom = nom | remove_first: mots[0] | strip
              endif
            -%}
            {%- if qte == blank -%}
              {%- assign notes = notes | append: nom | append: " " -%}
            {%- else -%}
              <div class="pv-contents__item">
                <span class="pv-contents__qty">{{ qte }}&times;</span>
                <div>
                  <div class="pv-contents__name">{{ nom }}</div>
                  {%- if precision != blank -%}
                    <div class="pv-contents__desc">{{ precision }}</div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if notes != blank -%}
          <p class="pv-contents__note pv-reveal">{{ notes | strip }}</p>
        {%- endif -%}

        {%- if product.metafields.custom.conseil_quantite != blank -%}
          <p class="pv-contents__note pv-reveal">{{ product.metafields.custom.conseil_quantite }}</p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

