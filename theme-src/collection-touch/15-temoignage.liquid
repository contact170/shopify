{% comment %} ── Témoignage client : Jean et Marie, Touch XL ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .tcm * { box-sizing:border-box; margin:0; padding:0; }
  .tcm { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#fff; color:#0b1220; padding:92px 24px; position:relative; overflow:hidden; }
  .tcm::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(680px 380px at 88% 30%,rgba(47,123,255,.07),transparent 64%); }
  .tcm-inner { position:relative; z-index:2; max-width:1140px; margin:0 auto;
    display:grid; grid-template-columns:.92fr 1.08fr; gap:56px; align-items:center; }

  .tcm-inner > * { min-width:0; }
  .tcm-visual { position:relative; }
  .tcm-frame { border-radius:24px; overflow:hidden; border:1px solid #e6ebf3; background:#f4f7fc;
    box-shadow:0 34px 74px -34px rgba(11,18,32,.40); }
  .tcm-frame img { width:100%; height:auto; display:block; }
  .tcm-badge { position:absolute; left:-14px; bottom:24px; display:inline-flex; align-items:center; gap:9px;
    padding:11px 18px; border-radius:99px; background:#fff; border:1px solid #dfe5ef;
    box-shadow:0 12px 30px -14px rgba(11,18,32,.32);
    font-size:12.5px; font-weight:500; color:#0b1220; }
  .tcm-badge svg { width:15px; height:15px; fill:none; stroke:#d9931f; stroke-width:2.4; stroke-linecap:round; stroke-linejoin:round; }

  .tcm-eyebrow { display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:600;
    letter-spacing:.2em; text-transform:uppercase; color:#5a6982; margin-bottom:16px; }
  .tcm-eyebrow::before { content:''; width:34px; height:1px; background:linear-gradient(90deg,#2f7bff,rgba(47,123,255,0)); }
  .tcm-title { font-size:clamp(26px,3.4vw,40px); font-weight:600; letter-spacing:-.03em; line-height:1.12; margin-bottom:16px; }
  .tcm-p { font-size:15.5px; color:#4a5a75; font-weight:300; line-height:1.68; max-width:520px; }
  .tcm-p + .tcm-p { margin-top:12px; }
  .tcm-p b { color:#0b1220; font-weight:500; }

  .tcm-facts { display:flex; gap:10px; flex-wrap:wrap; margin:26px 0 30px; }
  .tcm-fact { display:inline-flex; align-items:center; gap:8px; padding:10px 16px; border-radius:9px;
    background:#f4f7fc; border:1px solid #dfe5ef; font-size:13px; font-weight:500; color:#0b1220; }
  .tcm-fact svg { width:14px; height:14px; fill:none; stroke:#2f7bff; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }

  .tcm-b { display:inline-flex; align-items:center; gap:9px; padding:15px 26px; border-radius:10px;
    background:#0b1220; color:#fff; font-size:14.5px; font-weight:600; text-decoration:none;
    box-shadow:0 12px 30px -10px rgba(11,18,32,.45); transition:transform .18s; }
  .tcm-b:hover { transform:translateY(-2px); }
  .tcm-b svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }

  @media (max-width:960px) {
    .tcm-inner { grid-template-columns:1fr; gap:38px; }
    .tcm-visual { max-width:460px; }
    .tcm-badge { left:16px; }
  }
  @media (max-width:600px) { .tcm { padding:70px 20px; } }
</style>

<section class="tcm">
  <div class="tcm-inner">
    <div class="tcm-visual">
      <div class="tcm-frame">
        <img src="https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Capture_d_ecran_le_2025-10-30_a_13.45.18.png?v=1761828328" alt="Jean et Marie, clients Daewoo Security, ont équipé leur maison de campagne d'un système Touch XL" loading="lazy" width="932" height="940">
      </div>
      <span class="tcm-badge"><svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>Jean &amp; Marie · Système Touch XL</span>
    </div>

    <div>
      <span class="tcm-eyebrow">Témoignage client</span>
      <h2 class="tcm-title">Ils ont choisi<br>Daewoo Security.</h2>
      <p class="tcm-p">Jean et Marie, 48 et 46 ans, ont protégé leur maison à la campagne avec le système <b>Touch XL</b>.</p>
      <p class="tcm-p">Découvrez <b>leur configuration sur mesure</b>, les détecteurs extérieurs installés et le coût global de leur solution.</p>

      <div class="tcm-facts">
        <span class="tcm-fact"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>Maison à la campagne</span>
        <span class="tcm-fact"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/></svg>Centrale Touch XL</span>
        <span class="tcm-fact"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M5.5 5.5a9 9 0 0 0 0 13"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>Détecteurs extérieurs</span>
      </div>

      <a class="tcm-b" href="https://daewoo-security.fr/pages/ils-ont-choisi-daewoo-security">
        Voir leur configuration
        <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>
