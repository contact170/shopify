<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .tce * { box-sizing:border-box; margin:0; padding:0; }
  .tce { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#eef2f8; color:#0b1220; padding:92px 24px; position:relative; overflow:hidden; }
  .tce::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(800px 420px at 78% 20%,rgba(232,160,44,.10),transparent 62%); }
  .tce-inner { position:relative; z-index:2; max-width:1160px; margin:0 auto; }
  .tce-head { display:grid; grid-template-columns:1.1fr .9fr; gap:48px; align-items:end; margin-bottom:36px; }
  .tce-eyebrow { font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:#5a6982; margin-bottom:14px; }
  .tce-title { font-size:clamp(26px,3.4vw,40px); font-weight:600; color:#0b1220; letter-spacing:-.03em; line-height:1.12; }
  .tce-title em { font-style:normal; color:#8f5d0c; }
  .tce-sub { font-size:15px; color:#4a5a75; font-weight:300; line-height:1.7; }
  .tce-sub b { color:#0b1220; font-weight:500; }

  /* grille de vignettes compactes : tout tient à l'écran, aucun défilement */
  .tce-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
  .tce-item { display:flex; align-items:center; gap:14px; padding:12px 16px 12px 12px;
    background:#fff; border:1px solid #dfe5ef; border-radius:14px;
    text-decoration:none; color:inherit; transition:transform .18s, border-color .18s, box-shadow .18s; }
  .tce-item:hover { transform:translateY(-3px); border-color:#b9c7dd; box-shadow:0 14px 30px -20px rgba(11,18,32,.40); }
  .tce-thumb { flex:none; width:64px; height:64px; border-radius:10px; background:#f4f7fc; border:1px solid #eef1f7;
    display:flex; align-items:center; justify-content:center; padding:7px; overflow:hidden; }
  .tce-thumb img { max-width:100%; max-height:100%; object-fit:contain; display:block; }
  .tce-txt { min-width:0; }
  .tce-ref { font-size:10px; font-weight:700; letter-spacing:.14em; color:#1c5fd0; display:block; margin-bottom:3px; }
  .tce-nm { display:block; font-size:13.5px; font-weight:600; color:#0b1220; letter-spacing:-.015em; line-height:1.3; margin-bottom:3px; }
  .tce-pr { display:block; font-size:12.5px; color:#5a6982; font-weight:300; }

  .tce-foot { margin-top:28px; display:flex; gap:16px; align-items:center; flex-wrap:wrap; }
  .tce-btn { display:inline-flex; align-items:center; gap:9px; padding:14px 24px; border-radius:10px;
    background:#0b1220; border:1px solid #0b1220; color:#fff;
    font-size:14px; font-weight:600; text-decoration:none; transition:opacity .18s, transform .18s; }
  .tce-btn:hover { opacity:.88; transform:translateY(-2px); }
  .tce-hint { font-size:13px; color:#5a6982; font-weight:300; }

  @media (max-width:1000px) { .tce-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:900px) { .tce-head { grid-template-columns:1fr; gap:20px; } .tce { padding:72px 20px; } }
  @media (max-width:560px) { .tce-grid { grid-template-columns:1fr; } }
</style>

