{% comment %} ── Gamme Touch / Touch XL — Hero "backlit" + bandeau de confiance ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .tc-scope { --tc-ink:#05080f; --tc-ink2:#0a1120; --tc-surf:#111c30; --tc-line:rgba(255,255,255,.10);
    --tc-txt:#eaf0fb; --tc-mut:#93a2bd; --tc-blue:#4da3ff; --tc-gold:#f5b544; }
  .tc-hero * { box-sizing:border-box; margin:0; padding:0; }
  .tc-hero { position:relative; overflow:hidden; background:#05080f; color:#eaf0fb;
    font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    padding:96px 24px 104px; }
  .tc-hero::before { content:''; position:absolute; inset:0;
    background:
      radial-gradient(900px 480px at 78% 30%, rgba(77,163,255,.22), transparent 62%),
      radial-gradient(700px 420px at 12% 82%, rgba(245,181,68,.12), transparent 60%);
    pointer-events:none; }
  .tc-hero::after { content:''; position:absolute; inset:0; opacity:.35; pointer-events:none;
    background-image:linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
                     linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size:64px 64px;
    -webkit-mask-image:radial-gradient(circle at 50% 40%, #000 0%, transparent 78%);
            mask-image:radial-gradient(circle at 50% 40%, #000 0%, transparent 78%); }
  .tc-hero-inner { position:relative; z-index:2; max-width:1200px; margin:0 auto;
    display:grid; grid-template-columns:1.05fr .95fr; gap:56px; align-items:center; }
  .tc-eyebrow { display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:600;
    letter-spacing:.20em; text-transform:uppercase; color:#9fb6da; margin-bottom:22px; }
  .tc-eyebrow::before { content:''; width:34px; height:1px; background:linear-gradient(90deg,var(--tc-blue),transparent); }
  .tc-h1 { font-size:clamp(34px,4.6vw,58px); font-weight:600; line-height:1.05; letter-spacing:-.03em; margin-bottom:20px; }
  .tc-h1 em { font-style:normal; background:linear-gradient(100deg,#4da3ff 0%,#8fd0ff 45%,#f5b544 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent; }
  .tc-lead { font-size:16.5px; line-height:1.65; color:#a9b8d2; max-width:520px; margin-bottom:30px; font-weight:300; }
  .tc-models { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:32px; }
  .tc-chip { display:inline-flex; align-items:baseline; gap:8px; padding:9px 16px; border-radius:8px;
    background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.12); font-size:13px; font-weight:500; }
  .tc-chip b { font-weight:600; letter-spacing:.04em; }
  .tc-chip.is-blue b { color:#7cbcff; } .tc-chip.is-gold b { color:#ffcd72; }
  .tc-chip span { font-size:12px; color:#8fa1bd; font-weight:300; }
  .tc-ctas { display:flex; gap:12px; flex-wrap:wrap; }
  .tc-btn { display:inline-flex; align-items:center; gap:9px; padding:15px 26px; border-radius:10px;
    font-size:14.5px; font-weight:600; text-decoration:none; transition:transform .18s, box-shadow .18s, background .18s; }
  .tc-btn svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  .tc-btn--main { background:linear-gradient(120deg,#2f7bff,#4da3ff); color:#fff; box-shadow:0 12px 30px rgba(47,123,255,.34); }
  .tc-btn--main:hover { transform:translateY(-2px); box-shadow:0 18px 40px rgba(47,123,255,.44); }
  .tc-btn--ghost { background:rgba(255,255,255,.06); color:#eaf0fb; border:1px solid rgba(255,255,255,.16); }
  .tc-btn--ghost:hover { background:rgba(255,255,255,.11); transform:translateY(-2px); }
  .tc-hero-visual { position:relative; }
  .tc-hero-visual img { width:100%; height:auto; display:block; border-radius:20px;
    box-shadow:0 40px 90px rgba(0,0,0,.55); }
  .tc-glow { position:absolute; inset:-8% -6%; border-radius:50%; z-index:-1; filter:blur(70px);
    background:radial-gradient(circle,rgba(77,163,255,.38),transparent 66%); }
  .tc-float { position:absolute; left:-26px; bottom:34px; display:flex; align-items:center; gap:12px;
    padding:13px 18px; border-radius:13px; background:rgba(11,18,32,.82); border:1px solid rgba(255,255,255,.13);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); box-shadow:0 18px 40px rgba(0,0,0,.45); }
  .tc-float-dot { width:9px; height:9px; border-radius:50%; background:#3ddc97; box-shadow:0 0 0 5px rgba(61,220,151,.16); }
  .tc-float-t { font-size:13px; font-weight:600; display:block; }
  .tc-float-s { font-size:11.5px; color:#8fa1bd; font-weight:300; }

  /* bandeau de confiance : ligne fine, pas de cartes */
  .tc-trust { position:relative; z-index:2; background:#080e1a; border-top:1px solid rgba(255,255,255,.08);
    border-bottom:1px solid rgba(255,255,255,.08);
    font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; }
  .tc-trust-inner { max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); }
  .tc-trust-cell { padding:26px 24px; border-left:1px solid rgba(255,255,255,.07); display:flex; gap:13px; align-items:flex-start; }
  .tc-trust-cell:first-child { border-left:0; }
  .tc-trust-cell svg { width:19px; height:19px; flex:none; margin-top:2px; fill:none; stroke:#4da3ff; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
  .tc-trust-t { display:block; font-size:13.5px; font-weight:600; color:#eaf0fb; letter-spacing:-.01em; }
  .tc-trust-s { display:block; font-size:12px; color:#8093b3; font-weight:300; margin-top:2px; }

  @media (max-width:1000px) {
    .tc-hero-inner { grid-template-columns:1fr; gap:40px; }
    .tc-hero { padding:72px 20px 80px; }
    .tc-trust-inner { grid-template-columns:repeat(2,1fr); }
    .tc-trust-cell:nth-child(3) { border-left:0; }
    .tc-trust-cell:nth-child(-n+2) { border-bottom:1px solid rgba(255,255,255,.07); }
  }
  @media (max-width:560px) {
    .tc-float { left:12px; bottom:12px; }
    .tc-trust-inner { grid-template-columns:1fr; }
    .tc-trust-cell { border-left:0; border-bottom:1px solid rgba(255,255,255,.07); padding:20px; }
  }
</style>

<section class="tc-hero tc-scope">
  <div class="tc-hero-inner">
    <div>
      <span class="tc-eyebrow">Gamme Touch · AM301 &amp; AM302</span>
      <h1 class="tc-h1">L'alarme qui se pilote<br>du bout des <em>doigts</em>.</h1>
      <p class="tc-lead">Deux centrales à écran tactile, une même promesse&nbsp;: tout comprendre en un coup d'œil, tout commander en un geste. Sans abonnement, sans technicien, sans perçage.</p>
      <div class="tc-models">
        <span class="tc-chip is-blue"><b>TOUCH</b> <span>écran 4,3'' · 199,90 €</span></span>
        <span class="tc-chip is-gold"><b>TOUCH XL</b> <span>écran 7'' · 299,90 €</span></span>
      </div>
      <div class="tc-ctas">
        <a class="tc-btn tc-btn--main" href="#tc-duel">
          Comparer les 2 centrales
          <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a class="tc-btn tc-btn--ghost" href="https://daewoo-security.fr/pages/configurateur_2">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
          Configurer mon système
        </a>
      </div>
    </div>
    <div class="tc-hero-visual">
      <div class="tc-glow"></div>
      <img src="https://cdn.shopify.com/s/files/1/0326/3132/4811/files/ChatGPT_Image_30_avr._2026_11_20_36.png?v=1777540859" alt="Centrale d'alarme Daewoo Touch à écran tactile" loading="eager" width="900" height="700">
      <div class="tc-float">
        <span class="tc-float-dot"></span>
        <span>
          <span class="tc-float-t">Système armé · Mode Total</span>
          <span class="tc-float-s">12 accessoires connectés</span>
        </span>
      </div>
    </div>
  </div>
</section>

<div class="tc-trust tc-scope">
  <div class="tc-trust-inner">
    <div class="tc-trust-cell">
      <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      <span><span class="tc-trust-t">Installation en 30 min</span><span class="tc-trust-s">Sans câblage ni perçage</span></span>
    </div>
    <div class="tc-trust-cell">
      <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      <span><span class="tc-trust-t">Sans abonnement</span><span class="tc-trust-s">Application incluse à vie</span></span>
    </div>
    <div class="tc-trust-cell">
      <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span><span class="tc-trust-t">SAV basé en France</span><span class="tc-trust-s">Support 7j/7</span></span>
    </div>
    <div class="tc-trust-cell">
      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
      <span><span class="tc-trust-t">Garantie 2 ans</span><span class="tc-trust-s">Retour gratuit 14 jours</span></span>
    </div>
  </div>
</div>
