<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .elp * { box-sizing:border-box; margin:0; padding:0; }
  .elp { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#f1f3f2; color:#0d1520; padding:92px 24px 98px; }
  .elp-inner { max-width:1200px; margin:0 auto; }
  .elp-head { text-align:center; max-width:640px; margin:0 auto 50px; }
  .elp-eyebrow { display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:600;
    letter-spacing:.2em; text-transform:uppercase; color:#5c6a75; margin-bottom:16px; }
  .elp-eyebrow::before,.elp-eyebrow::after { content:''; width:28px; height:1px; background:#c3d1cf; }
  .elp-title { font-size:clamp(27px,3.6vw,42px); font-weight:600; letter-spacing:-.035em; line-height:1.1; margin-bottom:14px; }
  .elp-sub { font-size:15.5px; color:#4b5a63; font-weight:300; line-height:1.65; }

  .elp-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; align-items:stretch; }
  .elp-card { background:#fff; border:1px solid #e2e7e6; border-radius:20px; overflow:hidden;
    display:flex; flex-direction:column; box-shadow:0 18px 44px -30px rgba(13,21,32,.30); position:relative; }
  .elp-card--hero { border-color:#0d1520; box-shadow:0 26px 60px -30px rgba(13,21,32,.48); }
  .elp-flag { position:absolute; top:0; left:0; right:0; height:4px; background:#12a0ad; }
  .elp-card--hero .elp-flag { background:linear-gradient(90deg,#0a6068,#12a0ad); }
  .elp-shot { background:#f1f3f2; border-bottom:1px solid #e9edec; padding:14px; }
  .elp-shot img { width:100%; height:230px; object-fit:contain; display:block; }
  .elp-body { padding:26px 26px 28px; display:flex; flex-direction:column; flex:1; }
  .elp-badge { display:inline-block; align-self:flex-start; font-size:10px; font-weight:700; letter-spacing:.16em;
    text-transform:uppercase; padding:5px 10px; border-radius:5px; margin-bottom:14px;
    background:#eef1f0; color:#4b5a63; }
  .elp-badge--hot { background:#0d1520; color:#fff; }
  .elp-badge--max { background:rgba(18,160,173,.13); color:#0a6068; }
  .elp-n { font-size:20px; font-weight:600; letter-spacing:-.025em; line-height:1.25; margin-bottom:6px; }
  .elp-for { font-size:13.5px; color:#5c6a75; font-weight:300; line-height:1.5; margin-bottom:20px; }
  .elp-ul { display:flex; flex-direction:column; gap:10px; margin-bottom:22px; flex:1; }
  .elp-li { display:grid; grid-template-columns:auto 1fr; gap:11px; font-size:13.5px; color:#4b5a63;
    font-weight:300; line-height:1.5; }
  .elp-li b { display:inline-block; min-width:26px; font-weight:600; color:#0a6068; font-variant-numeric:tabular-nums; }
  .elp-li span b { min-width:0; color:#0d1520; font-weight:500; }
  .elp-price { padding-top:18px; border-top:1px solid #eef1f0; margin-bottom:16px; }
  .elp-from { display:block; font-size:12px; color:#5c6a75; font-weight:300; margin-bottom:2px; }
  .elp-amt { font-size:27px; font-weight:600; letter-spacing:-.03em; color:#0d1520; }
  .elp-was { font-size:14px; color:#5c6a75; font-weight:300; text-decoration:line-through; margin-left:9px; }
  .elp-save { display:inline-block; font-size:11px; font-weight:700; letter-spacing:.06em; padding:3px 8px;
    border-radius:5px; background:rgba(18,160,173,.13); color:#0a6068; margin-left:9px; vertical-align:2px; }
  .elp-buy { display:flex; align-items:center; justify-content:center; gap:9px; padding:14px 22px; border-radius:9px;
    font-size:14px; font-weight:600; text-decoration:none; transition:transform .18s, border-color .18s; }
  .elp-buy:hover { transform:translateY(-2px); }
  .elp-buy--1 { background:#fff; color:#0d1520; border:1px solid #d9e0df; }
  .elp-buy--1:hover { border-color:#0a6068; }
  .elp-buy--2 { background:#0d1520; color:#fff; box-shadow:0 12px 28px -10px rgba(13,21,32,.5); }
  .elp-buy svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  .elp-foot { text-align:center; margin-top:30px; font-size:13.5px; color:#5c6a75; font-weight:300; }
  .elp-foot a { color:#0a6068; font-weight:500; text-decoration:none; border-bottom:1px solid rgba(10,96,104,.35); }

  @media (max-width:1000px) { .elp-grid { grid-template-columns:1fr; max-width:460px; margin:0 auto; } }
  @media (max-width:600px) { .elp { padding:70px 20px 76px; } .elp-body { padding:24px 20px 26px; } }
</style>

