{% comment %} ── Passerelle Zigbee intégrée + radio 433 / 868 MHz — schéma deux réseaux ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .elz * { box-sizing:border-box; margin:0; padding:0; }
  .elz { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#fff; color:#0d1520; padding:94px 24px; position:relative; overflow:hidden; }
  .elz::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(700px 420px at 22% 50%,rgba(18,160,173,.08),transparent 64%); }
  .elz-inner { position:relative; z-index:2; max-width:1140px; margin:0 auto;
    display:grid; grid-template-columns:1.05fr .95fr; gap:60px; align-items:center; }
  .elz-eyebrow { display:inline-flex; align-items:center; gap:10px; font-size:11px; font-weight:600;
    letter-spacing:.2em; text-transform:uppercase; color:#5c6a75; margin-bottom:16px; }
  .elz-eyebrow::before { content:''; width:34px; height:1px; background:linear-gradient(90deg,#12a0ad,rgba(18,160,173,0)); }
  .elz-title { font-size:clamp(26px,3.5vw,40px); font-weight:600; letter-spacing:-.035em; line-height:1.1; margin-bottom:16px; }
  .elz-sub { font-size:15.5px; color:#4b5a63; font-weight:300; line-height:1.68; margin-bottom:34px; max-width:500px; }
  .elz-sub b { color:#0d1520; font-weight:500; }

  .elz-list { display:flex; flex-direction:column; gap:2px; }
  .elz-row { display:grid; grid-template-columns:auto 1fr; gap:16px; padding:17px 0; border-top:1px solid #e9edec; }
  .elz-row:last-child { border-bottom:1px solid #e9edec; }
  .elz-row svg { width:19px; height:19px; margin-top:2px; fill:none; stroke:#0a6068; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .elz-rt { font-size:15px; font-weight:600; letter-spacing:-.015em; margin-bottom:4px; }
  .elz-rd { font-size:13.8px; color:#4b5a63; font-weight:300; line-height:1.58; }
  .elz-rd b { color:#0d1520; font-weight:500; }
  .elz-warn { display:inline-block; font-size:12px; font-weight:500; color:#8a5a12; background:rgba(217,147,31,.14);
    padding:3px 9px; border-radius:5px; margin-top:7px; }

  .elz-visual { display:flex; align-items:center; justify-content:center; }
  .elz-card { width:100%; max-width:460px; background:#0d1520; border-radius:24px; padding:34px 30px 30px;
    box-shadow:0 36px 78px -34px rgba(13,21,32,.55); position:relative; overflow:hidden; }
  .elz-card::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(460px 300px at 50% 12%,rgba(18,160,173,.28),transparent 68%); }
  .elz-card > * { position:relative; z-index:2; }
  .elz-cl { font-size:11px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; color:#12a0ad; text-align:center; margin-bottom:6px; }
  .elz-cs { font-size:13px; font-weight:300; color:#a8b6bd; text-align:center; line-height:1.55; margin-bottom:16px; }
  .elz-svg { display:block; width:100%; height:auto; }
  .elz-legend { margin-top:18px; padding-top:18px; border-top:1px solid rgba(255,255,255,.14);
    display:flex; justify-content:center; gap:22px; flex-wrap:wrap; }
  .elz-lg { font-size:11.5px; color:#a8b6bd; font-weight:300; display:inline-flex; align-items:center; gap:7px; }
  .elz-lg i { width:16px; height:2px; flex:none; display:inline-block; border-radius:2px; }

  @media (max-width:960px) { .elz-inner { grid-template-columns:1fr; gap:44px; } .elz { padding:72px 20px; } }
</style>

<section class="elz">
  <div class="elz-inner">
    <div>
      <span class="elz-eyebrow">Passerelle Zigbee intégrée</span>
      <h2 class="elz-title">Une passerelle Zigbee en plus de la radio d'alarme.</h2>
      <p class="elz-sub">La centrale Élite embarque une <b>passerelle Zigbee</b>. Trois accessoires de la gamme l'utilisent — le contacteur <b>WDS502Z</b>, le détecteur de vibration <b>WVD502Z</b> et le clavier <b>WKE502Z</b> — et elle sert aussi de porte d'entrée vers des périphériques Zigbee du marché.</p>

      <div class="elz-list">
        <div class="elz-row">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="2.2"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l2.8 2.8M16.2 16.2 19 19M19 5l-2.8 2.8M7.8 16.2 5 19"/></svg>
          <div>
            <p class="elz-rt">Trois références en Zigbee, le reste en 433 / 868 MHz</p>
            <p class="elz-rd">Seuls les <b>WDS502Z, WVD502Z et WKE502Z</b> passent par le Zigbee. Les détecteurs de mouvement, sirènes, télécommandes, badges, détecteurs de fumée et de fuite d'eau utilisent la <b>fréquence radio 433 ou 868 MHz</b>.</p>
          </div>
        </div>
        <div class="elz-row">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 11.5 13.5 15.5 9"/></svg>
          <div>
            <p class="elz-rt">Liaison chiffrée et bidirectionnelle</p>
            <p class="elz-rd">La centrale et chaque accessoire se répondent et vérifient l'échange. <b>Le brouillage et l'interception sont bloqués</b>&nbsp;: un ordre ne part pas dans le vide, il est confirmé.</p>
          </div>
        </div>
        <div class="elz-row">
          <svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>
          <div>
            <p class="elz-rt">Ouverte sur la maison connectée</p>
            <p class="elz-rd">La passerelle accepte des accessoires <b>Zigbee 3.0 et Tuya</b> du marché, pour déclencher des scénarios&nbsp;: fermer les volets à l'armement, allumer une lumière sur détection.</p>
            <span class="elz-warn">Compatibilité non garantie selon les marques</span>
          </div>
        </div>
        <div class="elz-row">
          <svg viewBox="0 0 24 24"><path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.5 16a5.5 5.5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1.2"/><path d="M1.5 9a15 15 0 0 1 21 0"/></svg>
          <div>
            <p class="elz-rt">Amplificateur d'ondes EXT501</p>
            <p class="elz-rd">Si la maison est grande ou les murs épais, il étend la portée du réseau Zigbee — donc <b>celle des trois références 502Z uniquement</b>.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="elz-visual">
      <div class="elz-card">
        <p class="elz-cl">Deux réseaux, une centrale</p>
        <p class="elz-cs">La passerelle Zigbee d'un côté, le 433 / 868 MHz de l'autre.</p>
        <svg class="elz-svg" viewBox="0 0 360 320" role="img" aria-label="Schéma : la centrale Élite relie en Zigbee le contacteur WDS502Z, le détecteur de vibration WVD502Z et le clavier WKE502Z, et en radio 433 ou 868 MHz les détecteurs de mouvement, sirènes et télécommandes">
          <text x="66" y="24" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="10" font-weight="600" fill="#12a0ad" letter-spacing="1.2">ZIGBEE</text>
          <text x="294" y="24" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="10" font-weight="600" fill="#8f9ba4" letter-spacing="1.2">433 / 868 MHz</text>

          <g stroke="#12a0ad" stroke-width="1.6" stroke-dasharray="4 5" fill="none">
            <line x1="180" y1="170" x2="66" y2="72"/>
            <line x1="180" y1="170" x2="66" y2="170"/>
            <line x1="180" y1="170" x2="66" y2="268"/>
          </g>
          <g stroke="#5b6b76" stroke-width="1.6" stroke-dasharray="4 5" fill="none">
            <line x1="180" y1="170" x2="294" y2="72"/>
            <line x1="180" y1="170" x2="294" y2="170"/>
            <line x1="180" y1="170" x2="294" y2="268"/>
          </g>

          <circle cx="180" cy="170" r="48" fill="rgba(18,160,173,.16)"/>
          <circle cx="180" cy="170" r="34" fill="#12a0ad"/>
          <text x="180" y="167" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="11" font-weight="600" fill="#04252a">Élite</text>
          <text x="180" y="180" text-anchor="middle" font-family="Poppins,Arial,sans-serif" font-size="9" fill="#04252a">PA501Z</text>

          <g font-family="Poppins,Arial,sans-serif" font-size="8.5" fill="#cfdadd" text-anchor="middle">
            <circle cx="66" cy="72"  r="28" fill="#16232f" stroke="#12a0ad" stroke-width="1.4"/><text x="66" y="70">Ouverture</text><text x="66" y="81" font-size="7.5" fill="#8fa3ab">WDS502Z</text>
            <circle cx="66" cy="170" r="28" fill="#16232f" stroke="#12a0ad" stroke-width="1.4"/><text x="66" y="168">Vibration</text><text x="66" y="179" font-size="7.5" fill="#8fa3ab">WVD502Z</text>
            <circle cx="66" cy="268" r="28" fill="#16232f" stroke="#12a0ad" stroke-width="1.4"/><text x="66" y="266">Clavier</text><text x="66" y="277" font-size="7.5" fill="#8fa3ab">WKE502Z</text>

            <circle cx="294" cy="72"  r="28" fill="#16232f" stroke="#5b6b76" stroke-width="1.4"/><text x="294" y="70">Mouvement</text><text x="294" y="81" font-size="7.5" fill="#8fa3ab">WPS501…</text>
            <circle cx="294" cy="170" r="28" fill="#16232f" stroke="#5b6b76" stroke-width="1.4"/><text x="294" y="168">Sirènes</text><text x="294" y="179" font-size="7.5" fill="#8fa3ab">WOS501S</text>
            <circle cx="294" cy="268" r="28" fill="#16232f" stroke="#5b6b76" stroke-width="1.4"/><text x="294" y="266">Commande</text><text x="294" y="277" font-size="7.5" fill="#8fa3ab">WRC501…</text>
          </g>
        </svg>
        <div class="elz-legend">
          <span class="elz-lg"><i style="background:#12a0ad"></i>Zigbee (références 502Z)</span>
          <span class="elz-lg"><i style="background:#5b6b76"></i>Radio 433 / 868 MHz</span>
        </div>
      </div>
    </div>
  </div>
</section>
