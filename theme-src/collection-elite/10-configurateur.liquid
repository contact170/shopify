{% comment %} ── Configurateur — bandeau horizontal + remise jusqu'à -25 % ── {% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  .elc * { box-sizing:border-box; margin:0; padding:0; }
  .elc { font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
    background:#f1f3f2; padding:88px 24px 92px; }
  .elc-inner { max-width:1160px; margin:0 auto; }
  .elc-band { background:#0d1520; border-radius:24px; padding:46px 48px 48px; color:#fff;
    position:relative; overflow:hidden; box-shadow:0 34px 76px -36px rgba(13,21,32,.55); }
  .elc-band::before { content:''; position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(680px 340px at 88% 20%,rgba(18,160,173,.32),transparent 66%),
               radial-gradient(520px 300px at 4% 100%,rgba(18,160,173,.14),transparent 62%); }
  .elc-top { position:relative; z-index:2; display:grid; grid-template-columns:1.25fr .75fr;
    gap:48px; align-items:center; padding-bottom:36px; border-bottom:1px solid rgba(255,255,255,.14); }
  .elc-eyebrow { display:inline-flex; align-items:center; gap:9px; font-size:11px; font-weight:600;
    letter-spacing:.18em; text-transform:uppercase; color:#12a0ad; margin-bottom:16px; }
  .elc-title { font-size:clamp(25px,3.3vw,38px); font-weight:600; letter-spacing:-.035em; line-height:1.12; margin-bottom:14px; }
  .elc-title em { font-style:normal; color:#12a0ad; }
  .elc-sub { font-size:15.5px; color:#c2ced3; font-weight:300; line-height:1.68; max-width:520px; }

  .elc-medal { text-align:center; }
  .elc-pre { font-size:14px; font-weight:300; color:#a8b6bd; margin-bottom:2px; }
  .elc-big { font-size:clamp(58px,8vw,86px); font-weight:600; letter-spacing:-.05em; line-height:1; color:#fff; }
  .elc-cap { font-size:12.5px; font-weight:500; letter-spacing:.06em; text-transform:uppercase; color:#12a0ad; margin-top:6px; }

  .elc-bottom { position:relative; z-index:2; padding-top:34px;
    display:grid; grid-template-columns:repeat(3,1fr) auto; gap:32px; align-items:end; }
  .elc-step { display:grid; grid-template-columns:auto 1fr; gap:14px; align-items:flex-start; }
  .elc-n { width:28px; height:28px; border-radius:9px; flex:none; background:rgba(18,160,173,.18); color:#12a0ad;
    display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:600; }
  .elc-sn { font-size:14.5px; font-weight:500; color:#fff; margin-bottom:4px; line-height:1.35; }
  .elc-sd { font-size:13px; color:#a8b6bd; font-weight:300; line-height:1.55; }
  .elc-cta { display:inline-flex; align-items:center; gap:9px; padding:16px 28px; border-radius:9px;
    background:#12a0ad; color:#04252a; font-size:14.5px; font-weight:600; text-decoration:none;
    white-space:nowrap; transition:transform .18s; }
  .elc-cta:hover { transform:translateY(-2px); }
  .elc-cta svg { width:17px; height:17px; fill:none; stroke:currentColor; stroke-width:2.4; stroke-linecap:round; stroke-linejoin:round; }

  @media (max-width:1000px) {
    .elc-top { grid-template-columns:1fr; gap:30px; text-align:left; }
    .elc-medal { text-align:left; }
    .elc-bottom { grid-template-columns:1fr; gap:22px; align-items:start; }
    .elc-cta { justify-content:center; }
  }
  @media (max-width:600px) { .elc { padding:66px 20px; } .elc-band { padding:34px 24px 36px; } }
</style>

<section class="elc" aria-label="Configurateur Daewoo Security">
  <div class="elc-inner">
    <div class="elc-band">
      <div class="elc-top">
        <div>
          <span class="elc-eyebrow">Configurateur · 2 minutes</span>
          <h2 class="elc-title">Pas sûr du nombre de détecteurs&nbsp;?<br><em>Laissez le configurateur le calculer.</em></h2>
          <p class="elc-sub">Quelques questions sur votre logement et vos habitudes, et il compose votre système Élite&nbsp;: la centrale, le bon nombre de capteurs, les caméras s'il en faut — puis il applique la remise à l'ensemble de la configuration.</p>
        </div>
        <div class="elc-medal">
          <p class="elc-pre">jusqu'à</p>
          <p class="elc-big">−25&nbsp;%</p>
          <p class="elc-cap">sur votre configuration</p>
        </div>
      </div>

      <div class="elc-bottom">
        <div class="elc-step"><span class="elc-n">1</span><div><p class="elc-sn">Décrivez votre logement</p><p class="elc-sd">Type de bien, ouvertures à protéger, animaux.</p></div></div>
        <div class="elc-step"><span class="elc-n">2</span><div><p class="elc-sn">Recevez votre configuration</p><p class="elc-sd">Une liste claire, chiffrée, sans surdimensionner.</p></div></div>
        <div class="elc-step"><span class="elc-n">3</span><div><p class="elc-sn">Ajustez, puis validez</p><p class="elc-sd">Vous restez libre d'ajouter ou de retirer un accessoire.</p></div></div>
        <a class="elc-cta" href="https://daewoo-security.fr/pages/configurateur_2">
          Configurer mon système
          <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
