            composer une installation selon le logement et les équipements souhaités. Les
            commandes sont préparées et expédiées depuis Mérignac.
          </p>
          <a class="dwsa-link" href="/pages/pack-alarmes">Voir les packs alarme disponibles</a>
        </div>
        {%- if section.settings.resellers_text != blank -%}
          <div class="dwsa-buy-side">
            <h3>Distributeurs et marketplaces</h3>
            {{ section.settings.resellers_text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ 12 · FAQ ============ {%- endcomment -%}
  <section class="dwsa-sec dwsa-sec--mist">
    <div class="dwsa-wrap dwsa-wrap--narrow">
      <p class="dwsa-eyebrow">Questions fréquentes</p>
      <h2>Questions fréquentes sur Daewoo Security</h2>
      <div class="dwsa-faq">
        {%- for question in faq_questions -%}
          <details{% if forloop.first %} open{% endif %}>
            <summary><h3>{{ question }}</h3></summary>
            <div class="dwsa-answer">{{ faq_answers[forloop.index0] }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ 13 · CTA final ============ {%- endcomment -%}
  <section class="dwsa-sec dwsa-sec--navy dwsa-cta">
    <div class="dwsa-wrap">
      <h2>Trouvez le système Daewoo Security adapté à votre logement</h2>
      <div class="dwsa-btns">
        <a class="dwsa-btn dwsa-btn--primary" href="/pages/configurateur_2">Configurer mon alarme</a>
        <a class="dwsa-btn dwsa-btn--ghost" href="/pages/comparateur-am301-sa501-pa501z">Comparer les systèmes</a>
      </div>
    </div>
  </section>

</div>

