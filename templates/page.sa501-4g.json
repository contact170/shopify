{"sections":{"custom_liquid_nktG48":{"type":"custom-liquid","name":"t:sections.custom-liquid.name","settings":{"liquid":"<div class=\"hero-4g\">\n  <div class=\"hero-4g__inner\">\n    <div class=\"hero-4g__badge\">\n      <span class=\"hero-4g__dot\"><\/span>\n      Offre exclusive · Clients Daewoo Key\n    <\/div>\n    <h1 class=\"hero-4g__title\">\n      Votre alarme passe à la <em>4G<\/em>.<br>Avant que la 2G ne disparaisse.\n    <\/h1>\n    <p class=\"hero-4g__sub\">\n      Les opérateurs français arrêteront progressivement le réseau 2G en 2026. \n      Pour éviter toute interruption, remplacez uniquement votre centrale — \n      tous vos accessoires restent compatibles.\n    <\/p>\n    <div class=\"hero-4g__chips\">\n      <span>✓ Accessoires conservés<\/span>\n      <span>✓ Installation &lt; 15 min<\/span>\n      <span>✓ 99,90 € · livraison offerte<\/span>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.hero-4g {\n  background: linear-gradient(135deg, #1a1f33 0%, #2c3556 100%);\n  border-radius: 14px;\n  padding: 48px 40px;\n  margin: 0 0 32px 0;\n  position: relative;\n  overflow: hidden;\n}\n.hero-4g::before {\n  content: '';\n  position: absolute;\n  top: -60px; right: -60px;\n  width: 320px; height: 320px;\n  background: radial-gradient(circle, rgba(232,55,42,.18) 0%, transparent 70%);\n  pointer-events: none;\n}\n.hero-4g__inner {\n  position: relative;\n  z-index: 1;\n  max-width: 620px;\n}\n.hero-4g__badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  background: rgba(232,55,42,.15);\n  border: 1px solid rgba(232,55,42,.35);\n  color: #ff8577;\n  font-size: .72rem;\n  font-weight: 800;\n  letter-spacing: .07em;\n  text-transform: uppercase;\n  padding: 5px 12px;\n  border-radius: 20px;\n  margin-bottom: 18px;\n}\n.hero-4g__dot {\n  width: 6px; height: 6px;\n  background: #e8372a;\n  border-radius: 50%;\n  animation: hdot 1.5s ease infinite;\n}\n@keyframes hdot {\n  0%,100% { opacity:1; transform:scale(1); }\n  50% { opacity:.2; transform:scale(1.6); }\n}\n.hero-4g__title {\n  font-size: clamp(1.6rem, 3.5vw, 2.4rem);\n  font-weight: 900;\n  color: #ffffff;\n  line-height: 1.15;\n  margin: 0 0 16px 0;\n}\n.hero-4g__title em {\n  font-style: normal;\n  background: linear-gradient(110deg, #ff6b5b, #ffaa44);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n.hero-4g__sub {\n  font-size: .9rem;\n  color: rgba(255,255,255,.65);\n  line-height: 1.7;\n  margin: 0 0 24px 0;\n  max-width: 520px;\n}\n.hero-4g__chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.hero-4g__chips span {\n  background: rgba(255,255,255,.08);\n  border: 1px solid rgba(255,255,255,.15);\n  color: rgba(255,255,255,.8);\n  font-size: .75rem;\n  font-weight: 700;\n  padding: 6px 13px;\n  border-radius: 20px;\n}\n@media (max-width: 600px) {\n  .hero-4g { padding: 32px 20px; }\n  .hero-4g__title { font-size: 1.5rem; }\n}\n<\/style>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":0,"divider":false,"narrow":false,"rounded":false}},"custom_liquid_9cpLhC":{"type":"custom-liquid","name":"t:sections.custom-liquid.name","settings":{"liquid":"<div class=\"why-migrate\">\n  <h2 class=\"why-migrate__title\">Pourquoi migrer maintenant ?<\/h2>\n  <div class=\"why-migrate__grid\">\n    <div class=\"why-migrate__item\">\n      <div class=\"why-migrate__icon\">📡<\/div>\n      <strong>Le 2G s'arrête en 2026<\/strong>\n      <p>Les opérateurs français éteignent progressivement le réseau 2G. Sans action, votre alarme perdra sa connexion GSM.<\/p>\n    <\/div>\n    <div class=\"why-migrate__item\">\n      <div class=\"why-migrate__icon\">🔗<\/div>\n      <strong>Rien d'autre à changer<\/strong>\n      <p>Seule la centrale est remplacée. Tous vos détecteurs, sirènes et télécommandes restent compatibles.<\/p>\n    <\/div>\n    <div class=\"why-migrate__item\">\n      <div class=\"why-migrate__icon\">⚡<\/div>\n      <strong>Prêt en 15 minutes<\/strong>\n      <p>Installation guidée via l'application Daewoo Home Connect. Sans technicien, sans outil particulier.<\/p>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.why-migrate {\n  background: #1a1f33;\n  border-radius: 14px;\n  padding: 28px 24px 24px;\n  margin: 16px 0 16px;\n}\n.why-migrate__title {\n  font-size: 1rem;\n  font-weight: 900;\n  color: #ffffff;\n  margin-bottom: 16px;\n  text-align: center;\n  text-transform: uppercase;\n  letter-spacing: .06em;\n}\n.why-migrate__grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 12px;\n}\n.why-migrate__item {\n  background: rgba(255,255,255,.06);\n  border: 1px solid rgba(255,255,255,.1);\n  border-radius: 10px;\n  padding: 18px 16px;\n  text-align: center;\n  transition: background .2s;\n}\n.why-migrate__item:hover {\n  background: rgba(232,55,42,.12);\n  border-color: rgba(232,55,42,.3);\n}\n.why-migrate__icon {\n  font-size: 1.6rem;\n  margin-bottom: 10px;\n}\n.why-migrate__item strong {\n  display: block;\n  font-size: .85rem;\n  font-weight: 800;\n  color: #ffffff;\n  margin-bottom: 7px;\n}\n.why-migrate__item p {\n  font-size: .76rem;\n  color: rgba(255,255,255,.55);\n  line-height: 1.6;\n  margin: 0;\n}\n@media (max-width: 600px) {\n  .why-migrate__grid { grid-template-columns: 1fr; }\n}\n<\/style>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":72,"divider":false,"narrow":false,"rounded":false}},"multicolumn_with_icons_DTmJMA":{"type":"multicolumn-with-icons","blocks":{"column_DKWiGW":{"type":"column","settings":{"icon":"star","custom_icon":"","heading":"Accessoires conservés","text":"<p>Rien d'autre à acheter<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"column_qLAJt8":{"type":"column","settings":{"icon":"box","custom_icon":"","heading":"Module 4G intégré","text":"<p>Couverture