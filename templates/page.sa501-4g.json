","name":"t:sections.custom-liquid.name","settings":{"liquid":"<div class=\"reassurance-bar\">\n  <div class=\"reassurance-bar__item\">\n    <span class=\"reassurance-bar__ico\">📦<\/span>\n    <div>\n      <strong>Livraison offerte<\/strong>\n      <span>France & Belgique dès 50€<\/span>\n    <\/div>\n  <\/div>\n  <div class=\"reassurance-bar__item\">\n    <span class=\"reassurance-bar__ico\">↩<\/span>\n    <div>\n      <strong>14 jours pour changer d'avis<\/strong>\n      <span>Retour simple et gratuit<\/span>\n    <\/div>\n  <\/div>\n  <div class=\"reassurance-bar__item\">\n    <span class=\"reassurance-bar__ico\">🛡<\/span>\n    <div>\n      <strong>Garantie 2 ans<\/strong>\n      <span>Sur tous nos produits<\/span>\n    <\/div>\n  <\/div>\n  <div class=\"reassurance-bar__item\">\n    <span class=\"reassurance-bar__ico\">💬<\/span>\n    <div>\n      <strong>Support français<\/strong>\n      <span>Réactif & disponible<\/span>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.reassurance-bar {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  background: #1a1f33;\n  border-radius: 14px;\n  overflow: hidden;\n  margin: 16px 0;\n}\n.reassurance-bar__item {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  padding: 18px 16px;\n  border-right: 1px solid rgba(255,255,255,.08);\n  transition: background .2s;\n}\n.reassurance-bar__item:last-child { border-right: none; }\n.reassurance-bar__item:hover { background: rgba(232,55,42,.1); }\n.reassurance-bar__ico { font-size: 1.3rem; flex-shrink: 0; }\n.reassurance-bar__item strong {\n  display: block;\n  font-size: .8rem;\n  font-weight: 800;\n  color: #ffffff;\n  margin-bottom: 2px;\n}\n.reassurance-bar__item span {\n  font-size: .72rem;\n  color: rgba(255,255,255,.5);\n}\n@media (max-width: 768px) {\n  .reassurance-bar { grid-template-columns: repeat(2, 1fr); }\n  .reassurance-bar__item:nth-child(2) { border-right: none; }\n  .reassurance-bar__item:nth-child(3),\n  .reassurance-bar__item:nth-child(4) { border-top: 1px solid rgba(255,255,255,.08); }\n  .reassurance-bar__item:nth-child(4) { border-right: none; }\n}\n@media (max-width: 480px) {\n  .reassurance-bar { grid-template-columns: 1fr; }\n  .reassurance-bar__item { border-right: none; border-top: 1px solid rgba(255,255,255,.08); }\n  .reassurance-bar__item:first-child { border-top: none; }\n}\n<\/style>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":72,"divider":false,"narrow":false,"rounded":false}},"rich_text_BDDwXB":{"type":"rich-text","blocks":{"heading_WrMeid":{"type":"heading","settings":{"heading":"Notre collection d'accessoires compatible SA501","heading_size":"title-md","heading_tag":"h2","highlighted_text":"none","highlighted_scribble":"circle"}},"text_BKQLcE":{"type":"text","settings":{"text":"<p>Renforcez votre installation–20% avec votre codeProfitez du changement pour compléter votre alarme. La remise s'applique automatiquement avec le code promo.<\/p>","text_font":"body","text_size":"subtext-md","text_max_size":32,"text_line_height":1.6,"text_letter_spacing":0,"text_capitalize":false,"secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}},"liquid_FFPfYk":{"type":"liquid","disabled":true,"settings":{"liquid":"{% comment %}\n  Encart code promo — Migration 4G\n  À placer dans la page ou dans une section Shopify\n{% endcomment %}\n\n<div class=\"promo-encart\">\n  <div class=\"promo-encart__inner\">\n\n    <div class=\"promo-encart__left\">\n      <div class=\"promo-encart__icon\">🎁<\/div>\n      <div class=\"promo-encart__text\">\n        <strong>–20% sur tous les accessoires<\/strong>\n        <span>Offre exclusive réservée aux clients concernés par la migration 2G. Valable sur les accessoires uniquement.<\/span>\n      <\/div>\n    <\/div>\n\n    <div class=\"promo-encart__right\">\n      <div class=\"promo-encart__label\">Votre code promo<\/div>\n      <button class=\"promo-encart__code\" id=\"promoCodeBtn\" onclick=\"copyPromoCode(this)\" aria-label=\"Copier le code KEY20\">\n        <span class=\"promo-encart__code-text\">KEY20<\/span>\n        <span class=\"promo-encart__copy-icon\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"\/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"\/>\n          <\/svg>\n        <\/span>\n      <\/button>\n      <div class=\"promo-encart__feedback\" id=\"promoFeedback\" aria-live=\"polite\"><\/div>\n    <\/div>\n\n  <\/div>\n<\/div>\n\n<style>\n  .promo-encart {\n    background: linear-gradient(135deg, #0f4d2b 0%, #1a7a44 100%);\n    border-radius: 12px;\n    padding: 20px 24px;\n    margin: 28px 0;\n    font-family: 'Nunito', sans-serif;\n  }\n  .promo-encart__inner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    flex-wrap: wrap;\n  }\n  .promo-encart__left {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    flex: 1;\n    min-width: 220px;\n  }\n  .promo-encart__icon { font-size: 1.6rem; flex-shrink: 0; }\n  .promo-encart__text strong {\n    display: block;\n    font-size: .95rem;\n    font-weight: 800;\n    color: #ffffff;\n    margin-bottom: 3px;\n  }\n  .promo-encart__text span {\n    font-size: .78rem;\n    color: rgba(255,255,255,.65);\n    line-height: 1.5;\n  }\n  .promo-encart__right {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 6px;\n    flex-shrink: 0;\n  }\n  .promo-encart__label {\n    font-size: .68rem;\n    font-weight: 700;\n    color: rgba(255,255,255,.55);\n    text-transform: uppercase;\n    letter-spacing: .08em;\n  }\n  .promo-encart__code {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(255,255,255,.12);\n    border: 1.5px dashed rgba(255,255,255,.45);\n    color: #ffffff;\n    padding: 9px 18px;\n    border-radius: 8px;\n    cursor: pointer;\n    transition: background .2s, border-color .2s, transform .15s;\n    font-family: 'Courier New', Courier, monospace;\n    font-size: 1rem;\n    font-weight: 700;\n    letter-spacing: .14em;\n    white-space: nowrap;\n  }\n  .promo-encart__code:hover {\n    background: rgba(255,255,255,.22);\n    border-color: rgba(255,255,255,.7);\n    transform: translateY(-1px);\n  }\n  .promo-encart__code.copied {\n    background: rgba(255,255,255,.25);\n    border-color: #ffffff;\n    border-style: solid;\n  }\n  .promo-encart__copy-icon { opacity: .7; display: flex; align-items: center; }\n  .promo-encart__feedback {\n    font-size: .72rem;\n    font-weight: 700;\n    color: rgba(255,255,255,.85);\n    min-height: 16px;\n    text-align: right;\n    transition: opacity .2s;\n  }\n  @media (max-width: 600px) {\n    .promo-encart__inner { flex-direction: column; align-items: flex-start; }\n    .promo-encart__right { align-items: flex-start; width: 100%; }\n    .promo-encart__code { width: 100%; justify-content: center; }\n  }\n<\/style>\n\n<script>\n  function copyPromoCode(btn) {\n    var code = 'KEY20';\n    var feedback = document.getElementById('promoFeedback');\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(code).catch(function() { fallbackCopy(code); });\n    } else {\n      fallbackCopy(code);\n    }\n    btn.classList.add('copied');\n    btn.querySelector('.promo-encart__code-text').textContent = '✓ Copié !';\n    feedback.textContent = 'Code copié dans le presse-papier';\n    setTimeout(function() {\n      btn.classList.remove('copied');\n      btn.querySelector('.promo-encart__code-text').textContent = 'KEY20';\n      feedback.textContent = '';\n    }, 2000);\n  }\n  function fallbackCopy(text) {\n    var el = document.createElement('textarea');\n    el.value = text;\n    el.style.position = 'fixed';\n    el.style.opacity = '0';\n    document.body.appendChild(el);\n    el.focus();\n    el.select();\n    try { document.execCommand('copy'); } catch(e) {}\n    document.body.removeChild(el);\n  }\n<\/script>"}}},"block_order":["heading_WrMeid","text_BKQLcE","liquid_FFPfYk"],"name":"t:sections.rich-text.name","settings":{"text_alignment":"center","text_alignment_mobile":"center","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":72,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"collection_landing_DDABEP":{"type":"collection-landing","name":"Collection Landing","settings":{"collection":"special-sa501-4g","show_header":true,"title":"","subtitle":"Découvrez tous nos produits","show_sold_out":false,"btn_mode":"atc","btn_label_atc":"Ajouter au panier","btn_label_link":"Voir le produit","btn_bg_color":"#0c1e4a","btn_txt_color":"#ffffff","img_ratio":"1\/1","columns":4,"gap":24,"max_width":1400,"section_padding":64,"bg_color":"#f2f3ff","empty_message":"Aucun produit disponible dans cette collection."}},"featured_collection_dbb6iY":{"type":"featured-collection","disabled":true,"name":"t:sections.featured-collection.name","settings":{"collection":"accessoires","products":[],"product_limit":12,"columns":5,"carousel_on_desktop":false,"show_view_all":true,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Accessoires compatibles SA501","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","descrip