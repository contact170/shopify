    "custom_liquid_V3TkXD": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "<style>\n  .dcb-banner {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Segoe UI\", Helvetica, Arial, sans-serif;\n    background: #000000;\n    border-radius: 24px;\n    padding: 64px 48px;\n    margin: 0 auto;\n    max-width: 1160px;\n    text-align: center;\n    box-sizing: border-box;\n  }\n  .dcb-banner * { box-sizing: border-box; }\n\n  .dcb-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 6px 16px;\n    border-radius: 980px;\n    background: rgba(255,255,255,0.08);\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 500;\n  }\n\n  .dcb-title {\n    margin: 22px auto 12px;\n    max-width: 620px;\n    font-size: clamp(26px, 3.6vw, 38px);\n    font-weight: 600;\n    line-height: 1.1;\n    color: #ffffff;\n    letter-spacing: -0.02em;\n  }\n\n  .dcb-subtitle {\n    margin: 0 auto;\n    max-width: 480px;\n    font-size: 15px;\n    line-height: 1.55;\n    color: rgba(255,255,255,0.6);\n  }\n\n  .dcb-ctas {\n    margin-top: 34px;\n    display: flex;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: 14px;\n  }\n\n  .dcb-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 14px 28px;\n    border-radius: 980px;\n    font-size: 15px;\n    font-weight: 500;\n    text-decoration: none;\n    transition: opacity 0.2s ease, transform 0.2s ease;\n  }\n\n  .dcb-btn svg {\n    width: 16px;\n    height: 16px;\n    stroke: currentColor;\n    fill: none;\n    stroke-width: 2.2;\n    transition: transform 0.2s ease;\n  }\n\n  .dcb-btn:hover svg {\n    transform: translateX(3px);\n  }\n\n  .dcb-btn--primary {\n    background: #ffffff;\n    color: #1d1d1f;\n  }\n\n  .dcb-btn--primary:hover {\n    opacity: 0.85;\n    color: #1d1d1f;\n    transform: translateY(-1px);\n    text-decoration: none;\n  }\n\n  .dcb-btn--secondary {\n    background: transparent;\n    color: #ffffff;\n    border: 1px solid rgba(255,255,255,0.3);\n  }\n\n  .dcb-btn--secondary:hover {\n    border-color: rgba(255,255,255,0.6);\n    color: #ffffff;\n    transform: translateY(-1px);\n    text-decoration: none;\n  }\n\n  @media (max-width: 640px) {\n    .dcb-banner { padding: 48px 24px; border-radius: 18px; }\n    .dcb-ctas { flex-direction: column; align-items: stretch; }\n    .dcb-btn { justify-content: center; }\n  }\n</style>\n\n<section class=\"dcb-banner\">\n  <span class=\"dcb-tag\">\n    <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>\n    Sans abonnement · Sans engagement\n  </span>\n  <h2 class=\"dcb-title\">Prêt à passer à l'action ?</h2>\n  <p class=\"dcb-subtitle\">Choisissez un pack prêt à poser ou laissez notre configurateur composer le système parfait pour votre logement, en 2 minutes.</p>\n  <div class=\"dcb-ctas\">\n    <a href=\"https://daewoo-security.fr/pages/pack-alarmes?_pos=1&_psq=pack&_ss=e&_v=1.0\" class=\"dcb-btn dcb-btn--primary\">\n      Voir les packs\n      <svg viewBox=\"0 0 24 24\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg>\n    </a>\n    <a href=\"https://daewoo-security.fr/pages/configurateur_2\" class=\"dcb-btn dcb-btn--secondary\">\n      Configurer mon système\n      <svg viewBox=\"0 0 24 24\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg>\n    </a>\n  </div>\n</section>",
