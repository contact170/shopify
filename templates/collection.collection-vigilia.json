        "liquid": "<style>\n  .inst-section * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .inst-section {\n    background: #000000;\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Segoe UI\", Helvetica, Arial, sans-serif;\n    overflow: hidden;\n    position: relative;\n    min-height: 440px;\n    display: flex;\n    align-items: stretch;\n  }\n\n  .inst-left {\n    flex: 1;\n    min-width: 260px;\n    padding: 64px 48px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n\n  .inst-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    background: rgba(255,255,255,0.08);\n    color: rgba(255,255,255,0.9);\n    font-size: 12px;\n    font-weight: 500;\n    padding: 5px 14px;\n    border-radius: 980px;\n    margin-bottom: 24px;\n    width: fit-content;\n  }\n\n  .inst-tag::before {\n    content: '';\n    width: 6px;\n    height: 6px;\n    background: #30d158;\n    border-radius: 50%;\n    display: inline-block;\n  }\n\n  .inst-title {\n    font-size: clamp(24px, 3.2vw, 34px);\n    font-weight: 600;\n    color: #fff;\n    margin-bottom: 40px;\n    line-height: 1.12;\n    letter-spacing: -0.02em;\n  }\n\n  .inst-steps {\n    display: flex;\n    flex-direction: column;\n    gap: 26px;\n  }\n\n  .inst-step {\n    display: flex;\n    gap: 16px;\n    align-items: flex-start;\n  }\n\n  .inst-num {\n    background: rgba(255,255,255,0.1);\n    color: #fff;\n    border-radius: 50%;\n    width: 30px;\n    height: 30px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 13px;\n    font-weight: 600;\n    flex-shrink: 0;\n    margin-top: 1px;\n  }\n\n  .inst-step-title {\n    font-size: 15px;\n    font-weight: 600;\n    color: #fff;\n    margin-bottom: 4px;\n    letter-spacing: -0.005em;\n  }\n\n  .inst-step-desc {\n    font-size: 13.5px;\n    color: rgba(255,255,255,0.55);\n    line-height: 1.5;\n  }\n\n  .inst-right {\n    flex: 0 0 45%;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .inst-right img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    display: block;\n    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 20%);\n    mask-image: linear-gradient(to right, transparent 0%, black 20%);\n  }\n\n  @media (max-width: 768px) {\n    .inst-section { flex-direction: column; }\n    .inst-left { padding: 44px 24px; }\n    .inst-right {\n      flex: 0 0 280px;\n      width: 100%;\n    }\n    .inst-right img {\n      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%);\n      mask-image: linear-gradient(to bottom, transparent 0%, black 20%);\n    }\n  }\n</style>\n\n<div class=\"inst-section\">\n\n  <div class=\"inst-left\">\n    <div class=\"inst-tag\">Installation facile</div>\n    <h2 class=\"inst-title\">Installée en 30 minutes,<br>même sans bricolage</h2>\n    <div class=\"inst-steps\">\n\n      <div class=\"inst-step\">\n        <div class=\"inst-num\">1</div>\n        <div>\n          <p class=\"inst-step-title\">Déballez et positionnez</p>\n          <p class=\"inst-step-desc\">Placez les capteurs aux endroits stratégiques</p>\n        </div>\n      </div>\n\n      <div class=\"inst-step\">\n        <div class=\"inst-num\">2</div>\n        <div>\n          <p class=\"inst-step-title\">Associez à l'application</p>\n          <p class=\"inst-step-desc\">Scannez le QR code, tout se configure automatiquement</p>\n        </div>\n      </div>\n\n      <div class=\"inst-step\">\n        <div class=\"inst-num\">3</div>\n        <div>\n          <p class=\"inst-step-title\">Activez et dormez tranquille</p>\n          <p class=\"inst-step-desc\">Votre maison est protégée dès la première nuit</p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <div class=\"inst-right\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Daewoo_Vigilia_-_Alarme_