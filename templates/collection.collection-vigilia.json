        "liquid": "<style>\n  .pkv-section * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .pkv-section {\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Segoe UI\", Helvetica, Arial, sans-serif;\n    padding: 96px 24px;\n    background: #f5f5f7;\n    overflow: hidden;\n  }\n\n  .pkv-inner { max-width: 1160px; margin: 0 auto; }\n\n  .pkv-header { text-align: center; margin-bottom: 56px; }\n\n  .pkv-tag {\n    display: inline-flex;\n    align-items: center;\n    background: rgba(0,113,227,0.08);\n    color: #0071e3;\n    font-size: 12px;\n    font-weight: 600;\n    padding: 5px 14px;\n    border-radius: 980px;\n    margin-bottom: 16px;\n    letter-spacing: 0.02em;\n  }\n\n  .pkv-title {\n    font-size: clamp(28px, 3.6vw, 40px);\n    font-weight: 600;\n    color: #1d1d1f;\n    line-height: 1.1;\n    letter-spacing: -0.02em;\n    margin-bottom: 14px;\n  }\n\n  .pkv-subtitle {\n    font-size: 16px;\n    color: #6e6e73;\n    max-width: 520px;\n    margin: 0 auto;\n    line-height: 1.5;\n  }\n\n  .pkv-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n    margin-bottom: 48px;\n    align-items: stretch;\n  }\n\n  .pkv-card {\n    border-radius: 20px;\n    overflow: hidden;\n    position: relative;\n    transition: transform 0.2s, box-shadow 0.2s;\n    background: #fff;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .pkv-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 16px 36px rgba(0,0,0,0.08);\n  }\n\n  .pkv-card.featured {\n    box-shadow: 0 0 0 2px #0071e3;\n  }\n\n  .pkv-card-badge {\n    position: absolute;\n    top: 14px;\n    right: 14px;\n    background: #0071e3;\n    color: #fff;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 4px 12px;\n    border-radius: 980px;\n    white-space: nowrap;\n    z-index: 2;\n  }\n\n  .pkv-card-img-wrap {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n    background: #f5f5f7;\n    flex-shrink: 0;\n  }\n\n  .pkv-card-img-wrap img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    display: block;\n  }\n\n  .pkv-card-body {\n    padding: 26px;\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n  }\n\n  .pkv-card-ref {\n    font-size: 11px;\n    font-weight: 600;\n    color: #86868b;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    margin-bottom: 5px;\n  }\n\n  .pkv-card-title {\n    font-size: 17px;\n    font-weight: 600;\n    color: #1d1d1f;\n    margin-bottom: 4px;\n    line-height: 1.3;\n    letter-spacing: -0.01em;\n  }\n\n  .pkv-card-desc {\n    font-size: 12.5px;\n    color: #86868b;\n    margin-bottom: 16px;\n  }\n\n  .pkv-price {\n    font-size: 22px;\n    font-weight: 600;\n    color: #1d1d1f;\n    margin-bottom: 18px;\n    letter-spacing: -0.01em;\n  }\n\n  .pkv-divider {\n    height: 1px;\n    background: rgba(0,0,0,0.08);\n    margin-bottom: 18px;\n  }\n\n  .pkv-features {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin-bottom: 26px;\n    flex: 1;\n  }\n\n  .pkv-feature {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    font-size: 12.5px;\n    color: #424245;\n    line-height: 1.45;\n  }\n\n  .pkv-feature-dot {\n    width: 17px;\n    height: 17px;\n    border-radius: 50%;\n    background: #eef5ff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    margin-top: 1px;\n  }\n\n  .pkv-feature-dot svg {\n    width: 9px;\n    height: 9px;\n    stroke: #0071e3;\n    fill: none;\n    stroke-width: 2.5;\n  }\n\n  .pkv-card-btn {\n    display: block;\n    text-align: center;\n    padding: 12px 20px;\n    border-radius: 980px;\n    font-size: 14px;\n    font-weight: 500;\n    text-decoration: none;\n    transition: opacity 0.2s, transform 0.15s;\n    margin-top: auto;\n  }\n\n  .pkv-card-btn:hover { opacity: 0.85; transform: translateY(-1px); text-decoration: none; }\n\n  .pkv-card-btn.outline {\n    background: #f5f5f7;\n    color: #1d1d1f;\n  }\n\n  .pkv-card-btn.outline:hover { color: #1d1d1f; }\n\n  .pkv-card-btn.solid {\n    background: #1d1d1f;\n    color: #fff;\n  }\n\n  .pkv-card-btn.solid:hover { color: #fff; }\n\n  .pkv-cta {\n    background: #1d1d1f;\n    border-radius: 20px;\n    padding: 36px 44px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    flex-wrap: wrap;\n  }\n\n  .pkv-cta-title { font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 4px; letter-spacing: -0.01em; }\n  .pkv-cta-sub { font-size: 13.5px; color: rgba(255,255,255,0.6); }\n\n  .pkv-cta-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #fff;\n    color: #1d1d1f;\n    font-size: 14px;\n    font-weight: 500;\n    padding: 13px 26px;\n    border-radius: 980px;\n    text-decoration: none;\n    transition: opacity 0.2s, transform 0.15s;\n    white-space: nowrap;\n  }\n\n  .pkv-cta-btn:hover { opacity: 0.85; color: #1d1d1f; transform: translateY(-1px); text-decoration: none; }\n\n  .pkv-cta-btn svg {\n    width: 16px; height: 16px;\n    stroke: currentColor; fill: none; stroke-width: 2;\n    transition: transform 0.2s;\n  }\n\n  .pkv-cta-btn:hover svg { transform: translateX(3px); }\n\n  @media (max-width: 768px) {\n    .pkv-section { padding: 64px 0; }\n    .pkv-header { padding: 0 24px; }\n    .pkv-cta-wrap { padding: 0 24px; }\n\n    .pkv-grid {\n      display: flex;\n      flex-wrap: nowrap;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      gap: 16px;\n      padding: 8px 24px 16px;\n      margin-bottom: 32px;\n      scrollbar-width: none;\n      align-items: stretch;\n    }\n\n    .pkv-grid::-webkit-scrollbar { display: none; }\n\n    .pkv-card {\n      flex: 0 0 78vw;\n      max-width: 320px;\n      scroll-snap-align: start;\n    }\n\n    .pkv-cta { flex-direction: column; text-align: center; }\n  }\n</style>\n\n<div class=\"pkv-section\">\n  <div class=\"pkv-inner\">\n\n    <div class=\"pkv-header\">\n      <div class=\"pkv-tag\">Nos packs alarme</div>\n      <h2 class=\"pkv-title\">Tout ce qu'il faut pour<br>protéger votre maison</h2>\n      <p class=\"pkv-subtitle\">Chaque pack Vigilia est composé par nos experts pour couvrir votre logement sans avoir à chercher quoi acheter.</p>\n    </div>\n\n    <div class=\"pkv-grid\">\n\n      <!-- Pack Starter Vigilia -->\n      <div class=\"pkv-card\">\n        <div class=\"pkv-card-img-wrap\">\n          <img src=\"https://daewoo-security.fr/cdn/shop/files/958b5e1e-36cd-47db-93da-efc4b7f2d77c.jpg?v=1770108516&width=1600\" alt=\"Starter Pack Vigilia\">\n        </div>\n        <div class=\"pkv-card-body\">\n          <p class=\"pkv-card-ref\">Starter</p>\n          <p class=\"pkv-card-title\">Starter Pack Vigilia</p>\n          <p class=\"pkv-card-desc\">Appartement / Maison — l'essentiel pour démarrer</p>\n          <p class=\"pkv-price\">À partir de 139,90 €</p>\n          <div class=\"pkv-divider\"></div>\n          <div class=\"pkv-features\">\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Centrale Vigilia sans fil — clavier tactile + sirène 85 dB\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Caméra intérieure IP506P — Full HD\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              2× Contacteurs WDV301 + 1× Détecteur mouvement WPS305\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              1× Télécommande WRC305 + 2× Badges RFID\n            </div>\n          </div>\n          <a href=\"https://daewoo-security.fr/products/daewoo-vigilia-starter-pack?_pos=1&_sid=2302b090d&_ss=r\" class=\"pkv-card-btn outline\">Voir le pack →</a>\n        </div>\n      </div>\n\n      <!-- Pack VIG503 -->\n      <div class=\"pkv-card featured\">\n        <div class=\"pkv-card-badge\">Le plus populaire</div>\n        <div class=\"pkv-card-img-wrap\">\n          <img src=\"https://daewoo-security.fr/cdn/shop/files/VIG503_4.png?v=1773150766&width=1000\" alt=\"Pack Vigilia VIG503\">\n        </div>\n        <div class=\"pkv-card-body\">\n          <p class=\"pkv-card-ref\">VIG503</p>\n          <p class=\"pkv-card-title\">Pack Vigilia VIG503+</p>\n          <p class=\"pkv-card-desc\">Maison / Pavillon — 2 caméras + sirène solaire</p>\n          <p class=\"pkv-price\">À partir de 499,90 €</p>\n          <div class=\"pkv-divider\"></div>\n          <div class=\"pkv-features\">\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Centrale Vigilia Wi-Fi — clavier tactile + sirène 85 dB\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Caméra extérieure solaire W503SP + caméra intérieure IP506\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Sirène extérieure solaire WOS305S — flash stroboscopique\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              5× Contacteurs WDV301 + 2× Détecteurs mouvement WPS305\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              1× Télécommande SOS + 2× Badges RFID inclus\n            </div>\n          </div>\n          <a href=\"https://daewoo-security.fr/products/alarme-maison-wifi-sans-fil-vigilia-vig503-kit-complet-avec-2-cameras-full-hd-interieure-exterieure-solaire-et-11-accessoires\" class=\"pkv-card-btn solid\">Voir le pack →</a>\n        </div>\n      </div>\n\n      <!-- Pack VIG507 -->\n      <div class=\"pkv-card\">\n        <div class=\"pkv-card-img-wrap\">\n          <img src=\"https://daewoo-security.fr/cdn/shop/files/VIG507_2.png?v=1773156752&width=1000\" alt=\"Pack Vigilia VIG507\">\n        </div>\n        <div class=\"pkv-card-body\">\n          <p class=\"pkv-card-ref\">VIG507</p>\n          <p class=\"pkv-card-title\">Pack Vigilia VIG507+</p>\n          <p class=\"pkv-card-desc\">Grande maison / Villa — protection maximale Wi-Fi + GSM</p>\n          <p class=\"pkv-price\">À partir de 699,90 €</p>\n          <div class=\"pkv-divider\"></div>\n          <div class=\"pkv-features\">\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Centrale Vigilia Wi-Fi + GSM — sirène 85 dB intégrée\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Caméra motorisée extérieure W512MW + intérieure IP506\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              Sirène solaire WOS305S + détecteur fumée connecté 24h/24\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              8× Contacteurs WDV301 + 4× Détecteurs mouvement WPS305\n            </div>\n            <div class=\"pkv-feature\">\n              <div class=\"pkv-feature-dot\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></div>\n              1× Télécommande SOS + 2× Badges RFID inclus\n            </div>\n          </div>\n          <a href=\"https://daewoo-security.fr/products/alarme-maison-wifi-sans-fil-vigilia-vig507-kit-complet-avec-2-cameras-full-hd-interieur-exterieur-solaire-motorisee-et-17-accessoires-copie\" class=\"pkv-card-btn outline\">Voir le pack →</a>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- CTA -->\n    <div class=\"pkv-cta-wrap\">\n      <div class=\"pkv-cta\">\n        <div>\n          <p class=\"pkv-cta-title\">Pas sûr du pack idéal pour votre logement ?</p>\n          <p class=\"pkv-cta-sub\">Répondez à 7 questions — notre configurateur compose le pack parfait pour vous.</p>\n        </div>\n        <a href=\"https://daewoo-security.fr/pages/configurateur_2\" class=\"pkv-cta-btn\">\n          Trouver mon pack\n          <svg viewBox=\"0 0 24 24\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg>\n        </a>\n      </div>\n    </div>\n\n  </div>\n</div>",
