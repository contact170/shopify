      "settings": {
        "liquid": "<style>\n  .vg-hero *,\n  .vg-trust-bar * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  .vg-hero {\n    position: relative;\n    min-height: 460px;\n    display: flex;\n    align-items: center;\n    overflow: hidden;\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Segoe UI\", Helvetica, Arial, sans-serif;\n    border-radius: 20px 20px 0 0;\n  }\n\n  .vg-hero-bg {\n    position: absolute;\n    inset: 0;\n  }\n\n  .vg-hero-bg::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      95deg,\n      rgba(0,0,0,0.80) 0%,\n      rgba(0,0,0,0.45) 48%,\n      rgba(0,0,0,0.05) 100%\n    );\n  }\n\n  .vg-hero-bg img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center right;\n    display: block;\n  }\n\n  .vg-hero-content {\n    position: relative;\n    z-index: 2;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 64px 40px;\n    width: 100%;\n  }\n\n  .vg-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 5px 14px;\n    border-radius: 980px;\n    background: rgba(255,255,255,0.12);\n    border: 1px solid rgba(255,255,255,0.2);\n    color: rgba(255,255,255,0.92);\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: 0.01em;\n    margin-bottom: 20px;\n  }\n\n  .vg-title {\n    font-weight: 600;\n    font-size: clamp(30px, 4vw, 50px);\n    line-height: 1.06;\n    letter-spacing: -0.02em;\n    color: #fff;\n    margin-bottom: 14px;\n    max-width: 520px;\n  }\n\n  .vg-title span { color: #2997ff; }\n\n  .vg-sub {\n    font-size: 16px;\n    color: rgba(255,255,255,0.72);\n    line-height: 1.55;\n    max-width: 400px;\n    margin-bottom: 32px;\n    font-weight: 400;\n  }\n\n  .vg-ctas {\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n\n  .vg-btn-packs {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #fff;\n    color: #1d1d1f;\n    font-size: 15px;\n    font-weight: 500;\n    padding: 13px 24px;\n    border-radius: 980px;\n    text-decoration: none;\n    transition: opacity 0.2s, transform 0.15s;\n  }\n  .vg-btn-packs:hover {\n    opacity: 0.85;\n    transform: translateY(-1px);\n    color: #1d1d1f;\n    text-decoration: none;\n  }\n  .vg-btn-packs svg {\n    width: 15px; height: 15px;\n    stroke: currentColor; fill: none; stroke-width: 2;\n    transition: transform 0.2s;\n  }\n  .vg-btn-packs:hover svg { transform: translateX(3px); }\n\n  .vg-btn-config {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: transparent;\n    color: rgba(255,255,255,0.92);\n    font-size: 15px;\n    font-weight: 500;\n    padding: 12px 22px;\n    border-radius: 980px;\n    border: 1px solid rgba(255,255,255,0.35);\n    text-decoration: none;\n    transition: border-color 0.2s, transform 0.15s;\n  }\n  .vg-btn-config:hover {\n    border-color: rgba(255,255,255,0.75);\n    color: #fff;\n    transform: translateY(-1px);\n    text-decoration: none;\n  }\n  .vg-btn-config svg {\n    width: 15px; height: 15px;\n    stroke: currentColor; fill: none; stroke-width: 2;\n  }\n\n  .vg-trust-bar {\n    background: #1d1d1f;\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Segoe UI\", Helvetica, Arial, sans-serif;\n    border-radius: 0 0 20px 20px;\n  }\n\n  .vg-trust-inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 40px;\n    display: flex;\n    overflow-x: auto;\n    scrollbar-width: none;\n  }\n  .vg-trust-inner::-webkit-scrollbar { display: none; }\n\n  .vg-trust-item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 18px 32px 18px 0;\n    margin-right: 32px;\n    border-right: 1px solid rgba(255,255,255,0.1);\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n  .vg-trust-item:last-child { border-right: none; margin-right: 0; }\n\n  .vg-trust-icon {\n    width: 30px; height: 30px;\n    border-radius: 9px;\n    background: rgba(255,255,255,0.08);\n    display: flex; align-items: center; justify-content: center;\n    flex-shrink: 0;\n  }\n  .vg-trust-icon svg {\n    width: 15px; height: 15px;\n    stroke: #2997ff; fill: none; stroke-width: 2;\n  }\n\n  .vg-trust-label {\n    font-size: 12.5px; font-weight: 600;\n    color: #fff; display: block; line-height: 1.2;\n  }\n  .vg-trust-sub {\n    font-size: 11.5px;\n    color: rgba(255,255,255,0.45);\n    display: block; line-height: 1.3;\n  }\n\n  @media (max-width: 640px) {\n    .vg-hero { flex-direction: column; align-items: stretch; min-height: unset; border-radius: 14px 14px 0 0; }\n    .vg-hero-bg { position: relative; width: 100%; height: 260px; }\n    .vg-hero-bg img { object-position: center center; }\n    .vg-hero-bg::after { background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 100%); }\n    .vg-hero-content { background: #000; padding: 32px 24px 36px; position: relative; }\n    .vg-title { font-size: 26px; max-width: 100%; }\n    .vg-sub { font-size: 14px; max-width: 100%; }\n    .vg-ctas { flex-direction: column; gap: 10px; }\n    .vg-btn-packs, .vg-btn-config { width: 100%; justify-content: center; }\n    .vg-trust-inner { padding: 0 24px; }\n    .vg-trust-bar { border-radius: 0 0 14px 14px; }\n  }\n</style>\n\n<section class=\"vg-hero\">\n  <div class=\"vg-hero-bg\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Visuels_amazon_vendor_3_a1675f6c-d7ca-46f7-bf83-a223e20eb5e5.webp?v=1777539260\" alt=\"Alarme Vigilia\" loading=\"eager\">\n  </div>\n  <div class=\"vg-hero-content\">\n    <span class=\"vg-tag\">Sans abonnement · Sans engagement</span>\n    <h1 class=\"vg-title\">Protégez votre maison<br>avec l'alarme <span>Vigilia</span></h1>\n    <p class=\"vg-sub\">Installation en 30 minutes, sans perçage. Alertes en temps réel sur votre smartphone.</p>\n    <div class=\"vg-ctas\">\n      <a href=\"https://daewoo-security.fr/pages/pack-alarmes?_pos=1&_psq=pack&_ss=e&_v=1.0\" class=\"vg-btn-packs\">\n        Voir les packs\n        <svg viewBox=\"0 0 24 24\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg>\n      </a>\n      <a href=\"https://daewoo-security.fr/pages/configurateur_2\" class=\"vg-btn-config\">\n        <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14\"/></svg>\n        Configurer mon système\n      </a>\n    </div>\n  </div>\n</section>\n\n<div class=\"vg-trust-bar\">\n  <div class=\"vg-trust-inner\">\n    <div class=\"vg-trust-item\">\n      <div class=\"vg-trust-icon\">\n        <svg viewBox=\"0 0 24 24\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg>\n      </div>\n      <div>\n        <span class=\"vg-trust-label\">Installation 30 min</span>\n        <span class=\"vg-trust-sub\">Sans câblage ni perçage</span>\n      </div>\n    </div>\n    <div class=\"vg-trust-item\">\n      <div class=\"vg-trust-icon\">\n        <svg viewBox=\"0 0 24 24\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/></svg>\n      </div>\n      <div>\n        <span class=\"vg-trust-label\">Sans abonnement</span>\n        <span class=\"vg-trust-sub\">Application gratuite incluse</span>\n      </div>\n    </div>\n    <div class=\"vg-trust-item\">\n      <div class=\"vg-trust-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n      </div>\n      <div>\n        <span class=\"vg-trust-label\">SAV basé en France</span>\n        <span class=\"vg-trust-sub\">Support 7j/7</span>\n      </div>\n    </div>\n    <div class=\"vg-trust-item\">\n      <div class=\"vg-trust-icon\">\n        <svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n      </div>\n      <div>\n        <span class=\"vg-trust-label\">Garantie 2 ans</span>\n    