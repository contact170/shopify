    "custom_liquid_dEYpkg": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "<style>\n  .fd-banner {\n    font-family: sans-serif;\n    background: #FFFFFF;\n    overflow: hidden;\n    position: relative;\n    border-radius: 10px;\n    min-height: 80px;\n    display: flex;\n    align-items: stretch;\n    border: 1px solid #E8E8E8;\n    margin: 12px 0;\n  }\n  .fd-left-bar { width: 10px; background: #002395; flex-shrink: 0; }\n  .fd-right-bar { width: 10px; background: #ED2939; flex-shrink: 0; }\n  .fd-badge {\n    background: #002395;\n    color: #fff;\n    padding: 0 18px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    min-width: 90px;\n    text-align: center;\n    gap: 3px;\n  }\n  .fd-badge .fd-flag { font-size: 26px; line-height: 1; }\n  .fd-badge span { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.9; }\n  .fd-main {\n    flex: 1;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 16px 24px;\n  }\n  .fd-left { display: flex; flex-direction: column; gap: 4px; }\n  .fd-eyebrow { font-size: 10px; font-weight: 600; letter-spacing: 0.22em; color: #002395; text-transform: uppercase; margin: 0; }\n  .fd-headline { font-size: 28px; color: #111; letter-spacing: 0.03em; line-height: 1; margin: 0; display: flex; align-items: baseline; gap: 10px; }\n  .fd-headline .fd-percent { color: #ED2939; font-size: 40px; font-weight: 700; }\n  .fd-sub { font-size: 12px; color: #888; margin: 0; }\n  .fd-divider { width: 1px; background: #E8E8E8; align-self: stretch; margin: 12px 0; }\n  .fd-timer-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; flex-shrink: 0; padding: 0 8px; }\n  .fd-timer-label { font-size: 9px; font-weight: 600; letter-spacing: 0.2em; color: #aaa; text-transform: uppercase; }\n  .fd-timer { display: flex; gap: 4px; align-items: center; }\n  .fd-tick { display: flex; flex-direction: column; align-items: center; gap: 2px; }\n  .fd-tick-num { font-size: 20px; font-weight: 700; color: #002395; line-height: 1; background: #EEF2FF; border-radius: 4px; padding: 2px 6px; min-width: 34px; text-align: center; }\n  .fd-tick-label { font-size: 8px; color: #bbb; letter-spacing: 0.12em; text-transform: uppercase; }\n  .fd-sep { font-size: 18px; color: #ccc; line-height: 1; margin-bottom: 10px; }\n  .fd-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #002395;\n    color: #fff !important;\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 0.04em;\n    text-decoration: none !important;\n    padding: 11px 20px;\n    border-radius: 6px;\n    border: none;\n    cursor: pointer;\n    flex-shrink: 0;\n    white-space: nowrap;\n    transition: background 0.15s, transform 0.1s;\n  }\n  .fd-btn:hover { background: #001a6e; transform: scale(1.02); }\n  .fd-btn svg { width: 14px; height: 14px; flex-shrink: 0; }\n  @keyframes fd-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }\n  .fd-live-dot { width: 6px; height: 6px; border-radius: 50%; background: #ED2939; display: inline-block; animation: fd-pulse 1s ease-in-out infinite; margin-right: 5px; vertical-align: middle; }\n  .fd-tricolor-bar { height: 4px; background: linear-gradient(to right, #002395 33.3%, #FFFFFF 33.3%, #FFFFFF 66.6%, #ED2939 66.6%); position: absolute; top: 0; left: 0; right: 0; }\n  @media (max-width: 768px) {\n    .fd-timer-wrap, .fd-divider { display: none; }\n    .fd-main { flex-direction: column; align-items: flex-start; gap: 12px; padding: 14px; }\n    .fd-headline { font-size: 20px; }\n    .fd-headline .fd-percent { font-size: 28px; }\n    .fd-btn { width: 100%; justify-content: center; }\n  }\n</style>\n\n<div class=\"fd-banner\">\n  <div class=\"fd-tricolor-bar\"></div>\n  <div class=\"fd-left-bar\"></div>\n  <div class=\"fd-badge\">\n    <div class=\"fd-flag\">🇫🇷</div>\n    <span>French<br>Days</span>\n  </div>\n  <div class=\"fd-main\">\n    <div class=\"fd-left\">\n      <p class=\"fd-eyebrow\"><span class=\"fd-live-dot\"></span>Offre exclusive · Packs Alarmes</p>\n      <div class=\"fd-headline\">\n        <span class=\"fd-percent\">-5%</span>\n        <span>de remise supplémentaire</span>\n      </div>\n      <p class=\"fd-sub\">Sur tous les packs alarmes Daewoo Security — offre à durée limitée</p>\n    </div>\n    <div class=\"fd-divider\"></div>\n    <div class=\"fd-timer-wrap\">\n      <span class=\"fd-timer-label\">Temps restant</span>\n      <div class=\"fd-timer\">\n        <div class=\"fd-tick\">\n          <span class=\"fd-tick-num\" id=\"fd-h\">00</span>\n          <span class=\"fd-tick-label\">heures</span>\n        </div>\n        <span class=\"fd-sep\">:</span>\n        <div class=\"fd-tick\">\n          <span class=\"fd-tick-num\" id=\"fd-m\">00</span>\n          <span class=\"fd-tick-label\">min</span>\n        </div>\n        <span class=\"fd-sep\">:</span>\n        <div class=\"fd-tick\">\n          <span class=\"fd-tick-num\" id=\"fd-s\">00</span>\n          <span class=\"fd-tick-label\">sec</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"fd-divider\"></div>\n    <a class=\"fd-btn\" href=\"https://daewoo-security.fr/pages/pack-alarmes?_pos=1&_psq=pack&_ss=e&_v=1.0\">\n      Voir les packs\n      <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M1 7h12M8 2l5 5-5 5\" stroke=\"white\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </a>\n  </div>\n  <div class=\"fd-right-bar\"></div>\n</div>\n\n<script>\n  (function() {\n    var endDate = new Date('2026-05-05T23:59:59');\n    function pad(n) { return String(n).padStart(2, '0'); }\n    function fdTick() {\n      var diff = endDate - new Date();\n      if (diff <= 0) {\n        document.getElementById('fd-h').textContent = '00';\n        document.getElementById('fd-m').textContent = '00';\n        document.getElementById('fd-s').textContent = '00';\n        return;\n      }\n      document.getElementById('fd-h').textContent = pad(Math.floor(diff / 3600000));\n      document.getElementById('fd-m').textContent = pad(Math.floor((diff % 3600000) / 60000));\n      document.getElementById('fd-s').textContent = pad(Math.floor((diff % 60000) / 1000));\n    }\n    fdTick();\n    setInterval(fdTick, 1000);\n  })();\n</script>",
