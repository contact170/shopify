      "settings": {
        "liquid": "{% comment %} Section : Zéro abonnement — payez une fois, protégé à vie {% endcomment %}\n\n<div id=\"no-sub-section\">\n\n  <div class=\"ns-inner\">\n\n    <!-- EN-TÊTE -->\n    <div class=\"ns-header\">\n      <p class=\"ns-eyebrow\">La différence Daewoo Security</p>\n      <h2 class=\"ns-titre\">Achetez une fois.<br><span>Protégé à vie.</span></h2>\n      <p class=\"ns-sous\">Aucun abonnement. Aucun frais mensuel. Votre matériel vous appartient pour toujours.</p>\n    </div>\n\n    <!-- COMPARATIF -->\n    <div class=\"ns-cards\">\n\n      <!-- CARTE DAEWOO -->\n      <div class=\"ns-card ns-card--good\" data-ani=\"0\">\n        <div class=\"ns-card-top\">\n          <div class=\"ns-logo-wrap\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7L12 2z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n              <polyline points=\"8 12 11 15 16 9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </div>\n          <div>\n            <p class=\"ns-card-label\">Daewoo Security</p>\n            <p class=\"ns-card-sub\">Achat unique, protection permanente</p>\n          </div>\n        </div>\n        <div class=\"ns-price-wrap\">\n          <div class=\"ns-price-main\">\n            <span class=\"ns-currency\">€</span>\n            <span class=\"ns-amount\">0</span>\n            <span class=\"ns-period\">/mois</span>\n          </div>\n          <p class=\"ns-price-note\">Pour toujours. Sans condition.</p>\n        </div>\n        <ul class=\"ns-list\">\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><polyline points=\"3 8 6.5 11.5 13 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Matériel à vous pour toujours</li>\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><polyline points=\"3 8 6.5 11.5 13 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Application gratuite incluse</li>\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><polyline points=\"3 8 6.5 11.5 13 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Alertes smartphone sans surcoût</li>\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><polyline points=\"3 8 6.5 11.5 13 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>SAV français 7j/7</li>\n        </ul>\n      </div>\n\n      <!-- SÉPARATEUR VS -->\n      <div class=\"ns-vs\" aria-hidden=\"true\">VS</div>\n\n      <!-- CARTE CONCURRENTS -->\n      <div class=\"ns-card ns-card--bad\" data-ani=\"1\">\n        <div class=\"ns-card-top\">\n          <div class=\"ns-logo-wrap ns-logo-wrap--bad\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n              <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            </svg>\n          </div>\n          <div>\n            <p class=\"ns-card-label\">Autres systèmes</p>\n            <p class=\"ns-card-sub\">Abonnement obligatoire</p>\n          </div>\n        </div>\n        <div class=\"ns-price-wrap\">\n          <div class=\"ns-price-main ns-price-main--bad\">\n            <span class=\"ns-currency\">€</span>\n            <span class=\"ns-amount\">50</span>\n            <span class=\"ns-period\">/mois</span>\n          </div>\n          <p class=\"ns-price-note ns-price-note--bad\">En moyenne sur le marché</p>\n        </div>\n        <ul class=\"ns-list ns-list--bad\">\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><line x1=\"4\" y1=\"4\" x2=\"12\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><line x1=\"12\" y1=\"4\" x2=\"4\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>Résiliation = perte d'accès</li>\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><line x1=\"4\" y1=\"4\" x2=\"12\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><line x1=\"12\" y1=\"4\" x2=\"4\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>Frais cachés fréquents</li>\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><line x1=\"4\" y1=\"4\" x2=\"12\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><line x1=\"12\" y1=\"4\" x2=\"4\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>Engagement longue durée</li>\n          <li><svg viewBox=\"0 0 16 16\" fill=\"none\"><line x1=\"4\" y1=\"4\" x2=\"12\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><line x1=\"12\" y1=\"4\" x2=\"4\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>Prix qui augmentent chaque année</li>\n        </ul>\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n<style>\n#no-sub-section {\n  --ns-bg:      var(--color-background, #f8f9fc);\n  --ns-fg:      var(--color-foreground, #0d1b3e);\n  --ns-accent:  var(--color-button, #1a4faa);\n  --ns-good:    #1a4faa;\n  --ns-good-bg: #eef2fb;\n  --ns-bad:     #c0392b;\n  --ns-bad-bg:  #fdf0ef;\n  --ns-hfam:    var(--font-heading-family, system-ui, sans-serif);\n  --ns-bfam:    var(--font-body-family, system-ui, sans-serif);\n  --ns-ease:    cubic-bezier(0.22, 1, 0.36, 1);\n  --ns-radius:  20px;\n\n  background: var(--ns-bg);\n  padding: 80px 32px;\n  box-sizing: border-box;\n  overflow: hidden;\n}\n\n.ns-inner {\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.ns-header {\n  text-align: center;\n  margin-bottom: 3.5rem;\n}\n.ns-eyebrow {\n  font-family: var(--ns-bfam);\n  font-size: .72rem;\n  letter-spacing: .18em;\n  text-transform: uppercase;\n  color: var(--ns-accent);\n  margin: 0 0 .75rem;\n  opacity: 0;\n  transform: translateY(10px);\n  animation: ns-in .5s var(--ns-ease) .05s forwards;\n}\n.ns-titre {\n  font-family: var(--ns-hfam);\n  font-size: clamp(1.8rem, 4vw, 2.8rem);\n  font-weight: 700;\n  color: var(--ns-fg);\n  margin: 0 0 .6rem;\n  line-height: 1.12;\n  opacity: 0;\n  transform: translateY(14px);\n  animation: ns-in .55s var(--ns-ease) .13s forwards;\n}\n.ns-titre span { color: var(--ns-accent); }\n.ns-sous {\n  font-family: var(--ns-bfam);\n  font-size: 1rem;\n  color: var(--ns-fg);\n  opacity: 0;\n  margin: 0;\n  transform: translateY(8px);\n  animation: ns-in .5s var(--ns-ease) .2s forwards;\n}\n\n.ns-cards {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n}\n\n.ns-card {\n  border-radius: var(--ns-radius);\n  padding: 2rem 2rem 1.75rem;\n  opacity: 0;\n  transform: translateY(24px);\n}\n.ns-card[data-ani=\"0\"] { animation: ns-in .6s var(--ns-ease) .3s forwards; }\n.ns-card[data-ani=\"1\"] { animation: ns-in .6s var(--ns-ease) .45s forwards; }\n\n.ns-card--good { background: var(--ns-good-bg); border: 1.5px solid rgba(26,79,170,.2); }\n.ns-card--bad  { background: var(--ns-bad-bg);  border: 1.5px solid rgba(192,57,43,.15); }\n\n.ns-card-top {\n  display: flex;\n  align-items: center;\n  gap: .9rem;\n  margin-bottom: 1.5rem;\n}\n.ns-logo-wrap {\n  width: 40px; height: 40px;\n  border-radius: 10px;\n  background: rgba(26,79,170,.12);\n  color: var(--ns-good);\n  display: flex; align-items: center; justify-content: center;\n  flex-shrink: 0;\n}\n.ns-logo-wrap svg { width: 20px; height: 20px; }\n.ns-logo-wrap--bad { background: rgba(192,57,43,.10); color: var(--ns-bad); }\n\n.ns-card-label {\n  font-family: var(--ns-hfam);\n  font-size: .95rem;\n  font-weight: 700;\n  color: var(--ns-fg);\n  margin: 0 0 .15rem;\n}\n.ns-card-sub {\n  font-family: var(--ns-bfam);\n  font-size: .75rem;\n  color: var(--ns-fg);\n  opacity: .55;\n  margin: 0;\n}\n\n.ns-price-wrap { margin-bottom: 1.4rem; }\n.ns-price-main {\n  display: flex;\n  align-items: baseline;\n  gap: .2rem;\n  color: var(--ns-good);\n  margin-bottom: .2rem;\n}\n.ns-price-main--bad { color: var(--ns-bad); }\n.ns-currency { font-family: var(--ns-hfam); font-size: 1.4rem; font-weight: 600; }\n.ns-amount   { font-family: var(--ns-hfam); font-size: 3.2rem; font-weight: 700; line-height: 1; }\n.ns-period   { font-family: var(--ns-bfam); font-size: .85rem; opacity: .7; }\n.ns-price-note { font-family: var(--ns-bfam); font-size: .75rem; color: var(--ns-fg); opacity: .5; margin: 0; }\n.ns-price-note--bad { color: var(--ns-bad); opacity: .7; }\n\n.ns-list {\n  list-style: none;\n  padding: 0; margin: 0;\n  display: flex; flex-direction: column; gap: .55rem;\n}\n.ns-list li {\n  display: flex; align-items: center; gap: .55rem;\n  font-family: var(--ns-bfam); font-size: .85rem; color: var(--ns-fg);\n}\n.ns-list li svg { width: 16px; height: 16px; color: var(--ns-good); flex-shrink: 0; }\n.ns-list--bad li svg { color: var(--ns-bad); }\n\n.ns-vs {\n  font-family: var(--ns-hfam);\n  font-size: 1rem; font-weight: 700;\n  color: var(--ns-fg); opacity: .25;\n  padding: 0 1.5rem; text-align: center;\n}\n\n@keyframes ns-in {\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@media (max-width: 760px) {\n  #no-sub-section { padding: 3rem 1.25rem; }\n  .ns-cards { grid-template-columns: 1fr; }\n  .ns-vs { padding: .75rem 0; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .ns-eyebrow, .ns-titre, .ns-sous, .ns-card { animation: none; opacity: 1; transform: none; }\n}\n</style>",
