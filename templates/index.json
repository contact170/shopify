    "custom_liquid_jXhWbJ": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "{% comment %} \n  Section: Comment ça fonctionne — 4 étapes\n  Daewoo Security\n{% endcomment %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  :root {\n    --hp2-bg: #f2f3ff;\n    --hp2-bg-card: #ffffff;\n    --hp2-text: #0b1e4a;\n    --hp2-accent: #2d5be3;\n    --hp2-turquoise: #00c2a8;\n    --hp2-text-muted: #6b7a99;\n    --hp2-border: #e4e7f5;\n    --hp2-font: 'DM Sans', sans-serif;\n    --hp2-shadow: 0 4px 24px rgba(11, 30, 74, 0.07);\n    --hp2-shadow-hover: 0 12px 40px rgba(45, 91, 227, 0.14);\n  }\n\n  .hp2-how {\n    background: var(--hp2-bg);\n    padding: 96px 24px;\n    font-family: var(--hp2-font);\n    overflow: hidden;\n  }\n\n  .hp2-how__inner {\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  .hp2-how__header {\n    text-align: center;\n    margin-bottom: 64px;\n  }\n\n  .hp2-how__tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: rgba(45, 91, 227, 0.08);\n    color: var(--hp2-accent);\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    padding: 6px 14px;\n    border-radius: 100px;\n    margin-bottom: 20px;\n  }\n\n  .hp2-how__tag::before {\n    content: '';\n    display: block;\n    width: 6px;\n    height: 6px;\n    background: var(--hp2-accent);\n    border-radius: 50%;\n  }\n\n  .hp2-how__title {\n    font-size: clamp(28px, 4vw, 42px);\n    font-weight: 700;\n    color: var(--hp2-text);\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n    margin: 0 0 16px;\n  }\n\n  .hp2-how__subtitle {\n    font-size: 17px;\n    color: var(--hp2-text-muted);\n    max-width: 480px;\n    margin: 0 auto;\n    line-height: 1.6;\n    font-weight: 400;\n  }\n\n  .hp2-how__steps {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 0;\n    position: relative;\n    align-items: start;\n  }\n\n  .hp2-how__steps::before {\n    content: '';\n    position: absolute;\n    top: 52px;\n    left: calc(12.5% + 24px);\n    right: calc(12.5% + 24px);\n    height: 2px;\n    background: linear-gradient(90deg, var(--hp2-accent) 0%, var(--hp2-turquoise) 100%);\n    opacity: 0.25;\n    z-index: 0;\n  }\n\n  .hp2-how__step {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    padding: 0 16px;\n    position: relative;\n    z-index: 1;\n    opacity: 0;\n    transform: translateY(24px);\n    animation: hp2-fade-up 0.5s ease forwards;\n  }\n\n  .hp2-how__step:nth-child(1) { animation-delay: 0.1s; }\n  .hp2-how__step:nth-child(2) { animation-delay: 0.22s; }\n  .hp2-how__step:nth-child(3) { animation-delay: 0.34s; }\n  .hp2-how__step:nth-child(4) { animation-delay: 0.46s; }\n\n  @keyframes hp2-fade-up {\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  .hp2-how__icon-wrap {\n    width: 104px;\n    height: 104px;\n    border-radius: 28px;\n    background: var(--hp2-bg-card);\n    box-shadow: var(--hp2-shadow);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 28px;\n    position: relative;\n    transition: box-shadow 0.3s ease, transform 0.3s ease;\n    border: 1px solid var(--hp2-border);\n  }\n\n  .hp2-how__step:hover .hp2-how__icon-wrap {\n    box-shadow: var(--hp2-shadow-hover);\n    transform: translateY(-4px);\n  }\n\n  .hp2-how__num {\n    position: absolute;\n    top: -10px;\n    right: -10px;\n    width: 26px;\n    height: 26px;\n    background: var(--hp2-accent);\n    color: #fff;\n    font-size: 11px;\n    font-weight: 700;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 2px solid var(--hp2-bg);\n  }\n\n  .hp2-how__step:last-child .hp2-how__num {\n    background: var(--hp2-turquoise);\n  }\n\n  .hp2-how__icon-wrap svg {\n    width: 44px;\n    height: 44px;\n  }\n\n  .hp2-how__step-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: var(--hp2-text);\n    margin: 0 0 10px;\n    line-height: 1.3;\n    letter-spacing: -0.01em;\n  }\n\n  .hp2-how__step-desc {\n    font-size: 14px;\n    color: var(--hp2-text-muted);\n    line-height: 1.65;\n    font-weight: 400;\n    max-width: 200px;\n  }\n\n  .hp2-how__arrow {\n    position: absolute;\n    top: 42px;\n    right: -14px;\n    width: 28px;\n    height: 28px;\n    background: var(--hp2-bg);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 2;\n  }\n\n  .hp2-how__step:last-child .hp2-how__arrow { display: none; }\n\n  .hp2-how__arrow svg {\n    width: 14px;\n    height: 14px;\n    color: var(--hp2-accent);\n    opacity: 0.5;\n  }\n\n  .hp2-how__cta {\n    text-align: center;\n    margin-top: 56px;\n  }\n\n  .hp2-how__btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: var(--hp2-accent);\n    color: #fff;\n    font-family: var(--hp2-font);\n    font-size: 15px;\n    font-weight: 600;\n    padding: 16px 32px;\n    border-radius: 100px;\n    text-decoration: none;\n    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;\n    box-shadow: 0 4px 20px rgba(45, 91, 227, 0.3);\n  }\n\n  .hp2-how__btn:hover {\n    background: #2249c5;\n    transform: translateY(-2px);\n    box-shadow: 0 8px 28px rgba(45, 91, 227, 0.4);\n  }\n\n  .hp2-how__btn svg {\n    width: 18px;\n    height: 18px;\n    transition: transform 0.2s ease;\n  }\n\n  .hp2-how__btn:hover svg { transform: translateX(3px); }\n\n  @media (max-width: 900px) {\n    .hp2-how__steps {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 40px 0;\n    }\n    .hp2-how__steps::before { display: none; }\n    .hp2-how__arrow { display: none; }\n  }\n\n  @media (max-width: 560px) {\n    .hp2-how { padding: 64px 20px; }\n    .hp2-how__steps { grid-template-columns: 1fr; gap: 32px; }\n    .hp2-how__header { margin-bottom: 48px; }\n  }\n</style>\n\n<section class=\"hp2-how\">\n  <div class=\"hp2-how__inner\">\n\n    <div class=\"hp2-how__header\">\n      <div class=\"hp2-how__tag\">Fonctionnement</div>\n      <h2 class=\"hp2-how__title\">Comment ça fonctionne ?</h2>\n      <p class=\"hp2-how__subtitle\">Un système simple, réactif et entièrement contrôlable depuis votre smartphone.</p>\n    </div>\n\n    <div class=\"hp2-how__steps\">\n\n      <!-- ÉTAPE 1 -->\n      <div class=\"hp2-how__step\">\n        <div class=\"hp2-how__icon-wrap\">\n          <span class=\"hp2-how__num\">1</span>\n          <svg viewBox=\"0 0 44 44\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect x=\"8\" y=\"4\" width=\"22\" height=\"36\" rx=\"3\" stroke=\"#2d5be3\" stroke-width=\"2\" fill=\"none\"/>\n            <rect x=\"8\" y=\"4\" width=\"22\" height=\"36\" rx=\"3\" fill=\"#2d5be3\" fill-opacity=\"0.06\"/>\n            <circle cx=\"27\" cy=\"22\" r=\"2\" fill=\"#2d5be3\"/>\n            <path d=\"M30 4v36\" stroke=\"#2d5be3\" stroke-width=\"1.5\" stroke-dasharray=\"3 3\" opacity=\"0.3\"/>\n            <path d=\"M33 14l4-4M33 30l4 4\" stroke=\"#00c2a8\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <circle cx=\"37\" cy=\"10\" r=\"3\" fill=\"#00c2a8\" fill-opacity=\"0.2\" stroke=\"#00c2a8\" stroke-width=\"1.5\"/>\n            <circle cx=\"37\" cy=\"34\" r=\"3\" fill=\"#00c2a8\" fill-opacity=\"0.2\" stroke=\"#00c2a8\" stroke-width=\"1.5\"/>\n          </svg>\n          <div class=\"hp2-how__arrow\">\n            <svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 7h8M8 4l3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n        </div>\n        <h3 class=\"hp2-how__step-title\">Un détecteur s'active\n        <p class=\"hp2-how__step-desc\">Votre détecteur de mouvement ou d'ouverture se déclenche instantanément.</p>\n      </div>\n\n      <!-- ÉTAPE 2 -->\n      <div class=\"hp2-how__step\">\n        <div class=\"hp2-how__icon-wrap\">\n          <span class=\"hp2-how__num\">2</span>\n          <svg viewBox=\"0 0 44 44\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect x=\"12\" y=\"6\" width=\"16\" height=\"28\" rx=\"3\" stroke=\"#2d5be3\" stroke-width=\"2\" fill=\"none\"/>\n            <rect x=\"12\" y=\"6\" width=\"16\" height=\"28\" rx=\"3\" fill=\"#2d5be3\" fill-opacity=\"0.06\"/>\n            <circle cx=\"20\" cy=\"30\" r=\"1.5\" fill=\"#2d5be3\"/>\n            <rect x=\"16\" y=\"12\" width=\"8\" height=\"1.5\" rx=\"0.75\" fill=\"#2d5be3\" opacity=\"0.4\"/>\n            <rect x=\"15\" y=\"17\" width=\"10\" height=\"5\" rx=\"2\" fill=\"#2d5be3\"/>\n            <path d=\"M29 10c1.5 0 3 .6 4 1.7\" stroke=\"#00c2a8\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <path d=\"M30.5 13c.7 0 1.4.3 1.9.8\" stroke=\"#00c2a8\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <circle cx=\"33\" cy=\"8\" r=\"3\" fill=\"#00c2a8\"/>\n            <path d=\"M32 8l.8.8 1.4-1.6\" stroke=\"white\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n          <div class=\"hp2-how__arrow\">\n            <svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 7h8M8 4l3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n        </div>\n        <h3 class=\"hp2-how__step-title\">Notification immédiate</h3>\n        <p class=\"hp2-how__step-desc\">Vous recevez une alerte en temps réel sur votre smartphone, où que vous soyez.</p>\n      </div>\n\n      <!-- ÉTAPE 3 -->\n      <div class=\"hp2-how__step\">\n        <div class=\"hp2-how__icon-wrap\">\n          <span class=\"hp2-how__num\">3</span>\n          <svg viewBox=\"0 0 44 44\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect x=\"6\" y=\"14\" width=\"24\" height=\"18\" rx=\"3\" stroke=\"#2d5be3\" stroke-width=\"2\" fill=\"none\"/>\n            <rect x=\"6\" y=\"14\" width=\"24\" height=\"18\" rx=\"3\" fill=\"#2d5be3\" fill-opacity=\"0.06\"/>\n            <circle cx=\"18\" cy=\"23\" r=\"5\" stroke=\"#2d5be3\" stroke-width=\"2\" fill=\"none\"/>\n            <circle cx=\"18\" cy=\"23\" r=\"2.5\" fill=\"#2d5be3\" fill-opacity=\"0.3\"/>\n            <path d=\"M30 18.5l8-4v12l-8-4v-4z\" stroke=\"#2d5be3\" stroke-width=\"2\" stroke-linejoin=\"round\" fill=\"none\"/>\n            <path d=\"M10 14v-3a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3\" stroke=\"#2d5be3\" stroke-width=\"1.5\" fill=\"none\"/>\n            <circle cx=\"36\" cy=\"10\" r=\"3\" fill=\"#00c2a8\"/>\n            <path d=\"M35 10l.8.8 1.4-1.6\" stroke=\"white\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n          <div class=\"hp2-how__arrow\">\n            <svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 7h8M8 4l3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n        </div>\n        <h3 class=\"hp2-how__step-title\">Visualisez en direct</h3>\n        <p class=\"hp2-how__step-desc\">Accédez instantanément à votre caméra pour voir ce qu'il se passe chez vous.</p>\n      </div>\n\n      <!-- ÉTAPE 4 -->\n      <div class=\"hp2-how__step\">\n        <div class=\"hp2-how__icon-wrap\">\n          <span class=\"hp2-how__num\">4</span>\n          <svg viewBox=\"0 0 44 44\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M22 8L8 20v18h28V20L22 8z\" stroke=\"#00c2a8\" stroke-width=\"2\" stroke-linejoin=\"round\" fill=\"none\"/>\n            <path d=\"M22 8L8 20v18h28V20L22 8z\" fill=\"#00c2a8\" fill-opacity=\"0.06\"/>\n            <path d=\"M17 38V28a5 5 0 0 1 10 0v10\" stroke=\"#00c2a8\" stroke-width=\"2\" fill=\"none\"/>\n            <circle cx=\"22\" cy=\"24\" r=\"3\" fill=\"#00c2a8\" fill-opacity=\"0.3\" stroke=\"#00c2a8\" stroke-width=\"1.5\"/>\n            <path d=\"M36 13l3-3M36 15h3M36 17l3 3\" stroke=\"#00c2a8\" stroke-width=\"1.8\" stroke-linecap=\"round\" opacity=\"0.6\"/>\n          </svg>\n        </div>\n        <h3 class=\"hp2-how__step-title\">Déclenchement de l'alarme</h3>\n        <p class=\"hp2-how__step-desc\">Activez la sirène à distance ou laissez le système agir automatiquement.</p>\n      </div>\n\n    </div>\n\n    <div class=\"hp2-how__cta\">\n      <a href=\"https://daewoo-security.fr/pages/configurateur_2\" class=\"hp2-how__btn\">\n        Configurer mon système\n        <svg viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M3 9h12M11 5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </a>\n    </div>\n\n  </div>\n</section>",
