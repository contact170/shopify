      "settings": {
        "liquid": "<div class=\"daewoo-banner\">\n  <div class=\"daewoo-banner__hero\">\n\n    <!-- IMAGE DE FOND (claire à gauche, sujet à droite) -->\n    <div class=\"daewoo-banner__bg\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Image_Hero_2_1.webp?v=1787380944&width=1672\"\n        srcset=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Image_Hero_2_1.webp?v=1787380944&width=800   800w,\n                https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Image_Hero_2_1.webp?v=1787380944&width=1200 1200w,\n                https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Image_Hero_2_1.webp?v=1787380944&width=1672 1672w\"\n        sizes=\"100vw\"\n        width=\"1672\"\n        height=\"941\"\n        alt=\"Intérieur de maison lumineux sécurisé par un système d'alarme Daewoo sans abonnement\"\n        class=\"daewoo-banner__bg-img\"\n        loading=\"eager\"\n        fetchpriority=\"high\"\n        decoding=\"async\"\n      >\n    </div>\n    <!-- Voile clair (desktop uniquement) -->\n    <div class=\"daewoo-banner__scrim\"></div>\n\n    <div class=\"daewoo-banner__inner\">\n      <div class=\"daewoo-banner__content\">\n\n        <span class=\"daewoo-banner__badge\">SANS ABONNEMENT</span>\n\n        <h1 class=\"daewoo-banner__title\">Protégez votre maison<br>en toute simplicité</h1>\n\n        <div class=\"daewoo-banner__price\">\n          <span class=\"daewoo-banner__price-from\">À partir de</span>\n          <span class=\"daewoo-banner__price-amount\">139,90&nbsp;€<span class=\"daewoo-banner__price-ttc\">TTC</span></span>\n        </div>\n\n        <p class=\"daewoo-banner__description\">\n          Système d'alarme complet,<br>\n          facile à installer et pilotable à distance.\n        </p>\n\n        <div class=\"daewoo-banner__features\">\n          <div class=\"daewoo-banner__feature\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"1\" y1=\"1\" x2=\"23\" y2=\"23\"></line><path d=\"M16.72 11.06A10.94 10.94 0 0 1 19 12.55\"></path><path d=\"M5 12.55a10.94 10.94 0 0 1 5.17-2.39\"></path><path d=\"M10.71 5.05A16 16 0 0 1 22.58 9\"></path><path d=\"M1.42 9a15.91 15.91 0 0 1 4.7-2.88\"></path><path d=\"M8.53 16.11a6 6 0 0 1 6.95 0\"></path><line x1=\"12\" y1=\"20\" x2=\"12.01\" y2=\"20\"></line></svg>\n            <span>Sans<br>abonnement</span>\n          </div>\n          <div class=\"daewoo-banner__feature\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"></path></svg>\n            <span>Installation<br>rapide</span>\n          </div>\n          <div class=\"daewoo-banner__feature\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\" ry=\"2\"></rect><line x1=\"12\" y1=\"18\" x2=\"12.01\" y2=\"18\"></line></svg>\n            <span>Contrôle à<br>distance</span>\n          </div>\n        </div>\n\n        <div class=\"daewoo-banner__ctas\">\n          <a href=\"https://daewoo-security.fr/pages/pack-alarmes?_pos=1&_psq=pack&_ss=e&_v=1.0\" class=\"daewoo-banner__btn daewoo-banner__btn--primary\">\n            <span>Découvrir les packs</span><span class=\"daewoo-banner__arrow\">→</span>\n          </a>\n          <a href=\"https://daewoo-security.fr/pages/configurateur_2\" class=\"daewoo-banner__btn daewoo-banner__btn--secondary\">\n            <span>Configurer mon alarme</span><span class=\"daewoo-banner__arrow\">→</span>\n          </a>\n        </div>\n\n        <div class=\"daewoo-banner__trust\">\n          <div class=\"daewoo-banner__trust-item\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>\n            <span>Marque reconnue<br>depuis 1971</span>\n          </div>\n          <div class=\"daewoo-banner__trust-item\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 18v-6a9 9 0 0 1 18 0v6\"></path><path d=\"M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z\"></path></svg>\n            <span>Support client<br>basé en France</span>\n          </div>\n          <div class=\"daewoo-banner__trust-item\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle></svg>\n            <span>Livraison rapide<br>2 à 3 jours</span>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .daewoo-banner {\n    --navy:  #0a1a3a;\n    --blue:  #1552d6;\n    --cream: #f3f0ea;\n    --muted: rgba(10,26,58,0.72);\n    font-family: 'Helvetica Neue', Arial, sans-serif;\n    width: 100%; max-width: 100%; position: relative; overflow: hidden;\n  }\n  .daewoo-banner * { box-sizing: border-box; }\n  .daewoo-banner h1, .daewoo-banner p, .daewoo-banner span, .daewoo-banner a {\n    font-family: 'Helvetica Neue', Arial, sans-serif !important;\n    text-transform: none !important; letter-spacing: normal !important; font-style: normal !important;\n  }\n  .daewoo-banner h1::first-letter, .daewoo-banner p::first-letter {\n    font-size: inherit !important; font-weight: inherit !important; float: none !important; line-height: inherit !important;\n  }\n  .daewoo-banner *::before, .daewoo-banner *::after { content: none !important; }\n\n  /* ── HERO (desktop) ── */\n  .daewoo-banner__hero {\n    position: relative; width: 100%; min-height: 660px;\n    display: flex; overflow: hidden; background-color: var(--cream);\n  }\n  .daewoo-banner__bg { position: absolute; inset: 0; z-index: 0; }\n  .daewoo-banner__bg-img {\n    width: 100%; height: 100%; object-fit: cover;\n    object-position: right center; display: block;\n  }\n  .daewoo-banner__scrim {\n    position: absolute; inset: 0; z-index: 1;\n    background: linear-gradient(to right,\n      rgba(243,240,234,0.95) 0%,\n      rgba(243,240,234,0.85) 34%,\n      rgba(243,240,234,0.35) 56%,\n      rgba(243,240,234,0.00) 74%);\n  }\n\n  .daewoo-banner__inner {\n    position: relative; z-index: 2; width: 100%;\n    display: flex; align-items: center;\n    padding: 52px clamp(24px, 5vw, 72px);\n  }\n  .daewoo-banner__content { width: 100%; max-width: 600px; display: flex; flex-direction: column; gap: 20px; }\n\n  .daewoo-banner__badge {\n    align-self: flex-start; background: var(--navy); color: #fff !important;\n    font-size: 13px !important; font-weight: 700 !important;\n    letter-spacing: 0.08em !important; text-transform: uppercase !important;\n    padding: 10px 22px; border-radius: 100px;\n  }\n  .daewoo-banner__title {\n    font-size: clamp(34px, 5vw, 52px) !important; font-weight: 800 !important;\n    color: var(--navy) !important; line-height: 1.1 !important; margin: 0 !important;\n  }\n  .daewoo-banner__price { display: flex; flex-direction: column; gap: 2px; margin: 4px 0; }\n  .daewoo-banner__price-from { font-size: 19px !important; font-weight: 500 !important; color: var(--blue) !important; }\n  .daewoo-banner__price-amount { font-size: clamp(38px, 6vw, 52px) !important; font-weight: 800 !important; color: var(--blue) !important; line-height: 1 !important; }\n  .daewoo-banner__price-ttc { font-size: 20px !important; font-weight: 600 !important; margin-left: 8px; }\n  .daewoo-banner__description { font-size: 16px !important; color: var(--muted) !important; line-height: 1.55 !important; margin: 0 !important; font-weight: 400 !important; }\n\n  .daewoo-banner__features { display: flex; gap: 28px; margin-top: 6px; }\n  .daewoo-banner__feature { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }\n  .daewoo-banner__feature svg { width: 32px; height: 32px; color: var(--blue) !important; stroke-width: 1.7; }\n  .daewoo-banner__feature span { font-size: 13px !important; color: var(--navy) !important; line-height: 1.3 !important; font-weight: 600 !important; }\n\n  .daewoo-banner__ctas { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; max-width: 430px; }\n  .daewoo-banner__btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 10px;\n    padding: 16px 24px; font-size: 15px; font-weight: 600;\n    text-decoration: none; border-radius: 6px; transition: all 0.2s ease;\n  }\n  .daewoo-banner__arrow { font-size: 17px; }\n  .daewoo-banner__btn--primary { background: var(--blue); color: #fff !important; border: 2px solid var(--blue); }\n  .daewoo-banner__btn--primary:hover { background: #0f43b8; border-color: #0f43b8; transform: translateY(-1px); }\n  .daewoo-banner__btn--secondary { background: #fff; color: var(--blue) !important; border: 2px solid var(--blue); }\n  .daewoo-banner__btn--secondary:hover { background: var(--blue); color: #fff !important; }\n\n  .daewoo-banner__trust {\n    display: flex; gap: clamp(20px, 4vw, 44px); flex-wrap: wrap;\n    margin-top: 14px; max-width: 720px;\n    background: #fff; border-radius: 16px;\n    box-shadow: 0 12px 40px rgba(10,26,58,0.10); padding: 20px 26px;\n  }\n  .daewoo-banner__trust-item { display: flex; align-items: center; gap: 12px; }\n  .daewoo-banner__trust-item svg { width: 24px; height: 24px; color: var(--navy) !important; flex-shrink: 0; stroke-width: 1.7; }\n  .daewoo-banner__trust-item span { font-size: 13px !important; color: var(--navy) !important; line-height: 1.3 !important; font-weight: 500 !important; }\n\n  /* ══════════════════════════════════ MOBILE ══════════════════════════════════\n     Image en bandeau EN HAUT (on voit le produit) + texte SOUS sur fond crème plein\n  ══════════════════════════════════ */\n  @media (max-width: 768px) {\n    .daewoo-banner__hero { flex-direction: column; min-height: unset; }\n\n    /* L'image devient un vrai bloc en haut, au ratio natif :\n       aucun recadrage, tout le kit d'alarme reste visible */\n    .daewoo-banner__bg {\n      position: relative; inset: auto; order: 1;\n      width: 100%; height: auto;\n    }\n    .daewoo-banner__bg-img {\n      width: 100%; height: auto;\n      aspect-ratio: 1672 / 941;   /* ratio natif de Image_Hero_2_1.webp */\n      object-fit: contain;\n      object-position: center;\n    }\n    /* Plus de voile : le texte n'est plus sur l'image */\n    .daewoo-banner__scrim { display: none; }\n\n    /* Le texte passe sous l'image, sur fond crème plein → lisible */\n    .daewoo-banner__inner {\n      order: 2; position: relative; z-index: 2;\n      background: var(--cream);\n      padding: 28px 20px 24px;\n    }\n    .daewoo-banner__content { max-width: 100%; gap: 16px; }\n\n    .daewoo-banner__title { font-size: 30px !important; }\n    .daewoo-banner__price-amount { font-size: 42px !important; }\n    .daewoo-banner__description { font-size: 14px !important; }\n\n    .daewoo-banner__features { gap: 12px; }\n    .daewoo-banner__feature { flex: 1 1 0; min-width: 0; align-items: center; text-align: center; gap: 6px; }\n    .daewoo-banner__feature svg { width: 28px; height: 28px; }\n    .daewoo-banner__feature span { font-size: 11.5px !important; }\n\n    .daewoo-banner__ctas { max-width: 100%; }\n    .daewoo-banner__btn { width: 100%; padding: 14px 18px; font-size: 14px; }\n\n    .daewoo-banner__trust { gap: 8px; padding: 16px 12px; max-width: 100%; }\n    .daewoo-banner__trust-item { flex: 1 1 0; min-width: 0; flex-direction: column; text-align: center; gap: 6px; }\n    .daewoo-banner__trust-item span { font-size: 10.5px !important; }\n  }\n</style>\n\n<div class=\"dws-intro\">\n  <div class=\"dws-intro__inner\">\n\n    <h2 class=\"dws-intro__title\">Quel système pour votre logement&nbsp;?</h2>\n\n    <p class=\"dws-intro__text\">\n      Un appartement n'a pas les mêmes besoins qu'une maison avec jardin.\n      Alarmes sans fil, caméras intérieures et extérieures, détecteurs d'ouverture, badges&nbsp;:\n      <strong>vous composez le kit adapté au vôtre</strong>, et vous l'agrandissez quand vous voulez.\n    </p>\n\n    <p class=\"dws-intro__text\">\n      Le matériel s'achète une fois — <strong>aucun abonnement, aucun engagement</strong> —\n      et tout se pilote depuis l'<strong>application gratuite Daewoo&nbsp;Home</strong>.\n    </p>\n\n  </div>\n</div>\n\n<style>\n  .dws-intro {\n    --navy:  #0a1a3a;\n    --muted: rgba(10,26,58,0.72);\n    font-family: 'Helvetica Neue', Arial, sans-serif;\n    width: 100%;\n    padding: clamp(36px, 5vw, 56px) clamp(20px, 5vw, 72px);\n  }\n  .dws-intro * { box-sizing: border-box; }\n  /* Le thème ajoute des pseudo-éléments décoratifs sur les titres : on les neutralise\n     comme dans la section hero, sinon une capitale ornée s'insère devant le H2. */\n  .dws-intro *::before, .dws-intro *::after { content: none !important; }\n\n  .dws-intro__inner { max-width: 820px; margin: 0 auto; text-align: center; }\n\n  .dws-intro__title {\n    font-family: 'Helvetica Neue', Arial, sans-serif !important;\n    font-size: clamp(22px, 2.6vw, 30px) !important;\n    font-weight: 700 !important;\n    color: var(--navy) !important;\n    line-height: 1.25 !important;\n    letter-spacing: normal !important;\n    text-transform: none !important;\n    font-style: normal !important;\n    margin: 0 0 14px !important;\n  }\n  .dws-intro__text {\n    font-family: 'Helvetica Neue', Arial, sans-serif !important;\n    font-size: 16px !important;\n    font-weight: 400 !important;\n    color: var(--muted) !important;\n    line-height: 1.65 !important;\n    letter-spacing: normal !important;\n    text-transform: none !important;\n    margin: 0 !important;\n  }\n  .dws-intro__text + .dws-intro__text { margin-top: 12px !important; }\n  .dws-intro__text strong {\n    color: var(--navy) !important;\n    font-weight: 600 !important;\n  }\n  .dws-intro__title::first-letter, .dws-intro__text::first-letter {\n    font-size: inherit !important; font-weight: inherit !important;\n    float: none !important; line-height: inherit !important;\n  }\n\n  @media (max-width: 768px) {\n    .dws-intro { padding: 26px 20px 22px; }\n    .dws-intro__inner { text-align: left; }\n    .dws-intro__title { font-size: 21px !important; margin-bottom: 10px !important; }\n    .dws-intro__text  { font-size: 15px !important; line-height: 1.6 !important; }\n  }\n</style>\n",
