      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "<style>\n\n  .daewoo-hero {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    background: ;\n    padding: 64px 24px;\n    border-radius: 24px;\n  }\n  .daewoo-hero__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 48px;\n    align-items: stretch;\n  }\n  .daewoo-hero__badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #fff;\n    color: #0b1437;\n    font-weight: 700;\n    font-size: 13px;\n    letter-spacing: 0.08em;\n    padding: 10px 18px;\n    border-radius: 999px;\n    box-shadow: 0 4px 14px rgba(11,20,55,0.06);\n    margin-bottom: 26px;\n  }\n  .daewoo-hero__badge::before { content: \"✦\"; color: #1f3df5; }\n  .daewoo-hero__title {\n    font-size: clamp(32px, 4.6vw, 54px);\n    line-height: 1.05;\n    font-weight: 600;\n    color: #0b1e4a;\n    margin: 0 0 20px;\n    letter-spacing: -0.02em;\n  }\n  .daewoo-hero__title em { color: #1f3df5; font-style: normal; }\n  .daewoo-hero__subtitle {\n    font-size: 17px;\n    line-height: 1.5;\n    color: #5b6485;\n    margin: 0 0 24px;\n    max-width: 560px;\n  }\n  .daewoo-hero__features {\n    list-style: none;\n    padding: 0;\n    margin: 0 0 30px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px 24px;\n    max-width: 560px;\n  }\n  .daewoo-hero__features li {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    color: #0b1437;\n    font-weight: 500;\n    font-size: 15px;\n  }\n  .daewoo-hero__features li::before {\n    content: \"✓\";\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    background: #d8f3df;\n    color: #1a8a3e;\n    font-weight: 700;\n    font-size: 12px;\n    flex-shrink: 0;\n  }\n  .daewoo-hero__cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: linear-gradient(135deg, #0b1f8a 0%, #1f3df5 100%);\n    color: #fff;\n    text-decoration: none;\n    font-weight: 700;\n    font-size: 16px;\n    padding: 16px 32px;\n    border-radius: 999px;\n    box-shadow: 0 10px 24px rgba(31,61,245,0.28);\n    transition: transform .15s ease, box-shadow .15s ease;\n  }\n  .daewoo-hero__cta:hover {\n    transform: translateY(-1px);\n    box-shadow: 0 14px 28px rgba(31,61,245,0.34);\n  }\n  .daewoo-hero__meta {\n    margin-top: 16px;\n    font-size: 13px;\n    color: #6b7390;\n  }\n\n  .daewoo-hero__left {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n\n  /* Colonne de droite : les 2 options empilées, hauteur alignée sur la gauche */\n  .daewoo-hero__right {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n  .daewoo-hero__option {\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n    min-height: 0;\n  }\n\n  .daewoo-hero__option-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.05em;\n    color: #1f3df5;\n    background: #e8ebfe;\n    padding: 5px 12px;\n    border-radius: 999px;\n    margin-bottom: 8px;\n    align-self: flex-start;\n    flex-shrink: 0;\n  }\n  .daewoo-hero__option-tag--alt {\n    color: #0b1437;\n    background: #eef0fb;\n  }\n  .daewoo-hero__option-title {\n    font-size: clamp(16px, 1.8vw, 19px);\n    line-height: 1.2;\n    font-weight: 700;\n    color: #0b1437;\n    margin: 0 0 10px;\n    letter-spacing: -0.01em;\n    flex-shrink: 0;\n  }\n  .daewoo-hero__option-title em { color: #1f3df5; font-style: normal; }\n\n  /* Carte commune (quiz + pack) */\n  .daewoo-hero__card {\n    background: #fff;\n    border-radius: 16px;\n    padding: 18px;\n    box-shadow: 0 14px 34px rgba(11,20,55,0.10);\n    cursor: pointer;\n    transition: transform .2s ease;\n    text-decoration: none;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    flex: 1;\n    min-height: 0;\n  }\n  .daewoo-hero__card:hover { transform: translateY(-2px); }\n  .daewoo-hero__card:hover .daewoo-hero__cta-card,\n  .daewoo-hero__card:hover .daewoo-hero__pack-cta {\n    box-shadow: 0 12px 24px rgba(31,61,245,0.34);\n  }\n\n  /* Carte quiz */\n  .daewoo-hero__card-head {\n    display: flex;\n    justify-content: space-between;\n    color: #8a92ad;\n    font-size: 12px;\n    margin-bottom: 6px;\n  }\n  .daewoo-hero__progress {\n    height: 4px;\n    background: #eef0fb;\n    border-radius: 999px;\n    overflow: hidden;\n    margin-bottom: 12px;\n  }\n  .daewoo-hero__progress > span {\n    display: block;\n    width: 14%;\n    height: 100%;\n    background: #1f3df5;\n  }\n  .daewoo-hero__question {\n    font-size: 14px;\n    font-weight: 700;\n    color: #0b1437;\n    margin: 0 0 10px;\n  }\n  .daewoo-hero__quiz-opt {\n    border: 1px solid #e3e6f3;\n    border-radius: 9px;\n    padding: 9px 12px;\n    margin-bottom: 7px;\n    color: #0b1437;\n    font-weight: 500;\n    font-size: 12.5px;\n  }\n  .daewoo-hero__cta-card {\n    display: block;\n    width: 100%;\n    text-align: center;\n    background: linear-gradient(135deg, #0b1f8a 0%, #1f3df5 100%);\n    color: #fff;\n    padding: 13px;\n    border-radius: 10px;\n    font-weight: 700;\n    font-size: 14px;\n    margin-top: 6px;\n    box-sizing: border-box;\n    box-shadow: 0 8px 18px rgba(31,61,245,0.28);\n    flex-shrink: 0;\n  }\n\n  /* Carte pack */\n  .daewoo-hero__card--pack { padding: 14px; }\n  .daewoo-hero__pack-image {\n    width: 100%;\n    height: 150px;\n    object-fit: contain;\n    border-radius: 12px;\n    display: block;\n    margin-bottom: 12px;\n    background: #fff;\n    flex-shrink: 0;\n  }\n  .daewoo-hero__pack-cta {\n    display: block;\n    width: 100%;\n    text-align: center;\n    background: linear-gradient(135deg, #0b1f8a 0%, #1f3df5 100%);\n    color: #fff;\n    padding: 13px;\n    border-radius: 10px;\n    font-weight: 700;\n    font-size: 14px;\n    box-sizing: border-box;\n    box-shadow: 0 8px 18px rgba(31,61,245,0.28);\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 900px) {\n    .daewoo-hero { padding: 40px 18px; }\n    .daewoo-hero__inner { grid-template-columns: 1fr; gap: 32px; align-items: start; }\n    .daewoo-hero__features { grid-template-columns: 1fr; }\n    .daewoo-hero__right { height: auto; gap: 16px; }\n  }\n\n</style>\n\n<section class=\"daewoo-hero\">\n  <div class=\"daewoo-hero__inner\">\n\n    <div class=\"daewoo-hero__left\">\n      <span class=\"daewoo-hero__badge\">CONFIGURATEUR INTELLIGENT · 2 MINUTES</span>\n      <h1 class=\"daewoo-hero__title\">\n        Trouvez l'alarme parfaite pour <em>vous</em>.\n      </h1>\n      <p class=\"daewoo-hero__subtitle\">\n        Sans abonnement. Sans engagement. Faites-vous guider en 2 minutes ou choisissez directement l'un de nos packs conçus par nos experts.\n      </p>\n      <ul class=\"daewoo-hero__features\">\n        <li>Sans abonnement, à vie</li>\n        <li>Livraison sous 48h</li>\n        <li>Jusqu'à –25% de remise pack</li>\n        <li>Garantie 2 ans</li>\n      </ul>\n      <a href=\"/pages/configurateur_2\" class=\"daewoo-hero__cta\">Démarrer le quiz →</a>\n      <div class=\"daewoo-hero__meta\">Gratuit · Aucune inscription · Résultat immédiat</div>\n    </div>\n\n    <div class=\"daewoo-hero__right\">\n\n      <!-- Option 1 : Je me fais guider (quiz) -->\n      <div class=\"daewoo-hero__option\">\n        <span class=\"daewoo-hero__option-tag\">1 · SI VOUS HÉSITEZ</span>\n        <h3 class=\"daewoo-hero__option-title\">Je me fais <em>guider</em></h3>\n        <a href=\"/pages/configurateur_2\" class=\"daewoo-hero__card\">\n          <div class=\"daewoo-hero__card-head\">\n            <span>Étape 1 sur 7</span>\n            <span>14 %</span>\n          </div>\n          <div class=\"daewoo-hero__progress\"><span></span></div>\n          <p class=\"daewoo-hero__question\">Quel type de logement souhaitez-vous protéger ?</p>\n          <div class=\"daewoo-hero__quiz-opt\">Appartement</div>\n          <div class=\"daewoo-hero__quiz-opt\">Maison</div>\n          <div class=\"daewoo-hero__quiz-opt\">Villa / grande propriété</div>\n          <span class=\"daewoo-hero__cta-card\">Commencer maintenant →</span>\n        </a>\n      </div>\n\n      <!-- Option 2 : Je sais déjà ce qu'il me faut (packs) -->\n      <div class=\"daewoo-hero__option\">\n        <span class=\"daewoo-hero__option-tag daewoo-hero__option-tag--alt\">2 · SI VOUS SAVEZ DÉJÀ</span>\n        <h3 class=\"daewoo-hero__option-title\">Je sais <em>déjà</em> ce qu'il me faut</h3>\n        <a href=\"https://daewoo-security.fr/pages/pack-alarmes?_pos=1&_psq=pack&_ss=e&_v=1.0\" class=\"daewoo-hero__card daewoo-hero__card--pack\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Design_sans_titre_3.svg?v=1781705389\" alt=\"Contenu du pack alarme Daewoo : sirène, caméra, détecteurs, télécommande\" class=\"daewoo-hero__pack-image\">\n          <span class=\"daewoo-hero__pack-cta\">Voir les packs →</span>\n        </a>\n      </div>\n\n    </div>\n\n  </div>\n</section>",
