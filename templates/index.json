      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "{% comment %} Section : Scénario de vie — timeline narrative {% endcomment %}\n\n{% assign sc1_time  = \"Jour 1 — 30 minutes\" %}\n{% assign sc1_titre = \"Vous installez tout vous-même\" %}\n{% assign sc1_desc  = \"Sans perçage, sans câblage, sans technicien. Le système est opérationnel en moins de 30 minutes. Vous scannez le QR code, vous placez les détecteurs, c'est fait.\" %}\n\n{% assign sc2_time  = \"Départ en vacances\" %}\n{% assign sc2_titre = \"Vous partez l'esprit tranquille\" %}\n{% assign sc2_desc  = \"Que vous soyez à 10 km ou à l'autre bout du monde, vous activez l'alarme depuis votre smartphone. Vous voyez votre maison en direct via les caméras.\" %}\n\n{% assign sc3_time  = \"3h17 du matin\" %}\n{% assign sc3_titre = \"Tentative d'intrusion détectée\" %}\n{% assign sc3_desc  = \"Une alerte s'affiche instantanément sur votre téléphone. La sirène se déclenche automatiquement. Vous recevez une notification avec la vidéo en temps réel.\" %}\n\n{% assign sc4_time  = \"3h17 — depuis votre lit d'hôtel\" %}\n{% assign sc4_titre = \"Vous regardez, vous décidez, vous agissez\" %}\n{% assign sc4_desc  = \"Depuis l'app, vous ouvrez le flux caméra en direct. Vous voyez exactement ce qui se passe. En un tap, vous appelez les forces de l'ordre avec les images en main.\" %}\n\n{% assign sc5_time  = \"3h22\" %}\n{% assign sc5_titre = \"Votre maison est sécurisée\" %}\n{% assign sc5_desc  = \"Les forces de l'ordre sont intervenues. Vous avez les enregistrements. Votre maison est protégée. Sans débourser un centime d'abonnement mensuel.\" %}\n\n<div id=\"sc-section\">\n  <div class=\"sc-inner\">\n\n    <div class=\"sc-header\">\n      <p class=\"sc-eyebrow\">Concrètement, ça change quoi ?</p>\n      <h2 class=\"sc-titre\">Votre vie avec <em>Daewoo Security</em></h2>\n      <p class=\"sc-sous\">De l'installation à l'intervention, voici ce qui se passe réellement.</p>\n    </div>\n\n    <div class=\"sc-timeline\">\n\n      <div class=\"sc-item\" data-i=\"0\">\n        <div class=\"sc-left\">\n          <div class=\"sc-icon sc-icon--blue\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"10\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n          </div>\n          <div class=\"sc-line\"></div>\n        </div>\n        <div class=\"sc-right\">\n          <p class=\"sc-time\">{{ sc1_time }}</p>\n          <h3 class=\"sc-nom\">{{ sc1_titre }}</h3>\n          <p class=\"sc-desc\">{{ sc1_desc }}</p>\n        </div>\n      </div>\n\n      <div class=\"sc-item\" data-i=\"1\">\n        <div class=\"sc-left\">\n          <div class=\"sc-icon sc-icon--green\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M22 16.5A10 10 0 0 1 3.5 8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M2 12a10 10 0 0 1 17.5-6.6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M12 2v4M12 18v4M2 12H6M18 12h4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" opacity=\".4\"/></svg>\n          </div>\n          <div class=\"sc-line\"></div>\n        </div>\n        <div class=\"sc-right\">\n          <p class=\"sc-time\">{{ sc2_time }}</p>\n          <h3 class=\"sc-nom\">{{ sc2_titre }}</h3>\n          <p class=\"sc-desc\">{{ sc2_desc }}</p>\n        </div>\n      </div>\n\n      <div class=\"sc-item\" data-i=\"2\">\n        <div class=\"sc-left\">\n          <div class=\"sc-icon sc-icon--red\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><circle cx=\"18\" cy=\"5\" r=\"3\" fill=\"currentColor\" opacity=\".7\"/></svg>\n          </div>\n          <div class=\"sc-line\"></div>\n        </div>\n        <div class=\"sc-right\">\n          <p class=\"sc-time\">{{ sc3_time }}</p>\n          <h3 class=\"sc-nom\">{{ sc3_titre }}</h3>\n          <p class=\"sc-desc\">{{ sc3_desc }}</p>\n        </div>\n      </div>\n\n      <div class=\"sc-item\" data-i=\"3\">\n        <div class=\"sc-left\">\n          <div class=\"sc-icon sc-icon--blue\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.8\"/><rect x=\"8\" y=\"5\" width=\"8\" height=\"10\" rx=\"1.5\" fill=\"currentColor\" opacity=\".2\"/><circle cx=\"12\" cy=\"18\" r=\"1\" fill=\"currentColor\"/></svg>\n          </div>\n          <div class=\"sc-line\"></div>\n        </div>\n        <div class=\"sc-right\">\n          <p class=\"sc-time\">{{ sc4_time }}</p>\n          <h3 class=\"sc-nom\">{{ sc4_titre }}</h3>\n          <p class=\"sc-desc\">{{ sc4_desc }}</p>\n        </div>\n      </div>\n\n      <div class=\"sc-item\" data-i=\"4\">\n        <div class=\"sc-left\">\n          <div class=\"sc-icon sc-icon--green\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><polyline points=\"9 12 11 14 15 10\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n        </div>\n        <div class=\"sc-right\">\n          <p class=\"sc-time\">{{ sc5_time }}</p>\n          <h3 class=\"sc-nom\">{{ sc5_titre }}</h3>\n          <p class=\"sc-desc\">{{ sc5_desc }}</p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n#sc-section {\n  --sc-bg:    #0d1b3e;\n  --sc-fg:    #ffffff;\n  --sc-muted: rgba(255,255,255,0.50);\n  --sc-line:  rgba(255,255,255,0.08);\n  --sc-blue:  #5b9bd5;\n  --sc-green: #4ade80;\n  --sc-red:   #f87171;\n  --sc-hfam:  var(--font-heading-family, system-ui, sans-serif);\n  --sc-bfam:  var(--font-body-family, system-ui, sans-serif);\n  --sc-ease:  cubic-bezier(0.22, 1, 0.36, 1);\n\n  background: var(--sc-bg);\n  padding: 80px 32px;\n  box-sizing: border-box;\n}\n\n.sc-inner {\n  max-width: 780px;\n  margin: 0 auto;\n}\n\n/* ── Header ── */\n.sc-header {\n  text-align: center;\n  margin-bottom: 56px;\n}\n.sc-eyebrow {\n  font-family: var(--sc-bfam);\n  font-size: .7rem;\n  font-weight: 600;\n  letter-spacing: .2em;\n  text-transform: uppercase;\n  color: var(--sc-blue);\n  margin: 0 0 .75rem;\n  opacity: 0;\n  transform: translateY(10px);\n  animation: sc-in .5s var(--sc-ease) .05s forwards;\n}\n.sc-titre {\n  font-family: var(--sc-hfam);\n  font-size: clamp(1.6rem, 3.5vw, 2.4rem);\n  font-weight: 700;\n  color: var(--sc-fg);\n  margin: 0 0 .6rem;\n  line-height: 1.12;\n  opacity: 0;\n  transform: translateY(12px);\n  animation: sc-in .55s var(--sc-ease) .13s forwards;\n}\n.sc-titre em {\n  font-style: normal;\n  color: var(--sc-blue);\n}\n.sc-sous {\n  font-family: var(--sc-bfam);\n  font-size: .95rem;\n  color: var(--sc-muted);\n  margin: 0;\n  opacity: 0;\n  transform: translateY(8px);\n  animation: sc-in .5s var(--sc-ease) .2s forwards;\n}\n\n/* ── Timeline ── */\n.sc-timeline {\n  display: flex;\n  flex-direction: column;\n}\n\n.sc-item {\n  display: flex;\n  gap: 24px;\n  padding: 28px 0;\n  border-bottom: 1px solid var(--sc-line);\n  opacity: 0;\n  transform: translateY(20px);\n}\n.sc-item:last-child { border-bottom: none; }\n.sc-item[data-i=\"0\"] { animation: sc-in .6s var(--sc-ease) .28s forwards; }\n.sc-item[data-i=\"1\"] { animation: sc-in .6s var(--sc-ease) .38s forwards; }\n.sc-item[data-i=\"2\"] { animation: sc-in .6s var(--sc-ease) .48s forwards; }\n.sc-item[data-i=\"3\"] { animation: sc-in .6s var(--sc-ease) .58s forwards; }\n.sc-item[data-i=\"4\"] { animation: sc-in .6s var(--sc-ease) .68s forwards; }\n\n/* ── Colonne gauche ── */\n.sc-left {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  flex-shrink: 0;\n  width: 48px;\n}\n.sc-icon {\n  width: 46px;\n  height: 46px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.sc-icon svg { width: 20px; height: 20px; }\n.sc-icon--blue  { background: rgba(91,155,213,.15);  color: var(--sc-blue);  }\n.sc-icon--green { background: rgba(74,222,128,.12);  color: var(--sc-green); }\n.sc-icon--red   { background: rgba(248,113,113,.14); color: var(--sc-red);   }\n\n.sc-line {\n  width: 1px;\n  flex: 1;\n  background: var(--sc-line);\n  margin-top: 10px;\n  min-height: 24px;\n}\n\n/* ── Colonne droite ── */\n.sc-right {\n  flex: 1;\n  padding-top: 8px;\n  min-width: 0;\n}\n.sc-time {\n  font-family: var(--sc-bfam);\n  font-size: .7rem;\n  font-weight: 600;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: var(--sc-blue);\n  margin: 0 0 .4rem;\n}\n.sc-nom {\n  font-family: var(--sc-hfam);\n  font-size: clamp(1rem, 2vw, 1.15rem);\n  font-weight: 700;\n  color: var(--sc-fg);\n  margin: 0 0 .5rem;\n  line-height: 1.22;\n}\n.sc-desc {\n  font-family: var(--sc-bfam);\n  font-size: .88rem;\n  line-height: 1.75;\n  color: var(--sc-muted);\n  margin: 0;\n}\n\n/* ── Keyframes ── */\n@keyframes sc-in {\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* ── Responsive ── */\n@media (max-width: 540px) {\n  #sc-section { padding: 3rem 1.25rem; }\n  .sc-item { gap: 16px; padding: 22px 0; }\n  .sc-left { width: 38px; }\n  .sc-icon { width: 38px; height: 38px; }\n  .sc-icon svg { width: 17px; height: 17px; }\n  .sc-nom { font-size: .95rem; }\n  .sc-desc { font-size: .82rem; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sc-eyebrow, .sc-titre, .sc-sous, .sc-item {\n    animation: none; opacity: 1; transform: none;\n  }\n}\n</style>",
