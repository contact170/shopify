        "liquid": "<style>\n\n  .daewoo-hero {\n\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n\n    background:  ;\n\n    padding: 64px 24px;\n\n    border-radius: 24px;\n\n  }\n\n  .daewoo-hero__inner {\n\n    max-width: 1200px;\n\n    margin: 0 auto;\n\n    display: grid;\n\n    grid-template-columns: 1fr 1fr;\n\n    gap: 48px;\n\n    align-items: center;\n\n  }\n\n  .daewoo-hero__badge {\n\n    display: inline-flex;\n\n    align-items: center;\n\n    gap: 8px;\n\n    background: #fff;\n\n    color: #0b1437;\n\n    font-weight: 700;\n\n    font-size: 13px;\n\n    letter-spacing: 0.08em;\n\n    padding: 10px 18px;\n\n    border-radius: 999px;\n\n    box-shadow: 0 4px 14px rgba(11,20,55,0.06);\n\n    margin-bottom: 28px;\n\n  }\n\n  .daewoo-hero__badge::before { content: \"✦\"; color: #1f3df5; }\n\n  .daewoo-hero__title {\n\n    font-size: clamp(34px, 5vw, 60px);\n\n    line-height: 1.05;\n\n    font-weight: 600;\n\n    color: #0b1e4a;\n\n    margin: 0 0 24px;\n\n    letter-spacing: -0.02em;\n\n  }\n\n  .daewoo-hero__title em { color: #1f3df5; font-style: normal; }\n\n  .daewoo-hero__subtitle {\n\n    font-size: 18px;\n\n    line-height: 1.55;\n\n    color: #5b6485;\n\n    margin: 0 0 28px;\n\n    max-width: 560px;\n\n  }\n\n  .daewoo-hero__features {\n\n    list-style: none;\n\n    padding: 0;\n\n    margin: 0 0 36px;\n\n    display: grid;\n\n    grid-template-columns: 1fr 1fr;\n\n    gap: 12px 24px;\n\n    max-width: 560px;\n\n  }\n\n  .daewoo-hero__features li {\n\n    display: flex;\n\n    align-items: center;\n\n    gap: 10px;\n\n    color: #0b1437;\n\n    font-weight: 500;\n\n  }\n\n  .daewoo-hero__features li::before {\n\n    content: \"✓\";\n\n    display: inline-flex;\n\n    align-items: center;\n\n    justify-content: center;\n\n    width: 22px;\n\n    height: 22px;\n\n    border-radius: 50%;\n\n    background: #d8f3df;\n\n    color: #1a8a3e;\n\n    font-weight: 700;\n\n    font-size: 13px;\n\n    flex-shrink: 0;\n\n  }\n\n  .daewoo-hero__cta {\n\n    display: inline-flex;\n\n    align-items: center;\n\n    gap: 10px;\n\n    background: linear-gradient(135deg, #0b1f8a 0%, #1f3df5 100%);\n\n    color: #fff;\n\n    text-decoration: none;\n\n    font-weight: 700;\n\n    font-size: 17px;\n\n    padding: 18px 36px;\n\n    border-radius: 999px;\n\n    box-shadow: 0 10px 24px rgba(31,61,245,0.28);\n\n    transition: transform .15s ease, box-shadow .15s ease;\n\n  }\n\n  .daewoo-hero__cta:hover {\n\n    transform: translateY(-1px);\n\n    box-shadow: 0 14px 28px rgba(31,61,245,0.34);\n\n  }\n\n  .daewoo-hero__meta {\n\n    margin-top: 18px;\n\n    font-size: 14px;\n\n    color: #6b7390;\n\n  }\n\n \n\n  /* Aperçu carte */\n\n  .daewoo-hero__card {\n\n    background: #fff;\n\n    border-radius: 20px;\n\n    padding: 28px;\n\n    box-shadow: 0 20px 50px rgba(11,20,55,0.10);\n\n    cursor: pointer;\n\n    transition: transform .2s ease;\n\n  }\n\n  .daewoo-hero__card:hover { transform: translateY(-3px); }\n\n  .daewoo-hero__card-head {\n\n    display: flex;\n\n    justify-content: space-between;\n\n    color: #6b7390;\n\n    font-size: 14px;\n\n    margin-bottom: 10px;\n\n  }\n\n  .daewoo-hero__progress {\n\n    height: 6px;\n\n    background: #eef0fb;\n\n    border-radius: 999px;\n\n    overflow: hidden;\n\n    margin-bottom: 22px;\n\n  }\n\n  .daewoo-hero__progress > span {\n\n    display: block;\n\n    width: 14%;\n\n    height: 100%;\n\n    background: #1f3df5;\n\n  }\n\n  .daewoo-hero__question {\n\n    font-size: 18px;\n\n    font-weight: 700;\n\n    color: #0b1437;\n\n    margin: 0 0 18px;\n\n  }\n\n  .daewoo-hero__option {\n\n    border: 1px solid #e3e6f3;\n\n    border-radius: 12px;\n\n    padding: 16px 20px;\n\n    margin-bottom: 12px;\n\n    color: #0b1437;\n\n    font-weight: 500;\n\n  }\n\n  .daewoo-hero__cta-card {\n\n    display: block;\n\n    width: 100%;\n\n    text-align: center;\n\n    background: linear-gradient(135deg, #0b1f8a 0%, #1f3df5 100%);\n\n    color: #fff;\n\n    padding: 16px;\n\n    border-radius: 12px;\n\n    font-weight: 700;\n\n    margin-top: 8px;\n\n  }\n\n  .daewoo-hero__card-foot {\n\n    text-align: center;\n\n    color: #8a92ad;\n\n    font-size: 13px;\n\n    margin-top: 12px;\n\n  }\n\n \n\n  @media (max-width: 900px) {\n\n    .daewoo-hero { padding: 40px 18px; }\n\n    .daewoo-hero__inner { grid-template-columns: 1fr; gap: 36px; }\n\n    .daewoo-hero__features { grid-template-columns: 1fr; }\n\n  }\n\n</style>\n\n \n\n<section class=\"daewoo-hero\">\n\n  <div class=\"daewoo-hero__inner\">\n\n    <div>\n\n      <span class=\"daewoo-hero__badge\">CONFIGURATEUR INTELLIGENT · 2 MINUTES</span>\n\n      <h1 class=\"daewoo-hero__title\">\n\n        Trouvez l'alarme parfaite pour votre <em>logement</em> en 7 questions.\n\n      </h1>\n\n      <p class=\"daewoo-hero__subtitle\">\n\n        Sans abonnement. Sans engagement. Notre assistant compose le pack idéal et applique automatiquement votre remise jusqu'à –25 %.\n\n      </p>\n\n      <ul class=\"daewoo-hero__features\">\n\n        <li>Sans abonnement, à vie</li>\n\n        <li>Livraison sous 48h</li>\n\n        <li>Jusqu'à –25% de remise pack</li>\n\n        <li>Garantie 2 ans</li>\n\n      </ul>\n\n      <a href=\"/pages/configurateur_2\" class=\"daewoo-hero__cta\">Démarrer le quiz →</a>\n\n      <div class=\"daewoo-hero__meta\">Gratuit · Aucune inscription · Résultat immédiat</div>\n\n    </div>\n\n \n\n    <a href=\"/pages/configurateur_2\" class=\"daewoo-hero__card\" style=\"text-decoration:none;\">\n\n      <div class=\"daewoo-hero__card-head\">\n\n        <span>Aperçu · Étape 1 sur 7</span>\n\n        <span>14 %</span>\n\n      </div>\n\n      <div class=\"daewoo-hero__progress\"><span></span></div>\n\n      <p class=\"daewoo-hero__question\">Quel type de logement souhaitez-vous protéger ?</p>\n\n      <div class=\"daewoo-hero__option\">Appartement</div>\n\n      <div class=\"daewoo-hero__option\">Maison</div>\n\n      <div class=\"daewoo-hero__option\">Villa / grande propriété</div>\n\n      <div class=\"daewoo-hero__cta-card\">Commencer maintenant →</div>\n\n      <div class=\"daewoo-hero__card-foot\">Aperçu — cliquez pour démarrer le vrai configurateur</div>\n\n    </a>\n\n  </div>\n\n</section>",
