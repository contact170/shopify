    "custom_liquid_yMqHcP": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .gs-section * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .gs-section {\n    font-family: 'Poppins', sans-serif;\n    padding: 64px 48px;\n    background: ;\n  }\n\n  .gs-inner { max-width: 1100px; margin: 0 auto; }\n\n  .gs-header {\n    text-align: center;\n    margin-bottom: 40px;\n  }\n\n  .gs-tag {\n    display: inline-block;\n    background: #e6f1fb;\n    color: #185fa5;\n    font-size: 12px;\n    font-weight: 600;\n    padding: 4px 14px;\n    border-radius: 20px;\n    margin-bottom: 14px;\n  }\n\n  .gs-title {\n    font-size: clamp(22px, 3vw, 32px);\n    font-weight: 700;\n    color: #0f1a2e;\n    margin-bottom: 10px;\n    line-height: 1.15;\n  }\n\n  .gs-subtitle {\n    font-size: 15px;\n    color: #6b7280;\n  }\n\n  .gs-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n    align-items: stretch;\n  }\n\n  .gs-card {\n    background: #fff;\n    border-radius: 18px;\n    border: 1.5px solid #e5e7eb;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    transition: transform 0.2s, box-shadow 0.2s;\n  }\n\n  .gs-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 16px 40px rgba(0,0,0,0.08);\n  }\n\n  .gs-card.featured {\n    border: 2px solid #1a4faa;\n  }\n\n  .gs-card-img {\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    overflow: hidden;\n    flex-shrink: 0;\n  }\n\n  .gs-card-img img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    display: block;\n  }\n\n  .gs-card-badge {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    background: #1a4faa;\n    color: #fff;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 4px 12px;\n    border-radius: 20px;\n    z-index: 2;\n  }\n\n  .gs-card-body {\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n  }\n\n  .gs-card-ref {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    margin-bottom: 6px;\n  }\n\n  .gs-card-ref.blue   { color: #185fa5; }\n  .gs-card-ref.purple { color: #7c3aed; }\n\n  .gs-card-title {\n    font-size: 20px;\n    font-weight: 700;\n    color: #0f1a2e;\n    margin-bottom: 8px;\n    line-height: 1.2;\n  }\n\n  .gs-card-desc {\n    font-size: 13px;\n    color: #6b7280;\n    line-height: 1.6;\n    margin-bottom: 20px;\n  }\n\n  .gs-features {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin-bottom: 24px;\n    flex: 1;\n  }\n\n  .gs-feature {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 13px;\n    color: #374151;\n  }\n\n  .gs-feature-check {\n    font-size: 13px;\n  }\n\n  .gs-feature-check.blue   { color: #1a4faa; }\n  .gs-feature-check.purple { color: #7c3aed; }\n\n  .gs-btn {\n    display: block;\n    text-align: center;\n    padding: 13px 20px;\n    border-radius: 10px;\n    font-size: 14px;\n    font-weight: 600;\n    text-decoration: none;\n    transition: background 0.2s, transform 0.15s;\n    cursor: pointer;\n    border: none;\n    font-family: 'Poppins', sans-serif;\n  }\n\n  .gs-btn:hover { transform: translateY(-1px); text-decoration: none; }\n\n  .gs-btn.blue-outline {\n    background: #f0f4ff;\n    color: #185fa5;\n  }\n\n  .gs-btn.blue-outline:hover { background: #dbeafe; color: #185fa5; }\n\n  .gs-btn.blue-solid {\n    background: #1a4faa;\n    color: #fff;\n  }\n\n  .gs-btn.blue-solid:hover { background: #2260cc; color: #fff; }\n\n  .gs-btn.purple-outline {\n    background: #f5f3ff;\n    color: #7c3aed;\n  }\n\n  .gs-btn.purple-outline:hover { background: #ede9fe; color: #7c3aed; }\n\n  @media (max-width: 768px) {\n    .gs-section { padding: 48px 0; }\n    .gs-header   { padding: 0 24px; }\n\n    .gs-grid {\n      display: flex;\n      flex-wrap: nowrap;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      gap: 16px;\n      padding: 8px 24px 16px;\n      scrollbar-width: none;\n      align-items: stretch;\n    }\n\n    .gs-grid::-webkit-scrollbar { display: none; }\n\n    .gs-card {\n      flex: 0 0 78vw;\n      max-width: 300px;\n      scroll-snap-align: start;\n    }\n  }\n</style>\n\n<div class=\"gs-section\">\n  <div class=\"gs-inner\">\n\n    <div class=\"gs-header\">\n      <span class=\"gs-tag\">Nos 3 gammes</span>\n      <h2 class=\"gs-title\">Nos gammes d'alarmes</h2>\n      <p class=\"gs-subtitle\">Choisissez selon votre logement et votre niveau d'exigence.</p>\n    </div>\n\n    <div class=\"gs-grid\">\n\n      <!-- Vigilia -->\n      <div class=\"gs-card\">\n        <div class=\"gs-card-img\" style=\"background:#dbeafe;\">\n          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Visuels_amazon_vendor_3_a1675f6c-d7ca-46f7-bf83-a223e20eb5e5.webp?v=1777539260\" alt=\"Gamme Vigilia\">\n        </div>\n        <div class=\"gs-card-body\">\n          <p class=\"gs-card-ref blue\">Vigilia</p>\n          <p class=\"gs-card-title\">Simple & rapide</p>\n          <p class=\"gs-card-desc\">Idéale pour un appartement ou une maison. Sans fil, sans câble.</p>\n          <div class=\"gs-features\">\n            <div class=\"gs-feature\"><span class=\"gs-feature-check blue\">✓</span> Wi-Fi + batterie de secours</div>\n            <div class=\"gs-feature\"><span class=\"gs-feature-check blue\">✓</span> Jusqu'à 90 accessoires</div>\n            <div class=\"gs-feature\"><span class=\"gs-feature-check blue\">✓</span> App gratuite incluse</div>\n          </div>\n          <a href=\"https://daewoo-security.fr/collections/systeme-dalarme-vigilia\" class=\"gs-btn blue-outline\">Voir la gamme →</a>\n        </div>\n      </div>\n\n      <!-- Touch -->\n      <div class=\"gs-card featured\">\n        <div class=\"gs-card-img\" style=\"background:#bfdbfe;position:relative;\">\n          <div class=\"gs-card-badge\">Populaire</div>\n          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/BANNIERE_PC_VIGILIA_1450_x_700_px_1700_x_900_px_1700_x_700_px_7.webp?v=1777540487\" alt=\"Gamme Touch\">\n        </div>\n        <div class=\"gs-card-body\">\n          <p class=\"gs-card-ref blue\">Touch</p>\n          <p class=\"gs-card-title\">Moderne & évolutive</p>\n          <p class=\"gs-card-desc\">Écran tactile couleur. Pilotez tout depuis la centrale ou le smartphone.</p>\n          <div class=\"gs-features\">\n            <div class=\"gs-feature\"><span class=\"gs-feature-check blue\">✓</span> Écran tactile 4,3'' ou 7''</div>\n            <div class=\"gs-feature\"><span class=\"gs-feature-check blue\">✓</span> Wi-Fi + 4G optionnel</div>\n            <div class=\"gs-feature\"><span class=\"gs-feature-check blue\">✓</span> Batterie 4h à 20h</div>\n          </div>\n          <a href=\"https://daewoo-security.fr/collections/systeme-dalarme-am301-am302\" class=\"gs-btn blue-solid\">Voir la gamme →</a>\n        </div>\n      </div>\n\n      <!-- Élite -->\n      <div class=\"gs-card\">\n        <div class=\"gs-card-img\" style=\"background:#ede9fe;\">\n          <img class=\"lazyload\" data-src=\"https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Visuels_amazon_vendor_4.webp?v=1777541137\" alt=\"Gamme Élite\">\n        </div>\n        <div class=\"gs-card-body\">\n          <p class=\"gs-card-ref purple\">Élite</p>\n          <p class=\"gs-card-title\">Renforcée & pro</p>\n          <p class=\"gs-card-desc\">Zigbee 3.0, triple connexion, batterie 12h. Pour les grandes maisons.</p>\n          <div class=\"gs-features\">\n            <div class=\"gs-feature\"><span class=\"gs-feature-check purple\">✓</span> RJ45 + Wi-Fi + 4G</div>\n            <div class=\"gs-feature\"><span class=\"gs-feature-check purple\">✓</span> Zigbee 3.0 — réseau maillé</div>\n            <div class=\"gs-feature\"><span class=\"gs-feature-check purple\">✓</span> Batterie de secours 12h</div>\n          </div>\n      <a href=\"https://daewoo-security.fr/collections/systeme-dalarme-pa501z\" class=\"gs-btn purple-outline\">Voir la gamme →</a>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n</div>",
