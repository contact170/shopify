{%- comment -%}
  ============================================================================
  DAEWOO SECURITY — page /pages/configurateur_2
  BLOC 1 : bandeau garanties + choix « pack complet ou configurateur »

  À placer dans une section « Liquid personnalisé », AU-DESSUS de la section
  « Page » (celle qui contient l'iframe du configurateur).
  Réglages de la section : marge haute 0, marge basse 0.

  Palette, typographie et composants repris du design déjà en place sur le
  site : dégradé navy → bleu du hero, pastille cyan, badges pilule, cartes à
  bord 1,5 px et coins 18 px, Poppins + DM Sans.

  Les deux visuels sont ceux qui existent déjà dans vos fichiers Shopify
  (Image_Acceuil_Pack_Pret_a_poser_Daewoo / Image_Acceuil_Configurateur_Daewoo).
  Le prix mini et le nombre de packs sont tirés de la collection
  « starters-packs » : aucun chiffre à maintenir à la main.
  ============================================================================
{%- endcomment -%}

{%- assign packs = collections['starters-packs'] -%}
{%- assign packs_min = 0 -%}
{%- for p in packs.products -%}
  {%- if packs_min == 0 or p.price < packs_min -%}
    {%- assign packs_min = p.price -%}
  {%- endif -%}
{%- endfor -%}

{%- assign img_pack = 'https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Image_Acceuil_Pack_Pret_a_poser_Daewoo.png?v=1786099030' -%}
{%- assign img_config = 'https://cdn.shopify.com/s/files/1/0326/3132/4811/files/Image_Acceuil_Configurateur_Daewoo.png?v=1786099030' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Poppins:wght@600;700;800&display=swap">

<style>
  .cfg-scope {
    --nuit:    #0b1e4a;
    --azur:    #1a4fab;
    --cyan:    #48cae4;
    --brume:   #f2f3ff;
    --trait:   #dfe3f5;
    --ardoise: #5b6485;
    --craie:   #ffffff;
    --display: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --texte:   "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

    font-family: var(--texte);
    color: var(--nuit);
    line-height: 1.55;
    font-size: 16px;
  }
  .cfg-scope *, .cfg-scope *::before, .cfg-scope *::after { box-sizing: border-box; }
  .cfg-scope p, .cfg-scope h1, .cfg-scope h2, .cfg-scope ul { margin: 0; padding: 0; }

  /* ---------- badge pilule à pastille ---------- */
  .cfg-pill {
    display: inline-flex; align-items: center; gap: 8px;
    border-radius: 100px; padding: 6px 15px;
    font-size: 11px; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; width: fit-content;
  }
  .cfg-pill__dot { width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .cfg-pill--sombre {
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16);
    color: rgba(255,255,255,.72);
  }
  .cfg-pill--sombre .cfg-pill__dot { background: var(--cyan); }
  .cfg-pill--clair { background: #e6f1fb; border: 1px solid #cfe2f6; color: #185fa5; }
  .cfg-pill--clair .cfg-pill__dot { background: var(--azur); }

  /* ---------- bandeau pleine largeur ---------- */
  .cfg-bandeau {
    background: linear-gradient(135deg, var(--nuit) 0%, var(--azur) 100%);
    position: relative; overflow: hidden;
    width: 100vw; max-width: 100vw;
    margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%);
  }
  .cfg-bandeau::before {
    content: ""; position: absolute; top: -140px; right: -60px;
    width: 320px; height: 320px; border-radius: 50%;
    background: radial-gradient(circle, rgba(72,202,228,.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .cfg-bandeau__inner {
    max-width: 1280px; margin: 0 auto; padding: 14px 24px;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 34px;
    position: relative; z-index: 1;
  }
  .cfg-bandeau__item {
    display: flex; align-items: center; gap: 10px;
    font-size: 12.5px; font-weight: 500; letter-spacing: .04em;
    color: rgba(255,255,255,.82); white-space: nowrap;
  }
  .cfg-bandeau__item::before {
    content: ""; width: 5px; height: 5px; border-radius: 50%;
    background: var(--cyan); flex: none;
  }

  /* ---------- le choix ---------- */
  .cfg-choix { padding: 52px 0 8px; }
  .cfg-choix__intro { margin-bottom: 34px; }
  .cfg-h1 {
    font-family: var(--display); font-size: clamp(30px, 4.2vw, 52px);
    font-weight: 700; letter-spacing: -.025em; line-height: 1.06;
    text-wrap: balance; margin: 16px 0 14px;
  }
  .cfg-h1 em { font-style: normal; color: var(--azur); }
  .cfg-lede { max-width: 62ch; font-size: 17px; color: var(--ardoise); }

  .cfg-panneaux {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px; align-items: stretch;
  }
  .cfg-panneau {
    display: grid; grid-template-columns: 210px minmax(0, 1fr);
    border-radius: 18px; overflow: hidden; position: relative;
    transition: transform .22s ease, box-shadow .22s ease;
  }
  .cfg-panneau:hover { transform: translateY(-4px); }

  .cfg-panneau--pack {
    background: linear-gradient(135deg, var(--nuit) 0%, #16357e 55%, var(--azur) 100%);
    color: #eef2fb; box-shadow: 0 18px 44px -24px rgba(11, 30, 74, .85);
  }
  .cfg-panneau--pack::after {
    content: ""; position: absolute; bottom: -110px; right: -70px;
    width: 300px; height: 300px; border-radius: 50%;
    background: radial-gradient(circle, rgba(72,202,228,.16) 0%, transparent 70%);
    pointer-events: none;
  }
  .cfg-panneau--pack:hover { box-shadow: 0 28px 58px -24px rgba(11, 30, 74, .95); }

  .cfg-panneau--config {
    background: var(--craie); color: var(--nuit);
    border: 2px solid var(--azur); box-shadow: 0 10px 32px -22px rgba(11, 30, 74, .5);
  }
  .cfg-panneau--config:hover { box-shadow: 0 24px 46px -26px rgba(11, 30, 74, .6); }

  .cfg-visuel { position: relative; overflow: hidden; background: #0a1836; }
  .cfg-panneau--config .cfg-visuel { background: #dbe6f8; }
  .cfg-visuel img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center; display: block;
  }

  .cfg-corps { padding: 26px 26px 24px; display: flex; flex-direction: column; position: relative; z-index: 1; }
  .cfg-panneau__titre {
    font-family: var(--display); font-size: clamp(20px, 2.1vw, 26px);
    font-weight: 700; letter-spacing: -.02em; line-height: 1.18;
    margin: 16px 0 6px; text-wrap: balance;
  }
  .cfg-panneau__sous { font-size: 14.5px; margin-bottom: 20px; }
  .cfg-panneau--pack   .cfg-panneau__sous { color: rgba(238,242,251,.66); }
  .cfg-panneau--config .cfg-panneau__sous { color: var(--ardoise); }

  .cfg-points { list-style: none; margin-bottom: 22px; display: grid; gap: 12px; }
  .cfg-points li { display: grid; grid-template-columns: 22px 1fr; gap: 11px; align-items: start; font-size: 14.5px; }
  .cfg-points .coche {
    width: 22px; height: 22px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; flex: none; margin-top: 1px;
  }
  .cfg-panneau--pack   .cfg-points .coche { background: rgba(72,202,228,.16); color: var(--cyan); }
  .cfg-panneau--config .cfg-points .coche { background: #d8f3df; color: #1a8a3e; }

  .cfg-pied { margin-top: auto; }
  .cfg-chiffre { font-size: 13px; margin-bottom: 14px; }
  .cfg-panneau--pack   .cfg-chiffre { color: rgba(238,242,251,.6); }
  .cfg-panneau--config .cfg-chiffre { color: var(--ardoise); }
  .cfg-chiffre b { font-family: var(--display); font-weight: 700; font-size: 17px; }
  .cfg-panneau--pack   .cfg-chiffre b { color: #fff; }
  .cfg-panneau--config .cfg-chiffre b { color: var(--nuit); }

  .cfg-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; padding: 15px 24px; border-radius: 100px; border: 1px solid transparent;
    font-family: var(--texte); font-size: 14.5px; font-weight: 600;
    text-decoration: none; cursor: pointer;
    transition: background .18s ease, color .18s ease;
  }
  .cfg-btn:focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }
  .cfg-btn--blanc { background: var(--craie); color: var(--nuit); }
  .cfg-btn--blanc:hover { background: #dbe6f8; color: var(--nuit); }
  .cfg-btn--azur { background: var(--azur); color: #fff; box-shadow: 0 8px 22px -10px rgba(26,79,171,.7); }
  .cfg-btn--azur:hover { background: #16357e; color: #fff; }

  .cfg-aide {
    margin-top: 24px; padding: 18px 22px; background: var(--craie);
    border: 1.5px solid var(--trait); border-left: 4px solid var(--azur);
    border-radius: 0 14px 14px 0;
    font-size: 14.5px; color: var(--ardoise); max-width: 82ch;
  }
  .cfg-aide b { color: var(--nuit); font-weight: 600; }

  @media (max-width: 1080px) { .cfg-panneau { grid-template-columns: 170px minmax(0, 1fr); } }
  @media (max-width: 900px) {
    .cfg-panneaux { grid-template-columns: 1fr; }
    .cfg-panneau { grid-template-columns: 200px minmax(0, 1fr); }
    .cfg-choix { padding-top: 38px; }
  }
  @media (max-width: 620px) {
    .cfg-panneau { grid-template-columns: 1fr; }
    .cfg-visuel { aspect-ratio: 5 / 4; }
    .cfg-bandeau__inner { justify-content: flex-start; gap: 8px 20px; }
    .cfg-bandeau__item { font-size: 11.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cfg-scope * { animation: none !important; transition: none !important; }
  }
</style>

<div class="cfg-scope">

  <div class="cfg-bandeau">
    <div class="cfg-bandeau__inner">
      <span class="cfg-bandeau__item">Sans abonnement</span>
      <span class="cfg-bandeau__item">Expédition sous 24&nbsp;h</span>
      <span class="cfg-bandeau__item">Livraison en 2 à 3 jours</span>
      <span class="cfg-bandeau__item">Garantie 2 ans</span>
    </div>
  </div>

  <section class="cfg-choix">

    <div class="cfg-choix__intro">
      <span class="cfg-pill cfg-pill--clair"><span class="cfg-pill__dot"></span>Trouver mon alarme</span>
      <h1 class="cfg-h1">Deux façons d'équiper <em>votre maison</em>.</h1>
      <p class="cfg-lede">
        Prenez un pack déjà assemblé, ou composez votre système pièce par pièce.
        Les deux mènent à la même protection, sans abonnement et sans engagement.
      </p>
    </div>

    <div class="cfg-panneaux">

      {%- comment -%} Panneau A — l'option que le visiteur ne connaît pas encore {%- endcomment -%}
      <div class="cfg-panneau cfg-panneau--pack">
        <div class="cfg-visuel">
          <img src="{{ img_pack }}&width=600" alt="Pack d'alarme Daewoo prêt à poser" loading="lazy" width="600" height="990">
        </div>

        <div class="cfg-corps">
          <span class="cfg-pill cfg-pill--sombre"><span class="cfg-pill__dot"></span>Le plus rapide</span>
          <h2 class="cfg-panneau__titre">On a déjà fait le tri.</h2>
          <p class="cfg-panneau__sous">Pour un logement standard, tout est décidé d'avance.</p>

          <ul class="cfg-points">
            <li><span class="coche">&#10003;</span><span>Centrale, détecteurs et sirène assemblés et testés ensemble</span></li>
            <li><span class="coche">&#10003;</span><span>Livré prêt à poser — rien à choisir, rien à compléter</span></li>
            <li><span class="coche">&#10003;</span><span>Expédié sous 24&nbsp;h, chez vous en 2 à 3 jours</span></li>
          </ul>

          <div class="cfg-pied">
            <p class="cfg-chiffre">
              {%- if packs_min > 0 -%}à partir de <b>{{ packs_min | money }}</b>{%- endif -%}
              {%- if packs.all_products_count > 0 %} &nbsp;·&nbsp; {{ packs.all_products_count }} pack{% if packs.all_products_count > 1 %}s{% endif %}{%- endif -%}
            </p>
            <a class="cfg-btn cfg-btn--blanc" href="{{ packs.url | default: '/collections/starters-packs' }}">
              Voir les packs complets
            </a>
          </div>
        </div>
      </div>

      {%- comment -%} Panneau B — la page où le visiteur se trouve déjà {%- endcomment -%}
      <div class="cfg-panneau cfg-panneau--config">
        <div class="cfg-visuel">
          <img src="{{ img_config }}&width=600" alt="Configurateur d'alarme Daewoo" loading="lazy" width="600" height="990">
        </div>

        <div class="cfg-corps">
          <span class="cfg-pill cfg-pill--clair"><span class="cfg-pill__dot"></span>Vous êtes ici</span>
          <h2 class="cfg-panneau__titre">Vous composez le vôtre.</h2>
          <p class="cfg-panneau__sous">Le système suit votre logement, pas l'inverse.</p>

          <ul class="cfg-points">
            <li><span class="coche">&#10003;</span><span>Quelques questions sur votre logement, deux minutes</span></li>
            <li><span class="coche">&#10003;</span><span>Le nombre de détecteurs suit vos portes et fenêtres</span></li>
            <li><span class="coche">&#10003;</span><span>Vous ajoutez ou retirez chaque accessoire avant de valider</span></li>
          </ul>

          <div class="cfg-pied">
            <p class="cfg-chiffre">gratuit &nbsp;·&nbsp; sans engagement</p>
            <a class="cfg-btn cfg-btn--azur" href="#configurateur" data-cfg-goto>Configurer mon alarme</a>
          </div>
        </div>
      </div>

    </div>

    <p class="cfg-aide">
      <b>Vous hésitez&nbsp;?</b> Appartement ou plain-pied avec moins de cinq ouvertures : le pack complet suffit.
      Étage, dépendance, animaux ou grande surface : passez par le configurateur, il ajustera le nombre de détecteurs.
    </p>
  </section>

</div>

<script>
  // Le bouton « Configurer mon alarme » descend jusqu'à l'iframe du configurateur,
  // qui vit dans le corps de la page et n'a pas d'ancre propre.
  (function () {
    var btn = document.querySelector('[data-cfg-goto]');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      var cible = document.querySelector('.daewoo-configurator-wrapper')
               || document.getElementById('daewooConfigurator');
      if (!cible) return; // sans cible, on laisse le lien faire son travail
      e.preventDefault();
      var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      cible.scrollIntoView({ behavior: reduit ? 'auto' : 'smooth', block: 'start' });
    });
  })();
</script>
