{%- comment -%}
  ============================================================================
  DAEWOO SECURITY — page /pages/configurateur_2
  BLOC 2 : rail « Offres exclusives du moment »

  À placer dans une section « Liquid personnalisé », EN DESSOUS de la section
  « Page » (celle qui contient l'iframe du configurateur).
  Réglages de la section : marge haute 0, marge basse 0.

  Tout est dynamique : produits, photos, prix, remises et compteur viennent de
  la collection « offres-exclusives-copie ». Rien à mettre à jour à la main —
  il suffit d'ajouter ou de retirer un produit dans cette collection.
  Pour pointer vers une autre collection, changez la ligne ci-dessous.
  ============================================================================
{%- endcomment -%}

{%- assign offres = collections['offres-exclusives-copie'] -%}
{%- assign max_cartes = 12 -%}

{%- if offres.products.size > 0 -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap">

<style>
  .cfg-scope-offres {
    --nuit:       #0c1e4a;
    --brume:      #f2f3ff;
    --brume-trait:#d7dbf2;
    --signal:     #0b61cd;
    --alerte:     #e11d48;
    --craie:      #ffffff;
    --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --sans: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

    font-family: var(--sans);
    color: var(--nuit);
    line-height: 1.55;
    padding: 72px 0 24px;
  }
  .cfg-scope-offres *, .cfg-scope-offres *::before, .cfg-scope-offres *::after { box-sizing: border-box; }

  .cfg-offers__head { margin-bottom: 30px; }
  .cfg-h2 {
    font-size: clamp(26px, 3.4vw, 38px); font-weight: 800; letter-spacing: -.03em;
    line-height: 1.1; margin: 0 0 10px; text-wrap: balance;
  }
  .cfg-offers__sub { max-width: 56ch; font-size: 15.5px; color: #465185; margin: 0; }

  .cfg-live {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--mono); font-size: 11.5px; font-weight: 500;
    letter-spacing: .14em; text-transform: uppercase; color: var(--alerte);
    margin: 0 0 14px;
  }
  .cfg-live__led {
    width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--alerte);
    box-shadow: 0 0 0 0 rgba(225,29,72,.5);
    animation: cfg-pulse-red 2.6s ease-out infinite;
  }
  @keyframes cfg-pulse-red {
    0%   { box-shadow: 0 0 0 0 rgba(225,29,72,.5); }
    70%  { box-shadow: 0 0 0 7px rgba(225,29,72,0); }
    100% { box-shadow: 0 0 0 0 rgba(225,29,72,0); }
  }

  /* rail à défilement horizontal — évite une grille qui casse à 10 produits */
  .cfg-rail {
    display: grid; grid-auto-flow: column; grid-auto-columns: 268px; gap: 18px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 4px 24px 22px; margin: 0 -24px;
    scrollbar-width: thin; scrollbar-color: #b6bee4 transparent;
  }
  .cfg-rail::-webkit-scrollbar { height: 6px; }
  .cfg-rail::-webkit-scrollbar-thumb { background: #b6bee4; border-radius: 3px; }
  .cfg-rail::-webkit-scrollbar-track { background: transparent; }
  .cfg-rail:focus-visible { outline: 3px solid var(--signal); outline-offset: 4px; }

  .cfg-card {
    scroll-snap-align: start; background: var(--craie);
    border: 1px solid var(--brume-trait); border-radius: 12px; overflow: hidden;
    display: flex; flex-direction: column; text-decoration: none; color: inherit;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .cfg-card:hover {
    transform: translateY(-4px); border-color: #9fb6e6;
    box-shadow: 0 20px 38px -24px rgba(12, 30, 74, .6);
  }
  .cfg-card:focus-visible { outline: 3px solid var(--signal); outline-offset: 3px; }

  .cfg-card__media {
    position: relative; aspect-ratio: 1 / 1; background: var(--brume);
    display: grid; place-items: center; border-bottom: 1px solid var(--brume-trait);
  }
  .cfg-card__media img { width: 100%; height: 100%; object-fit: contain; display: block; }

  .cfg-cut {
    position: absolute; top: 10px; left: 10px;
    font-family: var(--mono); font-size: 12px; font-weight: 600;
    letter-spacing: .04em; font-variant-numeric: tabular-nums;
    background: var(--alerte); color: #fff; padding: 4px 8px; border-radius: 4px;
  }

  .cfg-card__body { padding: 15px 16px 17px; display: flex; flex-direction: column; flex: 1; gap: 10px; }
  .cfg-card__fam {
    font-family: var(--mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: .14em; text-transform: uppercase; color: #7b86b4; margin: 0;
  }
  .cfg-card__title {
    font-size: 14.5px; font-weight: 600; line-height: 1.35; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cfg-card__prices {
    margin-top: auto; display: flex; align-items: baseline; gap: 9px;
    font-variant-numeric: tabular-nums;
  }
  .cfg-card__now { font-size: 19px; font-weight: 700; letter-spacing: -.02em; }
  .cfg-card__was { font-size: 13px; color: #8a93bd; text-decoration: line-through; }
  .cfg-card__save {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: .02em;
    color: var(--alerte); font-variant-numeric: tabular-nums; margin: 0;
  }

  .cfg-offers__foot { margin-top: 26px; }
  .cfg-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 15px 26px; border-radius: 8px; border: 1px solid transparent;
    font-family: var(--sans); font-size: 14.5px; font-weight: 600;
    text-decoration: none; background: var(--nuit); color: #fff;
    transition: background .16s ease;
  }
  .cfg-btn:hover { background: var(--signal); color: #fff; }
  .cfg-btn:focus-visible { outline: 3px solid var(--signal); outline-offset: 3px; }

  @media (max-width: 860px) {
    .cfg-scope-offres { padding-top: 56px; }
    .cfg-rail { grid-auto-columns: 232px; }
  }
  @media (max-width: 520px) {
    .cfg-rail { margin: 0 -16px; padding-left: 16px; padding-right: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cfg-scope-offres * { animation: none !important; transition: none !important; }
  }
</style>

<div class="cfg-scope-offres">

  <div class="cfg-offers__head">
    <p class="cfg-live">
      <span class="cfg-live__led"></span>
      {{ offres.all_products_count }} offre{% if offres.all_products_count > 1 %}s{% endif %} en cours
    </p>
    <h2 class="cfg-h2">Offres exclusives du moment.</h2>
    <p class="cfg-offers__sub">
      Des packs déjà constitués, remisés tant qu'il reste du stock.
      Même garantie, toujours sans abonnement.
    </p>
  </div>

  <div class="cfg-rail" tabindex="0" role="region" aria-label="Offres exclusives">
    {%- for produit in offres.products limit: max_cartes -%}
      {%- unless produit.available -%}{%- continue -%}{%- endunless -%}

      {%- comment -%} Titre nettoyé : on retire le préfixe marketing pour garder le produit {%- endcomment -%}
      {%- assign titre = produit.title
          | remove_first: 'OFFRE EXCLUSIVE |'
          | remove_first: 'OFFRE LIMITÉE  |'
          | remove_first: 'OFFRE LIMITÉE |'
          | remove_first: 'OFFRE BLACK FRIDAY'
          | strip -%}

      {%- comment -%} Gamme déduite du titre, du plus précis au plus général {%- endcomment -%}
      {%- assign t_maj = produit.title | upcase -%}
      {%- if t_maj contains 'TOUCH XL' -%}{%- assign gamme = 'Touch XL' -%}
      {%- elsif t_maj contains 'TOUCH' -%}{%- assign gamme = 'Touch' -%}
      {%- elsif t_maj contains 'VIGILIA' -%}{%- assign gamme = 'Vigilia' -%}
      {%- elsif t_maj contains 'ÉLITE' or t_maj contains 'ELITE' -%}{%- assign gamme = 'Élite' -%}
      {%- else -%}{%- assign gamme = produit.type -%}
      {%- endif -%}

      {%- assign remise = 0 -%}
      {%- if produit.compare_at_price_min > produit.price_min -%}
        {%- assign ecart = produit.compare_at_price_min | minus: produit.price_min -%}
        {%- assign remise = ecart | times: 100.0 | divided_by: produit.compare_at_price_min | round -%}
      {%- endif -%}

      <a class="cfg-card" href="{{ produit.url }}">
        <div class="cfg-card__media">
          {%- if remise > 0 -%}
            <span class="cfg-cut">&minus;{{ remise }}&nbsp;%</span>
          {%- endif -%}
          {%- if produit.featured_image -%}
            {{ produit.featured_image | image_url: width: 600 | image_tag:
                 loading: 'lazy', widths: '268, 400, 536, 600', sizes: '268px', alt: titre }}
          {%- endif -%}
        </div>

        <div class="cfg-card__body">
          {%- if gamme != blank -%}<p class="cfg-card__fam">{{ gamme }}</p>{%- endif -%}
          <h3 class="cfg-card__title">{{ titre }}</h3>

          <div class="cfg-card__prices">
            <span class="cfg-card__now">{{ produit.price_min | money }}</span>
            {%- if remise > 0 -%}
              <span class="cfg-card__was">{{ produit.compare_at_price_min | money }}</span>
            {%- endif -%}
          </div>

          {%- if remise > 0 -%}
            <p class="cfg-card__save">vous économisez {{ ecart | money }}</p>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>

  <div class="cfg-offers__foot">
    <a class="cfg-btn" href="{{ offres.url }}">
      Voir les {{ offres.all_products_count }} offres
    </a>
  </div>

</div>

{%- endif -%}
