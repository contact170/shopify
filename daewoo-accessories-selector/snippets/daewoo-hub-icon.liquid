{%- doc -%}
  Small monoline icon set for the accessories hub (badge icons + feature
  bullets). The theme's own icon snippet has no security-specific glyphs
  (sensor, siren, remote, camera…), so this adds a minimal matching set:
  same stroke-based style (currentColor, ~1.6 stroke), simple primitives
  only (circles/rects/short paths) to stay legible at small sizes.

  @param {string} icon - one of: shield, touch, key, diamond, sensor,
    siren, remote, camera, connectivity, sliders
  @param {string} [class] - additional CSS classes

  @example
  {% render 'daewoo-hub-icon', icon: 'shield', class: 'daewoo-hub-row__badge-icon' %}
{%- enddoc -%}

{%- capture svg_class -%}daewoo-hub-icon{% if class != blank %} {{ class }}{% endif %}{%- endcapture -%}

{%- case icon -%}
  {%- when 'shield' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>

  {%- when 'touch' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="12" r="5.5"/>
      <circle cx="12" cy="12" r="9.5" opacity="0.45"/>
    </svg>

  {%- when 'key' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <circle cx="8" cy="8" r="4"/>
      <path d="M11 11l9 9"/>
      <path d="M17 14l3 3"/>
      <path d="M14 17l2 2"/>
    </svg>

  {%- when 'diamond' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <path d="M5 9l4-6h6l4 6-7 12-7-12z"/>
      <path d="M5 9h14"/>
    </svg>

  {%- when 'sensor' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <circle cx="7" cy="17" r="1.6" fill="currentColor" stroke="none"/>
      <path d="M11 17a6 6 0 0 0-4-9"/>
      <path d="M14.5 17a9.5 9.5 0 0 0-4-13"/>
    </svg>

  {%- when 'siren' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 3a5 5 0 0 1 5 5v4l2 4H5l2-4V8a5 5 0 0 1 5-5z"/>
      <path d="M9.5 20a2.5 2.5 0 0 0 5 0"/>
    </svg>

  {%- when 'remote' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <rect x="7" y="3" width="10" height="18" rx="3"/>
      <circle cx="12" cy="8" r="1.3" fill="currentColor" stroke="none"/>
      <path d="M9.5 13h5M9.5 16h5"/>
    </svg>

  {%- when 'camera' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="7" width="15" height="11" rx="2.5"/>
      <circle cx="10.5" cy="12.5" r="3"/>
      <path d="M7 7l1.5-2h4L14 7"/>
    </svg>

  {%- when 'connectivity' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="18" r="1.3" fill="currentColor" stroke="none"/>
      <path d="M8.5 15a5 5 0 0 1 7 0"/>
      <path d="M5.5 12a9 9 0 0 1 13 0"/>
    </svg>

  {%- when 'sliders' -%}
    <svg class="{{ svg_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 7h9M17 7h3"/>
      <circle cx="14" cy="7" r="2"/>
      <path d="M4 17h3M11 17h9"/>
      <circle cx="8" cy="17" r="2"/>
    </svg>
{%- endcase -%}
