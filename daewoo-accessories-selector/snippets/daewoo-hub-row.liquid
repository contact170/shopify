{%- doc -%}
  Renders one row of the accessories hub: product photo on one side (set
  against a soft signal-ring backdrop), content on the other — model-code
  chip, heading, tagline, compatibility tags, text-link CTA. Side
  alternates by row index. No card border — rows are separated by a
  hairline rule, read as an editorial list rather than a feature grid.

  @param {object} block - a card_vigilia / card_touch / card_key / card_elite block
  @param {number} index - 1-based position in the sequence, drives the alternation
  @param {string} [loading] - 'eager' or 'lazy' (default 'lazy')

  @example
  {% render 'daewoo-hub-row', block: block, index: 1 %}
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign loading = loading | default: 'lazy'
  assign card_alt = s.image_alt | default: s.heading | strip_html
  assign reversed = false
  assign remainder = index | modulo: 2
  if remainder == 0
    assign reversed = true
  endif
-%}

<div class="daewoo-hub-row{% if reversed %} daewoo-hub-row--reversed{% endif %}" {{ block.shopify_attributes }}>
  <div class="daewoo-hub-row__media">
    <div class="daewoo-hub__ring daewoo-hub__ring--row" aria-hidden="true"></div>
    {%- if s.image != blank -%}
      {{-
        s.image
        | image_url: width: s.image.width
        | image_tag:
          loading: loading,
          widths: '400,600,800,1000',
          sizes: '(max-width: 900px) 100vw, 45vw',
          alt: card_alt,
          class: 'daewoo-hub-row__img'
      -}}
    {%- else -%}
      {{- 'product-1' | placeholder_svg_tag: 'daewoo-hub-row__img placeholder-svg' -}}
    {%- endif -%}
  </div>

  <div class="daewoo-hub-row__content">
    {%- if s.model_code != blank -%}
      <p class="daewoo-hub-row__code">{{ s.model_code | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="daewoo-hub-row__heading heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.tagline != blank -%}
      <p class="daewoo-hub-row__tagline">{{ s.tagline }}</p>
    {%- endif -%}

    {%- assign has_tags = false -%}
    {%- if s.feature_1_label != blank or s.feature_2_label != blank or s.feature_3_label != blank or s.feature_4_label != blank -%}
      {%- assign has_tags = true -%}
    {%- endif -%}
    {%- if has_tags -%}
      <ul class="daewoo-hub-row__tags">
        {%- if s.feature_1_label != blank -%}<li>{{ s.feature_1_label }}</li>{%- endif -%}
        {%- if s.feature_2_label != blank -%}<li>{{ s.feature_2_label }}</li>{%- endif -%}
        {%- if s.feature_3_label != blank -%}<li>{{ s.feature_3_label }}</li>{%- endif -%}
        {%- if s.feature_4_label != blank -%}<li>{{ s.feature_4_label }}</li>{%- endif -%}
      </ul>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      {%- render 'button',
        label: s.button_label,
        link: s.button_link,
        style: 'link',
        show_icon: true,
        classes: 'daewoo-hub-row__cta'
      -%}
    {%- endif -%}
  </div>
</div>
