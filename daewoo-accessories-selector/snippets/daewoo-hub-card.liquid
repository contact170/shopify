{%- doc -%}
  Renders one sober, centered navigation card for the accessories
  consolidation hub (daewoo-accessories-hub section). Image is always
  contained on a neutral panel — never cropped — since this page is a
  simple router to the three real accessory collections, not a lifestyle
  showcase. The whole card is a single semantic <a>.

  @param {object} block - a card_vigilia_touch / card_key / card_elite block
  @param {string} [loading] - 'eager' or 'lazy' (default 'lazy')

  @example
  {% render 'daewoo-hub-card', block: block %}
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign loading = loading | default: 'lazy'
  assign card_alt = s.image_alt | default: s.heading | strip_html
-%}

<a
  href="{{ s.button_link | default: '#' }}"
  class="daewoo-hub-card flex flex-col items-center text-center block"
  aria-label="{{ s.heading | strip_html | escape }}{% if s.description != blank %} — {{ s.description | strip_html | escape }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <span class="daewoo-hub-card__stage flex items-center justify-center" aria-hidden="true">
    {%- if s.image != blank -%}
      {{-
        s.image
        | image_url: width: s.image.width
        | image_tag:
          loading: loading,
          widths: '240,360,480,600',
          sizes: '(max-width: 767px) 45vw, 220px',
          alt: card_alt,
          class: 'daewoo-hub-card__img'
      -}}
    {%- else -%}
      {{- 'product-1' | placeholder_svg_tag: 'daewoo-hub-card__img placeholder-svg' -}}
    {%- endif -%}
  </span>

  <span class="daewoo-hub-card__heading heading">{{ s.heading }}</span>

  {%- if s.description != blank -%}
    <span class="daewoo-hub-card__description">{{ s.description }}</span>
  {%- endif -%}

  {%- if s.button_label != blank -%}
    <span class="daewoo-hub-card__cta icon-with-text">
      <span class="link-text">{{ s.button_label | escape }}</span>
      {%- render 'icon', icon: 'arrow-right', size: 'sm', class: 'daewoo-hub-card__arrow' -%}
    </span>
  {%- endif -%}
</a>
