{%- doc -%}
  Daewoo Security — accessories consolidation hub.

  Three bands: a full-bleed ink hero (title + subtitle, no photo required —
  the signal-ring motif carries the visual weight), a mist-toned editorial
  list of four ranges separated by hairline rules (model-code chip,
  heading, tagline, compatibility tags, text-link CTA), and a closing
  ink band with two calls to action. No product grid, no filters — this
  page only has to get the visitor to the right destination.
{%- enddoc -%}

{{ 'daewoo-accessories-hub.css' | asset_url | stylesheet_tag }}

<div class="daewoo-hub">

  {%- if section.settings.enable_hero -%}
    <div class="daewoo-hub__hero-band">
      <div class="page-width daewoo-hub__hero">
        <div class="daewoo-hub__ring daewoo-hub__ring--hero" aria-hidden="true"></div>
        <div class="daewoo-hub__hero-text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="daewoo-hub__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="daewoo-hub__heading heading">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="daewoo-hub__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.scroll_label != blank -%}
            <a href="#DaewooHubRows-{{ section.id }}" class="daewoo-hub__scroll icon-with-text" is="hover-link">
              <span class="link-text">{{ section.settings.scroll_label | escape }}</span>
              {%- render 'icon', icon: 'arrow-down', size: 'sm' -%}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="daewoo-hub__rows-band">
    <div class="page-width daewoo-hub__rows" id="DaewooHubRows-{{ section.id }}">
      {%- liquid
        assign i = 0
        for block in section.blocks
          if block.type contains 'card_' and block.settings.enabled
            assign i = i | plus: 1
            render 'daewoo-hub-row', block: block, index: i, loading: 'lazy'
          endif
        endfor
      -%}
    </div>
  </div>

  {%- if section.settings.enable_help -%}
    <div class="daewoo-hub__help-band">
      <div class="page-width daewoo-hub__help">
        {%- if section.settings.help_heading != blank -%}
          <h2 class="daewoo-hub__help-heading heading">{{ section.settings.help_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.help_text != blank -%}
          <p class="daewoo-hub__help-text">{{ section.settings.help_text }}</p>
        {%- endif -%}
        {%- if section.settings.help_primary_label != blank or section.settings.help_secondary_label != blank -%}
          <div class="daewoo-hub__help-actions">
            {%- if section.settings.help_primary_label != blank -%}
              {%- render 'button', label: section.settings.help_primary_label, link: section.settings.help_primary_link, style: 'primary', size: 'lg', classes: 'daewoo-hub__help-btn daewoo-hub__help-btn--primary' -%}
            {%- endif -%}
            {%- if section.settings.help_secondary_label != blank -%}
              {%- render 'button', label: section.settings.help_secondary_label, link: section.settings.help_secondary_link, style: 'secondary', size: 'lg', classes: 'daewoo-hub__help-btn daewoo-hub__help-btn--secondary' -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

