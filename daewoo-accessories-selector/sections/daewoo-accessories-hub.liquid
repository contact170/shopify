{%- doc -%}
  Daewoo Security — accessories consolidation hub.

  Deliberately minimal: a short header and three equal cards routing to the
  three real accessory collections (Vigilia & Touch/Touch XL share one
  collection, SA501 Key and PA501Z Elite each have their own). No product
  grid, no filters, no reassurance strip, no identification section — this
  page's only job is "help the visitor find the right destination in one
  glance," so it is intentionally sober rather than exhaustive.

  Replaces daewoo-accessories-hub's previous, more elaborate section on
  purpose: fewer moving parts is the point here, not a missing feature.
{%- enddoc -%}

{{ 'daewoo-accessories-hub.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<div class="section daewoo-hub section--padding{% if section.settings.divider %} section--divider{% endif %}">
  <div class="page-width">
    <div class="daewoo-hub__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="daewoo-hub__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="daewoo-hub__heading heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="daewoo-hub__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="daewoo-hub__grid grid">
      {%- for block in section.blocks -%}
        {%- if block.type contains 'card_' and block.settings.enabled -%}
          <div class="daewoo-hub__item">
            {%- render 'daewoo-hub-card', block: block, loading: 'eager' -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Daewoo — Hub accessoires",
  "class": "daewoo-hub-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "ACCESSOIRES DAEWOO SECURITY" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Choisissez votre centrale" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Sélectionnez votre système d'alarme pour découvrir les accessoires compatibles." },

    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Espacement au-dessus", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Espacement en dessous", "default": 96 },
    { "type": "checkbox", "id": "divider", "label": "Séparateur", "default": false }
  ],
  "blocks": [
    {
      "type": "card_vigilia_touch",
      "name": "Carte — Vigilia & Touch",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Activer cette carte", "default": true },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Vigilia & Touch / Touch XL" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Détecteurs, sirènes, télécommandes et accessoires compatibles." },
        { "type": "text", "id": "button_label", "label": "Texte du lien", "default": "Voir les accessoires" },
        { "type": "url", "id": "button_link", "label": "URL de la collection" }
      ]
    },
    {
      "type": "card_key",
      "name": "Carte — SA501 Key",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Activer cette carte", "default": true },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "SA501 Key" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Détecteurs, sirènes, télécommandes et accessoires compatibles." },
        { "type": "text", "id": "button_label", "label": "Texte du lien", "default": "Voir les accessoires" },
        { "type": "url", "id": "button_link", "label": "URL de la collection" }
      ]
    },
    {
      "type": "card_elite",
      "name": "Carte — PA501Z Elite",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Activer cette carte", "default": true },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "PA501Z Elite" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Accessoires Zigbee et équipements compatibles." },
        { "type": "text", "id": "button_label", "label": "Texte du lien", "default": "Voir les accessoires" },
        { "type": "url", "id": "button_link", "label": "URL de la collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Daewoo — Hub accessoires",
      "blocks": [
        { "type": "card_vigilia_touch" },
        { "type": "card_key" },
        { "type": "card_elite" }
      ]
    }
  ]
}
{% endschema %}
