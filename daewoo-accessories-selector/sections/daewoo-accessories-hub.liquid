{%- doc -%}
  Daewoo Security — accessories consolidation hub.

  Hero (left-aligned title + subtitle + scroll hint, image on the right)
  followed by four large alternating rows — one per centrale range — each
  with a badge icon, heading, tagline, CTA and a short feature list, then a
  closing "don't know your centrale?" band with two calls to action. No
  product grid, no filters — this page only has to get the visitor to the
  right destination.
{%- enddoc -%}

{{ 'daewoo-accessories-hub.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<div class="section daewoo-hub section--padding{% if section.settings.divider %} section--divider{% endif %}">

  {%- if section.settings.enable_hero -%}
    <div class="daewoo-hub__hero page-width{% if section.settings.hero_image != blank %} daewoo-hub__hero--has-image{% endif %}">
      <div class="daewoo-hub__hero-text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="daewoo-hub__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="daewoo-hub__heading heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="daewoo-hub__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.scroll_label != blank -%}
          <a href="#DaewooHubRows-{{ section.id }}" class="daewoo-hub__scroll link icon-with-text">
            {%- render 'icon', icon: 'arrow-down', size: 'sm' -%}
            <span class="link-text">{{ section.settings.scroll_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.hero_image != blank -%}
        <div class="daewoo-hub__hero-media">
          {{-
            section.settings.hero_image
            | image_url: width: section.settings.hero_image.width
            | image_tag:
              loading: 'eager',
              widths: '400,600,800,1000,1200',
              sizes: '(max-width: 900px) 100vw, 45vw',
              alt: '',
              class: 'daewoo-hub__hero-img'
          -}}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="daewoo-hub__rows page-width" id="DaewooHubRows-{{ section.id }}">
    {%- liquid
      assign i = 0
      for block in section.blocks
        if block.type contains 'card_' and block.settings.enabled
          assign i = i | plus: 1
          render 'daewoo-hub-row', block: block, index: i, loading: 'lazy'
        endif
      endfor
    -%}
  </div>

  {%- if section.settings.enable_help -%}
    <div class="daewoo-hub__help page-width">
      <div class="daewoo-hub__help-inner">
        {%- if section.settings.help_icon != blank -%}
          <span class="daewoo-hub__help-icon">
            {%- render 'daewoo-hub-icon', icon: section.settings.help_icon -%}
          </span>
        {%- endif -%}
        <div class="daewoo-hub__help-text">
          {%- if section.settings.help_heading != blank -%}
            <p class="daewoo-hub__help-heading">{{ section.settings.help_heading }}</p>
          {%- endif -%}
          {%- if section.settings.help_text != blank -%}
            <p class="daewoo-hub__help-description">{{ section.settings.help_text }}</p>
          {%- endif -%}
        </div>
        <div class="daewoo-hub__help-actions">
          {%- if section.settings.help_primary_label != blank -%}
            {%- render 'button', label: section.settings.help_primary_label, link: section.settings.help_primary_link, style: 'primary', size: 'md', show_icon: true -%}
          {%- endif -%}
          {%- if section.settings.help_secondary_label != blank -%}
            {%- render 'button', label: section.settings.help_secondary_label, link: section.settings.help_secondary_link, style: 'secondary', size: 'md' -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

