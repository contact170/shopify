{%- comment -%}
  Daewoo Security — accessories consolidation hub.

  A short intro line, then three of the merchant's own compatibility
  infographics (one per centrale group), each a single full-image link to
  the matching real collection. The images already carry their own title,
  product photography and icon set, so this section adds no caption text
  of its own — it only frames, links and orders them.

  Note: this section intentionally avoids the theme's own "section",
  "section--padding" and "page-width" class names on its own wrapper
  elements — reusing those names on a custom section caused the whole
  section to render blank with no error, for reasons not fully
  understood. Layout/spacing is replicated here under custom class names
  instead.
{%- endcomment -%}

<style>
  .daewoo-hub-wrap {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .daewoo-hub-container {
    margin-inline: auto;
    max-width: 100%;
    padding-inline: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .daewoo-hub__intro {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .daewoo-hub__heading {
    margin: 0;
    font-size: clamp(1.75rem, 1.4vw + 1.3rem, 2.5rem);
    font-weight: var(--font-bold, 600);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .daewoo-hub__subheading {
    margin: 0;
    font-size: 1.0625rem;
    color: rgb(var(--color-foreground) / 0.65);
  }

  .daewoo-hub__grid {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    max-width: 1200px;
    margin-inline: auto;
  }

  .daewoo-hub-image-link {
    display: block;
    max-width: 100%;
    margin-inline: auto;
    border-radius: var(--border-radius-medium, 16px);
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(var(--color-shadow, var(--color-foreground)) / 0.08), 0 12px 28px rgb(var(--color-shadow, var(--color-foreground)) / 0.1);
    transition: transform var(--animation-primary, 0.3s), box-shadow var(--animation-primary, 0.3s);
  }

  .daewoo-hub-image-link__img {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    height: auto !important;
  }

  @media (hover: hover) {
    .daewoo-hub-image-link:hover {
      transform: translateY(-4px);
      box-shadow: 0 1px 2px rgb(var(--color-shadow, var(--color-foreground)) / 0.08), 0 20px 36px rgb(var(--color-shadow, var(--color-foreground)) / 0.16);
    }
  }

  .daewoo-hub-image-link:focus-visible {
    outline: 2px solid rgb(var(--color-keyboard-focus, var(--color-highlight)));
    outline-offset: 3px;
  }

  @media screen and (max-width: 900px) {
    .daewoo-hub__grid {
      grid-template-columns: 1fr;
      max-width: 32rem;
      margin-left: auto;
      margin-right: auto;
    }

    .daewoo-hub-image-link {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .daewoo-hub-image-link {
      transition: none;
    }
  }
</style>

<div class="daewoo-hub-wrap">
  <div class="daewoo-hub-container">
    <div class="daewoo-hub__intro">
      {%- if section.settings.heading != blank -%}
        <h1 class="daewoo-hub__heading heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="daewoo-hub__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="daewoo-hub__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' and block.settings.enabled -%}
          {%- render 'daewoo-hub-image-link', block: block, loading: 'eager' -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Daewoo — Hub accessoires",
  "class": "daewoo-hub-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouvez les accessoires compatibles avec votre centrale" },
    { "type": "textarea", "id": "subheading", "label": "Texte d'explication", "default": "Cliquez sur l'image correspondant à votre centrale d'alarme pour découvrir tous les accessoires compatibles." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Visuel compatibilité",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Afficher ce visuel", "default": true },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "url", "id": "link", "label": "Lien vers la collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Daewoo — Hub accessoires",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
