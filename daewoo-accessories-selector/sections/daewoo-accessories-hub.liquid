{%- doc -%}
  Daewoo Security — accessories consolidation hub.

  A short intro line, then three of the merchant's own compatibility
  infographics (one per centrale group), each a single full-image link to
  the matching real collection. The images already carry their own title,
  product photography and icon set, so this section adds no caption text
  of its own — it only frames, links and orders them.
{%- enddoc -%}

{{ 'daewoo-accessories-hub.css' | asset_url | stylesheet_tag }}

<div class="section daewoo-hub section--padding">
  <div class="page-width daewoo-hub__intro">
    {%- if section.settings.heading != blank -%}
      <h1 class="daewoo-hub__heading heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="daewoo-hub__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="page-width daewoo-hub__grid">
    {%- liquid
      for block in section.blocks
        if block.type == 'card' and block.settings.enabled
          render 'daewoo-hub-image-link', block: block, loading: 'lazy'
        endif
      endfor
    -%}
  </div>
</div>

{% schema %}
{
  "name": "Daewoo — Hub accessoires",
  "class": "daewoo-hub-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouvez les accessoires compatibles avec votre centrale" },
    { "type": "textarea", "id": "subheading", "label": "Texte d'explication", "default": "Cliquez sur l'image correspondant à votre centrale d'alarme pour découvrir tous les accessoires compatibles." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Visuel compatibilité",
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Afficher ce visuel", "default": true },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "url", "id": "link", "label": "Lien vers la collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Daewoo — Hub accessoires",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
