{%- comment -%}
  ============================================================================
  Daewoo Security — Bandeau promo « Week-end +8% » (page d'accueil)
  ----------------------------------------------------------------------------
  Version claire, sans animation décorative (seul le compte à rebours bouge).
  Remise supplémentaire de +8%, CUMULABLE avec les remises paliers du
  configurateur (jusqu'à -25%). Aucun code : la remise est appliquée
  automatiquement par le configurateur (Lovable).

  À coller dans une section « Contenu Liquid » / Custom Liquid sur la page
  d'accueil (idéalement sous le slideshow).

  À personnaliser (bloc RÉGLAGES) :
    - cta_url      → l'URL du configurateur
    - accent_color → la couleur d'accent (rouge par défaut ; ex. #178a54 vert,
                     #b8912e or, #0f3d33 vert émeraude…)
  Le compte à rebours vise AUTOMATIQUEMENT le dimanche 23h59 de la semaine
  en cours. Rien à changer chaque week-end.
  ============================================================================
{%- endcomment -%}

{%- assign cta_url = '/pages/configurateurs' -%}
{%- assign accent_color = '#d11f33' -%}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Poppins:wght@700;800&display=swap" rel="stylesheet">

<style>
  .dwp{
    --ivory:#f6f2ea; --ink:#1b1917; --muted:#6f685c; --red:{{ accent_color }}; --cream:#fff6ee;
    position:relative; overflow:hidden; background:var(--ivory);
    width:100vw; max-width:100vw; margin-left:calc(-50vw + 50%); margin-right:calc(-50vw + 50%);
    font-family:'DM Sans',sans-serif; color:var(--ink); box-sizing:border-box;
  }
  .dwp *{ box-sizing:border-box; }
  .dwp__inner{ display:grid; grid-template-columns:1.55fr .95fr; align-items:stretch; min-height:230px;
    max-width:1280px; margin:0 auto; }

  .dwp__left{ padding:38px clamp(22px,4vw,54px); display:flex; flex-direction:column; justify-content:center; }
  .dwp__eyebrow{ display:inline-flex; align-items:center; gap:9px; font-size:11.5px; font-weight:700;
    letter-spacing:.16em; text-transform:uppercase; color:var(--red); margin-bottom:14px; }
  .dwp__eyebrow::before{ content:""; width:22px; height:2px; background:var(--red); display:inline-block; }
  .dwp__title{ font-family:'Poppins',sans-serif; font-weight:800; color:var(--ink);
    font-size:clamp(26px,3.6vw,40px); line-height:1.05; letter-spacing:-.02em; margin:0 0 12px; }
  .dwp__title u{ text-decoration:none; color:var(--red); }
  .dwp__lede{ margin:0 0 22px; font-size:15.5px; line-height:1.55; color:var(--muted); max-width:46ch; }
  .dwp__lede b{ color:var(--ink); font-weight:600; }

  .dwp__tiers{ display:flex; align-items:center; gap:8px; margin:0 0 24px; flex-wrap:wrap; }
  .dwp__chip{ border:1.5px solid rgba(27,25,23,.2); color:var(--ink); font-weight:600; font-size:12.5px;
    padding:5px 12px; border-radius:100px; }
  .dwp__chip.max{ background:var(--ink); color:#fff; border-color:var(--ink); }
  .dwp__plus{ font-family:'Poppins',sans-serif; font-weight:800; color:var(--muted); font-size:15px; }
  .dwp__chip.boost{ background:var(--red); color:#fff; border-color:var(--red); font-weight:700; }

  .dwp__cta-row{ display:flex; flex-wrap:wrap; align-items:center; gap:16px; }
  .dwp__btn{ display:inline-flex; align-items:center; gap:10px; background:var(--ink); color:#fff !important;
    text-decoration:none; font-weight:700; font-size:15px; padding:14px 26px; border-radius:100px;
    transition:background .18s ease; }
  .dwp__btn:hover{ background:var(--red); }
  .dwp__btn svg{ width:16px; height:16px; }
  .dwp__auto{ display:inline-flex; align-items:center; gap:7px; font-size:12.5px; font-weight:600; color:var(--muted); }
  .dwp__auto svg{ width:15px; height:15px; color:#1a8a4e; }

  .dwp__right{ background:var(--red); color:var(--cream); position:relative;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px;
    padding:32px 26px; text-align:center; }
  .dwp__right::before{ content:""; position:absolute; left:-14px; top:0; bottom:0; width:28px; background:var(--ivory);
    -webkit-mask:radial-gradient(circle 14px at 0 50%,transparent 98%,#000); mask:radial-gradient(circle 14px at 0 50%,transparent 98%,#000); }
  .dwp__badge{ font-family:'Poppins',sans-serif; font-weight:700; font-size:11px; letter-spacing:.16em;
    text-transform:uppercase; opacity:.85; }
  .dwp__big{ font-family:'Poppins',sans-serif; font-weight:800; font-size:clamp(58px,8vw,84px);
    line-height:.86; letter-spacing:-.03em; }
  .dwp__subt{ font-family:'Poppins',sans-serif; font-weight:700; font-size:12.5px; letter-spacing:.10em;
    text-transform:uppercase; margin-top:-4px; }
  .dwp__count{ display:flex; gap:6px; margin-top:6px; }
  .dwp__u{ min-width:46px; text-align:center; border:1px solid rgba(255,255,255,.35); border-radius:9px; padding:7px 5px 6px; }
  .dwp__u b{ font-family:'Poppins',sans-serif; font-size:19px; font-weight:800; line-height:1;
    font-variant-numeric:tabular-nums; display:block; }
  .dwp__u span{ font-size:8.5px; letter-spacing:.08em; text-transform:uppercase; opacity:.8; margin-top:3px; display:block; font-weight:700; }

  @media (max-width:820px){
    .dwp__inner{ grid-template-columns:1fr; }
    .dwp__right{ padding:30px 22px; }
    .dwp__right::before{ display:none; }
    .dwp__left{ padding:32px 22px; }
  }
</style>

<section class="dwp" aria-label="Offre week-end : +8% de remise supplémentaire sur le configurateur">
  <div class="dwp__inner">
    <div class="dwp__left">
      <span class="dwp__eyebrow">Offre week-end &middot; 48&nbsp;h chrono</span>
      <h2 class="dwp__title"><u>+8&nbsp;%</u> de remise supplémentaire sur votre configuration</h2>
      <p class="dwp__lede">Ce week-end, on empile les réductions : <b>+8&nbsp;% cumulés avec vos remises paliers</b> qui grimpent déjà jusqu'à &minus;25&nbsp;% dans le configurateur.</p>

      <div class="dwp__tiers">
        <span class="dwp__chip">&minus;5&nbsp;%</span>
        <span class="dwp__chip">&minus;15&nbsp;%</span>
        <span class="dwp__chip max">jusqu'à &minus;25&nbsp;%</span>
        <span class="dwp__plus">+</span>
        <span class="dwp__chip boost">+8&nbsp;% week-end</span>
      </div>

      <div class="dwp__cta-row">
        <a class="dwp__btn" href="{{ cta_url }}">
          Configurer mon alarme
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <span class="dwp__auto">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Aucun code &mdash; remise appliquée automatiquement
        </span>
      </div>
    </div>

    <div class="dwp__right">
      <div class="dwp__badge">Ce week-end</div>
      <div class="dwp__big">+8%</div>
      <div class="dwp__subt">de remise en plus</div>
      <div class="dwp__count" id="dwp-count" role="timer" aria-live="off">
        <div class="dwp__u"><b data-d>00</b><span>Jours</span></div>
        <div class="dwp__u"><b data-h>00</b><span>Heures</span></div>
        <div class="dwp__u"><b data-m>00</b><span>Min</span></div>
        <div class="dwp__u"><b data-s>00</b><span>Sec</span></div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  // Cible : dimanche 23:59:59 de la semaine en cours (dimanche suivant si déjà passé).
  function target(){
    var n = new Date();
    var toSun = (7 - n.getDay()) % 7;
    var t = new Date(n.getFullYear(), n.getMonth(), n.getDate() + toSun, 23, 59, 59, 0);
    if (t.getTime() < n.getTime()) t.setDate(t.getDate() + 7);
    return t;
  }
  var end = target();
  var d=document.querySelector('[data-d]'), h=document.querySelector('[data-h]'),
      m=document.querySelector('[data-m]'), s=document.querySelector('[data-s]');
  function p(n){ return (n<10?'0':'')+n; }
  function tick(){
    var diff = Math.max(0, end.getTime() - Date.now());
    var sec = Math.floor(diff/1000);
    if(d) d.textContent = p(Math.floor(sec/86400));
    if(h) h.textContent = p(Math.floor(sec%86400/3600));
    if(m) m.textContent = p(Math.floor(sec%3600/60));
    if(s) s.textContent = p(sec%60);
    if(diff===0){ end = target(); }
  }
  tick(); setInterval(tick, 1000);
})();
</script>
