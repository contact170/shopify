{%- comment -%}
  ============================================================================
  Daewoo Security — Bandeau promo « Week-end -10% » (page d'accueil)
  ----------------------------------------------------------------------------
  À coller dans une section « Contenu Liquid » / Custom Liquid, sur la page
  d'accueil, à l'emplacement souhaité (idéalement juste sous le slideshow).

  3 points à personnaliser ci-dessous (bloc RÉGLAGES) :
    1. cta_url   → l'URL du configurateur
    2. promo     → le code promo affiché sur le coupon
    3. Le compte à rebours vise AUTOMATIQUEMENT le dimanche 23h59 de la
       semaine en cours. Rien à changer chaque week-end.

  Pensez à créer le code promo correspondant dans Shopify :
  Réductions → Créer un code → -10% → code « WEEKEND10 ».
  ============================================================================
{%- endcomment -%}

{%- assign cta_url = '/pages/configurateurs' -%}
{%- assign promo   = 'WEEKEND10' -%}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Poppins:wght@700;800&display=swap" rel="stylesheet">

<style>
  .dwp{
    --p-navy:#0b1e4a; --p-navy2:#081733; --p-blue:#1a4fab; --p-cyan:#48cae4;
    --p-ink:#eaf1ff; --p-mut:rgba(233,241,255,.60);
    position:relative; overflow:hidden; isolation:isolate;
    width:100vw; max-width:100vw; margin-left:calc(-50vw + 50%); margin-right:calc(-50vw + 50%);
    background:radial-gradient(120% 140% at 12% 0%,#123163 0%,var(--p-navy) 42%,var(--p-navy2) 100%);
    font-family:'DM Sans',sans-serif; color:var(--p-ink);
    padding:46px clamp(20px,5vw,68px); box-sizing:border-box;
  }
  .dwp *{ box-sizing:border-box; }
  .dwp__glow{ position:absolute; border-radius:50%; pointer-events:none; z-index:0; }
  .dwp__glow--a{ top:-160px; right:6%; width:420px; height:420px;
    background:radial-gradient(circle,rgba(72,202,228,.22) 0%,transparent 68%); animation:dwp-drift 14s ease-in-out infinite; }
  .dwp__glow--b{ bottom:-200px; left:-60px; width:460px; height:460px;
    background:radial-gradient(circle,rgba(46,107,230,.30) 0%,transparent 70%); animation:dwp-drift 18s ease-in-out infinite reverse; }
  .dwp__grid-lines{ position:absolute; inset:0; z-index:0; opacity:.5; pointer-events:none;
    background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px);
    background-size:100% 46px; -webkit-mask-image:linear-gradient(180deg,transparent,#000 40%,transparent);
    mask-image:linear-gradient(180deg,transparent,#000 40%,transparent); }

  .dwp__inner{ position:relative; z-index:1; max-width:1160px; margin:0 auto;
    display:grid; grid-template-columns:1.15fr .85fr; gap:clamp(28px,4vw,56px); align-items:center; }

  .dwp__eyebrow{ display:inline-flex; align-items:center; gap:9px;
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.16);
    border-radius:100px; padding:6px 14px; font-size:11.5px; font-weight:600;
    letter-spacing:.10em; text-transform:uppercase; color:#cfe6ff; margin-bottom:20px; }
  .dwp__eyebrow .dwp-dot{ width:7px; height:7px; border-radius:50%; background:var(--p-cyan);
    animation:dwp-pulse 1.8s ease-out infinite; }

  .dwp__title{ font-family:'Poppins',sans-serif; font-weight:800;
    font-size:clamp(30px,4.4vw,48px); line-height:1.04; letter-spacing:-.02em; margin:0 0 14px; }
  .dwp__pct{ display:inline-block;
    background:linear-gradient(120deg,var(--p-cyan),#8ef0ff); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .dwp__lede{ margin:0 0 26px; font-size:15.5px; line-height:1.55; color:var(--p-mut); max-width:44ch; }
  .dwp__lede b{ color:var(--p-ink); font-weight:600; }

  .dwp__cta-row{ display:flex; flex-wrap:wrap; align-items:center; gap:16px; }
  .dwp__btn{ position:relative; display:inline-flex; align-items:center; gap:10px;
    background:linear-gradient(120deg,var(--p-cyan),#2fb6d6); color:#06263a !important; text-decoration:none;
    font-weight:700; font-size:15px; padding:14px 26px; border-radius:100px;
    box-shadow:0 12px 30px -8px rgba(72,202,228,.55); transition:transform .18s ease, box-shadow .18s ease; overflow:hidden; }
  .dwp__btn::after{ content:""; position:absolute; top:0; left:-120%; width:60%; height:100%;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent); transform:skewX(-18deg);
    animation:dwp-sheen 3.6s ease-in-out infinite; }
  .dwp__btn:hover{ transform:translateY(-2px); box-shadow:0 18px 40px -10px rgba(72,202,228,.7); }
  .dwp__btn svg{ width:17px; height:17px; }
  .dwp__reassure{ font-size:12.5px; color:var(--p-mut); display:flex; align-items:center; gap:7px; }
  .dwp__reassure svg{ width:14px; height:14px; color:var(--p-cyan); }

  .dwp__ticket{ position:relative; border-radius:18px; padding:2px;
    background:conic-gradient(from 0deg,rgba(72,202,228,.7),rgba(46,107,230,.25),rgba(72,202,228,.7));
    animation:dwp-spin 8s linear infinite; }
  .dwp__ticket-in{ position:relative; background:linear-gradient(160deg,#0c1e46,#0a1836);
    border-radius:16px; padding:24px 26px 22px; overflow:hidden; }
  .dwp__ticket-in::before,.dwp__ticket-in::after{ content:""; position:absolute; width:26px; height:26px;
    background:var(--p-navy); border-radius:50%; top:50%; transform:translateY(-50%);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.05); }
  .dwp__ticket-in::before{ left:-13px; }
  .dwp__ticket-in::after{ right:-13px; }
  .dwp__ticket-head{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:16px; }
  .dwp__ticket-head span{ font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--p-mut); font-weight:600; }
  .dwp__ticket-head b{ font-family:'Poppins',sans-serif; font-size:13px; color:var(--p-cyan); font-weight:700; }

  .dwp__count{ display:flex; gap:8px; margin-bottom:18px; }
  .dwp__unit{ flex:1; text-align:center; background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.09); border-radius:11px; padding:11px 4px 8px; }
  .dwp__unit b{ font-family:'Poppins',sans-serif; font-size:26px; font-weight:800; line-height:1;
    font-variant-numeric:tabular-nums; display:block; }
  .dwp__unit span{ font-size:9.5px; letter-spacing:.10em; text-transform:uppercase; color:var(--p-mut); margin-top:5px; display:block; }

  .dwp__perf{ border-top:1.5px dashed rgba(255,255,255,.18); margin:0 -26px 18px; }
  .dwp__code{ display:flex; align-items:center; gap:10px; }
  .dwp__code-box{ flex:1; display:flex; align-items:center; justify-content:center; gap:10px;
    border:1.5px dashed rgba(72,202,228,.5); border-radius:11px; padding:12px; background:rgba(72,202,228,.06); }
  .dwp__code-box b{ font-family:'Poppins',sans-serif; font-size:19px; font-weight:800; letter-spacing:.10em; color:#fff; }
  .dwp__copy{ background:var(--p-cyan); color:#06263a; border:0; cursor:pointer; font-weight:700;
    font-size:13px; padding:12px 15px; border-radius:11px; white-space:nowrap; transition:background .15s ease; font-family:inherit; }
  .dwp__copy:hover{ background:#6fe0f5; }
  .dwp__copy.ok{ background:#2ec4a6; color:#03251d; }

  @keyframes dwp-drift{ 0%,100%{ transform:translate(0,0);} 50%{ transform:translate(-26px,22px);} }
  @keyframes dwp-pulse{ 0%{ box-shadow:0 0 0 0 rgba(72,202,228,.55);} 100%{ box-shadow:0 0 0 10px rgba(72,202,228,0);} }
  @keyframes dwp-sheen{ 0%,100%{ left:-120%;} 55%,100%{ left:160%;} }
  @keyframes dwp-spin{ to{ transform:rotate(360deg);} }

  @media (prefers-reduced-motion:reduce){
    .dwp__glow,.dwp__eyebrow .dwp-dot,.dwp__btn::after,.dwp__ticket{ animation:none; }
  }
  @media (max-width:820px){
    .dwp__inner{ grid-template-columns:1fr; gap:30px; }
    .dwp{ padding:38px 22px; }
  }
</style>

<section class="dwp" aria-label="Offre week-end -10% sur le configurateur">
  <div class="dwp__glow dwp__glow--a"></div>
  <div class="dwp__glow dwp__glow--b"></div>
  <div class="dwp__grid-lines"></div>

  <div class="dwp__inner">
    <div class="dwp__msg">
      <span class="dwp__eyebrow"><span class="dwp-dot"></span>Offre week-end · 48 h chrono</span>
      <h2 class="dwp__title">Composez votre alarme,<br><span class="dwp__pct">&minus;10&nbsp;%</span> tout le week-end.</h2>
      <p class="dwp__lede">Configurez le système Daewoo qui vous ressemble et profitez de <b>&minus;10&nbsp;% sur l'ensemble de votre pack</b>. Sans abonnement, prêt à poser.</p>
      <div class="dwp__cta-row">
        <a class="dwp__btn" href="{{ cta_url }}">
          Configurer mon alarme
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <span class="dwp__reassure">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg>
          Garantie 2 ans &middot; Livraison offerte
        </span>
      </div>
    </div>

    <div class="dwp__ticket">
      <div class="dwp__ticket-in">
        <div class="dwp__ticket-head">
          <span>L'offre se termine dans</span>
          <b>&minus;10&nbsp;%</b>
        </div>
        <div class="dwp__count" id="dwp-count" role="timer" aria-live="off">
          <div class="dwp__unit"><b data-dwp-d>00</b><span>Jours</span></div>
          <div class="dwp__unit"><b data-dwp-h>00</b><span>Heures</span></div>
          <div class="dwp__unit"><b data-dwp-m>00</b><span>Min</span></div>
          <div class="dwp__unit"><b data-dwp-s>00</b><span>Sec</span></div>
        </div>
        <div class="dwp__perf"></div>
        <div class="dwp__code">
          <div class="dwp__code-box">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#48cae4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h4M15 7h4a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-4M9 12h6"/></svg>
            <b id="dwp-code">{{ promo }}</b>
          </div>
          <button class="dwp__copy" id="dwp-copy" type="button">Copier</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  // Cible : dimanche 23:59:59 de la semaine en cours (dimanche suivant si déjà passé).
  function target(){
    var n = new Date();
    var toSun = (7 - n.getDay()) % 7;
    var t = new Date(n.getFullYear(), n.getMonth(), n.getDate() + toSun, 23, 59, 59, 0);
    if (t.getTime() < n.getTime()) t.setDate(t.getDate() + 7);
    return t;
  }
  var end = target();
  var d=document.querySelector('[data-dwp-d]'), h=document.querySelector('[data-dwp-h]'),
      m=document.querySelector('[data-dwp-m]'), s=document.querySelector('[data-dwp-s]');
  function p(n){ return (n<10?'0':'')+n; }
  function tick(){
    var diff = Math.max(0, end.getTime() - Date.now());
    var sec = Math.floor(diff/1000);
    if(d) d.textContent = p(Math.floor(sec/86400));
    if(h) h.textContent = p(Math.floor(sec%86400/3600));
    if(m) m.textContent = p(Math.floor(sec%3600/60));
    if(s) s.textContent = p(sec%60);
    if(diff===0){ end = target(); }
  }
  tick(); setInterval(tick, 1000);

  var btn = document.getElementById('dwp-copy');
  if(btn){ btn.addEventListener('click', function(){
    var code = (document.getElementById('dwp-code')||{}).textContent || '';
    var done = function(){ btn.textContent='Copié ✓'; btn.classList.add('ok');
      setTimeout(function(){ btn.textContent='Copier'; btn.classList.remove('ok'); }, 1800); };
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(code).then(done, done); }
    else { done(); }
  }); }
})();
</script>
