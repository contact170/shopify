{%- endcapture -%}
{%- assign avis = dw_donnees | strip | split: FIN -%}

{%- if mode == "cartes" -%}
  {%- for enr in avis limit: limite -%}
    {%- assign ch = enr | strip | split: SEP -%}
    {%- assign n = ch[0] | plus: 0 -%}
    <article class="pv-review-card">
      <div class="pv-review-card__stars" aria-label="{{ n }} étoiles sur 5">
        <span aria-hidden="true">
          {%- for i in (1..5) -%}{% if i <= n %}★{% else %}☆{% endif %}{%- endfor -%}
        </span>
      </div>
      <p class="pv-review-card__text">{{ ch[4] | truncate: 280 }}</p>
      <div class="pv-review-card__meta">
        <span class="pv-review-card__name">{{ ch[1] }}</span>
        <span class="pv-review-card__dot" aria-hidden="true"></span>
        <span>{% if ch[3] != blank %}{{ ch[3] }} · {% endif %}{{ ch[2] }}</span>
      </div>
    </article>
  {%- endfor -%}
{%- else -%}
[{% for enr in avis limit: limite %}{% assign ch = enr | strip | split: SEP %}{"r":{{ ch[0] | plus: 0 }},"n":{{ ch[1] | json }},"d":{{ ch[2] | json }},"c":{{ ch[3] | json }},"t":{{ ch[4] | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
{%- endif -%}
