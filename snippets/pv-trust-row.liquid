{%- doc -%}
  Rating badge + payment methods row, reused under every "Ajouter au
  panier" button on this page (hero, mid-page band, final CTA) so the
  trust signals travel with each CTA, not just the hero's.

  Params: has_rating, rating_value, rating_max, rating_count, rating_pct,
  reviews_anchor.
{%- enddoc -%}

{%- liquid
  # Two icons the merchant asked to drop from this row: EPS confirmed by
  # the merchant (was showing 4th from the left). klarna/bancontact were
  # an earlier best guess from reference screenshots, kept excluded as a
  # harmless no-op if that guess turns out to be wrong (neither renders
  # anything if the type was never enabled on this shop).
  assign pv_pay_excluded = "klarna,bancontact,eps" | split: ","
  assign pv_pay_visible_count = 0
  for type in shop.enabled_payment_types
    unless pv_pay_excluded contains type
      assign pv_pay_visible_count = pv_pay_visible_count | plus: 1
    endunless
  endfor
-%}
{%- if has_rating -%}
  <div class="pv-hero__rating">
    <a href="#{{ reviews_anchor }}" class="pv-rating-badge" aria-label="Note {{ rating_value }} sur {{ rating_max }}, {{ rating_count }} avis — voir les avis">
      <span class="pv-rating-badge__stars" aria-hidden="true">
        <span class="pv-rating-badge__stars-bg">★★★★★</span>
        <span class="pv-rating-badge__stars-fg" style="width:{{ rating_pct }}%">★★★★★</span>
      </span>
      <strong class="pv-rating-badge__score">{{ rating_value }}</strong>
      <span class="pv-rating-badge__sep" aria-hidden="true">·</span>
      <span class="pv-rating-badge__count">{{ rating_count }} avis</span>
      <svg class="pv-rating-badge__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </a>
  </div>
{%- endif -%}
<div class="pv-pay">
  {%- if pv_pay_visible_count > 0 -%}
    <div class="pv-pay__methods">
      {%- for type in shop.enabled_payment_types -%}
        {%- unless pv_pay_excluded contains type -%}
          {{ type | payment_type_svg_tag: class: 'pv-pay__icon' }}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  <button type="button" class="pv-pay__alma" data-pv-alma-open>
    <span class="pv-pay__alma-badge">alma</span>
    <span class="pv-pay__alma-text">3x, 4x sans frais</span>
    <svg class="pv-pay__alma-info" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-5"></path><path d="M12 8h.01"></path></svg>
  </button>
</div>
