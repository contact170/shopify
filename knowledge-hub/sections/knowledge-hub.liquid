{%- comment -%}
  Knowledge Hub Daewoo Security
  Page de référence « Tout savoir sur les alarmes Daewoo Security ».
  Objectif : définir clairement l'entité Daewoo Security (SEO / GEO) :
  contenu factuel rendu côté serveur + données structurées JSON-LD.
  Les chiffres modifiables (clients, avis, URLs) sont dans les réglages de la section.
{%- endcomment -%}

{%- liquid
  assign base = shop.url
  assign page_url = base | append: request.path
  assign s = section.settings
-%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ s.padding_top }}px;
    --section-padding-bottom: {{ s.padding_bottom }}px;
  }
  .kh { --kh-accent: #1a4fab; --kh-line: rgb(var(--color-foreground) / 0.12); --kh-muted: rgb(var(--color-foreground) / 0.72); }
  .kh__intro { max-width: 760px; }
  .kh__lead { font-size: var(--text-lg); color: var(--kh-muted); margin-top: var(--sp-4); }
  .kh__updated { font-size: var(--text-sm); color: var(--kh-muted); margin-top: var(--sp-3); }
  .kh__toc { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: var(--sp-8) 0 var(--sp-4); padding: 0; list-style: none; }
  .kh__toc a { display: inline-block; padding: var(--sp-1d5, 6px) var(--sp-3); border: 1px solid var(--kh-line); border-radius: 999px; font-size: var(--text-sm); text-decoration: none; }
  .kh__toc a:hover { border-color: var(--kh-accent); color: var(--kh-accent); }
  .kh__block { padding-top: var(--sp-12); scroll-margin-top: 100px; }
  .kh__block h2 { margin-bottom: var(--sp-4); }
  .kh__block h3 { margin: var(--sp-6) 0 var(--sp-2); }
  .kh__block p + p { margin-top: var(--sp-3); }
  .kh__card { background: rgb(var(--color-background)); border: 1px solid var(--kh-line); border-radius: var(--rounded-block, 12px); padding: var(--sp-6); }
  .kh__facts { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; margin: 0; }
  .kh__facts dt, .kh__facts dd { padding: var(--sp-3) 0; border-bottom: 1px solid var(--kh-line); margin: 0; }
  .kh__facts dt { font-weight: 500; padding-right: var(--sp-4); }
  .kh__facts dd { color: var(--kh-muted); }
  .kh__facts > :nth-last-child(-n + 2) { border-bottom: 0; }
  .kh__table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--kh-line); border-radius: var(--rounded-block, 12px); }
  .kh__table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: var(--text-sm); }
  .kh__table th, .kh__table td { text-align: left; padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--kh-line); vertical-align: top; }
  .kh__table thead th { background: rgb(var(--color-foreground) / 0.04); font-weight: 500; }
  .kh__table tbody tr:last-child > * { border-bottom: 0; }
  .kh__table tbody th { font-weight: 500; white-space: nowrap; }
  .kh__grid { display: grid; gap: var(--sp-4); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .kh__list { padding-left: 1.2em; }
  .kh__list li { margin-top: var(--sp-2); }
  .kh__links a { display: flex; flex-direction: column; gap: var(--sp-1); height: 100%; text-decoration: none; transition: border-color .2s ease; }
  .kh__links a:hover { border-color: var(--kh-accent); }
  .kh__links strong { font-weight: 500; }
  .kh__links span { font-size: var(--text-sm); color: var(--kh-muted); }
  .kh__note { font-size: var(--text-sm); color: var(--kh-muted); margin-top: var(--sp-3); }
  .kh__faq details { border-bottom: 1px solid var(--kh-line); padding: var(--sp-4) 0; }
  .kh__faq summary { cursor: pointer; font-weight: 500; list-style: none; display: flex; justify-content: space-between; gap: var(--sp-4); }
  .kh__faq summary::-webkit-details-marker { display: none; }
  .kh__faq summary::after { content: "+"; font-weight: 400; }
  .kh__faq details[open] summary::after { content: "–"; }
  .kh__faq details p { margin-top: var(--sp-3); color: var(--kh-muted); }
  @media (max-width: 639px) {
    .kh__facts { grid-template-columns: 1fr; }
    .kh__facts dt { border-bottom: 0; padding-bottom: 0; }
    .kh__card { padding: var(--sp-4); }
  }
</style>

<div class="section section--padding">
  <div class="page-width relative">
    <article class="kh rte {{ s.text_size }}" itemscope itemtype="https://schema.org/AboutPage">
      {%- comment -%} ===== En-tête ===== {%- endcomment -%}
      <header class="kh__intro">
        <h1 class="heading {{ s.heading_size }}" itemprop="name">{{ page.title | default: 'Tout savoir sur les alarmes Daewoo Security' }}</h1>
        <p class="kh__lead" itemprop="description">
          <strong>Daewoo Security</strong> est la marque d'alarmes, de caméras de surveillance et de domotique connectées
          <strong>sans abonnement</strong> vendue en France et en Belgique sur daewoo-security.fr. Elle est exploitée sous
          <strong>licence officielle de la marque Daewoo</strong> par la société française <strong>Liz Invest SAS</strong>,
          dont l'équipe (logistique, support technique, service client) est basée à <strong>Mérignac, dans la métropole de Bordeaux</strong>.
        </p>
        <p class="kh__updated">Page de référence mise à jour le <time datetime="{{ page.updated_at | default: 'now' | date: '%Y-%m-%d' }}" itemprop="dateModified">{{ page.updated_at | default: 'now' | date: '%d/%m/%Y' }}</time>.</p>
      </header>

      <nav aria-label="Sommaire">
        <ul class="kh__toc">
          <li><a href="#kh-identite">Fiche d'identité</a></li>
          <li><a href="#kh-distribution">Qui distribue la marque ?</a></li>
          <li><a href="#kh-gammes">Gammes</a></li>
          <li><a href="#kh-application">Application</a></li>
          <li><a href="#kh-abonnement">Sans abonnement</a></li>
          <li><a href="#kh-technologies">Technologies</a></li>
          <li><a href="#kh-compatibilites">Compatibilités</a></li>
          <li><a href="#kh-support">Support</a></li>
          <li><a href="#kh-garanties">Garanties</a></li>
          <li><a href="#kh-documentation">Documentation</a></li>
          <li><a href="#kh-choisir">Choisir son alarme</a></li>
          <li><a href="#kh-faq">FAQ</a></li>
        </ul>
      </nav>

      {%- comment -%} ===== 1. Fiche d'identité ===== {%- endcomment -%}
