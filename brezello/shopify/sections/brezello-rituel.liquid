{%- comment -%} Brezello – le rituel d'utilisation, en étapes numérotées. {%- endcomment -%}
{{ 'brezello.css' | asset_url | stylesheet_tag }}

<div class="bz" id="bz-{{ section.id }}">
  <div class="bz-wrap bz-ritual">
    <div class="bz-sec-head">
      <h2 class="bz-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="bz-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ol class="bz-steps">
      {%- for block in section.blocks -%}
        <li class="bz-step" {{ block.shopify_attributes }}>
          <div class="bz-step-top">
            <span class="bz-step-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {%- case block.settings.icon -%}
              {%- when 'ouvrir' -%}
                <svg width="56" height="56" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="10" y="24" width="28" height="18" rx="6"/><path d="M15 24v-6a4 4 0 0 1 8 0v6"/><path d="M29 14l4-8a4 4 0 0 1 6 4l-3 7" /><path d="M42 20l2 2"/></svg>
              {%- when 'inspirer' -%}
                <svg width="56" height="56" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 17c6-5 12 5 19 0s13-5 19 0"/><path d="M5 26c6-5 12 5 19 0s13-5 19 0"/><path d="M5 35c6-5 12 5 19 0"/></svg>
              {%- when 'refermer' -%}
                <svg width="56" height="56" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8" y="20" width="26" height="20" rx="6"/><path d="M12 20v-6a4 4 0 0 1 8 0v6"/><path d="M22 20v-6a4 4 0 0 1 8 0v6"/><path d="M36 38l3 3 6-7"/></svg>
              {%- else -%}
                <svg width="56" height="56" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M24 6l4 12 12 4-12 4-4 12-4-12-12-4 12-4z"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="bz-step-title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Brezello – Rituel",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Le rituel. Trois gestes, c'est tout." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Sans flamme, sans vapeur, sans bruit. Juste une bouffée d'arômes quand vous en avez envie, au bureau, en voiture ou entre deux trains." }
  ],
  "blocks": [
    {
      "type": "etape",
      "name": "Étape",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "ouvrir",
          "options": [
            { "value": "ouvrir", "label": "Ouvrir" },
            { "value": "inspirer", "label": "Inspirer" },
            { "value": "refermer", "label": "Refermer" },
            { "value": "etoile", "label": "Étoile" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Ouvrez" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Retirez les capuchons : les deux embouts sont prêts." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brezello – Rituel",
      "blocks": [
        { "type": "etape", "settings": { "icon": "ouvrir", "title": "Ouvrez", "text": "Retirez les capuchons : les deux embouts sont prêts." } },
        { "type": "etape", "settings": { "icon": "inspirer", "title": "Inspirez", "text": "Placez les embouts sous les narines et inspirez doucement par le nez, quelques secondes." } },
        { "type": "etape", "settings": { "icon": "refermer", "title": "Refermez", "text": "Remettez les capuchons pour garder les arômes intacts jusqu'à la prochaine fois." } }
      ]
    }
  ]
}
{% endschema %}
