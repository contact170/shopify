{%- comment -%} Brezello – mise en avant d'un coffret (produit choisi dans l'éditeur de thème). {%- endcomment -%}
{{ 'brezello.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign gift = section.settings.product
  assign gift_url = section.settings.fallback_url | default: routes.all_products_collection_url
  if gift != blank
    assign gift_url = gift.url
  endif
-%}
<div class="bz" id="bz-{{ section.id }}">
  <div class="bz-wrap bz-gift">
    <div class="bz-gift-card">
      <div class="bz-gift-text">
        {%- if section.settings.eyebrow != blank -%}<p class="bz-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="bz-h2">{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="bz-lead">{{ section.settings.text }}</p>{%- endif -%}
        <div class="bz-gift-cta">
          <a class="bz-btn" href="{{ gift_url }}">
            {{ section.settings.button_label }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
          </a>
          {%- if gift != blank -%}<span class="bz-gift-price">{{ gift.price | money }}</span>{%- endif -%}
        </div>
      </div>
      <div class="bz-gift-visual">
        {%- for block in section.blocks -%}
          <div class="bz-gift-col" style="--bz-tint: {{ block.settings.tint }}; --bz-deep: {{ block.settings.deep }}; --bz-body: {{ block.settings.body }};" {{ block.shopify_attributes }}>
            {% render 'brezello-inhaler', label: block.settings.name, decorative: true %}
            <span class="bz-gift-name">{{ block.settings.name }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brezello – Coffret",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit coffret" },
    { "type": "url", "id": "fallback_url", "label": "Lien si aucun produit choisi" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Idée cadeau" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Le coffret Quatre Humeurs." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Les quatre parfums réunis dans un étui à offrir, ou à garder pour soi." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir le coffret" }
  ],
  "blocks": [
    {
      "type": "couleur",
      "name": "Parfum du coffret",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Nom", "default": "Glaciale" },
        { "type": "color", "id": "tint", "label": "Couleur de fond", "default": "#D6EEF0" },
        { "type": "color", "id": "deep", "label": "Couleur foncée", "default": "#0F5C63" },
        { "type": "color", "id": "body", "label": "Couleur du boîtier", "default": "#7FC9CF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brezello – Coffret",
      "blocks": [
        { "type": "couleur", "settings": { "name": "Glaciale", "tint": "#D6EEF0", "deep": "#0F5C63", "body": "#7FC9CF" } },
        { "type": "couleur", "settings": { "name": "Agrumi", "tint": "#F6E7B8", "deep": "#7A5A00", "body": "#F2C14E" } },
        { "type": "couleur", "settings": { "name": "Dolce", "tint": "#F6D9CF", "deep": "#8A3B22", "body": "#EFA58C" } },
        { "type": "couleur", "settings": { "name": "Calma", "tint": "#E1DBF2", "deep": "#4B3D84", "body": "#A898DA" } }
      ]
    }
  ]
}
{% endschema %}
