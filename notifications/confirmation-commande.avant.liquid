{% capture email_title %}
  {% if has_pending_payment %}
    Votre commande est en attente de confirmation
  {% else %}
    Merci{% if customer.first_name %} {{ customer.first_name }}{% endif %}, votre commande est confirmée
  {% endif %}
{% endcapture %}
{% capture email_body %}
  {% if has_pending_payment %}
    {% if buyer_action_required %}
      Vous recevrez un e‑mail de confirmation après avoir effectué votre paiement.
    {% else %}
      Votre paiement est en cours de traitement. Vous recevrez un e‑mail lorsque votre commande sera confirmée.
    {% endif %}
  {% else %}
    {% if requires_shipping %}
    {% case delivery_method %}
        {% when 'pick-up' %}
          Vous recevrez un e-mail lorsque votre commande sera prête pour le ramassage.
        {% when 'local' %}
          Bonjour {{ customer.first_name }}, nous préparons actuellement la livraison de votre commande.
        {% else %}
          Nous préparons soigneusement vos produits. Vous recevrez un nouvel e-mail dès l’expédition de votre colis.
      {% endcase %}
        {% if delivery_instructions != blank  %}
          <p><b>Informations sur la livraison :</b> {{ delivery_instructions }}</p>
        {% endif %}
       {% if consolidated_estimated_delivery_time %}
        {% if has_multiple_delivery_methods %}
          <h3 class="estimated_delivery__title">Date de livraison estimée</h3>
          <p>{{ consolidated_estimated_delivery_time }}</p>
        {% else %}
          <p>
            Date de livraison estimée <b>{{ consolidated_estimated_delivery_time }}</b>
          </p>
        {% endif %}
       {% endif %}
    {% endif %}
  {% endif %}
  {% assign gift_card_line_items = line_items | where: "gift_card" %}
  {% assign found_gift_card_with_recipient_email = false %}
  {% for line_item in gift_card_line_items %}
    {% if line_item.properties["__shopify_send_gift_card_to_recipient"] and line_item.properties["Recipient email"] %}
      {% assign found_gift_card_with_recipient_email = true %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if found_gift_card_with_recipient_email %}
    <p>Le/la bénéficiaire de votre carte‑cadeau recevra un e‑mail contenant le code de sa carte‑cadeau.</p>
  {% elsif gift_card_line_items.first %}
    <p>Vous recevrez des e-mails distincts pour toutes les cartes-cadeaux.</p>
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="fr">
  <head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    body, .body { background:#f5f7f9 !important; color:#102a43; }
    .header { background:#f5f7f9 !important; }
    .header__cell { padding:30px 0 22px !important; }
    .content__cell { padding:0 0 32px !important; }
    .container { max-width:640px !important; }
    h1, h2, h3, h4, p, td, span { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif !important; }
    h2 { color:#102a43 !important; font-size:30px !important; line-height:1.22 !important; letter-spacing:-0.5px; }
    h3 { color:#102a43 !important; font-size:21px !important; }
    h4 { color:#102a43 !important; }
    p { color:#52667a; line-height:1.6; }
    .button__cell { background:#1769e0 !important; border-radius:10px !important; }
    .button__text { font-size:16px !important; font-weight:700 !important; padding:16px 28px !important; }
    a, a:hover, a:active, a:visited { color:#1769e0; }
    .order-number__text { color:#52667a !important; font-size:14px !important; }
    .premium-card { background:#ffffff; border:1px solid #e2e8ef; border-radius:18px; box-shadow:0 8px 28px rgba(16,42,67,.07); }
    .premium-hero { padding:40px 38px 30px; text-align:center; }
    .check-circle { width:58px; height:58px; line-height:58px; margin:0 auto 20px; border:3px solid #18a065; border-radius:50%; color:#18a065; font-size:31px; font-weight:700; }
    .hero-copy { max-width:500px; margin:0 auto; font-size:16px; }
    .next-step { margin:26px 0 0; padding:17px 20px; background:#f7f9fc; border-radius:12px; text-align:left; color:#52667a; font-size:14px; line-height:1.55; }
    .next-step strong { display:block; color:#102a43; font-size:15px; margin-bottom:3px; }
    .status-table { width:100%; margin-top:24px; border-top:1px solid #e4e9ef; }
    .status-cell { width:33.33%; padding:24px 5px 2px; text-align:center; color:#8a98a8; font-size:13px; }
    .status-active { color:#159b61 !important; font-weight:700; }
    .status-current { color:#102a43 !important; font-weight:700; }
    .status-dot { display:inline-block; width:30px; height:30px; line-height:30px; margin-bottom:8px; border:2px solid currentColor; border-radius:50%; font-size:15px; }
    .trust-wrap { padding:18px 0 2px; }
    .trust-table { width:100%; background:#eef5ff; border:1px solid #dce8f7; border-radius:14px; }
    .trust-cell { width:33.33%; padding:22px 10px; text-align:center; vertical-align:top; color:#102a43; font-size:13px; }
    .trust-cell + .trust-cell { border-left:1px solid #dce7f4; }
    .trust-icon { display:block; color:#1769e0; font-size:23px; margin-bottom:8px; }
    .trust-title { display:block; font-weight:700; margin-bottom:4px; }
    .trust-copy { color:#64778a; font-size:12px; line-height:1.4; }
    .section { background:transparent !important; }
    .section__cell { padding:22px 0 0 !important; }
    .section-title { margin:0 0 13px !important; padding-left:2px; }
    .content-card { background:#ffffff; border:1px solid #e2e8ef; border-radius:14px; }
    .content-card-inner { padding:8px 24px 18px !important; }
    .order-list__item { border-color:#e4e9ef !important; }
    .order-list__product-image { border-radius:10px !important; background:#f7f9fb; }
    .subtotal-table--total strong { color:#102a43 !important; font-size:20px !important; }
    .support-card { margin-top:20px; background:#eef5ff; border:1px solid #dce8f7; border-radius:12px; }
    .support-card td { padding:18px 22px; color:#102a43; font-size:14px; line-height:1.5; }
    .footer__cell { padding:26px 0 42px !important; }
    .disclaimer__subtext { text-align:center; color:#718096 !important; }
    @media only screen and (max-width:620px) {
      .premium-hero { padding:32px 20px 26px !important; }
      h2 { font-size:25px !important; }
      .header__cell { padding:22px 12px 18px !important; }
      .content-card-inner { padding:5px 16px 14px !important; }
      .trust-cell { display:block !important; width:auto !important; border-left:0 !important; border-top:1px solid #dce7f4; }
      .trust-cell:first-child { border-top:0 !important; }
      .status-cell { font-size:11px !important; }
    }
  </style>
</head>

